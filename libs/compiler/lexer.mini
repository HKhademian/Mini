include "../common/list.mini";
/// Return a token map with the fields used by T0.
fn token_new(kind, text, source, start, end, line, column, context) {
    token := map_new();
    map_set(token, "kind", kind);
    map_set(token, "text", text);
    map_set(token, "source", source);
    map_set(token, "start", start);
    map_set(token, "end", end);
    map_set(token, "line", line);
    map_set(token, "column", column);
    map_set(token, "context", context);
    return token;
}

/// Advance lexer state and return the consumed character.
fn lex_advance(state) {
    source := map_get(state, "text");
    position := map_get(state, "position");
    value := text_get(source, position);
    map_set(state, "position", position + 1);
    if value == "\n" {
        map_set(state, "line", map_get(state, "line") + 1);
        map_set(state, "column", 1);
    } else {
        map_set(state, "column", map_get(state, "column") + 1);
    }
    return value;
}

/// Return a token at the current lexer position.
fn lex_start(state) {
    lines := map_get(state, "lines");
    token := token_new("symbol", "", map_get(state, "source"), map_get(state, "position"),
        map_get(state, "position"), map_get(state, "line"), map_get(state, "column"),
        list_get(lines, map_get(state, "line") - 1));
    return token;
}

/// Return the caret indent for a token's source column.
fn diagnostic_indent(token) {
    context := map_get(token, "context");
    column := map_get(token, "column");
    indent := "";
    position := 0;
    while position < column - 1 && position < text_length(context) {
        if text_get(context, position) == "\t" {
            indent = indent + "\t";
        } else {
            indent = indent + " ";
        }
        position = position + 1;
    }
    return indent;
}

/// Return one positioned diagnostic block.
fn diagnostic_text(token, label) {
    return map_get(token, "source") + ":" + number_to_text(map_get(token, "line")) + ":"
        + number_to_text(map_get(token, "column")) + ": " + label + "\n"
        + map_get(token, "context") + "\n" + diagnostic_indent(token) + "^\n";
}

/// Report a positioned diagnostic and stop the compiler.
fn diagnostic_fail(token, message) {
    io_write_error(diagnostic_text(token, message));
    process_exit(1);
    return 0;
}

/// Report a positioned warning and continue the compiler.
fn diagnostic_warn(token, message) {
    io_write_error(diagnostic_text(token, "warning: " + message));
    return 0;
}

/// Report a lexer/tokenizer diagnostic.
fn lex_fail(token, message) {
    return diagnostic_fail(token, message);
}

/// Scan text into a token list, matching T0 positions and diagnostics.
fn tokenize(source, source_name, include_comments) {
    state := map_new();
    map_set(state, "text", source);
    map_set(state, "source", source_name);
    map_set(state, "tokens", list_new());
    map_set(state, "lines", split_lines(source));
    map_set(state, "position", 0);
    map_set(state, "line", 1);
    map_set(state, "column", 1);
    if text_length(source) >= 2 && text_get(source, 0) == "#" && text_get(source, 1) == "!" {
        shebang_token := lex_start(state);
        map_set(shebang_token, "kind", "shebang");
        while map_get(state, "position") < text_length(source)
            && text_get(source, map_get(state, "position")) != "\r"
            && text_get(source, map_get(state, "position")) != "\n" {
            lex_advance(state);
        }
        map_set(shebang_token, "text", text_slice(source, map_get(shebang_token, "start"), map_get(state, "position")));
        map_set(shebang_token, "end", map_get(state, "position"));
        initial_tokens := map_get(state, "tokens");
        list_set(initial_tokens, list_length(initial_tokens), shebang_token);
    }
    while map_get(state, "position") < text_length(source) {
        character := text_get(source, map_get(state, "position"));
        if text_find(" \t\r\n", character) >= 0 {
            lex_advance(state);
        } else {
            if character == "/" && text_get(source, map_get(state, "position") + 1) == "/" {
                comment_token := lex_start(state);
                while map_get(state, "position") < text_length(source)
                    && text_get(source, map_get(state, "position")) != "\r"
                    && text_get(source, map_get(state, "position")) != "\n" {
                    lex_advance(state);
                }
                if include_comments {
                    map_set(comment_token, "kind", "comment");
                    map_set(comment_token, "text", text_slice(source, map_get(comment_token, "start"), map_get(state, "position")));
                    map_set(comment_token, "end", map_get(state, "position"));
                    comment_tokens := map_get(state, "tokens");
                    list_set(comment_tokens, list_length(comment_tokens), comment_token);
                }
            } else {
                token := lex_start(state);
                if is_letter(character) {
                    map_set(token, "kind", "identifier");
                    while map_get(state, "position") < text_length(source)
                        && is_identifier_part(text_get(source, map_get(state, "position"))) {
                        lex_advance(state);
                    }
                    spelling := text_slice(source, map_get(token, "start"), map_get(state, "position"));
                    if spelling == "fn" || spelling == "return" || spelling == "if"
                        || spelling == "else" || spelling == "while" || spelling == "true" || spelling == "false" {
                        map_set(token, "kind", "keyword");
                    }
                } else {
                    if is_digit(character) {
                        map_set(token, "kind", "number");
                        while map_get(state, "position") < text_length(source)
                            && is_digit(text_get(source, map_get(state, "position"))) {
                            lex_advance(state);
                        }
                    } else {
                        if character == "\"" {
                            map_set(token, "kind", "text");
                            lex_advance(state);
                            while map_get(state, "position") < text_length(source)
                                && text_get(source, map_get(state, "position")) != "\"" {
                                inner := text_get(source, map_get(state, "position"));
                                if inner == "\n" || inner == "\r" {
                                    lex_fail(token, "unterminated text");
                                }
                                if inner == "\\" {
                                    escape := lex_start(state);
                                    lex_advance(state);
                                    if map_get(state, "position") == text_length(source)
                                        || text_find("\"\\nrt", text_get(source, map_get(state, "position"))) < 0 {
                                        lex_fail(escape, "unknown text escape");
                                    }
                                }
                                lex_advance(state);
                            }
                            if map_get(state, "position") == text_length(source) {
                                lex_fail(token, "unterminated text");
                            }
                            lex_advance(state);
                        } else {
                            if is_two_character_symbol(text_slice(source, map_get(state, "position"), map_get(state, "position") + 2)) {
                                lex_advance(state);
                                lex_advance(state);
                            } else {
                                if text_find("=+-!<>(),;{}", character) >= 0 {
                                    lex_advance(state);
                                } else {
                                    lex_fail(token, "unexpected character " + json_to_text(character));
                                }
                            }
                        }
                    }
                }
                map_set(token, "text", text_slice(source, map_get(token, "start"), map_get(state, "position")));
                map_set(token, "end", map_get(state, "position"));
                tokens := map_get(state, "tokens");
                list_set(tokens, list_length(tokens), token);
            }
        }
    }
    end_token := lex_start(state);
    map_set(end_token, "kind", "eof");
    end_tokens := map_get(state, "tokens");
    list_set(end_tokens, list_length(end_tokens), end_token);
    return end_tokens;
}


/// Resolve an include path against the including file.
fn resolve_include(base, path) {
    if text_starts_with(path, "/") {
        return normalize_path(path);
    }
    directory := dirname(base);
    if directory == "" {
        return normalize_path(path);
    }
    return normalize_path(directory + "/" + path);
}


/// Splice included files into a token stream. Includes are top-level,
/// include-once, and rejected on cycles or missing files.
fn expand_includes(tokens, base, stack, seen) {
    output := list_new();
    position := 0;
    depth := 0;
    while position < list_length(tokens) {
        token := list_get(tokens, position);
        text := map_get(token, "text");
        if text == "{" {
            depth = depth + 1;
        }
        if text == "}" {
            depth = depth - 1;
        }
        is_include := text == "include" && position + 2 < list_length(tokens)
            && map_get(list_get(tokens, position + 1), "kind") == "text"
            && map_get(list_get(tokens, position + 2), "text") == ";";
        if !is_include {
            list_set(output, list_length(output), token);
            position = position + 1;
        } else {
            if depth != 0 {
                diagnostic_fail(token, "include must be top-level");
            }
            quoted := map_get(list_get(tokens, position + 1), "text");
            path := text_slice(quoted, 1, text_length(quoted) - 1);
            resolved := resolve_include(base, path);
            if list_has_text(stack, resolved) {
                diagnostic_fail(token, "include cycle: " + path);
            }
            if !map_has(seen, resolved) {
                if !path_is_exists(resolved) {
                    diagnostic_fail(token, "cannot include " + path);
                }
                raw := tokenize(file_read(resolved), path, false);
                included := list_new();
                raw_position := 0;
                while raw_position < list_length(raw) {
                    if map_get(list_get(raw, raw_position), "kind") != "eof" {
                        list_set(included, list_length(included), list_get(raw, raw_position));
                    }
                    raw_position = raw_position + 1;
                }
                if list_length(included) > 0 && map_get(list_get(included, 0), "kind") == "shebang" {
                    diagnostic_fail(token, "included file must not have a shebang");
                }
                map_set(seen, resolved, true);
                nested_stack := list_copy(stack);
                list_set(nested_stack, list_length(nested_stack), resolved);
                expanded := expand_includes(included, resolved, nested_stack, seen);
                index := 0;
                while index < list_length(expanded) {
                    list_set(output, list_length(output), list_get(expanded, index));
                    index = index + 1;
                }
            }
            position = position + 3;
        }
    }
    return output;
}
