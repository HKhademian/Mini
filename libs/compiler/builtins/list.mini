/// List API contracts; implementations live in common/list and emitter registries.

import "./registry";

builtin_add("list_copy", "list", "list", "performance");
builtin_add("list_get", "unknown,number", "unknown", "representation");
builtin_add("list_length", "list", "number", "representation");
builtin_add("list_new", "", "list", "representation");
builtin_add("list_set", "unknown,number,unknown", "number", "representation");
builtin_add("list_join", "list,text", "text", "performance");
builtin_add("list_truncate", "list,number", "number", "representation");
