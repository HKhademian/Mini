builtin_add("text_from_code", "number", "text", "representation");
builtin_add("text_get", "unknown,number", "text", "representation");
builtin_add("text_length", "text", "number", "representation");
builtin_add("text_slice", "text,number,number", "text", "performance");
builtin_add("text_split", "text,text", "list", "performance");
builtin_add("text_to_bytes", "text", "list", "performance");
