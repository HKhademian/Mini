/// Map API contracts; implementations live in common/map and emitter registries.

import "./registry";

builtin_add("map_copy", "map", "map", "performance");
builtin_add("map_get", "unknown,text", "unknown", "representation");
builtin_add("map_has", "map,text", "boolean", "representation");
builtin_add("map_keys", "map", "list", "representation");
builtin_add("map_new", "", "map", "representation");
builtin_add("map_delete", "unknown,text", "number", "representation");
builtin_add("map_set", "unknown,text,unknown", "number", "representation");
