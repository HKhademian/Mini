/// Number API contracts; implementations live in common/number and emitter registries.

import "./registry";

builtin_add("number_add", "unknown,unknown", "number", "performance");
builtin_add("number_sub", "unknown,unknown", "number", "performance");
builtin_add("number_min", "unknown,unknown", "number", "performance");
builtin_add("number_max", "unknown,unknown", "number", "performance");
builtin_add("number_div", "number,number", "number", "performance");
builtin_add("number_floor", "number", "number", "performance");
builtin_add("number_from_text", "text", "number", "performance");
builtin_add("number_mod", "number,number", "number", "performance");
builtin_add("number_mul", "number,number", "number", "performance");
builtin_add("number_pow", "number,number", "number", "performance");
builtin_add("number_to_text", "number", "text", "performance");
