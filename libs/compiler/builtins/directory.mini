/// Directory builtin descriptors.

builtin_add(
    "directory_create",
    "text",
    "number",
    "essential",
    "",
    "directory_create",
    "function $mini_directory_create(path) {\n    process.getBuiltinModule(\"node:fs\").mkdirSync(path, { recursive: true })\n    return 0;\n}\n",
    "",
    "$mini_directory_create({0})"
);
builtin_add(
    "directory_list",
    "text",
    "list",
    "essential",
    "",
    "directory_list",
    "function $mini_directory_list(path) {\n    const fs = process.getBuiltinModule(\"node:fs\");\n    try { return fs.readdirSync(path).sort(); } catch { return []; }\n}\n",
    "",
    "$mini_directory_list({0})"
);
