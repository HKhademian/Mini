/// Hash builtin descriptors.

builtin_add(
    "hash_sha256",
    "unknown",
    "text",
    "performance",
    "",
    "hash_sha256",
    "function $mini_hash_sha256(value) {\n    const crypto = process.getBuiltinModule(\"node:crypto\");\n    const bytes = Array.isArray(value)\n        ? Buffer.from(value.map(item => typeof item === \"number\" && Number.isInteger(item) ? item & 255 : 0))\n        : Buffer.from(typeof value === \"string\" ? value : String(value), \"utf8\");\n    return crypto.createHash(\"sha256\").update(bytes).digest(\"hex\");\n}\n",
    "",
    "$mini_hash_sha256({0})"
);
