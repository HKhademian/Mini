/// Value builtin descriptors.

builtin_add(
    "value_kind",
    "unknown",
    "text",
    "essential",
    "",
    "value_kind",
    "function $mini_value_kind(value) {\n    if (typeof value === \"string\") return \"text\";\n    if (typeof value === \"number\") return \"number\";\n    if (typeof value === \"boolean\") return \"boolean\";\n    if (Array.isArray(value)) return \"list\";\n    if (value !== null && typeof value === \"object\") return \"map\";\n    return \"other\";\n}\n",
    "",
    "$mini_value_kind({0})"
);
