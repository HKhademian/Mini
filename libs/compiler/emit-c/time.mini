/// Native C host clock replacement.

import "./registry";

emit_c_host_include_add("time.h");
emit_c_host_function_add(
    "time_millis",
    list_of(
        "int MINI_ID(fn_time_millis)(MINI_ID(context) * context, MINI_ID(params) params,",
        "                            MINI_ID(value) * result) {",
        "  if (!result || (params.count && !params.args)) {",
        "    return 1;",
        "  }",
        "  struct timespec now;",
        "  if (timespec_get(&now, TIME_UTC) != TIME_UTC) {",
        "    return 1;",
        "  }",
        "  *result = (MINI_ID(value))MINI_VALUE_NUMBER((double)now.tv_sec * 1000 + now.tv_nsec / 1000000);",
        "  (void)context;",
        "  return 0;",
        "}",
        ""
    )
);
