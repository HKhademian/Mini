/// Native C SHA-256 replacement for the common hash function.

import "./registry";

emit_c_host_function_add(
    "hash_sha256",
    list_of(
        "static uint32_t MINI_ID(sha_rotr)(uint32_t value, unsigned int count) {",
        "  return (value >> count) | (value << (32 - count));",
        "}",
        "static const uint32_t MINI_ID(sha_constants)[64] = {",
        "    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,",
        "    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,",
        "    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,",
        "    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,",
        "    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,",
        "    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,",
        "    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,",
        "    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2};",
        "static void MINI_ID(sha_block)(uint32_t state[8], const unsigned char block[64]) {",
        "  uint32_t words[64];",
        "  for (size_t i = 0; i < 16; ++i) {",
        "    words[i] = ((uint32_t)block[i * 4] << 24) | ((uint32_t)block[i * 4 + 1] << 16) |",
        "               ((uint32_t)block[i * 4 + 2] << 8) | block[i * 4 + 3];",
        "  }",
        "  for (size_t i = 16; i < 64; ++i) {",
        "    uint32_t x = words[i - 15], y = words[i - 2];",
        "    uint32_t s0 = MINI_ID(sha_rotr)(x, 7) ^ MINI_ID(sha_rotr)(x, 18) ^ (x >> 3);",
        "    uint32_t s1 = MINI_ID(sha_rotr)(y, 17) ^ MINI_ID(sha_rotr)(y, 19) ^ (y >> 10);",
        "    words[i] = words[i - 16] + s0 + words[i - 7] + s1;",
        "  }",
        "  uint32_t a = state[0], b = state[1], c = state[2], d = state[3], e = state[4], f = state[5],",
        "           g = state[6], h = state[7];",
        "  for (size_t i = 0; i < 64; ++i) {",
        "    uint32_t s1 = MINI_ID(sha_rotr)(e, 6) ^ MINI_ID(sha_rotr)(e, 11) ^ MINI_ID(sha_rotr)(e, 25),",
        "             ch = (e & f) ^ (~e & g);",
        "    uint32_t t1 = h + s1 + ch + MINI_ID(sha_constants)[i] + words[i];",
        "    uint32_t s0 = MINI_ID(sha_rotr)(a, 2) ^ MINI_ID(sha_rotr)(a, 13) ^ MINI_ID(sha_rotr)(a, 22),",
        "             maj = (a & b) ^ (a & c) ^ (b & c);",
        "    uint32_t t2 = s0 + maj;",
        "    h = g;",
        "    g = f;",
        "    f = e;",
        "    e = d + t1;",
        "    d = c;",
        "    c = b;",
        "    b = a;",
        "    a = t1 + t2;",
        "  }",
        "  state[0] += a;",
        "  state[1] += b;",
        "  state[2] += c;",
        "  state[3] += d;",
        "  state[4] += e;",
        "  state[5] += f;",
        "  state[6] += g;",
        "  state[7] += h;",
        "}",
        "static void MINI_ID(sha_update)(uint32_t state[8], unsigned char block[64], size_t *used,",
        "                                uint64_t *length, const unsigned char *bytes, size_t count) {",
        "  while (count) {",
        "    size_t take = 64 - *used;",
        "    if (take > count) {",
        "      take = count;",
        "    }",
        "    memcpy(block + *used, bytes, take);",
        "    *used += take;",
        "    bytes += take;",
        "    count -= take;",
        "    *length += take;",
        "    if (*used == 64) {",
        "      MINI_ID(sha_block)(state, block);",
        "      *used = 0;",
        "    }",
        "  }",
        "}",
        "int MINI_ID(fn_hash_sha256)(MINI_ID(context) * context, MINI_ID(params) params,",
        "                            MINI_ID(value) * result) {",
        "  static const char digits[] = \"0123456789abcdef\";",
        "  if (!context || !result || params.count < 1 || !params.args) {",
        "    return 1;",
        "  }",
        "  uint32_t state[8] = {0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,",
        "                       0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19};",
        "  unsigned char block[64] = {0};",
        "  size_t used = 0;",
        "  uint64_t length = 0;",
        "  MINI_ID(value) input = params.args[0];",
        "  if (input.kind == MINI_ID(kind_text)) {",
        "    const unsigned char *data = NULL;",
        "    if (!MINI_ID(text_view)(input.text, &data)) {",
        "      return 1;",
        "    }",
        "    MINI_ID(sha_update)(state, block, &used, &length, data, input.text.length);",
        "  } else if (input.kind == MINI_ID(kind_list) && input.list) {",
        "    MINI_ID(value) *items = (MINI_ID(value) *)input.list->values.items;",
        "    for (size_t i = 0; i < input.list->values.count; ++i) {",
        "      if (items[i].kind != MINI_ID(kind_number) || items[i].number < 0 || items[i].number > 255 ||",
        "          items[i].number != (double)(unsigned char)items[i].number) {",
        "        return 1;",
        "      }",
        "      unsigned char byte = (unsigned char)items[i].number;",
        "      MINI_ID(sha_update)(state, block, &used, &length, &byte, 1);",
        "    }",
        "  } else {",
        "    return 1;",
        "  }",
        "  uint64_t bit_length = length * 8;",
        "  block[used++] = 128;",
        "  if (used > 56) {",
        "    memset(block + used, 0, 64 - used);",
        "    MINI_ID(sha_block)(state, block);",
        "    used = 0;",
        "  }",
        "  memset(block + used, 0, 56 - used);",
        "  for (size_t i = 0; i < 8; ++i) {",
        "    block[63 - i] = (unsigned char)(bit_length >> (i * 8));",
        "  }",
        "  MINI_ID(sha_block)(state, block);",
        "  size_t offset = context->buffer.count;",
        "  for (size_t i = 0; i < 8; ++i) {",
        "    for (int shift = 28; shift >= 0; shift -= 4) {",
        "      unsigned char byte = (unsigned char)digits[(state[i] >> shift) & 15];",
        "      if (MINI_ID(text_buffer_append)(&context->buffer, &byte, 1) != 0) {",
        "        return 1;",
        "      }",
        "    }",
        "  }",
        "  *result = MINI_ID(value_text)(&context->buffer, offset, 64);",
        "  return 0;",
        "}",
        ""
    )
);
