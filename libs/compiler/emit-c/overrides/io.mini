/// Register native C lowering for the imported Mini I/O API.

import "./registry";

// io_write uses the runtime writer; io_write_line has no native variadic lowering.
emit_c_host_function_add("io_write", "");
emit_c_host_function_add(
    "io_write_line",
    "int MINI_ID(fn_io_write_line)(MINI_ID(context) *context, MINI_ID(params) params, MINI_ID(value) *result) {\n"
    + "    if (!result) return 1;\n"
    + "    (void)params;\n"
    + "    return MINI_ID(fn_panic)(context, (MINI_ID(params)) MINI_PARAMS(0, NULL), result);\n"
    + "}\n"
);
