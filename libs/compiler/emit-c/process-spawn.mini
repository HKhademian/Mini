/// Native C process spawning with captured byte streams and inherited mode.

import "./registry";

emit_c_host_preamble_add("#define _POSIX_C_SOURCE 200809L");
emit_c_host_include_add("sys/types.h");
emit_c_host_include_add("sys/wait.h");
emit_c_host_include_add("unistd.h");
emit_c_host_include_add("fcntl.h");
emit_c_host_include_add("poll.h");
emit_c_host_include_add("signal.h");
emit_c_host_include_add("time.h");

emit_c_host_runtime_after_context_add(
    "process_spawn",
    list_of(
        "static char *MINI_ID(process_c_text)(MINI_ID(value) value) {",
        "  if (value.kind != MINI_ID(kind_text) || !value.text.buffer ||",
        "      value.text.offset > value.text.buffer->count ||",
        "      value.text.length > value.text.buffer->count - value.text.offset ||",
        "      value.text.length == SIZE_MAX) {",
        "    return NULL;",
        "  }",
        "  const unsigned char *source = value.text.buffer->items + value.text.offset;",
        "  if (memchr(source, 0, value.text.length)) {",
        "    return NULL;",
        "  }",
        "  char *text = malloc(value.text.length + 1);",
        "  if (!text) {",
        "    return NULL;",
        "  }",
        "  memcpy(text, source, value.text.length);",
        "  text[value.text.length] = 0;",
        "  return text;",
        "}",
        "static void MINI_ID(process_map_set)(MINI_ID(context) * context, MINI_ID(value) map,",
        "                                     const char *name, MINI_ID(value) value) {",
        "  size_t length = strlen(name), offset = context->buffer.count;",
        "  (void)MINI_ID(text_buffer_append)(&context->buffer, (const unsigned char *)name, length);",
        "  MINI_ID(map_set_value)(map.map, MINI_ID(value_text)(&context->buffer, offset, length), value);",
        "}",
        "static void MINI_ID(process_set_text)(MINI_ID(context) * context, MINI_ID(value) map,",
        "                                      const char *name, const char *text) {",
        "  size_t length = strlen(text), offset = context->buffer.count;",
        "  (void)MINI_ID(text_buffer_append)(&context->buffer, (const unsigned char *)text, length);",
        "  MINI_ID(process_map_set)(context, map, name,",
        "                           MINI_ID(value_text)(&context->buffer, offset, length));",
        "}",
        "static void MINI_ID(process_append_bytes)(MINI_ID(value) list, const unsigned char *bytes,",
        "                                          size_t length) {",
        "  for (size_t i = 0; i < length; ++i) {",
        "    MINI_ID(list_push)(list.list, (MINI_ID(value))MINI_VALUE_NUMBER(bytes[i]), 0);",
        "  }",
        "}",
        "static int MINI_ID(process_pipe)(int descriptors[2]) { return pipe(descriptors); }",
        "static long long MINI_ID(process_millis)(void) {",
        "  struct timespec now;",
        "  if (clock_gettime(CLOCK_MONOTONIC, &now) != 0) {",
        "    return 0;",
        "  }",
        "  return (long long)now.tv_sec * 1000 + now.tv_nsec / 1000000;",
        "}",
        "static void MINI_ID(process_drain)(int *descriptor, MINI_ID(value) output) {",
        "  unsigned char bytes[4096];",
        "  for (;;) {",
        "    ssize_t count = read(*descriptor, bytes, sizeof(bytes));",
        "    if (count > 0) {",
        "      MINI_ID(process_append_bytes)(output, bytes, (size_t)count);",
        "    } else if (count == 0) {",
        "      close(*descriptor);",
        "      *descriptor = -1;",
        "      return;",
        "    } else if (errno == EINTR) {",
        "      continue;",
        "    } else if (errno == EAGAIN || errno == EWOULDBLOCK) {",
        "      return;",
        "    } else {",
        "      close(*descriptor);",
        "      *descriptor = -1;",
        "      return;",
        "    }",
        "  }",
        "}",
        "static int MINI_ID(process_fd_nonblock)(int descriptor) {",
        "  int flags = fcntl(descriptor, F_GETFL, 0);",
        "  return flags < 0 || fcntl(descriptor, F_SETFL, flags | O_NONBLOCK) < 0 ? -1 : 0;",
        "}",
        "static MINI_ID(value)",
        "    MINI_ID(process_option)(MINI_ID(context) * context, MINI_ID(value) options, const char *name) {",
        "  size_t length = strlen(name), offset = context->buffer.count;",
        "  (void)MINI_ID(text_buffer_append)(&context->buffer, (const unsigned char *)name, length);",
        "  return MINI_ID(map_get_value)(options, MINI_ID(value_text)(&context->buffer, offset, length));",
        "}",
        "static int MINI_ID(process_text_is)(MINI_ID(value) value, const char *expected) {",
        "  if (value.kind != MINI_ID(kind_text) || !value.text.buffer ||",
        "      value.text.offset > value.text.buffer->count ||",
        "      value.text.length > value.text.buffer->count - value.text.offset) {",
        "    return 0;",
        "  }",
        "  size_t length = strlen(expected);",
        "  return length == value.text.length &&",
        "         (!length || memcmp(value.text.buffer->items + value.text.offset, expected, length) == 0);",
        "}",
        "static void MINI_ID(process_close)(int *descriptor) {",
        "  if (*descriptor >= 0) {",
        "    close(*descriptor);",
        "    *descriptor = -1;",
        "  }",
        "}",
        "static int MINI_ID(process_spawn_run)(MINI_ID(context) * context, MINI_ID(value) options,",
        "                                      MINI_ID(value) * result) {",
        "  if (!context || !result || options.kind != MINI_ID(kind_map) || !options.map) {",
        "    return 1;",
        "  }",
        "  *result = MINI_ID(map_new)(context);",
        "  MINI_ID(value) output = MINI_ID(list_new)(context), errors = MINI_ID(list_new)(context);",
        "  MINI_ID(process_map_set)(context, *result, \"stdout\", output);",
        "  MINI_ID(process_map_set)(context, *result, \"stderr\", errors);",
        "  MINI_ID(process_map_set)(context, *result, \"status\", (MINI_ID(value))MINI_VALUE_NUMBER(1));",
        "  MINI_ID(process_set_text)(context, *result, \"signal\", \"\");",
        "  MINI_ID(process_set_text)(context, *result, \"error\", \"\");",
        "  MINI_ID(value) command_option = MINI_ID(process_option)(context, options, \"command\");",
        "  char *command = MINI_ID(process_c_text)(command_option);",
        "  if (!command || !command[0]) {",
        "    free(command);",
        "    MINI_ID(process_set_text)(context, *result, \"error\", \"spawn failed\");",
        "    return 0;",
        "  }",
        "  MINI_ID(value) arguments = MINI_ID(process_option)(context, options, \"arguments\");",
        "  size_t argument_count =",
        "      arguments.kind == MINI_ID(kind_list) && arguments.list ? arguments.list->values.count : 0;",
        "  char **argv = calloc(argument_count + 2, sizeof(char *));",
        "  if (!argv) {",
        "    free(command);",
        "    return 1;",
        "  }",
        "  argv[0] = command;",
        "  MINI_ID(value) *argument_values =",
        "      arguments.list ? (MINI_ID(value) *)arguments.list->values.items : NULL;",
        "  for (size_t i = 0; i < argument_count; ++i) {",
        "    argv[i + 1] = MINI_ID(process_c_text)(argument_values[i]);",
        "    if (!argv[i + 1]) {",
        "      for (size_t j = 1; j <= i; ++j) {",
        "        free(argv[j]);",
        "      }",
        "      free(argv);",
        "      free(command);",
        "      return 1;",
        "    }",
        "  }",
        "  MINI_ID(value) directory_option = MINI_ID(process_option)(context, options, \"directory\");",
        "  char *directory = NULL;",
        "  if (directory_option.kind == MINI_ID(kind_text) && directory_option.text.length) {",
        "    directory = MINI_ID(process_c_text)(directory_option);",
        "    if (!directory) {",
        "      for (size_t i = 1; i <= argument_count; ++i) {",
        "        free(argv[i]);",
        "      }",
        "      free(argv);",
        "      free(command);",
        "      return 1;",
        "    }",
        "  }",
        "  MINI_ID(value) mode = MINI_ID(process_option)(context, options, \"mode\");",
        "  int inherit = MINI_ID(process_text_is)(mode, \"inherit\");",
        "  MINI_ID(value) timeout_option = MINI_ID(process_option)(context, options, \"timeout\");",
        "  long long timeout = timeout_option.kind == MINI_ID(kind_number) && timeout_option.number > 0",
        "                          ? (long long)timeout_option.number",
        "                          : 0;",
        "  long long deadline = timeout ? MINI_ID(process_millis)() + timeout : 0;",
        "  MINI_ID(value) input = MINI_ID(process_option)(context, options, \"input\");",
        "  MINI_ID(value) *input_values = input.kind == MINI_ID(kind_list) && input.list",
        "                                     ? (MINI_ID(value) *)input.list->values.items",
        "                                     : NULL;",
        "  size_t input_count =",
        "      input.kind == MINI_ID(kind_list) && input.list ? input.list->values.count : 0;",
        "  unsigned char *input_bytes = input_count ? malloc(input_count) : NULL;",
        "  if (input_count && !input_bytes) {",
        "    for (size_t i = 1; i <= argument_count; ++i) {",
        "      free(argv[i]);",
        "    }",
        "    free(argv);",
        "    free(command);",
        "    free(directory);",
        "    return 1;",
        "  }",
        "  for (size_t i = 0; i < input_count; ++i) {",
        "    double number = input_values[i].number;",
        "    if (input_values[i].kind != MINI_ID(kind_number) || number != number || number < 0 ||",
        "        number > 255 || number != (double)(unsigned char)number) {",
        "      free(input_bytes);",
        "      for (size_t j = 1; j <= argument_count; ++j) {",
        "        free(argv[j]);",
        "      }",
        "      free(argv);",
        "      free(command);",
        "      free(directory);",
        "      return 1;",
        "    }",
        "    input_bytes[i] = (unsigned char)number;",
        "  }",
        "  if (inherit && fflush(NULL) != 0) {",
        "    free(input_bytes);",
        "    for (size_t i = 1; i <= argument_count; ++i) {",
        "      free(argv[i]);",
        "    }",
        "    free(argv);",
        "    free(command);",
        "    free(directory);",
        "    return 1;",
        "  }",
        "  int out_pipe[2] = {-1, -1}, err_pipe[2] = {-1, -1}, in_pipe[2] = {-1, -1},",
        "      exec_pipe[2] = {-1, -1};",
        "  if ((!inherit && (MINI_ID(process_pipe)(out_pipe) || MINI_ID(process_pipe)(err_pipe) ||",
        "                    MINI_ID(process_pipe)(in_pipe))) ||",
        "      MINI_ID(process_pipe)(exec_pipe)) {",
        "    int saved = errno;",
        "    MINI_ID(process_close)(&out_pipe[0]);",
        "    MINI_ID(process_close)(&out_pipe[1]);",
        "    MINI_ID(process_close)(&err_pipe[0]);",
        "    MINI_ID(process_close)(&err_pipe[1]);",
        "    MINI_ID(process_close)(&in_pipe[0]);",
        "    MINI_ID(process_close)(&in_pipe[1]);",
        "    free(input_bytes);",
        "    for (size_t i = 1; i <= argument_count; ++i) {",
        "      free(argv[i]);",
        "    }",
        "    free(argv);",
        "    free(command);",
        "    free(directory);",
        "    MINI_ID(process_set_text)(context, *result, \"error\", strerror(saved));",
        "    return 0;",
        "  }",
        "  (void)fcntl(exec_pipe[1], F_SETFD, FD_CLOEXEC);",
        "  pid_t child = fork();",
        "  if (child < 0) {",
        "    int saved = errno;",
        "    MINI_ID(process_close)(&out_pipe[0]);",
        "    MINI_ID(process_close)(&out_pipe[1]);",
        "    MINI_ID(process_close)(&err_pipe[0]);",
        "    MINI_ID(process_close)(&err_pipe[1]);",
        "    MINI_ID(process_close)(&in_pipe[0]);",
        "    MINI_ID(process_close)(&in_pipe[1]);",
        "    MINI_ID(process_close)(&exec_pipe[0]);",
        "    MINI_ID(process_close)(&exec_pipe[1]);",
        "    free(input_bytes);",
        "    for (size_t i = 1; i <= argument_count; ++i) {",
        "      free(argv[i]);",
        "    }",
        "    free(argv);",
        "    free(command);",
        "    free(directory);",
        "    MINI_ID(process_set_text)(context, *result, \"error\", strerror(saved));",
        "    return 0;",
        "  }",
        "  if (child == 0) {",
        "    MINI_ID(process_close)(&exec_pipe[0]);",
        "    if (!inherit) {",
        "      MINI_ID(process_close)(&out_pipe[0]);",
        "      MINI_ID(process_close)(&err_pipe[0]);",
        "      MINI_ID(process_close)(&in_pipe[1]);",
        "      (void)dup2(in_pipe[0], STDIN_FILENO);",
        "      (void)dup2(out_pipe[1], STDOUT_FILENO);",
        "      (void)dup2(err_pipe[1], STDERR_FILENO);",
        "    }",
        "    if (directory && chdir(directory) != 0) {",
        "      int saved = errno;",
        "      (void)write(exec_pipe[1], &saved, sizeof(saved));",
        "      _exit(127);",
        "    }",
        "    execvp(command, argv);",
        "    int saved = errno;",
        "    (void)write(exec_pipe[1], &saved, sizeof(saved));",
        "    _exit(127);",
        "  }",
        "  MINI_ID(process_close)(&exec_pipe[1]);",
        "  if (!inherit) {",
        "    MINI_ID(process_close)(&out_pipe[1]);",
        "    MINI_ID(process_close)(&err_pipe[1]);",
        "    MINI_ID(process_close)(&in_pipe[0]);",
        "    (void)MINI_ID(process_fd_nonblock)(out_pipe[0]);",
        "    (void)MINI_ID(process_fd_nonblock)(err_pipe[0]);",
        "    (void)MINI_ID(process_fd_nonblock)(in_pipe[1]);",
        "  }",
        "  size_t input_offset = 0;",
        "  if (!input_count || inherit) {",
        "    MINI_ID(process_close)(&in_pipe[1]);",
        "  }",
        "  int status = 0, done = 0, timed_out = 0, child_done = 0;",
        "  while (!done) {",
        "    if (!inherit) {",
        "      struct pollfd watched[3];",
        "      nfds_t count = 0;",
        "      int out_index = -1, err_index = -1, in_index = -1;",
        "      if (out_pipe[0] >= 0) {",
        "        out_index = (int)count;",
        "        watched[count++] = (struct pollfd){out_pipe[0], POLLIN | POLLHUP, 0};",
        "      }",
        "      if (err_pipe[0] >= 0) {",
        "        err_index = (int)count;",
        "        watched[count++] = (struct pollfd){err_pipe[0], POLLIN | POLLHUP, 0};",
        "      }",
        "      if (in_pipe[1] >= 0) {",
        "        in_index = (int)count;",
        "        watched[count++] = (struct pollfd){in_pipe[1], POLLOUT | POLLHUP, 0};",
        "      }",
        "      int wait_ms = 50;",
        "      if (deadline) {",
        "        long long remaining = deadline - MINI_ID(process_millis)();",
        "        if (remaining <= 0) {",
        "          timed_out = 1;",
        "          break;",
        "        }",
        "        if (remaining < wait_ms) {",
        "          wait_ms = (int)remaining;",
        "        }",
        "      }",
        "      if (count) {",
        "        (void)poll(watched, count, wait_ms);",
        "      } else {",
        "        (void)poll(NULL, 0, wait_ms);",
        "      }",
        "      if (out_index >= 0 && (watched[out_index].revents & (POLLIN | POLLHUP | POLLERR))) {",
        "        MINI_ID(process_drain)(&out_pipe[0], output);",
        "      }",
        "      if (err_index >= 0 && (watched[err_index].revents & (POLLIN | POLLHUP | POLLERR))) {",
        "        MINI_ID(process_drain)(&err_pipe[0], errors);",
        "      }",
        "      if (in_index >= 0 && (watched[in_index].revents & (POLLOUT | POLLHUP | POLLERR))) {",
        "        ssize_t sent = write(in_pipe[1], input_bytes + input_offset, input_count - input_offset);",
        "        if (sent > 0) {",
        "          input_offset += (size_t)sent;",
        "        }",
        "        if (sent < 0 && errno != EINTR && errno != EAGAIN && errno != EWOULDBLOCK) {",
        "          MINI_ID(process_close)(&in_pipe[1]);",
        "        }",
        "        if (input_offset == input_count) {",
        "          MINI_ID(process_close)(&in_pipe[1]);",
        "        }",
        "      }",
        "    } else if (deadline) {",
        "      long long remaining = deadline - MINI_ID(process_millis)();",
        "      if (remaining <= 0) {",
        "        timed_out = 1;",
        "        break;",
        "      }",
        "      struct timespec pause = {0, 50000000};",
        "      (void)nanosleep(&pause, NULL);",
        "    }",
        "    if (!child_done) {",
        "      pid_t waited = waitpid(child, &status, WNOHANG);",
        "      if (waited == child) {",
        "        child_done = 1;",
        "      } else if (waited < 0 && errno != EINTR) {",
        "        child_done = 1;",
        "      }",
        "    }",
        "    if (child_done && (inherit || (out_pipe[0] < 0 && err_pipe[0] < 0))) {",
        "      done = 1;",
        "    }",
        "  }",
        "  if (timed_out) {",
        "    (void)kill(child, SIGKILL);",
        "    (void)waitpid(child, &status, 0);",
        "    child_done = 1;",
        "  }",
        "  if (!inherit) {",
        "    if (out_pipe[0] >= 0) {",
        "      MINI_ID(process_drain)(&out_pipe[0], output);",
        "    }",
        "    if (err_pipe[0] >= 0) {",
        "      MINI_ID(process_drain)(&err_pipe[0], errors);",
        "    }",
        "  }",
        "  int exec_error = 0;",
        "  ssize_t error_size = read(exec_pipe[0], &exec_error, sizeof(exec_error));",
        "  MINI_ID(process_close)(&exec_pipe[0]);",
        "  MINI_ID(process_close)(&out_pipe[0]);",
        "  MINI_ID(process_close)(&err_pipe[0]);",
        "  MINI_ID(process_close)(&in_pipe[1]);",
        "  free(input_bytes);",
        "  for (size_t i = 1; i <= argument_count; ++i) {",
        "    free(argv[i]);",
        "  }",
        "  free(argv);",
        "  free(command);",
        "  free(directory);",
        "  int exit_status = WIFEXITED(status) ? WEXITSTATUS(status) : 1;",
        "  if (error_size == (ssize_t)sizeof(exec_error)) {",
        "    exit_status = 1;",
        "  }",
        "  MINI_ID(process_map_set)(context, *result, \"status\",",
        "                           (MINI_ID(value))MINI_VALUE_NUMBER(exit_status));",
        "  if (WIFSIGNALED(status)) {",
        "    const char *signal_name = WTERMSIG(status) == SIGKILL   ? \"SIGKILL\"",
        "                              : WTERMSIG(status) == SIGTERM ? \"SIGTERM\"",
        "                              : WTERMSIG(status) == SIGINT  ? \"SIGINT\"",
        "                                                            : \"signal\";",
        "    MINI_ID(process_set_text)(context, *result, \"signal\", signal_name);",
        "  }",
        "  if (timed_out) {",
        "    MINI_ID(process_set_text)(context, *result, \"error\", \"process timed out\");",
        "  } else if (error_size == (ssize_t)sizeof(exec_error)) {",
        "    MINI_ID(process_set_text)(context, *result, \"error\", strerror(exec_error));",
        "  }",
        "  return 0;",
        "}",
        ""
    )
);

emit_c_host_function_add(
    "process_spawn",
    list_of(
        "int MINI_ID(fn_process_spawn)(MINI_ID(context) * context, MINI_ID(params) params,",
        "                              MINI_ID(value) * result) {",
        "  if (!context || !result || params.count < 1 || !params.args) {",
        "    return 1;",
        "  }",
        "  return MINI_ID(process_spawn_run)(context, params.args[0], result);",
        "}",
        ""
    )
);
