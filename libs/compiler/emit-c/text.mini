/// Native C replacements for the ASCII text representation operations.

import "./registry";

emit_c_host_runtime_add(
    "text_units",
    text_join(
        "\n",
        "static int MINI_ID(text_decode)(const unsigned char *bytes, size_t length, uint32_t *code,",
        "                                size_t *width) {",
        "  if (!bytes || !length || !code || !width) {",
        "    return 0;",
        "  }",
        "  unsigned char first = bytes[0];",
        "  if (first <= 127) {",
        "    *code = first;",
        "    *width = 1;",
        "    return 1;",
        "  }",
        "  if (first >= 194 && first <= 223 && length >= 2 && (bytes[1] & 192) == 128) {",
        "    *code = ((uint32_t)(first & 31) << 6) | (uint32_t)(bytes[1] & 63);",
        "    *width = 2;",
        "    return 1;",
        "  }",
        "  if (first >= 224 && first <= 239 && length >= 3 && (bytes[1] & 192) == 128 &&",
        "      (bytes[2] & 192) == 128 && !(first == 224 && bytes[1] < 160)) {",
        "    *code = ((uint32_t)(first & 15) << 12) | ((uint32_t)(bytes[1] & 63) << 6) |",
        "            (uint32_t)(bytes[2] & 63);",
        "    *width = 3;",
        "    return 1;",
        "  }",
        "  if (first >= 240 && first <= 244 && length >= 4 && (bytes[1] & 192) == 128 &&",
        "      (bytes[2] & 192) == 128 && (bytes[3] & 192) == 128 && !(first == 240 && bytes[1] < 144) &&",
        "      !(first == 244 && bytes[1] > 143)) {",
        "    *code = ((uint32_t)(first & 7) << 18) | ((uint32_t)(bytes[1] & 63) << 12) |",
        "            ((uint32_t)(bytes[2] & 63) << 6) | (uint32_t)(bytes[3] & 63);",
        "    *width = 4;",
        "    return 1;",
        "  }",
        "  return 0;",
        "}",
        "static int MINI_ID(text_view)(MINI_ID(text) text, const unsigned char **data) {",
        "  if (!text.buffer || text.offset > text.buffer->count ||",
        "      text.length > text.buffer->count - text.offset) {",
        "    return 0;",
        "  }",
        "  *data = text.buffer->items;",
        "  if (text.length) {",
        "    *data += text.offset;",
        "  }",
        "  return 1;",
        "}",
        "static int MINI_ID(text_units_length)(MINI_ID(text) text, size_t *units) {",
        "  if (!units) {",
        "    return 0;",
        "  }",
        "  if (text.units_known) {",
        "    *units = text.units;",
        "    return 1;",
        "  }",
        "  const unsigned char *data = NULL;",
        "  if (!MINI_ID(text_view)(text, &data)) {",
        "    return 0;",
        "  }",
        "  size_t count = 0, offset = 0;",
        "  while (offset < text.length) {",
        "    uint32_t code = 0;",
        "    size_t width = 0;",
        "    if (!MINI_ID(text_decode)(data + offset, text.length - offset, &code, &width)) {",
        "      return 0;",
        "    }",
        "    size_t add = 1;",
        "    if (count == SIZE_MAX) {",
        "      return 0;",
        "    }",
        "    count += add;",
        "    offset += width;",
        "  }",
        "  *units = count;",
        "  return 1;",
        "}",
        "static int MINI_ID(text_unit_offset)(MINI_ID(text) text, size_t position, size_t *byte_offset,",
        "                                     int *boundary) {",
        "  const unsigned char *data = NULL;",
        "  if (!byte_offset || !boundary || !MINI_ID(text_view)(text, &data)) {",
        "    return 0;",
        "  }",
        "  if (text.ascii_known && text.ascii) {",
        "    if (position > text.length) {",
        "      return 0;",
        "    }",
        "    *byte_offset = position;",
        "    *boundary = 1;",
        "    return 1;",
        "  }",
        "  size_t offset = 0, unit = 0;",
        "  if (!position) {",
        "    *byte_offset = 0;",
        "    *boundary = 1;",
        "    return 1;",
        "  }",
        "  while (offset < text.length) {",
        "    uint32_t code = 0;",
        "    size_t width = 0;",
        "    if (!MINI_ID(text_decode)(data + offset, text.length - offset, &code, &width)) {",
        "      return 0;",
        "    }",
        "    size_t count = 1;",
        "    if (position == unit) {",
        "      *byte_offset = offset;",
        "      *boundary = 1;",
        "      return 1;",
        "    }",
        "    if (position > unit && position < unit + count) {",
        "      *byte_offset = offset + width;",
        "      *boundary = 0;",
        "      return 1;",
        "    }",
        "    unit += count;",
        "    offset += width;",
        "    if (position == unit) {",
        "      *byte_offset = offset;",
        "      *boundary = 1;",
        "      return 1;",
        "    }",
        "  }",
        "  if (position != unit) {",
        "    return 0;",
        "  }",
        "  *byte_offset = offset;",
        "  *boundary = 1;",
        "  return 1;",
        "}",
        "typedef struct {",
        "  const unsigned char *data;",
        "  size_t length, offset;",
        "  uint16_t pending;",
        "  int has_pending;",
        "} MINI_ID(text_cursor);",
        "static int MINI_ID(text_next_unit)(MINI_ID(text_cursor) * cursor, uint16_t *unit) {",
        "  if (cursor->has_pending) {",
        "    *unit = cursor->pending;",
        "    cursor->has_pending = 0;",
        "    return 1;",
        "  }",
        "  if (cursor->offset >= cursor->length) {",
        "    return 0;",
        "  }",
        "  uint32_t code = 0;",
        "  size_t width = 0;",
        "  if (!MINI_ID(text_decode)(cursor->data + cursor->offset, cursor->length - cursor->offset, &code,",
        "                            &width)) {",
        "    return -1;",
        "  }",
        "  cursor->offset += width;",
        "  if (code > 65535) {",
        "    code -= 65536;",
        "    *unit = (uint16_t)(55296 + (code >> 10));",
        "    cursor->pending = (uint16_t)(56320 + (code & 1023));",
        "    cursor->has_pending = 1;",
        "  } else {",
        "    *unit = (uint16_t)code;",
        "  }",
        "  return 1;",
        "}",
        "static int MINI_ID(text_unit_compare)(MINI_ID(text) left, MINI_ID(text) right) {",
        "  const unsigned char *a = NULL, *b = NULL;",
        "  if (!MINI_ID(text_view)(left, &a)) {",
        "    return -1;",
        "  }",
        "  if (!MINI_ID(text_view)(right, &b)) {",
        "    return 1;",
        "  }",
        "  MINI_ID(text_cursor) x = {a, left.length, 0, 0, 0}, y = {b, right.length, 0, 0, 0};",
        "  for (;;) {",
        "    uint16_t u = 0, v = 0;",
        "    int has_u = MINI_ID(text_next_unit)(&x, &u), has_v = MINI_ID(text_next_unit)(&y, &v);",
        "    if (has_u < 0 || has_v < 0) {",
        "      return has_u < has_v ? -1 : 1;",
        "    }",
        "    if (!has_u || !has_v) {",
        "      return has_u - has_v;",
        "    }",
        "    if (u != v) {",
        "      return u < v ? -1 : 1;",
        "    }",
        "  }",
        "}",
        ""
    )
);

emit_c_host_runtime_after_context_add(
    "text_utf16_extract",
    text_join(
        "\n",
        "static int MINI_ID(text_utf16_extract)(MINI_ID(context) * context, MINI_ID(text) source,",
        "                                       size_t start, size_t end, MINI_ID(value) * result) {",
        "  size_t total = 0;",
        "  if (!context || !result || !source.buffer || source.offset > source.buffer->count ||",
        "      source.length > source.buffer->count - source.offset ||",
        "      !MINI_ID(text_units_length)(source, &total) || start > end || end > total) {",
        "    return 1;",
        "  }",
        "  size_t byte_start = 0, byte_end = 0;",
        "  int start_boundary = 0, end_boundary = 0;",
        "  if (!MINI_ID(text_unit_offset)(source, start, &byte_start, &start_boundary) ||",
        "      !MINI_ID(text_unit_offset)(source, end, &byte_end, &end_boundary)) {",
        "    return 1;",
        "  }",
        "  if (start_boundary && end_boundary) {",
        "    *result = (MINI_ID(value))MINI_VALUE_TEXT(source.buffer, source.offset + byte_start,",
        "                                              byte_end - byte_start);",
        "    result->text.units = end - start;",
        "    result->text.units_known = 1;",
        "    result->text.ascii_known = source.ascii_known;",
        "    result->text.ascii = source.ascii;",
        "    return 0;",
        "  }",
        "  size_t output = context->buffer.count, offset = 0, unit = 0;",
        "  while (offset < source.length && unit < end) {",
        "    uint32_t code = 0;",
        "    size_t width = 0;",
        "    const unsigned char *data = source.buffer->items + source.offset;",
        "    if (!MINI_ID(text_decode)(data + offset, source.length - offset, &code, &width)) {",
        "      return 1;",
        "    }",
        "    size_t count = 1;",
        "    size_t first = start > unit ? start : unit, last = end < unit + count ? end : unit + count;",
        "    if (last > first) {",
        "      if (count == 2 && last - first == 1) {",
        "        uint32_t scalar = code - 65536,",
        "                 surrogate = first == unit ? 55296 + (scalar >> 10) : 56320 + (scalar & 1023);",
        "        unsigned char encoded[3] = {(unsigned char)(224 | (surrogate >> 12)),",
        "                                    (unsigned char)(128 | ((surrogate >> 6) & 63)),",
        "                                    (unsigned char)(128 | (surrogate & 63))};",
        "        if (MINI_ID(text_buffer_append)(&context->buffer, encoded, 3) != 0) {",
        "          return 1;",
        "        }",
        "      } else if (MINI_ID(text_buffer_append)(&context->buffer, data + offset, width) != 0) {",
        "        return 1;",
        "      }",
        "    }",
        "    unit += count;",
        "    offset += width;",
        "  }",
        "  *result = MINI_ID(value_text)(&context->buffer, output, context->buffer.count - output);",
        "  return 0;",
        "}",
        ""
    )
);

emit_c_host_function_add(
    "text_merge",
    text_join(
        "\n",
        "int MINI_ID(fn_text_merge)(MINI_ID(context) * context, MINI_ID(params) params,",
        "                           MINI_ID(value) * result) {",
        "  if (!context || !result || (params.count && !params.args)) {",
        "    return 1;",
        "  }",
        "  size_t offset = context->buffer.count;",
        "  for (size_t index = 0; index < params.count; ++index) {",
        "    MINI_ID(value) value = params.args[index];",
        "    if (value.kind != MINI_ID(kind_text)) {",
        "      continue;",
        "    }",
        "    MINI_ID(text_buffer) *buffer = value.text.buffer;",
        "    if (!buffer || value.text.offset > buffer->count ||",
        "        value.text.length > buffer->count - value.text.offset) {",
        "      return 1;",
        "    }",
        "    if (value.text.length &&",
        "        MINI_ID(text_buffer_append)(&context->buffer, buffer->items + value.text.offset,",
        "                                    value.text.length) != 0) {",
        "      return 1;",
        "    }",
        "  }",
        "  *result = MINI_ID(value_text)(&context->buffer, offset, context->buffer.count - offset);",
        "  return 0;",
        "}",
        ""
    )
);

