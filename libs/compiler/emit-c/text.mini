/// Native C replacements for UTF-8 text operations.

import "./registry";

emit_c_host_runtime_add(
    "text_scalars",
    list_of(
        "static int MINI_ID(text_decode)(const unsigned char *bytes, size_t length, uint32_t *code,",
        "                                size_t *width) {",
        "  if (!bytes || !length || !code || !width) {",
        "    return 0;",
        "  }",
        "  unsigned char first = bytes[0];",
        "  if (first <= 127) {",
        "    *code = first;",
        "    *width = 1;",
        "    return 1;",
        "  }",
        "  if (first >= 194 && first <= 223 && length >= 2 && (bytes[1] & 192) == 128) {",
        "    *code = ((uint32_t)(first & 31) << 6) | (uint32_t)(bytes[1] & 63);",
        "    *width = 2;",
        "    return 1;",
        "  }",
        "  if (first >= 224 && first <= 239 && length >= 3 && (bytes[1] & 192) == 128 &&",
        "      (bytes[2] & 192) == 128 && !(first == 224 && bytes[1] < 160) &&",
        "      !(first == 237 && bytes[1] >= 160)) {",
        "    *code = ((uint32_t)(first & 15) << 12) | ((uint32_t)(bytes[1] & 63) << 6) |",
        "            (uint32_t)(bytes[2] & 63);",
        "    *width = 3;",
        "    return 1;",
        "  }",
        "  if (first >= 240 && first <= 244 && length >= 4 && (bytes[1] & 192) == 128 &&",
        "      (bytes[2] & 192) == 128 && (bytes[3] & 192) == 128 && !(first == 240 && bytes[1] < 144) &&",
        "      !(first == 244 && bytes[1] > 143)) {",
        "    *code = ((uint32_t)(first & 7) << 18) | ((uint32_t)(bytes[1] & 63) << 12) |",
        "            ((uint32_t)(bytes[2] & 63) << 6) | (uint32_t)(bytes[3] & 63);",
        "    *width = 4;",
        "    return 1;",
        "  }",
        "  return 0;",
        "}",
        "static int MINI_ID(text_view)(MINI_ID(text) text, const unsigned char **data) {",
        "  if (!text.buffer || text.offset > text.buffer->count ||",
        "      text.length > text.buffer->count - text.offset) {",
        "    return 0;",
        "  }",
        "  *data = text.buffer->items;",
        "  if (text.length) {",
        "    *data += text.offset;",
        "  }",
        "  return 1;",
        "}",
        "static int MINI_ID(text_scalar_length)(MINI_ID(text) text, size_t *scalars) {",
        "  if (!scalars) {",
        "    return 0;",
        "  }",
        "  if (text.scalars_known) {",
        "    *scalars = text.scalars;",
        "    return 1;",
        "  }",
        "  const unsigned char *data = NULL;",
        "  if (!MINI_ID(text_view)(text, &data)) {",
        "    return 0;",
        "  }",
        "  size_t count = 0, offset = 0;",
        "  while (offset < text.length) {",
        "    uint32_t code = 0;",
        "    size_t width = 0;",
        "    if (!MINI_ID(text_decode)(data + offset, text.length - offset, &code, &width)) {",
        "      return 0;",
        "    }",
        "    if (count == SIZE_MAX) {",
        "      return 0;",
        "    }",
        "    count += 1;",
        "    offset += width;",
        "  }",
        "  *scalars = count;",
        "  return 1;",
        "}",
        "static int MINI_ID(text_scalar_offset)(MINI_ID(text) text, size_t position, size_t *byte_offset) {",
        "  const unsigned char *data = NULL;",
        "  if (!byte_offset || !MINI_ID(text_view)(text, &data)) {",
        "    return 0;",
        "  }",
        "  if (text.ascii_known && text.ascii) {",
        "    if (position > text.length) {",
        "      return 0;",
        "    }",
        "    *byte_offset = position;",
        "    return 1;",
        "  }",
        "  size_t offset = 0, scalar = 0;",
        "  if (!position) {",
        "    *byte_offset = 0;",
        "    return 1;",
        "  }",
        "  while (scalar < position && offset < text.length) {",
        "    uint32_t code = 0;",
        "    size_t width = 0;",
        "    if (!MINI_ID(text_decode)(data + offset, text.length - offset, &code, &width)) {",
        "      return 0;",
        "    }",
        "    scalar += 1;",
        "    offset += width;",
        "  }",
        "  if (position != scalar) {",
        "    return 0;",
        "  }",
        "  *byte_offset = offset;",
        "  return 1;",
        "}",
        "static int MINI_ID(text_compare)(MINI_ID(text) left, MINI_ID(text) right) {",
        "  const unsigned char *a = NULL, *b = NULL;",
        "  if (!MINI_ID(text_view)(left, &a)) {",
        "    return -1;",
        "  }",
        "  if (!MINI_ID(text_view)(right, &b)) {",
        "    return 1;",
        "  }",
        "  size_t common = left.length < right.length ? left.length : right.length;",
        "  int compared = common ? memcmp(a, b, common) : 0;",
        "  return compared ? compared : (left.length > right.length) - (left.length < right.length);",
        "}",
        ""
    )
);

emit_c_host_runtime_after_context_add(
    "text_scalar_extract",
    list_of(
        "static int MINI_ID(text_scalar_extract)(MINI_ID(context) * context, MINI_ID(text) source,",
        "                                       size_t start, size_t end, MINI_ID(value) * result) {",
        "  size_t total = 0;",
        "  if (!context || !result || !source.buffer || source.offset > source.buffer->count ||",
        "      source.length > source.buffer->count - source.offset ||",
        "      !MINI_ID(text_scalar_length)(source, &total) || start > end || end > total) {",
        "    return 1;",
        "  }",
        "  size_t byte_start = 0, byte_end = 0;",
        "  if (!MINI_ID(text_scalar_offset)(source, start, &byte_start) ||",
        "      !MINI_ID(text_scalar_offset)(source, end, &byte_end)) {",
        "    return 1;",
        "  }",
        "  *result = (MINI_ID(value))MINI_VALUE_TEXT(source.buffer, source.offset + byte_start,",
        "                                            byte_end - byte_start);",
        "  result->text.scalars = end - start;",
        "  result->text.scalars_known = 1;",
        "  result->text.ascii_known = source.ascii_known;",
        "  result->text.ascii = source.ascii;",
        "  return 0;",
        "}",
        ""
    )
);

emit_c_host_function_add(
    "text_merge",
    list_of(
        "int MINI_ID(fn_text_merge)(MINI_ID(context) * context, MINI_ID(params) params,",
        "                           MINI_ID(value) * result) {",
        "  if (!context || !result || (params.count && !params.args)) {",
        "    return 1;",
        "  }",
        "  size_t offset = context->buffer.count;",
        "  for (size_t index = 0; index < params.count; ++index) {",
        "    MINI_ID(value) value = params.args[index];",
        "    if (value.kind != MINI_ID(kind_text)) {",
        "      continue;",
        "    }",
        "    MINI_ID(text_buffer) *buffer = value.text.buffer;",
        "    if (!buffer || value.text.offset > buffer->count ||",
        "        value.text.length > buffer->count - value.text.offset) {",
        "      return 1;",
        "    }",
        "    if (value.text.length &&",
        "        MINI_ID(text_buffer_append)(&context->buffer, buffer->items + value.text.offset,",
        "                                    value.text.length) != 0) {",
        "      return 1;",
        "    }",
        "  }",
        "  *result = MINI_ID(value_text)(&context->buffer, offset, context->buffer.count - offset);",
        "  return 0;",
        "}",
        ""
    )
);

emit_c_host_function_add(
    "text_join",
    list_of(
        "int MINI_ID(fn_text_join)(MINI_ID(context) * context, MINI_ID(params) params,",
        "                          MINI_ID(value) * result) {",
        "  if (!context || !result || (params.count && !params.args)) {",
        "    return 1;",
        "  }",
        "  size_t offset = context->buffer.count;",
        "  if (!params.count || params.args[0].kind != MINI_ID(kind_text)) {",
        "    *result = MINI_ID(value_text)(&context->buffer, offset, 0);",
        "    return 0;",
        "  }",
        "  MINI_ID(text) separator = params.args[0].text;",
        "  MINI_ID(text_buffer) *separator_buffer = separator.buffer;",
        "  if (!separator_buffer || separator.offset > separator_buffer->count ||",
        "      separator.length > separator_buffer->count - separator.offset) {",
        "    return 1;",
        "  }",
        "  for (size_t index = 1; index < params.count; ++index) {",
        "    if (index > 1 && separator.length &&",
        "        MINI_ID(text_buffer_append)(&context->buffer, separator_buffer->items + separator.offset,",
        "                                    separator.length) != 0) {",
        "      return 1;",
        "    }",
        "    MINI_ID(value) value = params.args[index];",
        "    if (value.kind != MINI_ID(kind_text)) {",
        "      continue;",
        "    }",
        "    MINI_ID(text_buffer) *buffer = value.text.buffer;",
        "    if (!buffer || value.text.offset > buffer->count ||",
        "        value.text.length > buffer->count - value.text.offset) {",
        "      return 1;",
        "    }",
        "    if (value.text.length &&",
        "        MINI_ID(text_buffer_append)(&context->buffer, buffer->items + value.text.offset,",
        "                                    value.text.length) != 0) {",
        "      return 1;",
        "    }",
        "  }",
        "  *result = MINI_ID(value_text)(&context->buffer, offset, context->buffer.count - offset);",
        "  return 0;",
        "}",
        ""
    )
);

emit_c_host_function_add(
    "text_length",
    list_of(
        "int MINI_ID(fn_text_length)(MINI_ID(context) * context, MINI_ID(params) params,",
        "                            MINI_ID(value) * result) {",
        "  if (!context || !result || params.count < 1 || !params.args) {",
        "    return 1;",
        "  }",
        "  size_t length = 0;",
        "  if (params.args[0].kind == MINI_ID(kind_text) &&",
        "      !MINI_ID(text_scalar_length)(params.args[0].text, &length)) {",
        "    return 1;",
        "  }",
        "  *result = (MINI_ID(value))MINI_VALUE_NUMBER((double)length);",
        "  return 0;",
        "}",
        ""
    )
);

emit_c_host_function_add(
    "text_get",
    list_of(
        "int MINI_ID(fn_text_get)(MINI_ID(context) * context, MINI_ID(params) params,",
        "                         MINI_ID(value) * result) {",
        "  if (!context || !result || params.count < 2 || !params.args) {",
        "    return 1;",
        "  }",
        "  size_t length = 0;",
        "  if (params.args[0].kind != MINI_ID(kind_text)) {",
        "    *result = MINI_ID(value_text)(&context->buffer, context->buffer.count, 0);",
        "    return 0;",
        "  }",
        "  if (!MINI_ID(text_scalar_length)(params.args[0].text, &length)) {",
        "    return 1;",
        "  }",
        "  MINI_ID(value) index = params.args[1];",
        "  if (index.kind != MINI_ID(kind_number) || index.number != index.number || index.number < 0 ||",
        "      index.number >= (double)length || index.number != (double)(size_t)index.number) {",
        "    *result = MINI_ID(value_text)(&context->buffer, context->buffer.count, 0);",
        "    return 0;",
        "  }",
        "  return MINI_ID(text_scalar_extract)(context, params.args[0].text, (size_t)index.number,",
        "                                     (size_t)index.number + 1, result);",
        "}",
        ""
    )
);

emit_c_host_function_add(
    "text_to_code",
    list_of(
        "int MINI_ID(fn_text_to_code)(MINI_ID(context) * context, MINI_ID(params) params,",
        "                             MINI_ID(value) * result) {",
        "  if (!context || !result || params.count < 2 || !params.args) {",
        "    return 1;",
        "  }",
        "  MINI_ID(value) source = params.args[0], index = params.args[1];",
        "  *result = (MINI_ID(value))MINI_VALUE_NUMBER(0);",
        "  if (source.kind != MINI_ID(kind_text) || index.kind != MINI_ID(kind_number) ||",
        "      index.number != index.number || index.number < 0 ||",
        "      index.number != (double)(size_t)index.number) {",
        "    return 0;",
        "  }",
        "  size_t length = 0, offset = 0;",
        "  if (!MINI_ID(text_scalar_length)(source.text, &length)) {",
        "    return 1;",
        "  }",
        "  if (index.number >= (double)length) {",
        "    return 0;",
        "  }",
        "  if (!MINI_ID(text_scalar_offset)(source.text, (size_t)index.number, &offset)) {",
        "    return 1;",
        "  }",
        "  const unsigned char *data = NULL;",
        "  if (!MINI_ID(text_view)(source.text, &data)) {",
        "    return 1;",
        "  }",
        "  uint32_t code = 0;",
        "  size_t width = 0;",
        "  if (!MINI_ID(text_decode)(data + offset, source.text.length - offset, &code, &width)) {",
        "    return 1;",
        "  }",
        "  *result = (MINI_ID(value))MINI_VALUE_NUMBER((double)code);",
        "  return 0;",
        "}",
        ""
    )
);

emit_c_host_function_add(
    "text_from_code",
    list_of(
        "int MINI_ID(fn_text_from_code)(MINI_ID(context) * context, MINI_ID(params) params,",
        "                               MINI_ID(value) * result) {",
        "  if (!context || !result || params.count < 1 || !params.args) {",
        "    return 1;",
        "  }",
        "  MINI_ID(value) code = params.args[0];",
        "  *result = MINI_ID(value_text)(&context->buffer, context->buffer.count, 0);",
        "  if (code.kind != MINI_ID(kind_number) || code.number != code.number || code.number < 0 ||",
        "      code.number > 1114111 || code.number != (double)(uint32_t)code.number ||",
        "      (code.number >= 55296 && code.number <= 57343)) {",
        "    return 0;",
        "  }",
        "  uint32_t scalar = (uint32_t)code.number;",
        "  unsigned char bytes[4];",
        "  size_t length = 0;",
        "  if (scalar <= 127) {",
        "    bytes[0] = (unsigned char)scalar;",
        "    length = 1;",
        "  } else if (scalar <= 2047) {",
        "    bytes[0] = (unsigned char)(192 | (scalar >> 6));",
        "    bytes[1] = (unsigned char)(128 | (scalar & 63));",
        "    length = 2;",
        "  } else if (scalar <= 65535) {",
        "    bytes[0] = (unsigned char)(224 | (scalar >> 12));",
        "    bytes[1] = (unsigned char)(128 | ((scalar >> 6) & 63));",
        "    bytes[2] = (unsigned char)(128 | (scalar & 63));",
        "    length = 3;",
        "  } else {",
        "    bytes[0] = (unsigned char)(240 | (scalar >> 18));",
        "    bytes[1] = (unsigned char)(128 | ((scalar >> 12) & 63));",
        "    bytes[2] = (unsigned char)(128 | ((scalar >> 6) & 63));",
        "    bytes[3] = (unsigned char)(128 | (scalar & 63));",
        "    length = 4;",
        "  }",
        "  size_t offset = context->buffer.count;",
        "  if (MINI_ID(text_buffer_append)(&context->buffer, bytes, length) != 0) {",
        "    return 1;",
        "  }",
        "  *result = MINI_ID(value_text)(&context->buffer, offset, length);",
        "  return 0;",
        "}",
        ""
    )
);

emit_c_host_function_add(
    "text_slice",
    list_of(
        "int MINI_ID(fn_text_slice)(MINI_ID(context) * context, MINI_ID(params) params,",
        "                           MINI_ID(value) * result) {",
        "  if (!context || !result || params.count < 3 || !params.args) {",
        "    return 1;",
        "  }",
        "  MINI_ID(value) source = params.args[0];",
        "  *result = MINI_ID(value_text)(&context->buffer, context->buffer.count, 0);",
        "  if (source.kind != MINI_ID(kind_text)) {",
        "    return 0;",
        "  }",
        "  size_t length = 0;",
        "  if (!MINI_ID(text_scalar_length)(source.text, &length)) {",
        "    return 1;",
        "  }",
        "  MINI_ID(value) first = params.args[1], last = params.args[2];",
        "  if (first.kind != MINI_ID(kind_number) || last.kind != MINI_ID(kind_number) ||",
        "      first.number < -9007199254740991.0 || first.number > 9007199254740991.0 ||",
        "      last.number < -9007199254740991.0 || last.number > 9007199254740991.0 ||",
        "      first.number != (double)(int64_t)first.number ||",
        "      last.number != (double)(int64_t)last.number) {",
        "    return 0;",
        "  }",
        "  int64_t start = (int64_t)first.number, end = (int64_t)last.number, size = (int64_t)length;",
        "  if (start < 0) {",
        "    start += size;",
        "  }",
        "  if (end < 0) {",
        "    end += size;",
        "  }",
        "  if (start < 0) {",
        "    start = 0;",
        "  }",
        "  if (end < 0) {",
        "    end = 0;",
        "  }",
        "  if (start > size) {",
        "    start = size;",
        "  }",
        "  if (end > size) {",
        "    end = size;",
        "  }",
        "  if (end <= start) {",
        "    return 0;",
        "  }",
        "  return MINI_ID(text_scalar_extract)(context, source.text, (size_t)start, (size_t)end, result);",
        "}",
        ""
    )
);
