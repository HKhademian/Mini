/// Register native C lowering for the imported Mini I/O API.

import "./registry";

/// Return output using a parameter view that bundles the argument count/pointer.
/// Each source call prepares its arguments before invoking this helper.
fn emit_c_io_runtime() {
    return emit_c_join_lines(
        list_of(
            "static int MINI_ID(io_write_json_value)(MINI_ID(value) value, size_t depth, FILE *stream);",
            "static int MINI_ID(io_write_json_map)(MINI_ID(value) value, size_t depth, FILE *stream);",
            "static int MINI_ID(io_write_json_text)(MINI_ID(text) text, FILE *stream) {",
            "  MINI_ID(text_buffer) *buffer = text.buffer;",
            "  if (!buffer || text.offset > buffer->count || text.length > buffer->count - text.offset) {",
            "    return 1;",
            "  }",
            "  if (fputc('\\\"', stream) == EOF) {",
            "    return 1;",
            "  }",
            "  for (size_t index = 0; index < text.length; ++index) {",
            "    unsigned char byte = buffer->items[text.offset + index];",
            "    if (byte == '\\\"' || byte == '\\\\') {",
            "      if (fputc('\\\\', stream) == EOF || fputc(byte, stream) == EOF) {",
            "        return 1;",
            "      }",
            "    } else if (byte == '\\n') {",
            "      if (fputs(\"\\\\n\", stream) == EOF) {",
            "        return 1;",
            "      }",
            "    } else if (byte == '\\r') {",
            "      if (fputs(\"\\\\r\", stream) == EOF) {",
            "        return 1;",
            "      }",
            "    } else if (byte == '\\t') {",
            "      if (fputs(\"\\\\t\", stream) == EOF) {",
            "        return 1;",
            "      }",
            "    } else if (byte < 32) {",
            "      if (fprintf(stream, \"\\\\u%04x\", byte) < 0) {",
            "        return 1;",
            "      }",
            "    } else if (fputc(byte, stream) == EOF) {",
            "      return 1;",
            "    }",
            "  }",
            "  return fputc('\\\"', stream) == EOF ? 1 : 0;",
            "}",
            "",
            "static int MINI_ID(io_write_json_value)(MINI_ID(value) value, size_t depth, FILE *stream) {",
            "  if (depth > 128) {",
            "    return 1;",
            "  }",
            "  if (value.kind == MINI_ID(kind_text)) {",
            "    return MINI_ID(io_write_json_text)(value.text, stream);",
            "  }",
            "  if (value.kind == MINI_ID(kind_map)) {",
            "    return MINI_ID(io_write_json_map)(value, depth, stream);",
            "  }",
            "  if (value.kind == MINI_ID(kind_boolean)) {",
            "    return fputs(value.boolean ? \"true\" : \"false\", stream) == EOF ? 1 : 0;",
            "  }",
            "  if (value.kind == MINI_ID(kind_number)) {",
            "    if (!(value.number == value.number) || value.number > DBL_MAX || value.number < -DBL_MAX) {",
            "      return fputs(\"null\", stream) == EOF ? 1 : 0;",
            "    }",
            "    if (value.number == 0) {",
            "      return fputs(\"0\", stream) == EOF ? 1 : 0;",
            "    }",
            "    return fprintf(stream, \"%.0f\", value.number) < 0 ? 1 : 0;",
            "  }",
            "  if (value.kind != MINI_ID(kind_list) || !value.list) {",
            "    return fputs(\"null\", stream) == EOF ? 1 : 0;",
            "  }",
            "  if (fputc('[', stream) == EOF) {",
            "    return 1;",
            "  }",
            "  MINI_ID(value) *items = (MINI_ID(value) *)value.list->values.items;",
            "  for (size_t index = 0; index < value.list->values.count; ++index) {",
            "    if (index && fputc(',', stream) == EOF) {",
            "      return 1;",
            "    }",
            "    if (MINI_ID(io_write_json_value)(items[index], depth + 1, stream) != 0) {",
            "      return 1;",
            "    }",
            "  }",
            "  return fputc(']', stream) == EOF ? 1 : 0;",
            "}",
            "",
            "static int MINI_ID(io_write_value)(MINI_ID(value) value, FILE *stream) {",
            "  if (value.kind == MINI_ID(kind_list) || value.kind == MINI_ID(kind_map)) {",
            "    return MINI_ID(io_write_json_value)(value, 0, stream);",
            "  }",
            "  if (value.kind == MINI_ID(kind_boolean)) {",
            "    return fputs(value.boolean ? \"true\" : \"false\", stream) == EOF ? 1 : 0;",
            "  }",
            "  if (value.kind == MINI_ID(kind_number)) {",
            "    MINI_ID(number) number = value.number;",
            "    if (!(number >= -9007199254740991.0 && number <= 9007199254740991.0)) {",
            "      return 0;",
            "    }",
            "    if ((MINI_ID(number))(int_least64_t)number != number) {",
            "      return 0;",
            "    }",
            "    if (number == 0) {",
            "      return fputs(\"0\", stream) == EOF ? 1 : 0;",
            "    }",
            "    return fprintf(stream, \"%.0f\", number) < 0 ? 1 : 0;",
            "  }",
            "  if (value.kind != MINI_ID(kind_text)) {",
            "    return 1;",
            "  }",
            "  MINI_ID(text_buffer) *buffer = value.text.buffer;",
            "  if (!buffer || value.text.offset > buffer->count ||",
            "      value.text.length > buffer->count - value.text.offset) {",
            "    return 1;",
            "  }",
            "  if (!value.text.length) {",
            "    return 0;",
            "  }",
            "  return fwrite(buffer->items + value.text.offset, 1, value.text.length, stream) ==",
            "                 value.text.length",
            "             ? 0",
            "             : 1;",
            "}",
            "",
            "static int MINI_ID(io_write)(MINI_ID(params) params) {",
            "  if (params.count && !params.args) {",
            "    return 1;",
            "  }",
            "  for (size_t index = 0; index < params.count; ++index) {",
            "    int status = MINI_ID(io_write_value)(params.args[index], stdout);",
            "    if (status != 0) {",
            "      return status;",
            "    }",
            "  }",
            "  return 0;",
            "}",
            "",
            "static int MINI_ID(io_write_error)(MINI_ID(params) params) {",
            "  if (params.count && !params.args) {",
            "    return 1;",
            "  }",
            "  for (size_t index = 0; index < params.count; ++index) {",
            "    int status = MINI_ID(io_write_value)(params.args[index], stderr);",
            "    if (status != 0) {",
            "      return status;",
            "    }",
            "  }",
            "  return 0;",
            "}",
            ""
        ),
        2
    );
}

emit_c_host_runtime_add("io_write", emit_c_io_runtime());

// io_write uses the runtime writer; io_write_line has no native variadic lowering.
emit_c_host_function_add(
    "io_write",
    text_join(
        "\n",
        "int MINI_ID(fn_io_write)(MINI_ID(context) * context, MINI_ID(params) params,",
        "                         MINI_ID(value) * result) {",
        "  if (!context || !result) {",
        "    return 1;",
        "  }",
        "  if (MINI_ID(io_write)(params) != 0) {",
        "    return 1;",
        "  }",
        "  *result = (MINI_ID(value))MINI_VALUE_NUMBER(0);",
        "  return 0;",
        "}",
        ""
    )
);
emit_c_host_function_add(
    "io_write_line",
    text_join(
        "\n",
        "int MINI_ID(fn_io_write_line)(MINI_ID(context) * context, MINI_ID(params) params,",
        "                              MINI_ID(value) * result) {",
        "  if (!context || !result || (params.count && !params.args)) {",
        "    return 1;",
        "  }",
        "  if (MINI_ID(io_write)(params) != 0 || fputc('\\n', stdout) == EOF) {",
        "    return 1;",
        "  }",
        "  *result = (MINI_ID(value))MINI_VALUE_NUMBER(0);",
        "  return 0;",
        "}",
        ""
    )
);

emit_c_host_function_add(
    "io_read_all",
    text_join(
        "\n",
        "int MINI_ID(fn_io_read_all)(MINI_ID(context) * context, MINI_ID(params) params,",
        "                            MINI_ID(value) * result) {",
        "  if (!context || !result || params.count != 0) {",
        "    return 1;",
        "  }",
        "  size_t offset = context->buffer.count;",
        "  int byte;",
        "  while ((byte = fgetc(stdin)) != EOF) {",
        "    unsigned char value = (unsigned char)byte;",
        "    if (MINI_ID(text_buffer_append)(&context->buffer, &value, 1) != 0) {",
        "      return 1;",
        "    }",
        "  }",
        "  if (ferror(stdin)) {",
        "    return 1;",
        "  }",
        "  *result = MINI_ID(value_text)(&context->buffer, offset, context->buffer.count - offset);",
        "  return 0;",
        "}",
        ""
    )
);

emit_c_host_function_add(
    "io_read_line",
    text_join(
        "\n",
        "int MINI_ID(fn_io_read_line)(MINI_ID(context) * context, MINI_ID(params) params,",
        "                             MINI_ID(value) * result) {",
        "  if (!context || !result || params.count != 0) {",
        "    return 1;",
        "  }",
        "  size_t offset = context->buffer.count;",
        "  int byte;",
        "  while ((byte = fgetc(stdin)) != EOF && byte != '\\n') {",
        "    unsigned char value = (unsigned char)byte;",
        "    if (MINI_ID(text_buffer_append)(&context->buffer, &value, 1) != 0) {",
        "      return 1;",
        "    }",
        "  }",
        "  if (ferror(stdin)) {",
        "    return 1;",
        "  }",
        "  size_t length = context->buffer.count - offset;",
        "  if (length && context->buffer.items[context->buffer.count - 1] == '\\r') {",
        "    context->buffer.count -= 1;",
        "    length -= 1;",
        "  }",
        "  *result = MINI_ID(value_text)(&context->buffer, offset, length);",
        "  return 0;",
        "}",
        ""
    )
);

emit_c_host_function_add(
    "io_read_bytes",
    text_join(
        "\n",
        "int MINI_ID(fn_io_read_bytes)(MINI_ID(context) * context, MINI_ID(params) params,",
        "                              MINI_ID(value) * result) {",
        "  if (!context || !result || params.count != 1 || !params.args) {",
        "    return 1;",
        "  }",
        "  MINI_ID(value) bytes = MINI_ID(list_new)(context);",
        "  MINI_ID(value) limit = params.args[0];",
        "  if (limit.kind != MINI_ID(kind_number) || limit.number <= 0 ||",
        "      limit.number > 9007199254740991.0 || limit.number != (double)(size_t)limit.number) {",
        "    *result = bytes;",
        "    return 0;",
        "  }",
        "  size_t count = (size_t)limit.number;",
        "  for (size_t index = 0; index < count; ++index) {",
        "    int byte = fgetc(stdin);",
        "    if (byte == EOF) {",
        "      if (ferror(stdin)) {",
        "        return 1;",
        "      }",
        "      break;",
        "    }",
        "    MINI_ID(list_push)(bytes.list, (MINI_ID(value))MINI_VALUE_NUMBER(byte), 0);",
        "  }",
        "  *result = bytes;",
        "  return 0;",
        "}",
        ""
    )
);

emit_c_host_function_add(
    "io_write_error",
    text_join(
        "\n",
        "int MINI_ID(fn_io_write_error)(MINI_ID(context) * context, MINI_ID(params) params,",
        "                               MINI_ID(value) * result) {",
        "  if (!context || !result || (params.count && !params.args)) {",
        "    return 1;",
        "  }",
        "  if (MINI_ID(io_write_error)(params) != 0) {",
        "    return 1;",
        "  }",
        "  *result = (MINI_ID(value))MINI_VALUE_NUMBER(0);",
        "  return 0;",
        "}",
        ""
    )
);
