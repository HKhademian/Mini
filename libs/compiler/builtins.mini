/// Return every builtin name once, in declaration order.
fn builtin_names() {
    return list_copy(builtin_names_list);
}

/// Return whether name selects a builtin.
fn builtin_exists(name) {
    return map_has(builtin_name_set, name);
}

/// Return builtin parameter kinds in declaration order.
fn builtin_parameters(name) {
    if (!map_has(builtin_parameter_kinds, name)) {
        return list_new();
    }
    var kinds = map_get(builtin_parameter_kinds, name);
    if (kinds == "") {
        return list_new();
    }
    return text_split(kinds, ",");
}

/// Return the builtin result kind.
fn builtin_result(name) {
    if (map_has(builtin_result_kinds, name)) {
        return map_get(builtin_result_kinds, name);
    }
    return "text";
}

/// Return builtin Node imports.
fn builtin_imports(name) {
    if (!map_has(builtin_import_names, name)) {
        return list_new();
    }
    var names = map_get(builtin_import_names, name);
    if (names == "") {
        return list_new();
    }
    return text_split(names, ",");
}

/// Reference mode lowers replaceable performance builtins to pure helpers.
var reference_mode = false;

/// Return the builtin layer: essential, representation, performance, or library.
fn builtin_class(name) {
    if (text_starts_with(name, "io_")
     || text_starts_with(name, "file_")
        || text_starts_with(name, "directory_") 
        || text_starts_with(name, "path_")
        || text_starts_with(name, "process_")
         || name == "time_millis" 
         || name == "value_kind") {
        return "essential";
    }
    if (name == "text_length" 
    || name == "text_get" 
    || name == "list_length"
        || name == "list_get"
         || name == "list_set" 
         || name == "list_new"
         || name == "list_truncate"
        || name == "map_get"
         || name == "map_set"
          || name == "map_keys"
        || name == "map_has" 
        || name == "map_new") {
        return "representation";
    }
    if (name == "text_slice" 
    || name == "text_find" 
    || name == "text_split"
        || name == "list_copy"
         || name == "map_copy" 
         || name == "json_parse"
        || name == "json_to_text"
         || name == "text_to_bytes"
          || name == "text_from_bytes"
        || name == "number_to_text"
         || name == "list_to_text" 
         || name == "hash_sha256" || name == "list_push_front" || name == "list_push_back" || name == "list_pop_front" || name == "list_pop_back") {
        return "performance";
    }
    return "library";
}

/// Reference targets implemented as pure Mini helpers.
var builtin_reference_targets = map_new();
map_set(builtin_reference_targets, "text_slice", "pure_text_slice");
map_set(builtin_reference_targets, "text_find", "pure_text_find");
map_set(builtin_reference_targets, "text_split", "pure_text_split");
map_set(builtin_reference_targets, "list_copy", "pure_list_copy");
map_set(builtin_reference_targets, "map_copy", "pure_map_copy");
map_set(builtin_reference_targets, "list_push_front", "pure_list_push_front");
map_set(builtin_reference_targets, "list_push_back", "pure_list_push_back");
map_set(builtin_reference_targets, "list_pop_front", "pure_list_pop_front");
map_set(builtin_reference_targets, "list_pop_back", "pure_list_pop_back");

/// Return the pure target for a builtin, or empty text.
fn builtin_reference_target(name) {
    if (map_has(builtin_reference_targets, name)) {
        return map_get(builtin_reference_targets, name);
    }
    return "";
}

/// Return the builtin adapter key, or empty text.
fn builtin_helper_key(name) {
    if (map_has(builtin_helper_keys, name)) {
        return map_get(builtin_helper_keys, name);
    }
    return "";
}

/// Return the adapter text for a helper key.
fn helper_text(key) {
    if (key == "map_runtime") {
        return map_runtime;
    }
    if (key == "directory_remove") {
        return directory_remove_helper;
    }
    if (key == "directory_temp") {
        return directory_temp_helper;
    }
    if (key == "file_remove") {
        return file_remove_helper;
    }
    if (key == "json_to_text") {
        return json_to_text_helper;
    }
    if (key == "list_copy") {
        return list_copy_helper;
    }
    if (key == "list_get") {
        return list_get_helper;
    }
    if (key == "list_set") {
        return list_set_helper;
    }
    if (key == "list_to_text") {
        return list_to_text_helper;
    }
    if (key == "map_copy") {
        return map_copy_helper;
    }
    if (key == "number_to_text") {
        return number_to_text_helper;
    }
    if (key == "process_run") {
        return process_run_helper;
    }
    if (key == "text_find") {
        return text_find_helper;
    }
    if (key == "text_get") {
        return text_get_helper;
    }
    if (key == "text_slice") {
        return text_slice_helper;
    }
    if (key == "text_split") {
        return text_split_helper;
    }
    if (key == "json_parse") {
        return json_parse_helper;
    }
    if (key == "text_to_bytes") {
        return text_to_bytes_helper;
    }
    if (key == "text_from_bytes") {
        return text_from_bytes_helper;
    }
    if (key == "file_read_bytes") {
        return file_read_bytes_helper;
    }
    if (key == "file_write_bytes") {
        return file_write_bytes_helper;
    }
    if (key == "hash_sha256") {
        return hash_sha256_helper;
    }
    if (key == "path_exists") {
        return path_exists_helper;
    }
    if (key == "path_is_directory") {
        return path_is_directory_helper;
    }
    if (key == "directory_list") {
        return directory_list_helper;
    }
    if (key == "directory_create") {
        return directory_create_helper;
    }
    if (key == "path_copy") {
        return path_copy_helper;
    }
    if (key == "path_remove") {
        return path_remove_helper;
    }
    if (key == "process_spawn") {
        return process_spawn_helper;
    }
    if (key == "value_kind") {
        return value_kind_helper;
    }
    if (key == "list_push_front") {
        return list_push_front_helper;
    }
    if (key == "list_push_back") {
        return list_push_back_helper;
    }
    if (key == "list_pop_front") {
        return list_pop_front_helper;
    }
    if (key == "list_pop_back") {
        return list_pop_back_helper;
    }
    if (key == "list_truncate") {
        return list_truncate_helper;
    }
    if (key == "read_line" || key == "io_read_line") {
        return read_line_helper;
    }
    if (key == "read_bytes" || key == "io_read_bytes") {
        return read_bytes_helper;
    }
    return "";
}

/// Return the lowered TypeScript call text for a builtin.
fn builtin_emit(name, args) {
    var first = list_get(args, 0);
    var second = list_get(args, 1);
    var reference_target = builtin_reference_target(name);
    if (reference_mode && reference_target != "") {
        return reference_target + "(" + list_to_text(args, ", ") + ")";
    }
    if (name == "io_read_line") {
        return "$mini_read_line()";
    }
    if (name == "io_read_bytes") {
        return "$mini_read_bytes(" + first + ")";
    }
    if (name == "map_get" || name == "map_set" || name == "map_has" || name == "list_set" || name == "list_get" || name == "text_get" || name == "text_slice" || name == "text_find" || name == "text_split" || name == "map_copy" || name == "list_copy" || name == "list_to_text" || name == "number_to_text" || name == "json_to_text" || name == "process_run" || name == "directory_temp" || name == "file_remove" || name == "directory_remove" || name == "json_parse" || name == "text_to_bytes" || name == "text_from_bytes" || name == "file_read_bytes" || name == "file_write_bytes" || name == "hash_sha256" || name == "path_exists" || name == "path_is_directory" || name == "directory_list" || name == "directory_create" || name == "path_copy" || name == "path_remove" || name == "process_spawn" || name == "value_kind" || name == "list_push_front" || name == "list_push_back" || name == "list_pop_front" || name == "list_pop_back" || name == "list_truncate") {
        return "$mini_" + name + "(" + list_to_text(args, ", ") + ")";
    }
    if (name == "process_exec_path") {
        return "process.execPath";
    }
    if (name == "process_script_path") {
        return "process.argv[1]";
    }
    if (name == "process_env") {
        return "(process.env[" + first + "] ?? \"\")";
    }
    if (name == "time_millis") {
        return "Date.now()";
    }
    if (name == "map_keys") {
        return "Object.keys(" + first + ")";
    }
    if (name == "map_new") {
        return "({ __proto__: $mini_map_proto })";
    }
    if (name == "list_new") {
        return "[]";
    }
    if (name == "io_write_error") {
        return "writeSync(2, " + first + ")";
    }
    if (name == "process_exit") {
        return "process.exit(" + first + ")";
    }
    if (name == "list_length") {
        return "(" + first + ").length";
    }
    if (name == "process_args") {
        return "process.argv.slice(2)";
    }
    if (name == "file_write") {
        return "writeFileSync(" + first + ", " + second + ", \"utf8\")";
    }
    if (name == "file_read") {
        return "readFileSync(" + first + ", \"utf8\")";
    }
    if (name == "text_length") {
        return "(" + first + ").length";
    }
    if (name == "io_read_all") {
        return "readFileSync(0, \"utf8\")";
    }
    if (name == "io_write") {
        return "writeSync(1, " + first + ")";
    }
    return "";
}

