/// Builtin registry and lowering.
var builtin_names_list = list_new();
var builtin_name_set = map_new();
var builtin_parameter_kinds = map_new();
var builtin_result_kinds = map_new();
var builtin_import_names = map_new();
var builtin_helper_keys = map_new();
var builtin_classes = map_new();
var builtin_helpers = map_new();
var builtin_reference_targets = map_new();
var builtin_emit_forms = map_new();

/// Register one builtin descriptor.
fn builtin_add(name, parameters, result, layer, import_name, helper_key, helper, reference, emit_form) {
    list_set(builtin_names_list, list_length(builtin_names_list), name);
    map_set(builtin_name_set, name, true);
    map_set(builtin_parameter_kinds, name, parameters);
    map_set(builtin_result_kinds, name, result);
    map_set(builtin_import_names, name, import_name);
    map_set(builtin_helper_keys, name, helper_key);
    map_set(builtin_classes, name, layer);
    map_set(builtin_emit_forms, name, emit_form);
    if helper_key != "" {
        map_set(builtin_helpers, helper_key, helper);
    }
    if reference != "" {
        map_set(builtin_reference_targets, name, reference);
    }
    return 0;
}

include "builtins/directory.mini";
include "builtins/file.mini";
include "builtins/hash.mini";
include "builtins/io.mini";
include "builtins/json.mini";
include "builtins/list.mini";
include "builtins/map.mini";
include "builtins/number.mini";
include "builtins/path.mini";
include "builtins/process.mini";
include "builtins/text.mini";
include "builtins/time.mini";
include "builtins/value.mini";



/// Return the builtin names.
fn builtin_names() {
    return list_copy(builtin_names_list);
}

/// Return whether a builtin exists.
fn builtin_exists(name) {
    return map_has(builtin_name_set, name);
}

/// Return parameter kinds for a builtin.
fn builtin_parameters(name) {
    if !map_has(builtin_parameter_kinds, name) {
        return list_new();
    }
    var kinds = map_get(builtin_parameter_kinds, name);
    if kinds == "" {
        return list_new();
    }
    return text_split(kinds, ",");
}

/// Return the result kind for a builtin.
fn builtin_result(name) {
    if map_has(builtin_result_kinds, name) {
        return map_get(builtin_result_kinds, name);
    }
    return "unknown";
}

/// Return host imports for a builtin.
fn builtin_imports(name) {
    if !map_has(builtin_import_names, name) {
        return list_new();
    }
    var imports = map_get(builtin_import_names, name);
    if imports == "" {
        return list_new();
    }
    return text_split(imports, ",");
}

/// Reference mode lowers replaceable performance builtins to pure helpers.
var reference_mode = false;

/// Return the builtin layer.
fn builtin_class(name) {
    if map_has(builtin_classes, name) {
        return map_get(builtin_classes, name);
    }
    return "library";
}

/// Return the pure target for a builtin, or empty text.
fn builtin_reference_target(name) {
    if map_has(builtin_reference_targets, name) {
        return map_get(builtin_reference_targets, name);
    }
    return "";
}

/// Return the builtin adapter key, or empty text.
fn builtin_helper_key(name) {
    if map_has(builtin_helper_keys, name) {
        return map_get(builtin_helper_keys, name);
    }
    return "";
}

/// Return the adapter text for a helper key.
fn helper_text(key) {
    if map_has(builtin_helpers, key) {
        return map_get(builtin_helpers, key);
    }
    return "";
}

/// Replace every occurrence of a template token.
fn builtin_replace(source, needle, replacement) {
    var output = "";
    var position = 0;
    while position < text_length(source) {
        var rest = text_slice(source, position, text_length(source));
        var found = text_find(rest, needle);
        if found < 0 {
            return output + text_slice(source, position, text_length(source));
        }
        output = output + text_slice(source, position, position + found) + replacement;
        position = position + found + text_length(needle);
    }
    return output;
}

/// Substitute positional arguments into an emit template.
fn builtin_apply(form, args) {
    var output = form;
    var position = 0;
    while position < list_length(args) {
        output = builtin_replace(output, "{" + number_to_text(position) + "}", list_get(args, position));
        position = position + 1;
    }
    return output;
}

/// Return the lowered TypeScript call text for a builtin.
fn builtin_emit(name, args) {
    var reference_target = builtin_reference_target(name);
    if reference_mode && reference_target != "" {
        return reference_target + "(" + list_to_text(args, ", ") + ")";
    }
    if !map_has(builtin_emit_forms, name) {
        return "";
    }
    return builtin_apply(map_get(builtin_emit_forms, name), args);
}
