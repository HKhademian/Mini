/// Lower Mini's checked AST to Node-compatible JavaScript source.
/// AST traversal and generated source assembly live here;
/// parsing and shared syntax checks remain in parser.mini.

import "common/text";
import "common/number";
import "common/list";
import "common/map";
import "./parser";
import "./emit-js/host";
import "./emit-js/registry";

/// Replace one target lowering token with its generated expression.
fn emit_js_replace_lowering(source, needle, replacement) {
    parts := list_new();
    position := 0;
    while position < text_length(source) {
        rest := text_slice(source, position, text_length(source));
        found := text_find(rest, needle);
        if found < 0 {
            list_set(parts, list_length(parts), text_slice(source, position, text_length(source)));
            return list_join("", parts);
        }
        list_set(parts, list_length(parts), text_slice(source, position, position + found));
        list_set(parts, list_length(parts), replacement);
        position = position + found + text_length(needle);
    }
    return list_join("", parts);
}

/// Apply a registry-owned target lowering to call arguments.
fn emit_js_apply_host_lowering(form, args) {
    output := form;
    if text_find(output, "{...}") >= 0 {
        output = emit_js_replace_lowering(output, "{...}", list_join(", ", args));
    }
    position := 0;
    while position < list_length(args) {
        output = emit_js_replace_lowering(output, "{" + number_to_text(position) + "}", list_get(args, position));
        position = position + 1;
    }
    return output;
}

/// Format one target-specific JavaScript operator.
fn emit_js_operator(operator) {
    if operator == "==" {
        return "===";
    }
    if operator == "!=" {
        return "!==";
    }
    return operator;
}

/// Emit one expression from the shared AST.
fn emit_js_expression(node) {
    kind := map_get(node, "node_kind");
    if kind == AST_LITERAL {
        literal_kind := map_get(node, "literal_kind");
        if literal_kind == "boolean" {
            if map_get(node, "value") {
                return "true";
            }
            return "false";
        }
        value := map_get(node, "value");
        if literal_kind == "number" && text_starts_with(value, "-") {
            return "(" + value + ")";
        }
        return value;
    }
    if kind == AST_NAME {
        return map_get(node, "name");
    }
    if kind == AST_GROUP {
        return emit_js_expression(map_get(node, "expression"));
    }
    if kind == AST_FN_ARGS {
        if map_get(node, "captures") {
            return "$mini_fn_args";
        }
        return "process.argv.slice(2)";
    }
    if kind == AST_UNARY {
        return "(" + map_get(node, "operator") + emit_js_expression(map_get(node, "operand")) + ")";
    }
    if kind == AST_BINARY {
        return "(" + emit_js_expression(map_get(node, "left")) + " " + emit_js_operator(map_get(node, "operator")) + " "
            + emit_js_expression(map_get(node, "right")) + ")";
    }
    if kind == AST_CALL {
        argument_codes := emit_js_arguments(map_get(node, "arguments"));
        callee := map_get(node, "callee");
        host_lowering := emit_js_host_lowering(callee);
        if host_lowering != "" {
            return emit_js_apply_host_lowering(host_lowering, argument_codes);
        }
        return callee + "(" + list_join(", ", argument_codes) + ")";
    }
    return "";
}

/// Emit one list of expression nodes as JavaScript source strings.
fn emit_js_arguments(nodes) {
    output := list_new();
    position := 0;
    while position < list_length(nodes) {
        list_set(output, list_length(output), emit_js_expression(list_get(nodes, position)));
        position = position + 1;
    }
    return output;
}

/// Emit one block while preserving the compiler's four-space layout.
fn emit_js_block(node) {
    body := emit_js_statements(map_get(node, "statements"));
    indented := text_indent_output(body);
    if indented == "" {
        return list_join("\n", list_of("{", "}"));
    }
    return list_join("\n", list_of("{", indented, "}"));
}

/// Emit one function body, including capture and fallthrough handling.
fn emit_js_function_body(node) {
    body_node := map_get(node, "body");
    body := emit_js_block(body_node);
    if !map_get(node, "has_final_return") {
        body = text_slice(body, 0, text_length(body) - 1) + "    return 0;\n}";
    }
    capture := "";
    if map_get(node, "captures_arguments") {
        capture = "    const $mini_fn_args = Array.prototype.slice.call(arguments);\n";
    }
    return "{\n" + capture + text_slice(body, 1, text_length(body));
}

/// Emit one function declaration from its syntax and semantic annotations.
fn emit_js_function(node) {
    name := map_get(node, "name");
    host_override := emit_js_host_function(name);
    if host_override != "" {
        return host_override;
    }
    parameters := list_new();
    nodes := map_get(node, "parameters");
    position := 0;
    while position < list_length(nodes) {
        list_set(parameters, list_length(parameters), map_get(list_get(nodes, position), "name"));
        position = position + 1;
    }
    return "function " + map_get(node, "name") + "(" + list_join(", ", parameters) + ") " + emit_js_function_body(node)
        + "\n";
}

/// Emit one statement node.
fn emit_js_statement(node) {
    kind := map_get(node, "node_kind");
    if kind == AST_FUNCTION {
        return emit_js_function(node);
    }
    if kind == AST_BLOCK {
        return emit_js_block(node);
    }
    if kind == AST_RETURN {
        return "return " + emit_js_expression(map_get(node, "value")) + ";\n";
    }
    if kind == AST_CALL_STATEMENT {
        return emit_js_expression(map_get(node, "expression")) + ";\n";
    }
    if kind == AST_BINDING {
        if map_get(node, "top_level") {
            return map_get(node, "name") + " = " + emit_js_expression(map_get(node, "initializer")) + ";\n";
        }
        return "let " + map_get(node, "name") + " = " + emit_js_expression(map_get(node, "initializer")) + ";\n";
    }
    if kind == AST_ASSIGNMENT {
        return map_get(node, "name") + " = " + emit_js_expression(map_get(node, "value")) + ";\n";
    }
    if kind == AST_IF {
        output := "if (" + emit_js_expression(map_get(node, "condition")) + ") " + emit_js_block(
            map_get(
                node,
                "consequent"
            )
        );
        alternate := map_get(node, "alternate");
        if alternate != 0 {
            if map_get(alternate, "node_kind") == AST_IF {
                return output + " else " + emit_js_statement(alternate);
            }
            output = output + " else " + emit_js_block(alternate);
        }
        return output + "\n";
    }
    if kind == AST_WHILE {
        return "while (" + emit_js_expression(map_get(node, "condition")) + ") " + emit_js_block(map_get(node, "body"))
            + "\n";
    }
    return "";
}

/// Emit a list of statement nodes in source order.
fn emit_js_statements(nodes) {
    parts := list_new();
    position := 0;
    while position < list_length(nodes) {
        list_set(parts, list_length(parts), emit_js_statement(list_get(nodes, position)));
        position = position + 1;
    }
    return list_join("", parts);
}

/// Emit a source file's top-level executable statements.
fn emit_js_file_body(nodes, file) {
    parts := list_new();
    position := 0;
    while position < list_length(nodes) {
        node := list_get(nodes, position);
        if map_get(node, "file") == file && map_get(node, "node_kind") != AST_FUNCTION {
            list_set(parts, list_length(parts), emit_js_statement(node));
        }
        position = position + 1;
    }
    return list_join("", parts);
}

/// Emit file initializer wrappers and their dependency-first entry point.
fn emit_js_file_initializers(program) {
    wrappers := list_new();
    calls := list_new();
    files := map_get(program, "files");
    body := map_get(program, "body");
    index := 0;
    while index < list_length(files) {
        name := "$mini_file_" + number_to_text(index);
        code := emit_js_file_body(body, list_get(files, index));
        wrapper_lines := list_of("function " + name + "() {", text_indent_output(code), "}", "");
        list_set(wrappers, list_length(wrappers), list_join("\n", wrapper_lines));
        list_set(calls, list_length(calls), "    " + name + "();");
        index = index + 1;
    }
    if list_length(files) > 0 {
        main_lines := list_of("function $mini_main() {", list_join("\n", calls), "}", "$mini_main();", "");
        list_set(wrappers, list_length(wrappers), list_join("\n", main_lines));
    }
    return list_join("", wrappers);
}

/// Emit the program without helper/import wrappers, retaining main-source statements only.
fn emit_js_program_only(program) {
    output := list_new();
    body := map_get(program, "body");
    main_source := map_get(program, "main_source");
    position := 0;
    while position < list_length(body) {
        node := list_get(body, position);
        if map_get(node, "source") == main_source {
            if map_get(node, "node_kind") == AST_BINDING && map_get(node, "top_level") {
                list_set(
                    output,
                    list_length(output),
                    "let " + map_get(node, "name") + " = " + emit_js_expression(map_get(node, "initializer")) + ";\n"
                );
            } else {
                list_set(output, list_length(output), emit_js_statement(node));
            }
        }
        position = position + 1;
    }
    return list_join("", output);
}

/// Emit a complete JavaScript program from the checked shared AST.
fn emit_js_program(program) {
    body := map_get(program, "body");
    position := 0;
    globals := list_new();
    declarations := list_new();
    while position < list_length(body) {
        node := list_get(body, position);
        if map_get(node, "node_kind") == AST_FUNCTION {
            list_set(declarations, list_length(declarations), emit_js_function(node));
        } else if map_get(node, "node_kind") == AST_BINDING && map_get(node, "top_level") {
            list_set(globals, list_length(globals), "let " + map_get(node, "name") + ";\n");
        }
        position = position + 1;
    }
    shebang := "";
    if map_get(program, "has_shebang") {
        shebang = "#!/usr/bin/env node\n";
    }
    return list_join(
        "",
        list_of(
            shebang,
            "\"use strict\";\n",
            list_join("", globals),
            list_join("", declarations),
            emit_js_file_initializers(program)
        )
    );
}

/// Parse one prepared token list once and return complete JavaScript source.
fn emit_js_set_reference_mode(enabled) {
    reference_mode = enabled;
    return 0;
}

fn emit_js_compile(tokens) {
    return emit_js_program(parser_ast(tokens));
}

/// Parse once and return the main-source body without runtime wrappers.
fn emit_js_compile_program_only(tokens) {
    return emit_js_program_only(parser_ast(tokens));
}

/// Parse without condition warnings and return complete JavaScript source.
fn emit_js_compile_quiet(tokens) {
    return emit_js_program(parser_ast_quiet(tokens));
}
