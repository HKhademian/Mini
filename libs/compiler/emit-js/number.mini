/// JavaScript host replacements for common numeric functions.

import "./registry";

emit_js_host_function_add(
    "number_add",
    text_join(
        "\n",
        "function number_add(a, b) {",
        "  if (typeof a !== \"number\" || typeof b !== \"number\") {",
        "    return 0;",
        "  }",
        "  return a + b;",
        "}",
        ""
    ),
    false,
    ""
);
emit_js_host_function_add(
    "number_sub",
    text_join(
        "\n",
        "function number_sub(a, b) {",
        "  if (typeof a !== \"number\" || typeof b !== \"number\") {",
        "    return 0;",
        "  }",
        "  return a - b;",
        "}",
        ""
    ),
    false,
    ""
);
emit_js_host_function_add(
    "number_min",
    text_join(
        "\n",
        "function number_min(a, b) {",
        "  if (typeof a !== \"number\" || typeof b !== \"number\") {",
        "    return 0;",
        "  }",
        "  return Math.min(a, b);",
        "}",
        ""
    ),
    false,
    ""
);
emit_js_host_function_add(
    "number_max",
    text_join(
        "\n",
        "function number_max(a, b) {",
        "  if (typeof a !== \"number\" || typeof b !== \"number\") {",
        "    return 0;",
        "  }",
        "  return Math.max(a, b);",
        "}",
        ""
    ),
    false,
    ""
);
emit_js_host_function_add(
    "number_div",
    text_join(
        "\n",
        "function number_div(a, b) {",
        "  if (typeof a !== \"number\" || typeof b !== \"number\" || b === 0) {",
        "    return 0;",
        "  }",
        "  return Math.trunc(a / b);",
        "}",
        ""
    ),
    false,
    ""
);
emit_js_host_function_add(
    "number_floor",
    text_join(
        "\n",
        "function number_floor(value) {",
        "  if (typeof value !== \"number\") {",
        "    return 0;",
        "  }",
        "  return Math.floor(value);",
        "}",
        ""
    ),
    false,
    ""
);
emit_js_host_function_add(
    "number_from_text",
    text_join(
        "\n",
        "function number_from_text(text) {",
        "  if (typeof text !== \"string\" || !/^-?[0-9]+$/.test(text)) {",
        "    return 0;",
        "  }",
        "  const value = Number(text);",
        "  return Number.isSafeInteger(value) ? value : 0;",
        "}",
        ""
    ),
    false,
    ""
);
emit_js_host_function_add(
    "number_mod",
    text_join(
        "\n",
        "function number_mod(a, b) {",
        "  if (typeof a !== \"number\" || typeof b !== \"number\" || b === 0) {",
        "    return 0;",
        "  }",
        "  return a % b;",
        "}",
        ""
    ),
    false,
    ""
);
emit_js_host_function_add(
    "number_mul",
    text_join(
        "\n",
        "function number_mul(a, b) {",
        "  if (typeof a !== \"number\" || typeof b !== \"number\") {",
        "    return 0;",
        "  }",
        "  return a * b;",
        "}",
        ""
    ),
    false,
    ""
);
emit_js_host_function_add(
    "number_pow",
    text_join(
        "\n",
        "function number_pow(a, b) {",
        "  if (typeof a !== \"number\" || typeof b !== \"number\" || !Number.isInteger(b) || b < 0) {",
        "    return 0;",
        "  }",
        "  return Math.pow(a, b);",
        "}",
        ""
    ),
    false,
    ""
);
emit_js_host_function_add(
    "number_to_text",
    text_join(
        "\n",
        "function number_to_text(value) {",
        "  if (typeof value !== \"number\" || !Number.isSafeInteger(value)) {",
        "    return \"\";",
        "  }",
        "  return String(value);",
        "}",
        ""
    ),
    false,
    ""
);
