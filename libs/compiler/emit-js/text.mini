/// JavaScript host replacements for common text functions.

import "./registry";

emit_js_host_function_add(
    "text_find",
    list_of(
        "function text_find(source, needle) {",
        "  if (typeof source !== \"string\" || typeof needle !== \"string\") {",
        "    return -1;",
        "  }",
        "  const found = source.indexOf(needle);",
        "  return found < 0 ? -1 : Array.from(source.slice(0, found)).length;",
        "}",
        ""
    ),
    false,
    ""
);
emit_js_host_function_add(
    "text_from_bytes",
    list_of(
        "function text_from_bytes(bytes) {",
        "  if (!Array.isArray(bytes)) {",
        "    return \"\";",
        "  }",
        "  return Buffer",
        "      .from(bytes.map(",
        "          value => typeof value === \"number\" && Number.isInteger(value) ? value & 255 : 0))",
        "      .toString(\"utf8\");",
        "}",
        ""
    ),
    false,
    ""
);
emit_js_host_function_add(
    "text_from_code",
    list_of(
        "function text_from_code(code) {",
        "  if (typeof code !== \"number\" || !Number.isInteger(code) || code < 0 || code > 0x10FFFF ||",
        "      (code >= 0xD800 && code <= 0xDFFF)) {",
        "    return \"\";",
        "  }",
        "  return String.fromCodePoint(code);",
        "}",
        ""
    ),
    true,
    ""
);
emit_js_host_function_add(
    "text_to_code",
    list_of(
        "function text_to_code(source, index) {",
        "  if (typeof source !== \"string\" || !Number.isInteger(index) || index < 0) {",
        "    return 0;",
        "  }",
        "  text_length(source);",
        "  const character = text_length.cache.get(source)[index];",
        "  return character === undefined ? 0 : character.codePointAt(0);",
        "}",
        ""
    ),
    true,
    ""
);
emit_js_host_function_add(
    "text_get",
    list_of(
        "function text_get(source, index) {",
        "  if (typeof source !== \"string\" || !Number.isInteger(index) || index < 0) {",
        "    return \"\";",
        "  }",
        "  text_length(source);",
        "  return text_length.cache.get(source)[index] ?? \"\";",
        "}",
        ""
    ),
    true,
    ""
);
emit_js_host_function_add(
    "text_length",
    list_of(
        "function text_length(source) {",
        "  if (typeof source !== \"string\") {",
        "    return 0;",
        "  }",
        "  const cache = text_length.cache ?? (text_length.cache = new Map());",
        "  let characters = cache.get(source);",
        "  if (!characters) {",
        "    characters = Array.from(source);",
        "    if (cache.size >= 64) {",
        "      cache.clear();",
        "    }",
        "    cache.set(source, characters);",
        "  }",
        "  return characters.length;",
        "}",
        ""
    ),
    true,
    ""
);
emit_js_host_function_add(
    "text_slice",
    list_of(
        "function text_slice(source, start, end) {",
        "  if (typeof source !== \"string\" || !Number.isInteger(start) || !Number.isInteger(end)) {",
        "    return \"\";",
        "  }",
        "  text_length(source);",
        "  const characters = text_length.cache.get(source);",
        "  if (start < 0) {",
        "    start = characters.length + start;",
        "  }",
        "  if (end < 0) {",
        "    end = characters.length + end;",
        "  }",
        "  if (start < 0) {",
        "    start = 0;",
        "  }",
        "  if (end < 0) {",
        "    end = 0;",
        "  }",
        "  if (start > characters.length) {",
        "    start = characters.length;",
        "  }",
        "  if (end > characters.length) {",
        "    end = characters.length;",
        "  }",
        "  if (end <= start) {",
        "    return \"\";",
        "  }",
        "  return characters.slice(start, end).join(\"\");",
        "}",
        ""
    ),
    false,
    ""
);
emit_js_host_function_add(
    "text_split",
    list_of(
        "function text_split(source, divider) {",
        "  if (typeof source !== \"string\" || typeof divider !== \"string\") {",
        "    return [];",
        "  }",
        "  if (divider === \"\") {",
        "    return [source];",
        "  }",
        "  return source.split(divider);",
        "}",
        ""
    ),
    false,
    ""
);
emit_js_host_function_add(
    "text_to_bytes",
    list_of(
        "function text_to_bytes(source) {",
        "  return typeof source === \"string\" ? Array.from(Buffer.from(source, \"utf8\")) : [];",
        "}",
        ""
    ),
    false,
    ""
);
