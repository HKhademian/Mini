/// JavaScript host replacements for common list operations.

import "./registry";

emit_js_host_function_add(
    "list_new",
    text_join("\n", "function list_new() {", "  return [];", "}", ""),
    true,
    ""
);
emit_js_host_function_add(
    "list_get",
    text_join(
        "\n",
        "function list_get(items, index) {",
        "  if (!Array.isArray(items) || !Number.isInteger(index)) {",
        "    return 0;",
        "  }",
        "  if (index < 0) {",
        "    index = items.length + index;",
        "  }",
        "  return index >= 0 && index < items.length && index in items ? items[index] : 0;",
        "}",
        ""
    ),
    true,
    ""
);
emit_js_host_function_add(
    "list_length",
    text_join("\n", "function list_length(items) {", "  return Array.isArray(items) ? items.length : 0;", "}", ""),
    true,
    "({0}).length"
);
emit_js_host_function_add(
    "list_set",
    text_join(
        "\n",
        "function list_set(items, index, value) {",
        "  if (!Array.isArray(items) || !Number.isInteger(index)) {",
        "    return 0;",
        "  }",
        "  if (index < 0) {",
        "    index = items.length + index;",
        "  }",
        "  if (index >= 0) {",
        "    items[index] = value;",
        "  }",
        "  return 0;",
        "}",
        ""
    ),
    true,
    ""
);
emit_js_host_function_add(
    "list_truncate",
    text_join(
        "\n",
        "function list_truncate(items, length) {",
        "  if (Array.isArray(items) && Number.isInteger(length) && length >= 0 && length < items.length) {",
        "    items.length = length;",
        "  }",
        "  return 0;",
        "}",
        ""
    ),
    true,
    ""
);
emit_js_host_function_add(
    "list_copy",
    text_join("\n", "function list_copy(items) {", "  return Array.isArray(items) ? items.slice() : [];", "}", ""),
    false,
    ""
);
emit_js_host_function_add(
    "list_join",
    text_join(
        "\n",
        "function list_join(separator, ...sources) {",
        "  if (typeof separator !== \"string\") {",
        "    return \"\";",
        "  }",
        "  let output = \"\";",
        "  let hasItem = false;",
        "  for (const items of sources) {",
        "    if (!Array.isArray(items)) {",
        "      continue;",
        "    }",
        "    for (const value of items) {",
        "      if (hasItem) {",
        "        output += separator;",
        "      }",
        "      if (typeof value === \"string\") {",
        "        output += value;",
        "      }",
        "      hasItem = true;",
        "    }",
        "  }",
        "  return output;",
        "}",
        ""
    ),
    false,
    ""
);
