/// JavaScript host replacements for common map operations.
//

import "./registry";

emit_js_host_function_add(
    "map_new",
    list_of(
        "function map_new() {",
        "  return Object.create(null);",
        "}",
        ""
    ),
    true,
    ""
);
emit_js_host_function_add(
    "map_get",
    list_of(
        "function map_get(items, key) {",
        "  if (items === null || typeof items !== \"object\" || Array.isArray(items)) {",
        "    return 0;",
        "  }",
        "  return Object.prototype.hasOwnProperty.call(items, key) ? items[key] : 0;",
        "}",
        ""
    ),
    true,
    ""
);
emit_js_host_function_add(
    "map_set",
    list_of(
        "function map_set(items, key, value) {",
        "  if (items !== null && typeof items === \"object\" && !Array.isArray(items) &&",
        "      typeof key === \"string\") {",
        "    items[key] = value;",
        "  }",
        "  return 0;",
        "}",
        ""
    ),
    true,
    ""
);
emit_js_host_function_add(
    "map_has",
    list_of(
        "function map_has(items, key) {",
        "  return items !== null && typeof items === \"object\" && !Array.isArray(items) &&",
        "      typeof key === \"string\" && Object.prototype.hasOwnProperty.call(items, key);",
        "}",
        ""
    ),
    true,
    ""
);
emit_js_host_function_add(
    "map_keys",
    list_of(
        "function map_keys(items) {",
        "  if (items === null || typeof items !== \"object\" || Array.isArray(items)) {",
        "    return [];",
        "  }",
        "  return Object.keys(items);",
        "}",
        ""
    ),
    true,
    ""
);
emit_js_host_function_add(
    "map_delete",
    list_of(
        "function map_delete(items, key) {",
        "  if (items !== null && typeof items === \"object\" && !Array.isArray(items) &&",
        "      typeof key === \"string\") {",
        "    delete items[key];",
        "  }",
        "  return 0;",
        "}",
        ""
    ),
    true,
    ""
);
emit_js_host_function_add(
    "map_copy",
    list_of(
        "function map_copy(items) {",
        "  if (items === null || typeof items !== \"object\" || Array.isArray(items)) {",
        "    return Object.create(null);",
        "  }",
        "  return Object.assign(Object.create(null), items);",
        "}",
        ""
    ),
    false,
    ""
);
