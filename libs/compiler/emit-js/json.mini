/// JavaScript host replacements for common JSON functions.

import "./registry";

emit_js_host_function_add(
    "json_value",
    text_join(
        "\n",
        "function json_value(text) {",
        "  const result = Object.create(null);",
        "  result.ok = false;",
        "  result.value = 0;",
        "  if (typeof text !== \"string\") {",
        "    return result;",
        "  }",
        "  let parsed;",
        "  try {",
        "    parsed = JSON.parse(text);",
        "  } catch {",
        "    return result;",
        "  }",
        "  const clean = (item) => {",
        "    if (item === null) {",
        "      return 0;",
        "    }",
        "    if (typeof item === \"number\") {",
        "      if (!Number.isSafeInteger(item)) {",
        "        throw 0;",
        "      }",
        "      return item;",
        "    }",
        "    if (Array.isArray(item)) {",
        "      return item.map(clean);",
        "    }",
        "    if (typeof item === \"object\") {",
        "      const out = Object.create(null);",
        "      for (const key of Object.keys(item)) {",
        "        out[key] = clean(item[key]);",
        "      }",
        "      return out;",
        "    }",
        "    return item;",
        "  };",
        "  try {",
        "    result.value = clean(parsed);",
        "  } catch {",
        "    return result;",
        "  }",
        "  result.ok = true;",
        "  return result;",
        "}",
        ""
    ),
    false,
    ""
);
emit_js_host_function_add(
    "json_text",
    text_join(
        "\n",
        "function json_text(value) {",
        "  const seen = new Set();",
        "  function encode(item) {",
        "    if (typeof item === \"string\") {",
        "      return JSON.stringify(item);",
        "    }",
        "    if (typeof item === \"number\") {",
        "      const text = number_to_text(item);",
        "      return text === \"\" ? \"null\" : text;",
        "    }",
        "    if (typeof item === \"boolean\") {",
        "      return item ? \"true\" : \"false\";",
        "    }",
        "    if (item === null || item === undefined) {",
        "      return \"null\";",
        "    }",
        "    if (typeof item !== \"object\") {",
        "      return \"null\";",
        "    }",
        "    if (seen.has(item)) {",
        "      throw 0;",
        "    }",
        "    seen.add(item);",
        "    let output;",
        "    if (Array.isArray(item)) {",
        "      const parts = [];",
        "      for (let index = 0; index < item.length; index++) {",
        "        parts.push(index in item ? encode(item[index]) : \"null\");",
        "      }",
        "      output = \"[\" + parts.join(\",\") + \"]\";",
        "    } else {",
        "      const parts = [];",
        "      for (const key of Object.keys(item).sort()) {",
        "        parts.push(JSON.stringify(key) + \":\" + encode(item[key]));",
        "      }",
        "      output = \"{\" + parts.join(\",\") + \"}\";",
        "    }",
        "    seen.delete(item);",
        "    return output;",
        "  }",
        "  try {",
        "    return encode(value);",
        "  } catch {",
        "    return \"\";",
        "  }",
        "}",
        ""
    ),
    false,
    ""
);
