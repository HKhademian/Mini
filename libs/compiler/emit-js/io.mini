        "        parts.push(i in value ? encode(value[i], depth + 1, seen) : \"null\");",
        "      }",
        "      output = \"[\" + parts.join(\",\") + \"]\";",
        "    } else {",
        "      const parts = [];",
        "      const keys = Object.keys(value).sort(compareText);",
        "      for (const key of keys) {",
        "        parts.push(JSON.stringify(key) + \":\" + encode(value[key], depth + 1, seen));",
        "      }",
        "      output = \"{\" + parts.join(\",\") + \"}\";",
        "    }",
