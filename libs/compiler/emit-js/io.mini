/// JavaScript host replacements for standard input and output operations.

import "./registry";

emit_js_host_function_add(
    "io_read_all",
    list_of(
        "function io_read_all() {",
        "  return process.getBuiltinModule(\"node:fs\").readFileSync(0, \"utf8\");",
        "}",
        ""
    ),
    true,
    ""
);
emit_js_host_function_add(
    "io_read_bytes",
    list_of(
        "function io_read_bytes(count) {",
        "  if (typeof count !== \"number\" || !Number.isInteger(count) || count <= 0) {",
        "    return [];",
        "  }",
        "  const fs = process.getBuiltinModule(\"node:fs\");",
        "  const buffer = Buffer.alloc(count);",
        "  const read = fs.readSync(0, buffer, 0, count, null);",
        "  return Array.from(buffer.subarray(0, read));",
        "}",
        ""
    ),
    true,
    ""
);
emit_js_host_function_add(
    "io_read_line",
    list_of(
        "function io_read_line() {",
        "  const fs = process.getBuiltinModule(\"node:fs\");",
        "  const buffer = Buffer.alloc(1);",
        "  const bytes = [];",
        "  while (true) {",
        "    const count = fs.readSync(0, buffer, 0, 1, null);",
        "    if (count === 0 || buffer[0] === 10) {",
        "      break;",
        "    }",
        "    bytes.push(buffer[0]);",
        "  }",
        "  if (bytes.length > 0 && bytes[bytes.length - 1] === 13) {",
        "    bytes.pop();",
        "  }",
        "  return Buffer.from(bytes).toString(\"utf8\");",
        "}",
        ""
    ),
    true,
    ""
);
emit_js_host_function_add(
    "io_write",
    list_of(
        "function io_write(...values) {",
        "  function compareText(left, right) {",
        "    let a = 0, b = 0;",
        "    while (a < left.length && b < right.length) {",
        "      const x = left.codePointAt(a), y = right.codePointAt(b);",
        "      if (x !== y) {",
        "        return x < y ? -1 : 1;",
        "      }",
        "      a += x > 65535 ? 2 : 1;",
        "      b += y > 65535 ? 2 : 1;",
        "    }",
        "    return a < left.length ? 1 : b < right.length ? -1 : 0;",
        "  }",
        "  function encode(value, depth, seen) {",
        "    if (depth > 128) throw 0;",
        "    if (typeof value === \"string\") return JSON.stringify(value);",
        "    if (typeof value === \"number\") return Number.isSafeInteger(value) ? String(value) : \"null\";",
        "    if (typeof value === \"boolean\") return value ? \"true\" : \"false\";",
        "    if (value === null || value === undefined) return \"null\";",
        "    if (typeof value !== \"object\" || seen.has(value)) throw 0;",
        "    seen.add(value);",
        "    let output;",
        "    if (Array.isArray(value)) {",
        "      const parts = [];",
        "      for (let i = 0; i < value.length; i++) {",
        "        parts.push(i in value ? encode(value[i], depth + 1, seen) : \"null\");",
        "      }",
        "      output = \"[\" + parts.join(\",\") + \"]\";",
        "    } else {",
        "      const parts = [];",
        "      const keys = Object.keys(value).sort(compareText);",
        "      for (const key of keys) {",
        "        parts.push(JSON.stringify(key) + \":\" + encode(value[key], depth + 1, seen));",
        "      }",
        "      output = \"{\" + parts.join(\",\") + \"}\";",
        "    }",
        "    seen.delete(value);",
        "    return output;",
        "  }",
        "  function display(value) {",
        "    if (typeof value === \"string\") {",
        "      return value;",
        "    }",
        "    if (typeof value === \"number\") {",
        "      return Number.isSafeInteger(value) ? String(value) : \"\";",
        "    }",
        "    if (typeof value === \"boolean\") {",
        "      return value ? \"true\" : \"false\";",
        "    }",
        "    if (Array.isArray(value) || (value !== null && typeof value === \"object\")) {",
        "      return encode(value, 0, new Set());",
        "    }",
        "    return \"0\";",
        "  }",
        "  let text = \"\";",
        "  for (const value of values) {",
        "    text += display(value);",
        "  }",
        "  process.getBuiltinModule(\"node:fs\").writeSync(1, Buffer.from(text, \"utf8\"));",
        "  return 0;",
        "}",
        ""
    ),
    true,
    ""
);
emit_js_host_function_add(
