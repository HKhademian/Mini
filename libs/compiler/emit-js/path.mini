/// JavaScript host replacements for common directory and path operations.

import "./registry";

emit_js_host_function_add(
    "directory_create",
    text_join(
        "\n",
        "function directory_create(path) {",
        "  process.getBuiltinModule(\"node:fs\").mkdirSync(path, {recursive: true});",
        "  return 0;",
        "}",
        ""
    ),
    true,
    ""
);
emit_js_host_function_add(
    "directory_list",
    text_join(
        "\n",
        "function directory_list(path) {",
        "  const fs = process.getBuiltinModule(\"node:fs\");",
        "  try {",
        "    return fs.readdirSync(path).sort();",
        "  } catch {",
        "    return [];",
        "  }",
        "}",
        ""
    ),
    true,
    ""
);
emit_js_host_function_add(
    "path_copy",
    text_join(
        "\n",
        "function path_copy(from, to) {",
        "  process.getBuiltinModule(\"node:fs\").cpSync(",
        "      from, to, {recursive: true, force: true, dereference: true});",
        "  return 0;",
        "}",
        ""
    ),
    true,
    ""
);
emit_js_host_function_add(
    "path_is_directory",
    text_join(
        "\n",
        "function path_is_directory(path) {",
        "  const fs = process.getBuiltinModule(\"node:fs\");",
        "  try {",
        "    return fs.statSync(path).isDirectory();",
        "  } catch {",
        "    return false;",
        "  }",
        "}",
        ""
    ),
    true,
    ""
);
emit_js_host_function_add(
    "path_is_exists",
    text_join(
        "\n",
        "function path_is_exists(path) {",
        "  const fs = process.getBuiltinModule(\"node:fs\");",
        "  try {",
        "    return fs.existsSync(path);",
        "  } catch {",
        "    return false;",
        "  }",
        "}",
        ""
    ),
    true,
    ""
);
emit_js_host_function_add(
    "path_is_file",
    text_join(
        "\n",
        "function path_is_file(path) {",
        "  try {",
        "    return process.getBuiltinModule(\"node:fs\").statSync(path).isFile();",
        "  } catch {",
        "    return false;",
        "  }",
        "}",
        ""
    ),
    true,
    ""
);
emit_js_host_function_add(
    "path_remove",
    text_join(
        "\n",
        "function path_remove(path) {",
        "  process.getBuiltinModule(\"node:fs\").rmSync(path, {recursive: true, force: true});",
        "  return 0;",
        "}",
        ""
    ),
    true,
    ""
);
emit_js_host_function_add(
    "path_temp_directory",
    text_join(
        "\n",
        "function path_temp_directory() {",
        "  const fs = process.getBuiltinModule(\"node:fs\");",
        "  const os = process.getBuiltinModule(\"node:os\");",
        "  return fs.mkdtempSync(os.tmpdir() + \"/mini-\");",
        "}",
        ""
    ),
    true,
    ""
);
