/// Registry for target-specific implementations of same-name Mini functions.

js_host_functions := map_new();

/// Register emitted JavaScript for one public Mini function.
fn emit_js_host_function_add(name, definition) {
    map_set(js_host_functions, name, definition);
    return 0;
}

/// Return a registered host implementation unless reference mode is active.
fn emit_js_host_function(name) {
    if reference_mode || !map_has(js_host_functions, name) {
        return "";
    }
    return map_get(js_host_functions, name);
}

include "./overrides/number.mini";
