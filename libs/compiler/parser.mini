/// Eager recursive-descent parser and shallow checker over a complete token list.
/// Returns one checked Program AST; it does not emit target source.

import "core/text";
import "core/number";
import "core/list";
import "core/map";
import "./lexer";
import "./ast";

/// Report a parser/checker diagnostic.
fn parser_fail(token, message) {
    return diagnostic_fail(token, message);
}

/// Build one typed target-neutral binary expression node.
fn parser_binary_expression(kind, left, operator, right) {
    node := ast_derive(AST_BINARY, left, kind);
    map_set(node, "operator", map_get(operator, "text"));
    map_set(node, "left", left);
    map_set(node, "right", right);
    ast_finish_node(node, right);
    return node;
}

/// Return the current parser token.
fn parser_token(parser) {
    return list_get(map_get(parser, "tokens"), map_get(parser, "position"));
}

/// Return a token offset from the current parser position.
fn parser_peek(parser, offset) {
    return list_get(map_get(parser, "tokens"), map_get(parser, "position") + offset);
}

/// Return the current token and advance.
fn parser_take(parser) {
    token := parser_token(parser);
    map_set(parser, "position", map_get(parser, "position") + 1);
    return token;
}

/// Consume required punctuation or report a diagnostic.
fn parser_expect(parser, text) {
    if map_get(parser_token(parser), "text") != text {
        parser_fail(parser_token(parser), "expected " + text);
    }
    parser_take(parser);
    return 0;
}

/// Consume an identifier or report the selected diagnostic.
fn parser_identifier(parser, message) {
    if map_get(parser_token(parser), "kind") != "identifier" {
        parser_fail(parser_token(parser), message);
    }
    return parser_take(parser);
}

/// Parse logical disjunction.
fn parser_expression(parser) {
    left := parser_conjunction(parser);
    while map_get(parser_token(parser), "text") == "||" {
        operator := parser_take(parser);
        right := parser_conjunction(parser);
        if (map_get(left, "value_kind") != "boolean" && map_get(left, "value_kind") != "unknown") || (map_get(
                right,
                "value_kind"
            ) != "boolean" && map_get(right, "value_kind") != "unknown") {
            parser_fail(operator, "|| needs booleans");
        }
        left = parser_binary_expression("boolean", left, operator, right);
    }
    return left;
}

/// Parse logical conjunction.
fn parser_conjunction(parser) {
    left := parser_equality(parser);
    while map_get(parser_token(parser), "text") == "&&" {
        operator := parser_take(parser);
        right := parser_equality(parser);
        if (map_get(left, "value_kind") != "boolean" && map_get(left, "value_kind") != "unknown") || (map_get(
                right,
                "value_kind"
            ) != "boolean" && map_get(right, "value_kind") != "unknown") {
            parser_fail(operator, "&& needs booleans");
        }
        left = parser_binary_expression("boolean", left, operator, right);
    }
    return left;
}

/// Parse scalar equality and inequality.
fn parser_equality(parser) {
    left := parser_comparison(parser);
    while map_get(parser_token(parser), "text") == "==" || map_get(parser_token(parser), "text") == "!=" {
        operator := parser_take(parser);
        right := parser_comparison(parser);
        left_kind := map_get(left, "value_kind");
        right_kind := map_get(right, "value_kind");
        if left_kind == "list" || right_kind == "list" || left_kind == "map" || right_kind == "map" || (left_kind != "unknown"
            && right_kind != "unknown" && left_kind != right_kind) {
            parser_fail(operator, "equality needs matching scalar kinds");
        }
        left = parser_binary_expression("boolean", left, operator, right);
    }
    return left;
}

/// Parse numeric comparisons.
fn parser_comparison(parser) {
    left := parser_additive(parser);
    while map_get(parser_token(parser), "text") == "<" || map_get(parser_token(parser), "text") == "<=" || map_get(
        parser_token(parser),
        "text"
    ) == ">" || map_get(parser_token(parser), "text") == ">=" {
        operator := parser_take(parser);
        right := parser_additive(parser);
        if (map_get(left, "value_kind") != "number" && map_get(left, "value_kind") != "unknown") || (map_get(
                right,
                "value_kind"
            ) != "number" && map_get(right, "value_kind") != "unknown") {
            parser_fail(operator, "comparison needs numbers");
        }
        left = parser_binary_expression("boolean", left, operator, right);
    }
    return left;
}

/// Return whether kind can participate in addition.
fn parser_additive_kind(kind) {
    return kind == "number" || kind == "text" || kind == "unknown";
}

/// Parse numeric addition/subtraction and text concatenation.
fn parser_additive(parser) {
    left := parser_unary(parser);
    while map_get(parser_token(parser), "text") == "+" || map_get(parser_token(parser), "text") == "-" {
        operator := parser_take(parser);
        right := parser_unary(parser);
        left_kind := map_get(left, "value_kind");
        right_kind := map_get(right, "value_kind");
        if map_get(operator, "text") == "-" {
            if (left_kind != "number" && left_kind != "unknown") || (right_kind != "number" && right_kind != "unknown") {
                parser_fail(operator, "- needs two numbers");
            }
        } else {
            if !parser_additive_kind(left_kind) || !parser_additive_kind(right_kind) || (left_kind != "unknown" && right_kind
                != "unknown" && left_kind != right_kind) {
                parser_fail(operator, "+ needs two numbers or two texts");
            }
        }
        result_kind := left_kind;
        if left_kind == "unknown" {
            result_kind = right_kind;
        }
        left = parser_binary_expression(result_kind, left, operator, right);
    }
    return left;
}

/// Parse boolean negation and negative number literals.
fn parser_unary(parser) {
    if map_get(parser_token(parser), "text") == "-" {
        operator := parser_take(parser);
        number := parser_token(parser);
        if map_get(number, "kind") != "number" {
            parser_fail(operator, "- must precede a number literal");
        }
        parser_take(parser);
        value := "-" + lex_normalize_number(map_get(number, "text"));
        node := ast_node(AST_LITERAL, operator);
        map_set(node, "literal_kind", "number");
        map_set(node, "value", value);
        map_set(node, "raw", "-" + map_get(number, "text"));
        ast_finish(node, number);
        map_set(node, "value_kind", "number");
        return node;
    }
    if map_get(parser_token(parser), "text") == "!" {
        operator := parser_take(parser);
        value := parser_unary(parser);
        kind := "boolean";
        if map_get(value, "value_kind") != kind && map_get(value, "value_kind") != "unknown" {
            parser_fail(operator, map_get(operator, "text") + " needs a " + kind);
        }
        node := ast_node(AST_UNARY, operator);
        map_set(node, "value_kind", kind);
        map_set(node, "operator", map_get(operator, "text"));
        map_set(node, "operand", value);
        ast_finish_node(node, value);
        return node;
    }
    return parser_primary(parser);
}

/// Return normalized decimal text for a digit-only literal.
fn lex_normalize_number(text) {
    position := 0;
    while position < text_length(text) && text_get(text, position) == "0" {
        position = position + 1;
    }
    if position == text_length(text) {
        return "0";
    }
    return text_slice(text, position, text_length(text));
}

/// Parse literals, bindings, calls, and parenthesized expressions.
fn parser_primary(parser) {
    token := parser_take(parser);
    if map_get(token, "text") == "(" {
        value := parser_expression(parser);
        close := parser_token(parser);
        parser_expect(parser, ")");
        node := ast_node(AST_GROUP, token);
        map_set(node, "expression", value);
        ast_finish(node, close);
        map_set(node, "value_kind", map_get(value, "value_kind"));
        return node;
    }
    if map_get(token, "kind") == "number" {
        node := ast_expression(AST_LITERAL, token, "number");
        map_set(node, "literal_kind", "number");
        map_set(node, "raw", map_get(token, "text"));
        map_set(node, "value", lex_normalize_number(map_get(token, "text")));
        return node;
    }
    if map_get(token, "kind") == "text" {
        node := ast_expression(AST_LITERAL, token, "text");
        map_set(node, "literal_kind", "text");
        map_set(node, "raw", map_get(token, "text"));
        map_set(node, "value", map_get(token, "text"));
        return node;
    }
    if map_get(token, "text") == "true" || map_get(token, "text") == "false" {
        node := ast_expression(AST_LITERAL, token, "boolean");
        map_set(node, "literal_kind", "boolean");
        map_set(node, "raw", map_get(token, "text"));
        map_set(node, "value", map_get(token, "text") == "true");
        return node;
    }
    if map_get(token, "kind") == "identifier" && map_get(token, "text") == "fn_args" {
        return parser_fn_args(parser, token);
    }
    if map_get(token, "kind") == "identifier" && map_get(parser_token(parser), "text") == "(" {
        return parser_call(parser, token);
    }
    if map_get(token, "kind") == "identifier" && map_has(map_get(parser, "variables"), map_get(token, "text")) {
        value_kind := map_get(map_get(parser, "variables"), map_get(token, "text"));
        node := ast_expression(AST_NAME, token, value_kind);
        map_set(node, "name", map_get(token, "text"));
        return node;
    }
    parser_fail(token, "expected expression");
    node := ast_expression(AST_LITERAL, token, "unknown");
    map_set(node, "value", "");
    return node;
}

/// Return the supplied arguments of the current context as a list.
///
/// Top level means the process. The invoked name and the node entry are
/// munched there, so the result is the program arguments in every invocation
/// shape. Any other position means the enclosing call: every supplied argument
/// is imported, even beyond the declared parameters.
fn parser_fn_args(parser, token) {
    parser_expect(parser, "(");
    close := parser_token(parser);
    parser_expect(parser, ")");
    if !map_get(parser, "in_function") {
        node := ast_expression(AST_FN_ARGS, token, "list");
        map_set(node, "captures", false);
        ast_finish(node, close);
        return node;
    }
    map_set(map_get(parser, "current"), "captures", true);
    node := ast_expression(AST_FN_ARGS, token, "list");
    map_set(node, "captures", true);
    ast_finish(node, close);
    return node;
}

/// Create one call node from a resolved callee and checked argument expressions.
fn parser_call_node(name, args, result_kind, close) {
    node := ast_node(AST_CALL, name);
    map_set(node, "callee", map_get(name, "text"));
    map_set(node, "value_kind", result_kind);
    argument_nodes := list_new();
    position := 0;
    while position < list_length(args) {
        list_set(argument_nodes, list_length(argument_nodes), list_get(args, position));
        position = position + 1;
    }
    map_set(node, "arguments", argument_nodes);
    ast_finish(node, close);
    return node;
}

/// Parse a call to any function declared in the imported source graph.
fn parser_call(parser, name) {
    name_text := map_get(name, "text");
    functions := map_get(parser, "functions");
    has_user := map_has(functions, name_text);
    if !has_user {
        parser_fail(name, "unknown function " + name_text);
    }
    parser_expect(parser, "(");
    args := list_new();
    if map_get(parser_token(parser), "text") != ")" {
        list_set(args, list_length(args), parser_expression(parser));
        while map_get(parser_token(parser), "text") == "," {
            parser_take(parser);
            list_set(args, list_length(args), parser_expression(parser));
        }
    }
    close := parser_token(parser);
    parser_expect(parser, ")");
    // Every call uses the same argument convention: missing declared
    // parameters receive 0, and extra arguments remain visible to fn_args().
    arity := map_get(map_get(functions, name_text), "arity");
    while list_length(args) < arity {
        zero := ast_expression(AST_LITERAL, name, "number");
        map_set(zero, "literal_kind", "number");
        map_set(zero, "raw", "0");
        map_set(zero, "value", "0");
        map_set(zero, "synthetic", true);
        list_set(args, list_length(args), zero);
    }
    result_kind := map_get(map_get(functions, name_text), "result");
    return parser_call_node(name, args, result_kind, close);
}

/// Parse and check one statement into the shared AST.
fn parser_statement(parser) {
    if map_get(parser_token(parser), "text") == "while" {
        token := parser_take(parser);
        while_condition := parser_condition(parser);
        body := parser_block(parser);
        node := ast_node(AST_WHILE, token);
        map_set(node, "condition", while_condition);
        map_set(node, "body", body);
        ast_finish_node(node, body);
        return node;
    }
    if map_get(parser_token(parser), "text") == "if" {
        token := parser_take(parser);
        if_condition := parser_condition(parser);
        consequent := parser_block(parser);
        alternate := 0;
        if map_get(parser_token(parser), "text") == "else" {
            parser_take(parser);
            if map_get(parser_token(parser), "text") == "if" {
                alternate = parser_statement(parser);
                node := ast_node(AST_IF, token);
                map_set(node, "condition", if_condition);
                map_set(node, "consequent", consequent);
                map_set(node, "alternate", alternate);
                ast_finish_node(node, alternate);
                return node;
            }
            alternate = parser_block(parser);
        }
        node := ast_node(AST_IF, token);
        map_set(node, "condition", if_condition);
        map_set(node, "consequent", consequent);
        if alternate != 0 {
            map_set(node, "alternate", alternate);
            ast_finish_node(node, alternate);
        } else {
            ast_finish_node(node, consequent);
        }
        return node;
    }
    if map_get(parser_token(parser), "text") == "fn" {
        return parser_function_declaration(parser);
    }
    if map_get(parser_token(parser), "text") == "return" {
        return_token := parser_take(parser);
        if !map_get(parser, "in_function") {
            parser_fail(return_token, "return outside function");
        }
        return_value := parser_expression(parser);
        semicolon := parser_token(parser);
        parser_expect(parser, ";");
        map_set(map_get(parser, "current"), "result", map_get(return_value, "value_kind"));
        node := ast_node(AST_RETURN, return_token);
        map_set(node, "value", return_value);
        ast_finish(node, semicolon);
        return node;
    }
    if map_get(parser_token(parser), "kind") == "identifier" && map_get(parser_peek(parser, 1), "text") == "(" {
        call_value := parser_expression(parser);
        semicolon := parser_token(parser);
        parser_expect(parser, ";");
        node := ast_node(AST_CALL_STATEMENT, call_value);
        map_set(node, "expression", call_value);
        ast_finish(node, semicolon);
        return node;
    }
    variables := map_get(parser, "variables");
    statement_name := parser_identifier(parser, "expected binding name");
    if map_get(parser_token(parser), "text") == ":=" {
        parser_take(parser);
        if map_has(map_get(parser, "declared"), map_get(statement_name, "text")) {
            parser_fail(statement_name, "duplicate binding " + map_get(statement_name, "text"));
        }
        declaration_value := parser_expression(parser);
        semicolon := parser_token(parser);
        parser_expect(parser, ";");
        value_kind := map_get(declaration_value, "value_kind");
        map_set(variables, map_get(statement_name, "text"), value_kind);
        map_set(map_get(parser, "declared"), map_get(statement_name, "text"), true);
        top_level := map_get(parser, "depth") == 0 && !map_get(parser, "in_function");
        node := ast_node(AST_BINDING, statement_name);
        map_set(node, "name", map_get(statement_name, "text"));
        map_set(node, "value_kind", value_kind);
        map_set(node, "initializer", declaration_value);
        map_set(node, "top_level", top_level);
        ast_finish(node, semicolon);
        return node;
    }
    if !map_has(variables, map_get(statement_name, "text")) {
        parser_fail(statement_name, "unknown binding " + map_get(statement_name, "text"));
    }
    parser_expect(parser, "=");
    assignment_value := parser_expression(parser);
    semicolon := parser_token(parser);
    parser_expect(parser, ";");
    value_kind := map_get(assignment_value, "value_kind");
    map_set(variables, map_get(statement_name, "text"), value_kind);
    node := ast_node(AST_ASSIGNMENT, statement_name);
    map_set(node, "name", map_get(statement_name, "text"));
    map_set(node, "value_kind", value_kind);
    map_set(node, "value", assignment_value);
    ast_finish(node, semicolon);
    return node;
}

/// Return whether parentheses enclose the complete following condition.
fn parser_condition_parenthesized(parser) {
    tokens := map_get(parser, "tokens");
    position := map_get(parser, "position");
    if map_get(list_get(tokens, position), "text") != "(" {
        return false;
    }
    depth := 0;
    while position < list_length(tokens) {
        text := map_get(list_get(tokens, position), "text");
        if text == "(" {
            depth = depth + 1;
        }
        if text == ")" {
            depth = depth - 1;
            if depth == 0 {
                return map_get(list_get(tokens, position + 1), "text") == "{";
            }
        }
        position = position + 1;
    }
    return false;
}

/// Parse a boolean condition ending at the following block.
fn parser_condition(parser) {
    start := parser_token(parser);
    if map_get(parser, "warn") && parser_condition_parenthesized(parser) {
        diagnostic_warn(start, "unnecessary condition parentheses");
    }
    condition := parser_expression(parser);
    if map_get(condition, "value_kind") != "boolean" && map_get(condition, "value_kind") != "unknown" {
        parser_fail(start, "condition must be boolean");
    }
    return condition;
}

/// Parse a braced block with copied binding and declaration scopes.
fn parser_block(parser) {
    open := parser_token(parser);
    parser_expect(parser, "{");
    outer := map_get(parser, "variables");
    outer_declared := map_get(parser, "declared");
    map_set(parser, "variables", map_copy(outer));
    map_set(parser, "declared", map_new());
    map_set(parser, "depth", map_get(parser, "depth") + 1);
    last_statement := 0;
    statements := list_new();
    while map_get(parser_token(parser), "text") != "}" && map_get(parser_token(parser), "kind") != "eof" {
        statement := parser_statement(parser);
        last_statement = statement;
        list_set(statements, list_length(statements), statement);
    }
    close := parser_token(parser);
    parser_expect(parser, "}");
    if map_get(parser, "depth") == 1 {
        map_set(
            parser,
            "block_ends_with_return",
            last_statement != 0 && map_get(last_statement, "node_kind") == AST_RETURN
        );
    }
    map_set(parser, "depth", map_get(parser, "depth") - 1);
    map_set(parser, "variables", outer);
    map_set(parser, "declared", outer_declared);
    node := ast_node(AST_BLOCK, open);
    map_set(node, "statements", statements);
    map_set(node, "ends_with_return", last_statement != 0 && map_get(last_statement, "node_kind") == AST_RETURN);
    ast_finish(node, close);
    return node;
}

/// Parse a top-level function declaration.
fn parser_function_declaration(parser) {
    token := parser_take(parser);
    if map_get(parser, "depth") != 0 {
        parser_fail(token, "functions must be top-level");
    }
    name := parser_identifier(parser, "expected function name");
    parser_expect(parser, "(");
    parameters := list_new();
    parameter_nodes := list_new();
    if map_get(parser_token(parser), "text") != ")" {
        first_parameter := parser_identifier(parser, "expected parameter name");
        list_set(parameters, list_length(parameters), map_get(first_parameter, "text"));
        first_node := ast_node(AST_NAME, first_parameter);
        map_set(first_node, "name", map_get(first_parameter, "text"));
        map_set(first_node, "role", "parameter");
        list_set(parameter_nodes, list_length(parameter_nodes), first_node);
        while map_get(parser_token(parser), "text") == "," {
            parser_take(parser);
            next_parameter := parser_identifier(parser, "expected parameter name");
            list_set(parameters, list_length(parameters), map_get(next_parameter, "text"));
            next_node := ast_node(AST_NAME, next_parameter);
            map_set(next_node, "name", map_get(next_parameter, "text"));
            map_set(next_node, "role", "parameter");
            list_set(parameter_nodes, list_length(parameter_nodes), next_node);
        }
    }
    parser_expect(parser, ")");
    info := map_get(map_get(parser, "functions"), map_get(name, "text"));
    map_set(parser, "current", info);
    map_set(parser, "in_function", true);
    outer := map_get(parser, "variables");
    map_set(parser, "variables", map_copy(outer));
    position := 0;
    while position < list_length(parameters) {
        map_set(map_get(parser, "variables"), list_get(parameters, position), "unknown");
        position = position + 1;
    }
    map_set(parser, "block_ends_with_return", false);
    body := parser_block(parser);
    map_set(parser, "variables", outer);
    map_set(parser, "in_function", false);
    node := ast_node(AST_FUNCTION, token);
    map_set(node, "name", map_get(name, "text"));
    map_set(node, "parameters", parameter_nodes);
    map_set(node, "body", body);
    map_set(node, "captures_arguments", map_get(info, "captures"));
    map_set(node, "result_kind", map_get(info, "result"));
    map_set(node, "has_final_return", map_get(body, "ends_with_return"));
    ast_finish_node(node, body);
    return node;
}

/// Return canonical file identity when imports supplied it, otherwise source identity.
fn parser_file_key(token) {
    if map_has(token, "file") {
        return map_get(token, "file");
    }
    return map_get(token, "source");
}

/// Register a file once, ordered after its dependencies for execution.
/// Validation still follows the original expanded token/declaration order.
fn parser_file_register(order, priorities, token) {
    file := parser_file_key(token);
    if !map_has(priorities, file) {
        priority := 0;
        if map_has(token, "file_order") {
            priority = map_get(token, "file_order");
        }
        index := list_length(order);
        while index > 0 && map_get(priorities, list_get(order, index - 1)) > priority {
            list_set(order, index, list_get(order, index - 1));
            index = index - 1;
        }
        list_set(order, index, file);
        map_set(priorities, file, priority);
    }
    return file;
}

/// Parse the token list into a checked program AST.
fn parser_program(parser) {
    has_shebang := false;
    if map_get(parser_token(parser), "kind") == "shebang" {
        parser_take(parser);
        has_shebang = true;
    }
    order := list_new();
    priorities := map_new();
    ast_body := list_new();
    tokens := map_get(parser, "tokens");
    main_source := map_get(list_get(tokens, list_length(tokens) - 1), "source");
    while map_get(parser_token(parser), "kind") != "eof" {
        token := parser_token(parser);
        statement := parser_statement(parser);
        list_set(ast_body, list_length(ast_body), statement);
        parser_file_register(order, priorities, token);
    }
    program := ast_node(AST_PROGRAM, list_get(tokens, 0));
    map_set(program, "ast_schema_version", AST_SCHEMA_VERSION);
    map_set(program, "body", ast_body);
    map_set(program, "files", order);
    map_set(program, "main_source", main_source);
    map_set(program, "has_shebang", has_shebang);
    map_set(program, "tokens", tokens);
    ast_finish(program, list_get(tokens, list_length(tokens) - 1));
    return program;
}

/// Return a parser state with pre-registered top-level function signatures.
fn parser_new(tokens) {
    parser := map_new();
    map_set(parser, "tokens", tokens);
    map_set(parser, "position", 0);
    map_set(parser, "variables", map_new());
    map_set(parser, "functions", map_new());
    map_set(parser, "declared", map_new());
    map_set(parser, "warn", true);
    map_set(parser, "depth", 0);
    map_set(parser, "in_function", false);
    map_set(parser, "current", map_new());
    depth := 0;
    index := 0;
    while index < list_length(tokens) {
        token := list_get(tokens, index);
        if map_get(token, "text") == "{" {
            depth = depth + 1;
        }
        if map_get(token, "text") == "}" {
            depth = depth - 1;
        }
        if depth == 0 && map_get(token, "kind") == "identifier"
            && map_get(list_get(tokens, index + 1), "text") == ":=" {
            map_set(map_get(parser, "variables"), map_get(token, "text"), "unknown");
        }
        if depth == 0 && map_get(token, "text") == "fn" && map_get(list_get(tokens, index + 1), "kind") == "identifier" {
            arity := 0;
            cursor := index + 3;
            while cursor < list_length(tokens) && map_get(list_get(tokens, cursor), "text") != ")" && map_get(
                list_get(
                    tokens,
                    cursor
                ),
                "text"
            ) != "{" {
                if map_get(list_get(tokens, cursor), "kind") == "identifier" {
                    arity = arity + 1;
                }
                cursor = cursor + 1;
            }
            info := map_new();
            map_set(info, "arity", arity);
            map_set(info, "result", "unknown");
            map_set(info, "captures", false);
            map_set(info, "file", parser_file_key(token));
            map_set(map_get(parser, "functions"), map_get(list_get(tokens, index + 1), "text"), info);
        }
        index = index + 1;
    }
    return parser;
}

/// Parse and check a token list into a shared target-neutral program AST.
fn parser_ast(tokens) {
    return parser_program(parser_new(tokens));
}

/// Parse and check a token list into a shared AST without condition warnings.
fn parser_ast_quiet(tokens) {
    parser := parser_new(tokens);
    map_set(parser, "warn", false);
    return parser_program(parser);
}
