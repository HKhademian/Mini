include "./lexer.mini";
include "./builtins.mini";
/// Report a parser/checker diagnostic.
fn parser_fail(token, message) {
    return diagnostic_fail(token, message);
}

/// Return an expression map with emitted code and kind.
fn parser_expression_new(code, kind) {
    expression := map_new();
    map_set(expression, "code", code);
    map_set(expression, "kind", kind);
    return expression;
}

/// Return the current parser token.
fn parser_token(parser) {
    return list_get(map_get(parser, "tokens"), map_get(parser, "position"));
}

/// Return a token offset from the current parser position.
fn parser_peek(parser, offset) {
    return list_get(map_get(parser, "tokens"), map_get(parser, "position") + offset);
}

/// Return the current token and advance.
fn parser_take(parser) {
    token := parser_token(parser);
    map_set(parser, "position", map_get(parser, "position") + 1);
    return token;
}

/// Consume required punctuation or report a diagnostic.
fn parser_expect(parser, text) {
    if map_get(parser_token(parser), "text") != text {
        parser_fail(parser_token(parser), "expected " + text);
    }
    parser_take(parser);
    return 0;
}

/// Consume an identifier or report the selected diagnostic.
fn parser_identifier(parser, message) {
    if map_get(parser_token(parser), "kind") != "identifier" {
        parser_fail(parser_token(parser), message);
    }
    return parser_take(parser);
}

/// Parse logical disjunction.
fn parser_expression(parser) {
    left := parser_conjunction(parser);
    while map_get(parser_token(parser), "text") == "||" {
        operator := parser_take(parser);
        right := parser_conjunction(parser);
        if (map_get(left, "kind") != "boolean" && map_get(left, "kind") != "unknown")
            || (map_get(right, "kind") != "boolean" && map_get(right, "kind") != "unknown") {
            parser_fail(operator, "|| needs booleans");
        }
        left = parser_expression_new("(" + map_get(left, "code") + " || " + map_get(right, "code") + ")", "boolean");
    }
    return left;
}

/// Parse logical conjunction.
fn parser_conjunction(parser) {
    left := parser_equality(parser);
    while map_get(parser_token(parser), "text") == "&&" {
        operator := parser_take(parser);
        right := parser_equality(parser);
        if (map_get(left, "kind") != "boolean" && map_get(left, "kind") != "unknown")
            || (map_get(right, "kind") != "boolean" && map_get(right, "kind") != "unknown") {
            parser_fail(operator, "&& needs booleans");
        }
        left = parser_expression_new("(" + map_get(left, "code") + " && " + map_get(right, "code") + ")", "boolean");
    }
    return left;
}

/// Parse scalar equality and inequality.
fn parser_equality(parser) {
    left := parser_comparison(parser);
    while map_get(parser_token(parser), "text") == "==" || map_get(parser_token(parser), "text") == "!=" {
        operator := parser_take(parser);
        right := parser_comparison(parser);
        left_kind := map_get(left, "kind");
        right_kind := map_get(right, "kind");
        if left_kind == "list" || right_kind == "list"
            || left_kind == "map" || right_kind == "map"
            || (left_kind != "unknown" && right_kind != "unknown" && left_kind != right_kind) {
            parser_fail(operator, "equality needs matching scalar kinds");
        }
        symbol := "===";
        if map_get(operator, "text") == "!=" {
            symbol = "!==";
        }
        left = parser_expression_new("(" + map_get(left, "code") + " " + symbol + " " + map_get(right, "code") + ")", "boolean");
    }
    return left;
}

/// Parse numeric comparisons.
fn parser_comparison(parser) {
    left := parser_additive(parser);
    while map_get(parser_token(parser), "text") == "<" || map_get(parser_token(parser), "text") == "<="
        || map_get(parser_token(parser), "text") == ">" || map_get(parser_token(parser), "text") == ">=" {
        operator := parser_take(parser);
        right := parser_additive(parser);
        if (map_get(left, "kind") != "number" && map_get(left, "kind") != "unknown")
            || (map_get(right, "kind") != "number" && map_get(right, "kind") != "unknown") {
            parser_fail(operator, "comparison needs numbers");
        }
        left = parser_expression_new("(" + map_get(left, "code") + " " + map_get(operator, "text") + " " + map_get(right, "code") + ")", "boolean");
    }
    return left;
}

/// Return whether kind can participate in addition.
fn parser_additive_kind(kind) {
    return kind == "number" || kind == "text" || kind == "unknown";
}

/// Parse numeric addition/subtraction and text concatenation.
fn parser_additive(parser) {
    left := parser_unary(parser);
    while map_get(parser_token(parser), "text") == "+" || map_get(parser_token(parser), "text") == "-" {
        operator := parser_take(parser);
        right := parser_unary(parser);
        left_kind := map_get(left, "kind");
        right_kind := map_get(right, "kind");
        if map_get(operator, "text") == "-" {
            if (left_kind != "number" && left_kind != "unknown")
                || (right_kind != "number" && right_kind != "unknown") {
                parser_fail(operator, "- needs two numbers");
            }
        } else {
            if !parser_additive_kind(left_kind) || !parser_additive_kind(right_kind)
                || (left_kind != "unknown" && right_kind != "unknown" && left_kind != right_kind) {
                parser_fail(operator, "+ needs two numbers or two texts");
            }
        }
        result_kind := left_kind;
        if left_kind == "unknown" {
            result_kind = right_kind;
        }
        left = parser_expression_new("(" + map_get(left, "code") + " " + map_get(operator, "text") + " " + map_get(right, "code") + ")", result_kind);
    }
    return left;
}

/// Parse boolean negation and negative number literals.
fn parser_unary(parser) {
    if map_get(parser_token(parser), "text") == "-" {
        operator := parser_take(parser);
        number := parser_token(parser);
        if map_get(number, "kind") != "number" {
            parser_fail(operator, "- must precede a number literal");
        }
        parser_take(parser);
        return parser_expression_new("(-" + lex_normalize_number(map_get(number, "text")) + ")", "number");
    }
    if map_get(parser_token(parser), "text") == "!" {
        operator := parser_take(parser);
        value := parser_unary(parser);
        kind := "boolean";
        if map_get(value, "kind") != kind && map_get(value, "kind") != "unknown" {
            parser_fail(operator, map_get(operator, "text") + " needs a " + kind);
        }
        return parser_expression_new("(" + map_get(operator, "text") + map_get(value, "code") + ")", kind);
    }
    return parser_primary(parser);
}

/// Return normalized decimal text for a digit-only literal.
fn lex_normalize_number(text) {
    position := 0;
    while position < text_length(text) && text_get(text, position) == "0" {
        position = position + 1;
    }
    if position == text_length(text) {
        return "0";
    }
    return text_slice(text, position, text_length(text));
}

/// Parse literals, bindings, calls, and parenthesized expressions.
fn parser_primary(parser) {
    token := parser_take(parser);
    if map_get(token, "text") == "(" {
        value := parser_expression(parser);
        parser_expect(parser, ")");
        return value;
    }
    if map_get(token, "kind") == "number" {
        return parser_expression_new(lex_normalize_number(map_get(token, "text")), "number");
    }
    if map_get(token, "kind") == "text" {
        return parser_expression_new(map_get(token, "text"), "text");
    }
    if map_get(token, "text") == "true" || map_get(token, "text") == "false" {
        return parser_expression_new(map_get(token, "text"), "boolean");
    }
    if map_get(token, "kind") == "identifier" && map_get(token, "text") == "fn_args" {
        return parser_fn_args(parser, token);
    }
    if map_get(token, "kind") == "identifier" && map_get(parser_token(parser), "text") == "(" {
        return parser_call(parser, token);
    }
    if map_get(token, "kind") == "identifier" && map_has(map_get(parser, "variables"), map_get(token, "text")) {
        return parser_expression_new(map_get(token, "text"), map_get(map_get(parser, "variables"), map_get(token, "text")));
    }
    parser_fail(token, "expected expression");
    return parser_expression_new("", "unknown");
}

/// Return the supplied arguments of the current context as a list.
///
/// Top level means the process. The invoked name and the node entry are
/// munched there, so the result is the program arguments in every invocation
/// shape. Any other position means the enclosing call: every supplied argument
/// is included, even beyond the declared parameters.
fn parser_fn_args(parser, token) {
    parser_expect(parser, "(");
    parser_expect(parser, ")");
    if !map_get(parser, "in_function") {
        return parser_expression_new("process.argv.slice(2)", "list");
    }
    map_set(map_get(parser, "current"), "captures", true);
    return parser_expression_new("$mini_fn_args", "list");
}

/// Return argument code texts.
fn parser_argument_code_list(args) {
    codes := list_new();
    position := 0;
    while position < list_length(args) {
        list_set(codes, list_length(codes), map_get(list_get(args, position), "code"));
        position = position + 1;
    }
    return codes;
}

/// Return argument code text joined by comma-space.
fn parser_argument_codes(args) {
    return list_join(parser_argument_code_list(args), ", ");
}

/// Parse a call and apply builtin metadata or a user signature.
fn parser_call(parser, name) {
    name_text := map_get(name, "text");
    is_builtin := builtin_exists(name_text);
    functions := map_get(parser, "functions");
    has_user := map_has(functions, name_text);
    if !is_builtin && !has_user {
        parser_fail(name, "unknown function " + name_text);
    }
    parser_expect(parser, "(");
    args := list_new();
    if map_get(parser_token(parser), "text") != ")" {
        list_set(args, list_length(args), parser_expression(parser));
        while map_get(parser_token(parser), "text") == "," {
            parser_take(parser);
            list_set(args, list_length(args), parser_expression(parser));
        }
    }
    parser_expect(parser, ")");
    if is_builtin {
        // Builtin arity is part of the host contract, so it stays exact.
        arity := list_length(builtin_parameters(name_text));
        variadic := arity > 0 && text_slice(list_get(builtin_parameters(name_text), arity - 1), 0, 3) == "...";
        fixed_arity := arity;
        if variadic {
            fixed_arity = arity - 1;
        }
        if (!variadic && list_length(args) != arity) || (variadic && list_length(args) < fixed_arity) {
            suffix := "s";
            if (variadic && fixed_arity == 1) || (!variadic && arity == 1) {
                suffix = "";
            }
            message := "expected " + number_to_text(arity) + " argument" + suffix;
            if variadic {
                message = "expected " + number_to_text(fixed_arity) + " or more argument" + suffix;
            }
            parser_fail(name, message);
        }
    } else {
        // User calls pad missing arguments with 0. Extra arguments reach the
        // callee, where declared parameters ignore them and fn_args() sees all.
        arity := map_get(map_get(functions, name_text), "arity");
        while list_length(args) < arity {
            list_set(args, list_length(args), parser_expression_new("0", "number"));
        }
    }
    if !is_builtin {
        return parser_expression_new(name_text + "(" + parser_argument_codes(args) + ")", map_get(map_get(functions, name_text), "result"));
    }
    parameters := builtin_parameters(name_text);
    position := 0;
    while position < list_length(parameters) {
        kind := list_get(parameters, position);
        if text_slice(kind, 0, 3) != "..." {
            actual := map_get(list_get(args, position), "kind");
            if kind != "unknown" && kind != "any_value" && actual != "unknown" && actual != kind {
                parser_fail(name, "expected " + kind + " argument");
            }
        }
        position = position + 1;
    }
    imports := builtin_imports(name_text);
    position = 0;
    while position < list_length(imports) {
        map_set(map_get(parser, "imports"), list_get(imports, position), true);
        position = position + 1;
    }
    helper := builtin_helper_key(name_text);
    if helper != "" {
        map_set(map_get(parser, "helpers"), helper, true);
    }
    if name_text == "io_write" || name_text == "to_text" {
        map_set(map_get(parser, "helpers"), builtin_helper_key("number_to_text"), true);
        map_set(map_get(parser, "helpers"), builtin_helper_key("json_to_text"), true);
    }
    if name_text == "io_write" {
        map_set(map_get(parser, "helpers"), builtin_helper_key("to_text"), true);
    }
    if name_text == "json_to_text" {
        map_set(map_get(parser, "helpers"), builtin_helper_key("number_to_text"), true);
    }
    return parser_expression_new(builtin_emit(name_text, parser_argument_code_list(args)), builtin_result(name_text));
}

/// Parse a statement and return emitted TypeScript.
fn parser_statement(parser) {
    if map_get(parser_token(parser), "text") == "while" {
        parser_take(parser);
        while_condition := parser_condition(parser);
        return "while (" + map_get(while_condition, "code") + ") " + parser_block(parser) + "\n";
    }
    if map_get(parser_token(parser), "text") == "if" {
        parser_take(parser);
        if_condition := parser_condition(parser);
        output := "if (" + map_get(if_condition, "code") + ") " + parser_block(parser);
        if map_get(parser_token(parser), "text") == "else" {
            parser_take(parser);
            if map_get(parser_token(parser), "text") == "if" {
                return output + " else " + parser_statement(parser);
            }
            output = output + " else " + parser_block(parser);
        }
        return output + "\n";
    }
    if map_get(parser_token(parser), "text") == "fn" {
        return parser_function_declaration(parser);
    }
    if map_get(parser_token(parser), "text") == "return" {
        return_token := parser_take(parser);
        if !map_get(parser, "in_function") {
            parser_fail(return_token, "return outside function");
        }
        return_value := parser_expression(parser);
        parser_expect(parser, ";");
        map_set(map_get(parser, "current"), "result", map_get(return_value, "kind"));
        return "return " + map_get(return_value, "code") + ";\n";
    }
    if map_get(parser_token(parser), "kind") == "identifier" && map_get(parser_peek(parser, 1), "text") == "(" {
        call_value := parser_expression(parser);
        parser_expect(parser, ";");
        return map_get(call_value, "code") + ";\n";
    }
    variables := map_get(parser, "variables");
    statement_name := parser_identifier(parser, "expected binding name");
    if map_get(parser_token(parser), "text") == ":=" {
        parser_take(parser);
        if map_has(map_get(parser, "declared"), map_get(statement_name, "text")) {
            parser_fail(statement_name, "duplicate binding " + map_get(statement_name, "text"));
        }
        declaration_value := parser_expression(parser);
        parser_expect(parser, ";");
        map_set(variables, map_get(statement_name, "text"), map_get(declaration_value, "kind"));
        map_set(map_get(parser, "declared"), map_get(statement_name, "text"), true);
        if map_get(parser, "emit_helpers") && map_get(parser, "depth") == 0 && !map_get(parser, "in_function") {
            map_set(parser, "globals", map_get(parser, "globals") + "let " + map_get(statement_name, "text") + ";\n");
            return map_get(statement_name, "text") + " = " + map_get(declaration_value, "code") + ";\n";
        }
        return "let " + map_get(statement_name, "text") + " = " + map_get(declaration_value, "code") + ";\n";
    }
    if !map_has(variables, map_get(statement_name, "text")) {
        parser_fail(statement_name, "unknown binding " + map_get(statement_name, "text"));
    }
    parser_expect(parser, "=");
    assignment_value := parser_expression(parser);
    parser_expect(parser, ";");
    map_set(variables, map_get(statement_name, "text"), map_get(assignment_value, "kind"));
    return map_get(statement_name, "text") + " = " + map_get(assignment_value, "code") + ";\n";
}

/// Return whether parentheses enclose the complete following condition.
fn parser_condition_parenthesized(parser) {
    tokens := map_get(parser, "tokens");
    position := map_get(parser, "position");
    if map_get(list_get(tokens, position), "text") != "(" {
        return false;
    }
    depth := 0;
    while position < list_length(tokens) {
        text := map_get(list_get(tokens, position), "text");
        if text == "(" {
            depth = depth + 1;
        }
        if text == ")" {
            depth = depth - 1;
            if depth == 0 {
                return map_get(list_get(tokens, position + 1), "text") == "{";
            }
        }
        position = position + 1;
    }
    return false;
}

/// Parse a boolean condition ending at the following block.
fn parser_condition(parser) {
    start := parser_token(parser);
    if map_get(parser, "warn") && parser_condition_parenthesized(parser) {
        diagnostic_warn(start, "unnecessary condition parentheses");
    }
    condition := parser_expression(parser);
    if map_get(condition, "kind") != "boolean" && map_get(condition, "kind") != "unknown" {
        parser_fail(start, "condition must be boolean");
    }
    return condition;
}

/// Parse a braced block with copied binding and declaration scopes.
fn parser_block(parser) {
    parser_expect(parser, "{");
    outer := map_get(parser, "variables");
    outer_declared := map_get(parser, "declared");
    map_set(parser, "variables", map_copy(outer));
    map_set(parser, "declared", map_new());
    map_set(parser, "depth", map_get(parser, "depth") + 1);
    output := "";
    last_statement := "";
    while map_get(parser_token(parser), "text") != "}" && map_get(parser_token(parser), "kind") != "eof" {
        last_statement = parser_statement(parser);
        output = output + last_statement;
    }
    parser_expect(parser, "}");
    if map_get(parser, "depth") == 1 {
        map_set(parser, "block_ends_with_return", text_starts_with(last_statement, "return "));
    }
    map_set(parser, "depth", map_get(parser, "depth") - 1);
    map_set(parser, "variables", outer);
    map_set(parser, "declared", outer_declared);
    indented := indent_output(output);
    if indented == "" {
        return "{\n}";
    }
    return "{\n" + indented + "\n}";
}

/// Parse a top-level function declaration.
fn parser_function_declaration(parser) {
    token := parser_take(parser);
    if map_get(parser, "depth") != 0 {
        parser_fail(token, "functions must be top-level");
    }
    name := parser_identifier(parser, "expected function name");
    parser_expect(parser, "(");
    parameters := list_new();
    if map_get(parser_token(parser), "text") != ")" {
        list_set(parameters, list_length(parameters), map_get(parser_identifier(parser, "expected parameter name"), "text"));
        while map_get(parser_token(parser), "text") == "," {
            parser_take(parser);
            list_set(parameters, list_length(parameters), map_get(parser_identifier(parser, "expected parameter name"), "text"));
        }
    }
    parser_expect(parser, ")");
    info := map_get(map_get(parser, "functions"), map_get(name, "text"));
    map_set(parser, "current", info);
    map_set(parser, "in_function", true);
    outer := map_get(parser, "variables");
    map_set(parser, "variables", map_copy(outer));
    position := 0;
    while position < list_length(parameters) {
        map_set(map_get(parser, "variables"), list_get(parameters, position), "unknown");
        position = position + 1;
    }
    map_set(parser, "block_ends_with_return", false);
    body := parser_block(parser);
    map_set(parser, "variables", outer);
    map_set(parser, "in_function", false);
    if !map_get(parser, "block_ends_with_return") {
        body = text_slice(body, 0, text_length(body) - 1)
            + "    return 0;\n}";
    }
    capture := "";
    if map_get(info, "captures") {
        capture = "    const $mini_fn_args = Array.prototype.slice.call(arguments);\n";
    }
    body = "{\n" + capture + text_slice(body, 1, text_length(body));
    return "function " + map_get(name, "text") + "(" + list_join(parameters, ", ") + ") " + body + "\n";
}

/// Return the fixed sorted import list used by the generated program.
fn parser_import_names(imports) {
    output := "";
    if map_has(imports, "readFileSync") {
        output = output + "readFileSync";
    }
    if map_has(imports, "writeFileSync") {
        if output != "" {
            output = output + ", ";
        }
        output = output + "writeFileSync";
    }
    if map_has(imports, "writeSync") {
        if output != "" {
            output = output + ", ";
        }
        output = output + "writeSync";
    }
    return output;
}

/// Return the used helper blocks in registration order.
fn parser_helper_blocks(helpers) {
    return builtin_used_helper_blocks(helpers);
}

/// Return canonical file identity when includes supplied it, otherwise source identity.
fn parser_file_key(token) {
    if map_has(token, "file") { return map_get(token, "file"); }
    return map_get(token, "source");
}

/// Register a file once, ordered after its dependencies for execution.
/// Validation still follows the original expanded token/declaration order.
fn parser_file_register(order, priorities, token) {
    file := parser_file_key(token);
    if !map_has(priorities, file) {
        priority := 0;
        if map_has(token, "file_order") { priority = map_get(token, "file_order"); }
        index := list_length(order);
        while index > 0 && map_get(priorities, list_get(order, index - 1)) > priority {
            list_set(order, index, list_get(order, index - 1));
            index = index - 1;
        }
        list_set(order, index, file);
        map_set(priorities, file, priority);
    }
    return file;
}

/// Parse the token list and return the complete TypeScript program.
fn parser_program(parser) {
    shebang := "";
    if map_get(parser_token(parser), "kind") == "shebang" {
        parser_take(parser);
        shebang = "#!/usr/bin/env node\n";
    }
    output := "";
    declarations := "";
    files := map_new();
    order := list_new();
    priorities := map_new();
    tokens := map_get(parser, "tokens");
    main_source := map_get(list_get(tokens, list_length(tokens) - 1), "source");
    while map_get(parser_token(parser), "kind") != "eof" {
        token := parser_token(parser);
        statement := parser_statement(parser);
        if map_get(parser, "emit_helpers") {
            file := parser_file_register(order, priorities, token);
            if !map_has(files, file) {
                map_set(files, file, "");
            }
            if map_get(token, "text") == "fn" {
                declarations = declarations + statement;
            } else {
                map_set(files, file, map_get(files, file) + statement);
            }
        } else if map_get(token, "source") == main_source {
            output = output + statement;
        }
    }
    imports := map_get(parser, "imports");
    import_text := "";
    if list_length(map_keys(imports)) > 0 {
        import_text = "import { " + parser_import_names(imports) + " } from \"node:fs\";\n";
    }
    helper_text := "";
    if map_get(parser, "emit_helpers") {
        helper_text = parser_helper_blocks(map_get(parser, "helpers"));
    }
    if map_get(parser, "emit_helpers") {
        calls := "";
        index := 0;
        while index < list_length(order) {
            name := "$mini_file_" + number_to_text(index);
            output = output + "function " + name + "() {\n"
                + indent_output(map_get(files, list_get(order, index))) + "\n}\n";
            calls = calls + "    " + name + "();\n";
            index = index + 1;
        }
        if list_length(order) > 0 {
            output = output + "function $mini_main() {\n" + calls + "}\n$mini_main();\n";
        }
        return shebang + "\"use strict\";\n" + import_text + helper_text + map_get(parser, "globals") + declarations + output;
    }
    return output;
}

/// Return a parser state with pre-registered top-level function signatures.
fn parser_new(tokens) {
    parser := map_new();
    map_set(parser, "tokens", tokens);
    map_set(parser, "globals", "");
    map_set(parser, "position", 0);
    map_set(parser, "variables", map_new());
    map_set(parser, "functions", map_new());
    map_set(parser, "declared", map_new());
    map_set(parser, "warn", true);
    map_set(parser, "imports", map_new());
    map_set(parser, "helpers", map_new());
    map_set(parser, "emit_helpers", true);
    map_set(parser, "depth", 0);
    map_set(parser, "in_function", false);
    map_set(parser, "current", map_new());
    depth := 0;
    index := 0;
    while index < list_length(tokens) {
        token := list_get(tokens, index);
        if map_get(token, "text") == "{" {
            depth = depth + 1;
        }
        if map_get(token, "text") == "}" {
            depth = depth - 1;
        }
        if depth == 0 && map_get(token, "text") == "fn" && map_get(list_get(tokens, index + 1), "kind") == "identifier" {
            arity := 0;
            cursor := index + 3;
            while cursor < list_length(tokens) && map_get(list_get(tokens, cursor), "text") != ")"
                && map_get(list_get(tokens, cursor), "text") != "{" {
                if map_get(list_get(tokens, cursor), "kind") == "identifier" {
                    arity = arity + 1;
                }
                cursor = cursor + 1;
            }
            info := map_new();
            map_set(info, "arity", arity);
            map_set(info, "result", "unknown");
            map_set(info, "captures", false);
            map_set(map_get(parser, "functions"), map_get(list_get(tokens, index + 1), "text"), info);
        }
        index = index + 1;
    }
    return parser;
}

/// Compile a token list into JavaScript text.
fn parser_compile(tokens) {
    return parser_program(parser_new(tokens));
}

/// Compile a token list without condition warnings.
fn parser_compile_quiet(tokens) {
    parser := parser_new(tokens);
    map_set(parser, "warn", false);
    return parser_program(parser);
}

/// Compile a token list without the helper block.
fn parser_compile_program(tokens) {
    parser := parser_new(tokens);
    map_set(parser, "emit_helpers", false);
    return parser_program(parser);
}

