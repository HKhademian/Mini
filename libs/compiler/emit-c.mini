/// C11 lowering for the initial literal-output target slice.
/// The shared parser validates the complete program before this bounded token
/// walk emits supported statements. Text views reference a growable byte buffer.

include "./parser.mini";

/// Reject a valid language form that the C target cannot lower yet.
fn emit_c_fail(token) {
    return diagnostic_fail(token, "C target supports only bindings and top-level io_write with literal or binding values");
}

/// Consume punctuation in the supported target shape, or reject that shape.
fn emit_c_expect(parser, text) {
    if map_get(parser_token(parser), "text") != text {
        emit_c_fail(parser_token(parser));
    }
    return parser_expect(parser, text);
}

/// Decode one lexer-validated ASCII literal to decimal byte initializer texts.
/// The decoded bytes are escaped into readable C string input later.
fn emit_c_literal_bytes(token) {
    spelling := map_get(token, "text");
    bytes := list_new();
    position := 1;
    while position < text_length(spelling) - 1 {
        character := text_get(spelling, position);
        code := text_code(character);
        if character == "\\" {
            position = position + 1;
            character = text_get(spelling, position);
            code = text_code(character);
            if character == "n" {
                code = 10;
            } else if character == "r" {
                code = 13;
            } else if character == "t" {
                code = 9;
            }
        }
        if code > 127 {
            diagnostic_fail(token, "C target supports only ASCII text literals");
        }
        list_set(bytes, list_length(bytes), number_to_text(code));
        position = position + 1;
    }
    return bytes;
}

/// Return an include guard using the companion header's filename.
fn emit_c_header_guard(name) {
    guard := "MINI_GENERATED_";
    position := 0;
    while position < text_length(name) {
        character := text_get(name, position);
        if is_identifier_part(character) {
            guard = guard + character;
        } else {
            guard = guard + "_";
        }
        position = position + 1;
    }
    return guard + "_INCLUDED";
}

/// Return a guarded companion header with direct names, initializers, and declarations.
fn emit_c_header(name) {
    guard := emit_c_header_guard(name);
    return "// Generated by the mini C target.\n#ifndef " + guard + "\n#define " + guard + "\n"
        + "#include <stddef.h>\n#include <float.h>\n\n#ifndef MINI_ID\n#define MINI_ID(name) mini_##name\n#endif\n\n"
        + "typedef double MINI_ID(number);\n_Static_assert(FLT_RADIX == 2 && DBL_MANT_DIG >= 53, \"mini requires binary numbers with at least 53 bits of precision\");\n\n"
        + "typedef enum { MINI_ID(kind_text), MINI_ID(kind_number), MINI_ID(kind_boolean) } MINI_ID(value_kind);\n"
        + "typedef struct {\n    unsigned char *data;\n    size_t length;\n    size_t capacity;\n} MINI_ID(text_buffer);\n"
        + "typedef struct {\n    MINI_ID(text_buffer) *buffer;\n    size_t offset;\n    size_t length;\n} MINI_ID(text);\n"
        + "typedef struct {\n    MINI_ID(value_kind) kind;\n    union { MINI_ID(text) text; MINI_ID(number) number; int boolean; };\n} MINI_ID(value);\n\n"
        + "typedef struct {\n    size_t count;\n    const MINI_ID(value) *args;\n} MINI_ID(params);\n\n"
        + "#define MINI_PARAMS(count_arg, args_arg) { .count = (count_arg), .args = (args_arg) }\n\n"
        + "MINI_ID(params) MINI_ID(params_make)(size_t count, const MINI_ID(value) *args);\n"
        + "#define MINI_VALUE_TEXT(buffer_arg, offset_arg, length_arg) { .kind = MINI_ID(kind_text), .text = { (buffer_arg), (offset_arg), (length_arg) } }\n\n"
        + "#define MINI_VALUE_NUMBER(number_arg) { .kind = MINI_ID(kind_number), .number = (number_arg) }\n\n"
        + "#define MINI_VALUE_BOOLEAN(boolean_arg) { .kind = MINI_ID(kind_boolean), .boolean = !!(boolean_arg) }\n\n"
        + "MINI_ID(value) MINI_ID(value_boolean)(int boolean);\n"
        + "MINI_ID(value) MINI_ID(value_number)(MINI_ID(number) number);\n"
        + "int MINI_ID(text_buffer_append)(MINI_ID(text_buffer) *buffer, const unsigned char *data, size_t length);\n"
        + "void MINI_ID(text_buffer_free)(MINI_ID(text_buffer) *buffer);\n"
        + "MINI_ID(value) MINI_ID(value_text)(MINI_ID(text_buffer) *buffer, size_t offset, size_t length);\n\n#endif\n";
}

/// Return the constructor definition using the static initializer as an expression.
fn emit_c_value_constructor() {
    return "MINI_ID(params) MINI_ID(params_make)(size_t count, const MINI_ID(value) *args) {\n"
        + "    return (MINI_ID(params)) MINI_PARAMS(count, args);\n}\n\n"
        + "MINI_ID(value) MINI_ID(value_boolean)(int boolean) {\n"
        + "    return (MINI_ID(value)) MINI_VALUE_BOOLEAN(boolean);\n}\n\n"
        + "MINI_ID(value) MINI_ID(value_number)(MINI_ID(number) number) {\n"
        + "    return (MINI_ID(value)) MINI_VALUE_NUMBER(number);\n}\n\n"
        + "int MINI_ID(text_buffer_append)(MINI_ID(text_buffer) *buffer, const unsigned char *data, size_t length) {\n"
        + "    if (!buffer || (length && !data) || length > SIZE_MAX - buffer->length) return 1;\n"
        + "    size_t required = buffer->length + length;\n"
        + "    if (required > buffer->capacity) {\n"
        + "        size_t capacity = buffer->capacity ? buffer->capacity : 16;\n"
        + "        while (capacity < required) {\n"
        + "            if (capacity > SIZE_MAX / 2) { capacity = required; break; }\n"
        + "            capacity *= 2;\n        }\n"
        + "        unsigned char *grown = malloc(capacity);\n"
        + "        if (!grown) return 1;\n"
        + "        if (buffer->length) memcpy(grown, buffer->data, buffer->length);\n"
        + "        if (length) memcpy(grown + buffer->length, data, length);\n"
        + "        free(buffer->data);\n        buffer->data = grown;\n        buffer->capacity = capacity;\n"
        + "    } else if (length) {\n        memmove(buffer->data + buffer->length, data, length);\n    }\n"
        + "    buffer->length = required;\n    return 0;\n}\n\n"
        + "void MINI_ID(text_buffer_free)(MINI_ID(text_buffer) *buffer) {\n"
        + "    if (!buffer) return;\n    free(buffer->data);\n"
        + "    *buffer = (MINI_ID(text_buffer)){0};\n}\n\n"
        + "MINI_ID(value) MINI_ID(value_text)(MINI_ID(text_buffer) *buffer, size_t offset, size_t length) {\n"
        + "    return (MINI_ID(value)) MINI_VALUE_TEXT(buffer, offset, length);\n}\n\n";
}

/// Return output using a parameter view that bundles the argument count/pointer.
/// Each source call prepares its arguments before invoking this helper.
fn emit_c_output_runtime() {
    return "static int MINI_ID(io_write_value)(MINI_ID(value) value) {\n"
        + "    if (value.kind == MINI_ID(kind_boolean))\n"
        + "        return fputs(value.boolean ? \"true\" : \"false\", stdout) == EOF ? 1 : 0;\n"
        + "    if (value.kind == MINI_ID(kind_number)) {\n"
        + "        MINI_ID(number) number = value.number;\n"
        + "        if (!(number >= -9007199254740991.0 && number <= 9007199254740991.0)) return 0;\n"
        + "        if ((MINI_ID(number))(int_least64_t)number != number) return 0;\n"
        + "        if (number == 0) return fputs(\"0\", stdout) == EOF ? 1 : 0;\n"
        + "        return fprintf(stdout, \"%.0f\", number) < 0 ? 1 : 0;\n    }\n"
        + "    if (value.kind != MINI_ID(kind_text)) return 1;\n"
        + "    MINI_ID(text_buffer) *buffer = value.text.buffer;\n"
        + "    if (!buffer || value.text.offset > buffer->length\n"
        + "        || value.text.length > buffer->length - value.text.offset) return 1;\n"
        + "    if (!value.text.length) return 0;\n"
        + "    return fwrite(buffer->data + value.text.offset, 1, value.text.length, stdout)\n"
        + "        == value.text.length ? 0 : 1;\n}\n\n"
        + "static int MINI_ID(io_write)(MINI_ID(params) params) {\n"
        + "    if (params.count && !params.args) return 1;\n"
        + "    for (size_t index = 0; index < params.count; ++index) {\n"
        + "        int status = MINI_ID(io_write_value)(params.args[index]);\n"
        + "        if (status != 0) return status;\n    }\n"
        + "    return 0;\n}\n\n";
}

/// Return a readable C string input, using fixed-width octal for other ASCII controls.
fn emit_c_literal_input(bytes) {
    output := "\"";
    position := 0;
    while position < list_length(bytes) {
        code := number_from_text(list_get(bytes, position));
        if code == 34 { output = output + "\\\""; }
        else if code == 92 { output = output + "\\\\"; }
        else if code == 63 { output = output + "\\?"; }
        else if code == 10 { output = output + "\\n"; }
        else if code == 13 { output = output + "\\r"; }
        else if code == 9 { output = output + "\\t"; }
        else if code >= 32 && code < 127 { output = output + text_from_code(code); }
        else {
            output = output + "\\" + number_to_text(number_div(code, 64))
                + number_to_text(number_mod(number_div(code, 8), 8)) + number_to_text(number_mod(code, 8));
        }
        position = position + 1;
    }
    return output + "\"";
}

/// Normalize decimal spelling and reject magnitude before host numeric rounding.
/// The location is the argument start, including its optional unary minus.
fn emit_c_number_literal(token, negative, location) {
    digits := lex_normalize_number(map_get(token, "text"));
    maximum := "9007199254740991";
    exceeds := text_length(digits) > text_length(maximum);
    if text_length(digits) == text_length(maximum) {
        position := 0;
        comparing := true;
        while position < text_length(digits) && comparing {
            digit := text_code(text_get(digits, position));
            limit := text_code(text_get(maximum, position));
            if digit != limit {
                exceeds = digit > limit;
                comparing = false;
            }
            position = position + 1;
        }
    }
    if exceeds { diagnostic_fail(location, "C target supports only safe integer literals"); }
    if negative { return "-" + digits + ".0"; }
    return digits + ".0";
}

/// Lower a supported literal or binding read into a destination value.
fn emit_c_binding_value(parser, bindings, binding_orders, destination) {
    token := parser_token(parser);
    body := "";
    if map_get(token, "text") == "true" || map_get(token, "text") == "false" {
        boolean := "0";
        if map_get(token, "text") == "true" { boolean = "1"; }
        body = "    " + destination + " = (MINI_ID(value)) MINI_VALUE_BOOLEAN(" + boolean + ");\n";
    } else if map_get(token, "kind") == "text" {
        bytes := emit_c_literal_bytes(token);
        count := number_to_text(list_length(bytes));
        body = "    if (MINI_ID(text_buffer_append)(buffer, (const unsigned char *) "
            + emit_c_literal_input(bytes) + ", " + count + ") != 0) return 1;\n"
            + "    " + destination + " = (MINI_ID(value)) MINI_VALUE_TEXT(buffer, buffer->length - " + count + ", " + count + ");\n";
    } else if map_get(token, "kind") == "identifier" && map_has(bindings, map_get(token, "text")) {
        binding_name := map_get(token, "text");
        if map_get(token, "file_order") < map_get(binding_orders, binding_name) {
            diagnostic_fail(token, "C target cannot read a binding before its file runs");
        }
        binding := map_get(bindings, binding_name);
        body = "    if (!context->initialized_" + binding + ") return 1;\n"
            + "    " + destination + " = context->binding_" + binding + ";\n";
    } else {
        negative := map_get(token, "text") == "-";
        if negative { parser_take(parser); }
        number := parser_token(parser);
        if map_get(number, "kind") != "number" { emit_c_fail(number); }
        spelling := emit_c_number_literal(number, negative, token);
        body = "    " + destination + " = (MINI_ID(value)) MINI_VALUE_NUMBER(" + spelling + ");\n";
    }
    parser_take(parser);
    return body;
}

/// Lower unary boolean negation and grouped expressions.
fn emit_c_unary(parser, bindings, binding_orders, destination) {
    token := parser_token(parser);
    if map_get(token, "text") == "!" {
        parser_take(parser);
        body := emit_c_unary(parser, bindings, binding_orders, destination);
        return body + "    if (" + destination + ".kind != MINI_ID(kind_boolean)) return 1;\n"
            + "    " + destination + ".boolean = !" + destination + ".boolean;\n";
    }
    if map_get(token, "text") == "(" {
        parser_take(parser);
        body := emit_c_disjunction(parser, bindings, binding_orders, destination);
        emit_c_expect(parser, ")");
        return body;
    }
    return emit_c_binding_value(parser, bindings, binding_orders, destination);
}

/// Lower addition in left-to-right order.
fn emit_c_addition(parser, bindings, binding_orders, destination) {
    body := emit_c_unary(parser, bindings, binding_orders, destination);
    while map_get(parser_token(parser), "text") == "+" {
        parser_take(parser);
        index := map_get(parser, "c_temp");
        map_set(parser, "c_temp", index + 1);
        right := "tmp" + number_to_text(index);
        body = body + "    MINI_ID(value) " + right + ";\n"
            + emit_c_unary(parser, bindings, binding_orders, right);
        map_set(parser, "c_add_used", true);
        body = body + "    if (MINI_ID(add)(buffer, &" + destination + ", " + right + ") != 0) return 1;\n";
    }
    return body;
}

/// Lower numeric ordering, then scalar equality, in source order.
fn emit_c_comparison(parser, bindings, binding_orders, destination, equality) {
    body := "";
    if equality { body = emit_c_comparison(parser, bindings, binding_orders, destination, false); }
    else { body = emit_c_addition(parser, bindings, binding_orders, destination); }
    op := map_get(parser_token(parser), "text");
    more := op == "<" || op == "<=" || op == ">" || op == ">=";
    if equality { more = op == "==" || op == "!="; }
    while more {
        parser_take(parser);
        index := map_get(parser, "c_temp");
        map_set(parser, "c_temp", index + 1);
        right := "tmp" + number_to_text(index);
        body = body + "    MINI_ID(value) " + right + ";\n";
        if equality {
            body = body + emit_c_comparison(parser, bindings, binding_orders, right, false);
            map_set(parser, "c_equal_used", true);
            expression := "MINI_ID(equal)(" + destination + ", " + right + ")";
            if op == "!=" { expression = "!" + expression; }
            body = body + "    " + destination + " = (MINI_ID(value)) MINI_VALUE_BOOLEAN(" + expression + ");\n";
        } else {
            body = body + emit_c_addition(parser, bindings, binding_orders, right);
            body = body + "    if (" + destination + ".kind != MINI_ID(kind_number) || " + right + ".kind != MINI_ID(kind_number)) return 1;\n"
                + "    " + destination + " = (MINI_ID(value)) MINI_VALUE_BOOLEAN(" + destination + ".number " + op + " " + right + ".number);\n";
        }
        op = map_get(parser_token(parser), "text");
        more = op == "<" || op == "<=" || op == ">" || op == ">=";
        if equality { more = op == "==" || op == "!="; }
    }
    return body;
}

/// Return scalar equality without text encoding or NUL-termination assumptions.
fn emit_c_equal_runtime() {
    return "static int MINI_ID(equal)(MINI_ID(value) left, MINI_ID(value) right) {\n"
        + "    if (left.kind != right.kind) return 0;\n"
        + "    if (left.kind == MINI_ID(kind_number)) return left.number == right.number;\n"
        + "    if (left.kind == MINI_ID(kind_boolean)) return !!left.boolean == !!right.boolean;\n"
        + "    if (left.kind != MINI_ID(kind_text)) return 0;\n"
        + "    MINI_ID(text) a = left.text, b = right.text;\n"
        + "    if (!a.buffer || !b.buffer || a.offset > a.buffer->length || b.offset > b.buffer->length\n"
        + "        || a.length > a.buffer->length - a.offset || b.length > b.buffer->length - b.offset) return 0;\n"
        + "    if (a.length != b.length) return 0;\n"
        + "    if (!a.length) return 1;\n"
        + "    return memcmp(a.buffer->data + a.offset, b.buffer->data + b.offset, a.length) == 0;\n}\n\n";
}

/// Lower conjunction or disjunction with lazy right operand evaluation.
fn emit_c_logical(parser, bindings, binding_orders, destination, operator) {
    body := "";
    if operator == "&&" { body = emit_c_comparison(parser, bindings, binding_orders, destination, true); }
    else { body = emit_c_logical(parser, bindings, binding_orders, destination, "&&"); }
    while map_get(parser_token(parser), "text") == operator {
        parser_take(parser);
        index := map_get(parser, "c_temp");
        map_set(parser, "c_temp", index + 1);
        right := "tmp" + number_to_text(index);
        condition := destination + ".boolean";
        if operator == "||" { condition = "!" + condition; }
        body = body + "    if (" + destination + ".kind != MINI_ID(kind_boolean)) return 1;\n"
            + "    if (" + condition + ") {\n        MINI_ID(value) " + right + ";\n";
        if operator == "&&" { body = body + emit_c_comparison(parser, bindings, binding_orders, right, true); }
        else { body = body + emit_c_logical(parser, bindings, binding_orders, right, "&&"); }
        body = body + "        if (" + right + ".kind != MINI_ID(kind_boolean)) return 1;\n"
            + "        " + destination + " = " + right + ";\n    }\n";
    }
    return body;
}

/// Lower a boolean or additive expression with Mini precedence.
fn emit_c_disjunction(parser, bindings, binding_orders, destination) {
    return emit_c_logical(parser, bindings, binding_orders, destination, "||");
}

/// Return number addition and text joining over invocation-owned storage.
fn emit_c_add_runtime() {
    return "static int MINI_ID(add)(MINI_ID(text_buffer) *buffer, MINI_ID(value) *left, MINI_ID(value) right) {\n"
        + "    if (left->kind == MINI_ID(kind_number) && right.kind == MINI_ID(kind_number)) {\n"
        + "        left->number += right.number;\n        return 0;\n    }\n"
        + "    if (left->kind != MINI_ID(kind_text) || right.kind != MINI_ID(kind_text)) return 1;\n"
        + "    MINI_ID(text) a = left->text, b = right.text;\n"
        + "    if (a.buffer != buffer || b.buffer != buffer || a.offset > buffer->length || b.offset > buffer->length\n"
        + "        || a.length > buffer->length - a.offset || b.length > buffer->length - b.offset) return 1;\n"
        + "    size_t start = buffer->length;\n"
        + "    if (a.length && MINI_ID(text_buffer_append)(buffer, buffer->data + a.offset, a.length)) return 1;\n"
        + "    if (b.length && MINI_ID(text_buffer_append)(buffer, buffer->data + b.offset, b.length)) return 1;\n"
        + "    *left = (MINI_ID(value)) MINI_VALUE_TEXT(buffer, start, buffer->length - start);\n"
        + "    return 0;\n}\n\n";
}

/// Wrap one file's operations using invocation-owned storage.
fn emit_c_file_function(index, body) {
    return "static int MINI_ID(file_" + number_to_text(index) + ")(MINI_ID(context) *context) {\n"
        + "    MINI_ID(text_buffer) *buffer = &context->buffer;\n    (void)buffer;\n" + body
        + "    return 0;\n}\n\n";
}

/// Lower a braced block with its own binding scope.
fn emit_c_block(parser, bindings, binding_orders) {
    emit_c_expect(parser, "{");
    scoped := map_copy(bindings);
    scoped_orders := map_copy(binding_orders);
    body := "";
    while map_get(parser_token(parser), "text") != "}" {
        body = body + emit_c_statement(parser, scoped, scoped_orders);
    }
    emit_c_expect(parser, "}");
    return body;
}

/// Lower one supported statement, including a conditional and scoped blocks.
fn emit_c_statement(parser, bindings, binding_orders) {
    token := parser_token(parser);
    body := "";
    binding_count := map_get(parser, "c_binding_count");
    declarations := map_get(parser, "c_declarations");
    if map_get(token, "text") == "if" || map_get(token, "text") == "while" {
        loop := map_get(token, "text") == "while";
        parser_take(parser);
        index := map_get(parser, "c_temp");
        map_set(parser, "c_temp", index + 1);
        number := number_to_text(index);
        condition := "tmp" + number;
        condition_body := emit_c_disjunction(parser, bindings, binding_orders, condition);
        fields := map_get(parser, "c_declarations") + "    int condition_status_" + number + ";\n    int condition_value_" + number + ";\n";
        map_set(parser, "c_declarations", fields);
        helper := "static int MINI_ID(condition_" + number + ")(MINI_ID(context) *context, int *result) {\n"
            + "    MINI_ID(text_buffer) *buffer = &context->buffer;\n    (void)buffer;\n"
            + "    MINI_ID(value) " + condition + ";\n" + condition_body
            + "    if (" + condition + ".kind != MINI_ID(kind_boolean)) return 1;\n"
            + "    *result = " + condition + ".boolean;\n    return 0;\n}\n\n";
        map_set(parser, "c_conditions", map_get(parser, "c_conditions") + helper);
        keyword := "if";
        if loop { keyword = "while"; }
        body = keyword + " ((context->condition_status_" + number + " = MINI_ID(condition_" + number
            + ")(context, &context->condition_value_" + number + ")) != 0 || context->condition_value_" + number + ") {\n"
            + "    if (context->condition_status_" + number + " != 0) return 1;\n";
        body = body + emit_c_block(parser, bindings, binding_orders) + "    }";
        if !loop && map_get(parser_token(parser), "text") == "else" {
            parser_take(parser);
            if map_get(parser_token(parser), "text") == "if" {
                body = body + " else " + emit_c_statement(parser, map_copy(bindings), map_copy(binding_orders));
                return body;
            }
            body = body + " else {\n" + emit_c_block(parser, bindings, binding_orders) + "    }";
        }
        return body + "\n";
    }
    operator := map_get(parser_peek(parser, 1), "text");
        if operator == ":=" || operator == "=" {
            binding_name := map_get(token, "text");
            if operator == ":=" {
                binding := number_to_text(binding_count);
                binding_count = binding_count + 1;
                map_set(parser, "c_binding_count", binding_count);
                declarations = declarations + "    MINI_ID(value) binding_" + binding + ";\n    int initialized_" + binding + ";\n";
            }
            binding := "";
            if operator == ":=" { binding = number_to_text(binding_count - 1); }
            else { binding = map_get(bindings, binding_name); }
            parser_take(parser);
            parser_take(parser);
            temporary := "tmp" + number_to_text(map_get(parser, "c_temp"));
            map_set(parser, "c_temp", map_get(parser, "c_temp") + 1);
            body = body + "    MINI_ID(value) " + temporary + ";\n"
                + emit_c_disjunction(parser, bindings, binding_orders, temporary)
                + "    context->binding_" + binding + " = " + temporary + ";\n";
            emit_c_expect(parser, ";");
            if operator == ":=" {
                map_set(bindings, binding_name, binding);
                map_set(binding_orders, binding_name, map_get(token, "file_order"));
            }
            if map_get(token, "file_order") < map_get(binding_orders, binding_name) {
                map_set(binding_orders, binding_name, map_get(token, "file_order"));
            }
            body = body + "    context->initialized_" + binding + " = 1;\n";
        } else {
            if map_get(token, "text") != "io_write" { emit_c_fail(token); }
            parser_take(parser);
            emit_c_expect(parser, "(");
            argument_name := "args" + number_to_text(map_get(parser, "c_temp"));
            map_set(parser, "c_temp", map_get(parser, "c_temp") + 1);
            argument_body := "";
            argument_count := 0;
            map_set(parser, "c_has_calls", true);
            if map_get(parser_token(parser), "text") != ")" {
                more := true;
                while more {
                    name := argument_name + "[" + number_to_text(argument_count) + "]";
                    argument_body = argument_body + emit_c_disjunction(parser, bindings, binding_orders, name);
                    argument_count = argument_count + 1;

                    more = map_get(parser_token(parser), "text") == ",";
                    if more { parser_take(parser); }
                }
            }
            emit_c_expect(parser, ")");
            emit_c_expect(parser, ";");
            argument_code := "(MINI_ID(params)) MINI_PARAMS(0, NULL)";
            if argument_count > 0 {
                body = body + "    MINI_ID(value) " + argument_name + "[" + number_to_text(argument_count) + "];\n" + argument_body;
                argument_code = "(MINI_ID(params)) MINI_PARAMS(" + number_to_text(argument_count) + ", " + argument_name + ")";
            }
            body = body + "    if (MINI_ID(io_write)(" + argument_code + ") != 0) return 1;\n";
        }
    map_set(parser, "c_declarations", declarations);
    return body;
}

/// Validate the complete program and lower the supported binding/output subset.
fn emit_c_compile(tokens, header_name) {
    parser_compile_quiet(tokens);
    parser := parser_new(tokens);
    map_set(parser, "c_temp", 0);
    map_set(parser, "c_add_used", false);
    map_set(parser, "c_equal_used", false);
    if map_get(parser_token(parser), "kind") == "shebang" { parser_take(parser); }
    files := "";
    calls := "";
    bodies := map_new();
    order := list_new();
    priorities := map_new();
    bindings := map_new();
    binding_orders := map_new();
    declarations := "";
    map_set(parser, "c_binding_count", 0);
    map_set(parser, "c_declarations", "");
    map_set(parser, "c_conditions", "");
    map_set(parser, "c_has_calls", false);
    while map_get(parser_token(parser), "kind") != "eof" {
        token := parser_token(parser);
        file := parser_file_register(order, priorities, token);
        if !map_has(bodies, file) { map_set(bodies, file, ""); }
        body := map_get(bodies, file);
        body = body + emit_c_statement(parser, bindings, binding_orders);
        map_set(bodies, file, body);
    }
    file_index := 0;
    while file_index < list_length(order) {
        file := list_get(order, file_index);
        files = files + emit_c_file_function(file_index, map_get(bodies, file));
        calls = calls + "    if (MINI_ID(file_" + number_to_text(file_index) + ")(&context) != 0) { status = 1; goto cleanup; }\n";
        file_index = file_index + 1;
    }
    runtime := "";
    if map_get(parser, "c_has_calls") { runtime = emit_c_output_runtime(); }
    if map_get(parser, "c_add_used") { runtime = runtime + emit_c_add_runtime(); }
    if map_get(parser, "c_equal_used") { runtime = runtime + emit_c_equal_runtime(); }
    return "// Generated by the mini C target.\n#include \"" + header_name + "\"\n#include <stdio.h>\n#include <stdint.h>\n#include <stdlib.h>\n#include <string.h>\n\n"
        + emit_c_value_constructor() + runtime
        + "typedef struct {\n    MINI_ID(text_buffer) buffer;\n" + map_get(parser, "c_declarations") + "} MINI_ID(context);\n\n"
        + map_get(parser, "c_conditions") + files + "int main(void) {\n    MINI_ID(context) context = {0};\n    int status = 0;\n" + calls
        + "    if (fflush(stdout) != 0) status = 1;\n    goto cleanup;\ncleanup:\n"
        + "    MINI_ID(text_buffer_free)(&context.buffer);\n    return status;\n}\n";
}
