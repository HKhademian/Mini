/// C11 lowering for the initial literal-output target slice.
/// The shared parser validates the complete program before this bounded token
/// walk emits supported statements. All text storage is static and length-based.

include "./parser.mini";

/// Return a name customized by the host's MINI_ID preprocessor macro.
fn c_identifier(name) {
    return "MINI_ID(" + name + ")";
}

/// Reject a valid language form that the C target cannot lower yet.
fn c_fail(token) {
    return diagnostic_fail(token, "C target supports only top-level io_write calls with text literals");
}

/// Consume punctuation in the supported target shape, or reject that shape.
fn c_expect(parser, text) {
    if map_get(parser_token(parser), "text") != text {
        c_fail(parser_token(parser));
    }
    return parser_expect(parser, text);
}

/// Decode one lexer-validated ASCII literal to decimal byte initializer texts.
/// Numeric initializers preserve embedded NUL/control bytes without C escapes.
fn c_literal_bytes(token) {
    spelling := map_get(token, "text");
    bytes := list_new();
    position := 1;
    while position < text_length(spelling) - 1 {
        character := text_get(spelling, position);
        code := text_code(character);
        if character == "\\" {
            position = position + 1;
            character = text_get(spelling, position);
            code = text_code(character);
            if character == "n" {
                code = 10;
            } else if character == "r" {
                code = 13;
            } else if character == "t" {
                code = 9;
            }
        }
        if code > 127 {
            diagnostic_fail(token, "C target supports only ASCII text literals");
        }
        list_set(bytes, list_length(bytes), number_to_text(code));
        position = position + 1;
    }
    return bytes;
}

/// Return an include guard using the companion header's filename.
fn c_header_guard(name) {
    guard := "MINI_GENERATED_";
    position := 0;
    while position < text_length(name) {
        character := text_get(name, position);
        if is_identifier_part(character) {
            guard = guard + character;
        } else {
            guard = guard + "_";
        }
        position = position + 1;
    }
    return guard + "_INCLUDED";
}

/// Return a guarded companion header with direct names, initializers, and declarations.
fn c_header(name) {
    guard := c_header_guard(name);
    return "// Generated by the mini C target.\n#ifndef " + guard + "\n#define " + guard + "\n"
        + "#include <stddef.h>\n\n#ifndef MINI_ID\n#define MINI_ID(name) mini_##name\n#endif\n\n"
        + "typedef enum { MINI_ID(kind_text) } MINI_ID(value_kind);\n"
        + "typedef struct {\n    const unsigned char *data;\n    size_t length;\n} MINI_ID(text);\n"
        + "typedef struct {\n    MINI_ID(value_kind) kind;\n    union { MINI_ID(text) text; };\n} MINI_ID(value);\n\n"
        + "#define MINI_VALUE_TEXT(data_arg, length_arg) { .kind = MINI_ID(kind_text), .text = { (data_arg), (length_arg) } }\n\n"
        + "MINI_ID(value) MINI_ID(value_text)(const unsigned char *data, size_t length);\n\n#endif\n";
}

/// Return the constructor definition using the static initializer as an expression.
fn c_value_constructor() {
    return "MINI_ID(value) MINI_ID(value_text)(const unsigned char *data, size_t length) {\n"
        + "    return (MINI_ID(value)) MINI_VALUE_TEXT(data, length);\n}\n\n";
}

/// Return the output helper only for programs that write literal values.
fn c_text_runtime() {
    return "static int MINI_ID(io_write)(MINI_ID(value) value) {\n"
        + "    if (value.kind != MINI_ID(kind_text)) return 1;\n"
        + "    return fwrite(value.text.data, 1, value.text.length, stdout)\n"
        + "        == value.text.length ? 0 : 1;\n}\n\n";
}

/// Validate through the shared parser, then lower literal output to C11.
/// Return complete C source; target rejection occurs before the caller writes it.
fn c_compile(tokens, header_name) {
    parser_compile_quiet(tokens);
    parser := parser_new(tokens);
    if map_get(parser_token(parser), "kind") == "shebang" {
        parser_take(parser);
    }
    declarations := "";
    body := "";
    literal_count := 0;
    write_name := c_identifier("io_write");
    while map_get(parser_token(parser), "kind") != "eof" {
        token := parser_token(parser);
        if map_get(parser_peek(parser, 1), "text") == ":=" {
            diagnostic_fail(token, "C target does not support bindings yet");
        }
        if map_get(token, "text") != "io_write" {
            c_fail(token);
        }
        parser_take(parser);
        c_expect(parser, "(");
        if map_get(parser_token(parser), "text") != ")" {
            more := true;
            while more {
                literal := parser_token(parser);
                if map_get(literal, "kind") != "text" {
                    c_fail(literal);
                }
                bytes := c_literal_bytes(literal);
                suffix := "literal_" + number_to_text(literal_count);
                name := c_identifier(suffix);
                bytes_name := c_identifier(suffix + "_bytes");
                initializer := list_join(bytes, ", ");
                if initializer == "" {
                    initializer = "0";
                }
                declarations = declarations + "static const unsigned char " + bytes_name + "[] = { " + initializer + " };\n"
                    + "static const MINI_ID(value) " + name + " = MINI_VALUE_TEXT("
                    + bytes_name + ", " + number_to_text(list_length(bytes)) + ");\n";
                body = body + "    if (" + write_name + "(" + name + ") != 0) return 1;\n";
                literal_count = literal_count + 1;
                parser_take(parser);
                more = map_get(parser_token(parser), "text") == ",";
                if more {
                    parser_take(parser);
                }
            }
        }
        c_expect(parser, ")");
        c_expect(parser, ";");
    }
    runtime := "";
    if literal_count > 0 {
        runtime = c_text_runtime();
        body = body + "    if (fflush(stdout) != 0) return 1;\n";
    }
    return "// Generated by the mini C target.\n#include \"" + header_name + "\"\n#include <stdio.h>\n\n"
        + c_value_constructor() + runtime + declarations + "\nint main(void) {\n" + body + "    return 0;\n}\n";
}
