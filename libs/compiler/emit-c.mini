/// Lower Mini's checked AST to C11 source and its companion header.
/// The parser owns syntax and shared name/kind checks; this module owns C
/// capability checks, syntax lowering, runtime fragments, and source assembly.
/// Text views reference a growable byte buffer owned by each program invocation.

import "common/text";
import "common/number";
import "common/list";
import "common/map";
import "./parser";
import "./emit-c/overrides/panic";
import "./emit-c/overrides/io";
import "./emit-c/overrides/file";
import "./emit-c/overrides/path";
import "./emit-c/overrides/list";
import "./emit-c/overrides/map";
import "./emit-c/overrides/value";
import "./emit-c/overrides/display";
import "./emit-c/overrides/text";
import "./emit-c/overrides/process";
import "./emit-c/overrides/operators";

/// Reject a valid language form that the C target cannot lower yet.
fn emit_c_fail(token) {
    message := "C target cannot lower this syntax or operation";
    if token != 0 && map_has(token, "node_kind") {
        message = message + " (unsupported " + map_get(token, "node_kind") + ")";
    }
    if token != 0 && map_has(token, "node_kind") {
        return diagnostic_fail(emit_c_ast_location(token), message);
    }
    return diagnostic_fail(token, message);
}

/// Reconstruct token spelling used by source-positioned diagnostics.
fn emit_c_ast_location(node) {
    location := map_copy(node);
    kind := map_get(node, "node_kind");
    text := "";
    if kind == AST_NAME {
        text = map_get(node, "name");
    } else if kind == AST_LITERAL {
        text = map_get(node, "raw");
    } else if kind == AST_BINARY || kind == AST_UNARY {
        text = map_get(node, "operator");
    } else if kind == AST_CALL {
        text = map_get(node, "callee");
    }
    map_set(location, "text", text);
    return location;
}

/// Return whether the C registry replaces a same-name Mini library definition.
fn emit_c_skip_host_definition(name) {
    return emit_c_host_function_exists(name);
}

/// Prefix nonempty generated-code lines by one nested C indentation level.
fn emit_c_indent(source) {
    lines := text_split(source, "\n");
    result := list_new();
    position := 0;
    while position < list_length(lines) {
        line := list_get(lines, position);
        if text_length(line) > 0 {
            list_set(result, list_length(result), "    " + line);
        } else {
            list_set(result, list_length(result), "");
        }
        position = position + 1;
    }
    return list_join("\n", result);
}

/// Decode one lexer-validated ASCII literal to decimal byte initializer texts.
/// The decoded bytes are escaped into readable C string input later.
fn emit_c_literal_bytes(token) {
    spelling := map_get(token, "text");
    bytes := list_new();
    position := 1;
    while position < text_length(spelling) - 1 {
        character := text_get(spelling, position);
        code := text_code(character);
        if character == "\\" {
            position = position + 1;
            character = text_get(spelling, position);
            code = text_code(character);
            if character == "n" {
                code = 10;
            } else if character == "r" {
                code = 13;
            } else if character == "t" {
                code = 9;
            }
        }
        if code > 127 {
            diagnostic_fail(token, "C target supports only ASCII text literals");
        }
        list_set(bytes, list_length(bytes), number_to_text(code));
        position = position + 1;
    }
    return bytes;
}

/// Return an include guard using the companion header's filename.
fn emit_c_header_guard(name) {
    guard := "MINI_GENERATED_";
    position := 0;
    while position < text_length(name) {
        character := text_get(name, position);
        if text_is_identifier_part(character) {
            guard = guard + character;
        } else {
            guard = guard + "_";
        }
        position = position + 1;
    }
    return guard + "_INCLUDED";
}

/// Join generated lines and encode terminal newlines as empty final lines.
fn emit_c_join_lines(lines, trailing_newlines) {
    length := list_length(lines);
    position := length;
    while position > 0 && list_get(lines, position - 1) == "" {
        position = position - 1;
    }
    existing := length - position;
    while existing > trailing_newlines {
        list_truncate(lines, list_length(lines) - 1);
        existing = existing - 1;
    }
    while existing < trailing_newlines {
        list_set(lines, list_length(lines), "");
        existing = existing + 1;
    }
    return list_join("\n", lines);
}

/// Return generic vector storage operations shared by lists and text buffers.
fn emit_c_vec_runtime() {
    return emit_c_join_lines(
        list_of(
            "void MINI_ID(vec_init)(MINI_ID(vec) *vec, size_t item_size) {",
            "    if (!vec || !item_size || (vec->item_size && vec->item_size != item_size)) abort();",
            "    vec->item_size = item_size;",
            "}",
            "",
            "void MINI_ID(vec_reserve)(MINI_ID(vec) *vec, size_t expected_count) {",
            "    if (!vec || !vec->item_size) abort();",
            "    size_t maximum = SIZE_MAX / vec->item_size;",
            "    if (expected_count > maximum) abort();",
            "    if (expected_count <= vec->capacity) return;",
            "    size_t capacity = vec->capacity ? vec->capacity : 8;",
            "    while (capacity < expected_count) {",
            "        if (capacity > maximum / 2) { capacity = expected_count; break; }",
            "        capacity *= 2;",
            "    }",
            "    unsigned char *grown = realloc(vec->items, capacity * vec->item_size);",
            "    if (!grown) abort();",
            "    vec->items = grown;",
            "    vec->capacity = capacity;",
            "}",
            "",
            "void MINI_ID(vec_append)(MINI_ID(vec) *vec, const void *items, size_t count) {",
            "    if (!vec || !vec->item_size || (count && !items) || count > SIZE_MAX - vec->count) abort();",
            "    if (count > SIZE_MAX / vec->item_size) abort();",
            "    size_t bytes = count * vec->item_size;",
            "    uintptr_t source = (uintptr_t)items, base = (uintptr_t)vec->items;",
            "    int aliases = bytes && vec->items && source >= base && source - base < vec->count * vec->item_size;",
            "    size_t source_offset = aliases ? (size_t)(source - base) : 0;",
            "    if (aliases && bytes > vec->count * vec->item_size - source_offset) abort();",
            "    size_t old_count = vec->count;",
            "    MINI_ID(vec_reserve)(vec, old_count + count);",
            "    if (aliases) items = vec->items + source_offset;",
            "    if (bytes) memmove(vec->items + old_count * vec->item_size, items, bytes);",
            "    vec->count = old_count + count;",
            "}",
            "",
            "void MINI_ID(vec_free)(MINI_ID(vec) *vec) {",
            "    if (!vec) return;",
            "    free(vec->items);",
            "    *vec = (MINI_ID(vec)){0};",
            "}"
        ),
        1
    );
}

/// Return a guarded companion header with direct names, initializers, and declarations.
fn emit_c_header(name) {
    guard := emit_c_header_guard(name);
    return emit_c_join_lines(
        list_of(
            "// Generated by the mini C target.",
            "#ifndef " + guard,
            "#define " + guard,
            "#include <stddef.h>",
            "#include <stdint.h>",
            "#include <stdlib.h>",
            "#include <float.h>",
            "",
            "#ifndef MINI_ID",
            "#define MINI_ID(name) mini_##name",
            "#endif",
            "",
            "typedef double MINI_ID(number);",
            "_Static_assert(FLT_RADIX == 2 && DBL_MANT_DIG >= 53, \"mini requires binary numbers with at least 53 bits of precision\");",
            "",
            "typedef enum { MINI_ID(kind_text), MINI_ID(kind_number), MINI_ID(kind_boolean), MINI_ID(kind_list) } MINI_ID(value_kind);",
            "typedef struct { unsigned char *items; size_t count; size_t capacity; size_t item_size; } MINI_ID(vec);",
            "typedef MINI_ID(vec) MINI_ID(text_buffer);",
            "typedef struct MINI_ID(list) MINI_ID(list);",
            "typedef struct {",
            "    MINI_ID(text_buffer) *buffer;",
            "    size_t offset;",
            "    size_t length;",
            "} MINI_ID(text);",
            "typedef struct {",
            "    MINI_ID(value_kind) kind;",
            "    union { MINI_ID(text) text; MINI_ID(number) number; int boolean; MINI_ID(list) *list; };",
            "} MINI_ID(value);",
            "struct MINI_ID(list) { MINI_ID(vec) values; };",
            "",
            "typedef struct {",
            "    size_t count;",
            "    const MINI_ID(value) *args;",
            "} MINI_ID(params);",
            "",
            "#define MINI_PARAMS(count_arg, args_arg) { .count = (count_arg), .args = (args_arg) }",
            "",
            "MINI_ID(params) MINI_ID(params_make)(size_t count, const MINI_ID(value) *args);",
            "#define MINI_VALUE_TEXT(buffer_arg, offset_arg, length_arg) { .kind = MINI_ID(kind_text), .text = { (buffer_arg), (offset_arg), (length_arg) } }",
            "",
            "#define MINI_VALUE_NUMBER(number_arg) { .kind = MINI_ID(kind_number), .number = (number_arg) }",
            "",
            "#define MINI_VALUE_BOOLEAN(boolean_arg) { .kind = MINI_ID(kind_boolean), .boolean = !!(boolean_arg) }",
            "",
            "#define MINI_VALUE_LIST(list_arg) { .kind = MINI_ID(kind_list), .list = (list_arg) }",
            "",
            "MINI_ID(value) MINI_ID(value_boolean)(int boolean);",
            "MINI_ID(value) MINI_ID(value_number)(MINI_ID(number) number);",
            "void MINI_ID(vec_init)(MINI_ID(vec) *vec, size_t item_size);",
            "void MINI_ID(vec_reserve)(MINI_ID(vec) *vec, size_t expected_count);",
            "void MINI_ID(vec_append)(MINI_ID(vec) *vec, const void *items, size_t count);",
            "void MINI_ID(vec_free)(MINI_ID(vec) *vec);",
            "int MINI_ID(text_buffer_append)(MINI_ID(text_buffer) *buffer, const unsigned char *data, size_t length);",
            "void MINI_ID(text_buffer_free)(MINI_ID(text_buffer) *buffer);",
            "MINI_ID(value) MINI_ID(value_text)(MINI_ID(text_buffer) *buffer, size_t offset, size_t length);",
            "",
            "#endif"
        ),
        1
    );
}

/// Return the constructor definition using the static initializer as an expression.
fn emit_c_value_constructor() {
    return emit_c_join_lines(
        list_of(
            "MINI_ID(params) MINI_ID(params_make)(size_t count, const MINI_ID(value) *args) {",
            "    return (MINI_ID(params)) MINI_PARAMS(count, args);",
            "}",
            "",
            "MINI_ID(value) MINI_ID(value_boolean)(int boolean) {",
            "    return (MINI_ID(value)) MINI_VALUE_BOOLEAN(boolean);",
            "}",
            "",
            "MINI_ID(value) MINI_ID(value_number)(MINI_ID(number) number) {",
            "    return (MINI_ID(value)) MINI_VALUE_NUMBER(number);",
            "}",
            "",
            "int MINI_ID(text_buffer_append)(MINI_ID(text_buffer) *buffer, const unsigned char *data, size_t length) {",
            "    if (!buffer || (length && !data) || length > SIZE_MAX - buffer->count) return 1;",
            "    if (!buffer->item_size) MINI_ID(vec_init)(buffer, sizeof(unsigned char));",
            "    if (buffer->item_size != sizeof(unsigned char)) return 1;",
            "    MINI_ID(vec_append)(buffer, data, length);",
            "    return 0;",
            "}",
            "",
            "void MINI_ID(text_buffer_free)(MINI_ID(text_buffer) *buffer) {",
            "    MINI_ID(vec_free)(buffer);",
            "}",
            "",
            "MINI_ID(value) MINI_ID(value_text)(MINI_ID(text_buffer) *buffer, size_t offset, size_t length) {",
            "    return (MINI_ID(value)) MINI_VALUE_TEXT(buffer, offset, length);",
            "}",
            ""
        ),
        1
    );
}

/// Return a readable C string input, using fixed-width octal for other ASCII controls.
fn emit_c_literal_input(bytes) {
    parts := list_of("\"");
    position := 0;
    while position < list_length(bytes) {
        code := number_from_text(list_get(bytes, position));
        if code == 34 {
            list_set(parts, list_length(parts), "\\\"");
        } else if code == 92 {
            list_set(parts, list_length(parts), "\\\\");
        } else if code == 63 {
            list_set(parts, list_length(parts), "\\?");
        } else if code == 10 {
            list_set(parts, list_length(parts), "\\n");
        } else if code == 13 {
            list_set(parts, list_length(parts), "\\r");
        } else if code == 9 {
            list_set(parts, list_length(parts), "\\t");
        } else if code >= 32 && code < 127 {
            list_set(parts, list_length(parts), text_from_code(code));
        } else {
            escaped := "\\" + number_to_text(number_div(code, 64)) + number_to_text(
                number_mod(
                    number_div(code, 8),
                    8
                )
            ) + number_to_text(number_mod(code, 8));
            list_set(parts, list_length(parts), escaped);
        }
        position = position + 1;
    }
    list_set(parts, list_length(parts), "\"");
    return list_join("", parts);
}

/// Normalize decimal spelling and reject magnitude before host numeric rounding.
/// The location is the argument start, including its optional unary minus.
fn emit_c_number_literal(token, negative, location) {
    digits := lex_normalize_number(map_get(token, "text"));
    maximum := "9007199254740991";
    exceeds := text_length(digits) > text_length(maximum);
    if text_length(digits) == text_length(maximum) {
        position := 0;
        comparing := true;
        while position < text_length(digits) && comparing {
            digit := text_code(text_get(digits, position));
            limit := text_code(text_get(maximum, position));
            if digit != limit {
                exceeds = digit > limit;
                comparing = false;
            }
            position = position + 1;
        }
    }
    if exceeds {
        diagnostic_fail(location, "C target supports only safe integer literals");
    }
    if negative {
        return "-" + digits + ".0";
    }
    return digits + ".0";
}

/// Wrap one file's operations using invocation-owned storage.
fn emit_c_file_function(index, body) {
    lines := list_new();
    emit_c_collect_lines(
        lines,
        "static int MINI_ID(file_" + number_to_text(index) + ")(MINI_ID(context) *context) {"
    );
    emit_c_collect_lines(lines, "    MINI_ID(text_buffer) *buffer = &context->buffer;");
    emit_c_collect_lines(lines, "    (void)buffer;");
    emit_c_collect_fragments(lines, body);
    emit_c_collect_lines(lines, "    return 0;");
    emit_c_collect_lines(lines, "}");
    return emit_c_join_lines(lines, 2);
}

/// Append generated source as line items so assembly stays readable and uniform.
fn emit_c_collect_lines(lines, source) {
    if source == "" {
        return 0;
    }
    parts := text_split(source, "\n");
    count := list_length(parts);
    if count > 0 && list_get(parts, count - 1) == "" {
        count = count - 1;
    }
    position := 0;
    while position < count {
        list_set(lines, list_length(lines), list_get(parts, position));
        position = position + 1;
    }
    return 0;
}

/// Append a sequence of generated source fragments as lines.
fn emit_c_collect_fragments(lines, fragments) {
    position := 0;
    while position < list_length(fragments) {
        emit_c_collect_lines(lines, list_get(fragments, position));
        position = position + 1;
    }
    return 0;
}

/// Lower one target-neutral expression into a C value destination.
fn emit_c_ast_expression(node, state, bindings, binding_orders, destination, in_function) {
    kind := map_get(node, "node_kind");
    if kind == AST_LITERAL {
        literal_kind := map_get(node, "literal_kind");
        if literal_kind == "boolean" {
            boolean := "0";
            if map_get(node, "value") {
                boolean = "1";
            }
            return "    " + destination + " = (MINI_ID(value)) MINI_VALUE_BOOLEAN(" + boolean + ");\n";
        }
        if literal_kind == "text" {
            token := emit_c_ast_location(node);
            bytes := emit_c_literal_bytes(token);
            count := number_to_text(list_length(bytes));
            return "    if (MINI_ID(text_buffer_append)(buffer, (const unsigned char *) " + emit_c_literal_input(bytes)
                + ", " + count + ") != 0) return 1;\n" + "    " + destination + " = (MINI_ID(value)) MINI_VALUE_TEXT(buffer, buffer->count - "
                + count + ", " + count + ");\n";
        }
        raw := map_get(node, "raw");
        negative := text_starts_with(raw, "-");
        if negative {
            raw = text_slice(raw, 1, text_length(raw));
        }
        token := emit_c_ast_location(node);
        map_set(token, "text", raw);
        return "    " + destination + " = (MINI_ID(value)) MINI_VALUE_NUMBER(" + emit_c_number_literal(
            token,
            negative,
            token
        ) + ");\n";
    }
    if kind == AST_NAME {
        name := map_get(node, "name");
        if !map_has(bindings, name) {
            emit_c_fail(node);
        }
        if !in_function && map_get(node, "file_order") < map_get(binding_orders, name) {
            diagnostic_fail(emit_c_ast_location(node), "C target cannot read a binding before its file runs");
        }
        binding := map_get(bindings, name);
        if text_starts_with(binding, "p") || text_starts_with(binding, "local_") {
            return "    " + destination + " = " + binding + ";\n";
        }
        return "    if (!context->initialized_" + binding + ") return 1;\n" + "    " + destination + " = context->binding_"
            + binding + ";\n";
    }
    if kind == AST_GROUP {
        return emit_c_ast_expression(map_get(node, "expression"), state, bindings, binding_orders, destination, in_function);
    }
    if kind == AST_FN_ARGS {
        emit_c_fail(node);
    }
    if kind == AST_CALL {
        return emit_c_ast_call(node, state, bindings, binding_orders, destination, in_function);
    }
    if kind == AST_UNARY {
        body := emit_c_ast_expression(map_get(node, "operand"), state, bindings, binding_orders, destination, in_function);
        return body + "    if (" + destination + ".kind != MINI_ID(kind_boolean)) return 1;\n" + "    " + destination + ".boolean = !"
            + destination + ".boolean;\n";
    }
    if kind == AST_BINARY {
        operator := map_get(node, "operator");
        if operator == "&&" || operator == "||" {
            body := emit_c_ast_expression(map_get(node, "left"), state, bindings, binding_orders, destination, in_function);
            index := map_get(state, "c_temp");
            map_set(state, "c_temp", index + 1);
            right := "tmp" + number_to_text(index);
            condition := destination + ".boolean";
            if operator == "||" {
                condition = "!" + condition;
            }
            return body + "    if (" + destination + ".kind != MINI_ID(kind_boolean)) return 1;\n"
                + "    if (" + condition + ") {\n        MINI_ID(value) " + right + ";\n"
                + emit_c_indent(emit_c_ast_expression(map_get(node, "right"), state, bindings, binding_orders, right, in_function))
                + "        if (" + right + ".kind != MINI_ID(kind_boolean)) return 1;\n"
                + "        " + destination + " = " + right + ";\n    }\n";
        }
        index := map_get(state, "c_temp");
        map_set(state, "c_temp", index + 1);
        right := "tmp" + number_to_text(index);
        body := emit_c_ast_expression(map_get(node, "left"), state, bindings, binding_orders, destination, in_function) + "    MINI_ID(value) "
            + right + ";\n" + emit_c_ast_expression(map_get(node, "right"), state, bindings, binding_orders, right, in_function);
        if operator == "+" {
            return body + "    if (MINI_ID(add)(buffer, &" + destination + ", " + right + ") != 0) return 1;\n";
        }
        if operator == "-" {
            return body + "    if (" + destination + ".kind != MINI_ID(kind_number) || " + right + ".kind != MINI_ID(kind_number)) return 1;\n"
                + "    " + destination + ".number -= " + right + ".number;\n";
        }
        if operator == "==" || operator == "!=" {
            expression := "MINI_ID(equal)(" + destination + ", " + right + ")";
            if operator == "!=" {
                expression = "!" + expression;
            }
            return body + "    " + destination + " = (MINI_ID(value)) MINI_VALUE_BOOLEAN(" + expression + ");\n";
        }
        if operator == "<" || operator == "<=" || operator == ">" || operator == ">=" {
            return body + "    if (" + destination + ".kind != MINI_ID(kind_number) || " + right + ".kind != MINI_ID(kind_number)) return 1;\n"
                + "    " + destination + " = (MINI_ID(value)) MINI_VALUE_BOOLEAN(" + destination + ".number " + operator
                + " " + right + ".number);\n";
        }
    }
    emit_c_fail(node);
    return "";
}

/// Lower one checked call node and its argument expressions.
fn emit_c_ast_call(node, state, bindings, binding_orders, destination, in_function) {
    name := map_get(node, "callee");
    nodes := map_get(node, "arguments");
    index := map_get(state, "c_arg_count");
    map_set(state, "c_arg_count", index + 1);
    array := "args" + number_to_text(index);
    count := list_length(nodes);
    body := list_new();
    if count > 0 {
        list_set(body, list_length(body), "    MINI_ID(value) " + array + "[" + number_to_text(count) + "];\n");
    }
    position := 0;
    while position < count {
        list_set(
            body,
            list_length(body),
            emit_c_ast_expression(
                list_get(nodes, position),
                state,
                bindings,
                binding_orders,
                array + "[" + number_to_text(position) + "]",
                in_function
            )
        );
        position = position + 1;
    }
    params := "(MINI_ID(params)) MINI_PARAMS(0, NULL)";
    if count > 0 {
        params = "(MINI_ID(params)) MINI_PARAMS(" + number_to_text(count) + ", " + array + ")";
    }
    list_set(
        body,
        list_length(body),
        "    if (MINI_ID(fn_" + name + ")(context, " + params + ", &" + destination + ") != 0) return 1;\n"
    );
    return list_join("", body);
}

/// Lower one AST statement using target state and lexical binding maps.
fn emit_c_ast_statement(node, state, bindings, binding_orders, in_function) {
    kind := map_get(node, "node_kind");
    if kind == AST_BLOCK {
        output := list_new();
        statements := map_get(node, "statements");
        scoped := map_copy(bindings);
        orders := map_copy(binding_orders);
        position := 0;
        while position < list_length(statements) {
            list_set(
                output,
                list_length(output),
                emit_c_ast_statement(list_get(statements, position), state, scoped, orders, in_function)
            );
            position = position + 1;
        }
        return list_join("", output);
    }
    if kind == AST_BINDING || kind == AST_ASSIGNMENT {
        name := map_get(node, "name");
        index := map_get(state, "c_temp");
        map_set(state, "c_temp", index + 1);
        temporary := "tmp" + number_to_text(index);
        expression := map_get(node, "initializer");
        if kind == AST_ASSIGNMENT {
            expression = map_get(node, "value");
        }
        body := "    MINI_ID(value) " + temporary + ";\n" + emit_c_ast_expression(
            expression,
            state,
            bindings,
            binding_orders,
            temporary,
            in_function
        );
        if kind == AST_BINDING && (map_get(node, "top_level") || !in_function) {
            binding := map_get(bindings, name);
            if !map_has(bindings, name) || !map_get(node, "top_level") {
                binding = number_to_text(map_get(state, "c_binding_count"));
                map_set(state, "c_binding_count", map_get(state, "c_binding_count") + 1);
                map_set(bindings, name, binding);
                map_set(binding_orders, name, map_get(node, "file_order"));
                list_set(
                    map_get(state, "c_declarations"),
                    list_length(map_get(state, "c_declarations")),
                    "    MINI_ID(value) binding_" + binding + ";\n    int initialized_" + binding + ";\n"
                );
            }
            return body + "    context->binding_" + binding + " = " + temporary + ";\n    context->initialized_" + binding
                + " = 1;\n";
        }
        if kind == AST_BINDING {
            binding := "local_" + number_to_text(map_get(state, "c_local_count"));
            map_set(state, "c_local_count", map_get(state, "c_local_count") + 1);
            map_set(bindings, name, binding);
            return "    MINI_ID(value) " + binding + ";\n" + body + "    " + binding + " = " + temporary + ";\n";
        }
        binding := map_get(bindings, name);
        if !in_function && kind == AST_ASSIGNMENT && map_get(node, "file_order") < map_get(binding_orders, name) {
            map_set(binding_orders, name, map_get(node, "file_order"));
        }
        if text_starts_with(binding, "p") || text_starts_with(binding, "local_") {
            return body + "    " + binding + " = " + temporary + ";\n";
        }
        return body + "    context->binding_" + binding + " = " + temporary + ";\n    context->initialized_" + binding + " = 1;\n";
    }
    if kind == AST_CALL_STATEMENT {
        expression := map_get(node, "expression");
        index := map_get(state, "c_temp");
        map_set(state, "c_temp", index + 1);
        temporary := "tmp" + number_to_text(index);
        return "    MINI_ID(value) " + temporary + ";\n" + emit_c_ast_call(
            expression,
            state,
            bindings,
            binding_orders,
            temporary,
            in_function
        ) + "    (void)" + temporary + ";\n";
    }
    if kind == AST_RETURN {
        if !in_function {
            emit_c_fail(node);
        }
        index := map_get(state, "c_temp");
        map_set(state, "c_temp", index + 1);
        temporary := "tmp" + number_to_text(index);
        return "    MINI_ID(value) " + temporary + ";\n" + emit_c_ast_expression(
            map_get(node, "value"),
            state,
            bindings,
            binding_orders,
            temporary,
            in_function
        ) + "    *result = " + temporary + ";\n    return 0;\n";
    }
    if kind == AST_IF || kind == AST_WHILE {
        consequent := map_get(node, "consequent");
        if kind == AST_WHILE {
            consequent = map_get(node, "body");
        }
        index := map_get(state, "c_temp");
        map_set(state, "c_temp", index + 1);
        number := number_to_text(index);
        condition := "tmp" + number;
        expression := emit_c_ast_expression(map_get(node, "condition"), state, bindings, binding_orders, condition, in_function);
        if in_function {
            if kind == AST_WHILE {
                return list_join(
                    "",
                    list_of(
                        "    while (1) {\n        MINI_ID(value) " + condition + ";\n",
                        emit_c_indent(expression),
                        "        if (" + condition + ".kind != MINI_ID(kind_boolean)) return 1;\n",
                        "        if (!" + condition + ".boolean) break;\n",
                        emit_c_indent(
                            emit_c_ast_statement(consequent, state, map_copy(bindings), map_copy(binding_orders), true)
                        ),
                        "    }\n"
                    )
                );
            }
            output := list_of(
                "    MINI_ID(value) " + condition + ";\n",
                expression,
                "    if (" + condition + ".kind != MINI_ID(kind_boolean)) return 1;\n",
                "    if (" + condition + ".boolean) {\n",
                emit_c_indent(
                    emit_c_ast_statement(consequent, state, map_copy(bindings), map_copy(binding_orders), true)
                ),
                "    }"
            );
            if map_has(node, "alternate") {
                list_set(output, list_length(output), " else {\n");
                list_set(
                    output,
                    list_length(output),
                    emit_c_indent(
                        emit_c_ast_statement(
                            map_get(node, "alternate"),
                            state,
                            map_copy(bindings),
                            map_copy(binding_orders),
                            true
                        )
                    )
                );
                list_set(output, list_length(output), "    }");
            }
            list_set(output, list_length(output), "\n");
            return list_join("", output);
        }
        list_set(
            map_get(state, "c_declarations"),
            list_length(map_get(state, "c_declarations")),
            "    int condition_status_" + number + ";\n    int condition_value_" + number + ";\n"
        );
        helper_lines := list_new();
        emit_c_collect_lines(
            helper_lines,
            "static int MINI_ID(condition_" + number + ")(MINI_ID(context) *context, int *result) {"
        );
        emit_c_collect_lines(helper_lines, "    MINI_ID(text_buffer) *buffer = &context->buffer;");
        emit_c_collect_lines(helper_lines, "    (void)buffer;");
        emit_c_collect_lines(helper_lines, "    MINI_ID(value) " + condition + ";");
        emit_c_collect_lines(helper_lines, expression);
        emit_c_collect_lines(helper_lines, "    if (" + condition + ".kind != MINI_ID(kind_boolean)) return 1;");
        emit_c_collect_lines(helper_lines, "    *result = " + condition + ".boolean;");
        emit_c_collect_lines(helper_lines, "    return 0;");
        emit_c_collect_lines(helper_lines, "}");
        helper := emit_c_join_lines(helper_lines, 2);
        list_set(map_get(state, "c_conditions"), list_length(map_get(state, "c_conditions")), helper);
        keyword := "if";
        if kind == AST_WHILE {
            keyword = "while";
        }
        output := list_of(
            keyword + " ((context->condition_status_" + number + " = MINI_ID(condition_" + number + ")(context, &context->condition_value_"
            + number + ")) != 0 || context->condition_value_" + number + ") {\n",
            "    if (context->condition_status_" + number + " != 0) return 1;\n",
            emit_c_ast_statement(
                consequent,
                state,
                map_copy(bindings),
                map_copy(binding_orders),
                false
            ),
            "    }"
        );
        if kind == AST_IF && map_has(node, "alternate") {
            list_set(output, list_length(output), " else {\n");
            list_set(
                output,
                list_length(output),
                emit_c_ast_statement(
                    map_get(node, "alternate"),
                    state,
                    map_copy(bindings),
                    map_copy(binding_orders),
                    false
                )
            );
            list_set(output, list_length(output), "    }");
        }
        list_set(output, list_length(output), "\n");
        return list_join("", output);
    }
    emit_c_fail(node);
    return "";
}

/// Lower a checked top-level function declaration.
fn emit_c_ast_function(node, state, bindings, binding_orders) {
    name := map_get(node, "name");
    reachable := map_get(state, "c_reachable_functions");
    if !map_has(reachable, name) || emit_c_skip_host_definition(name) {
        return "";
    }
    params := map_get(node, "parameters");
    declarations := list_new();
    local := map_copy(bindings);
    position := 0;
    while position < list_length(params) {
        parameter := list_get(params, position);
        slot := "p" + number_to_text(position);
        map_set(local, map_get(parameter, "name"), slot);
        list_set(
            declarations,
            list_length(declarations),
            "    MINI_ID(value) " + slot + " = params.count > " + number_to_text(position) + " ? params.args["
            + number_to_text(position) + "] : (MINI_ID(value)) MINI_VALUE_NUMBER(0);\n    (void)" + slot + ";\n"
        );
        position = position + 1;
    }
    outer_temp := map_get(state, "c_temp");
    outer_arg_count := map_get(state, "c_arg_count");
    map_set(state, "c_local_count", 0);
    map_set(state, "c_temp", 0);
    map_set(state, "c_arg_count", 0);
    signature := "int MINI_ID(fn_" + name + ")(MINI_ID(context) *context, MINI_ID(params) params, MINI_ID(value) *result)";
    list_set(
        map_get(state, "c_prototypes"),
        list_length(map_get(state, "c_prototypes")),
        signature + ";\n"
    );
    body := emit_c_ast_statement(map_get(node, "body"), state, local, map_copy(binding_orders), true);
    map_set(state, "c_temp", outer_temp);
    map_set(state, "c_arg_count", outer_arg_count);
    function_lines := list_new();
    emit_c_collect_lines(function_lines, signature + " {");
    emit_c_collect_lines(function_lines, "    if (params.count && !params.args) return 1;");
    emit_c_collect_lines(function_lines, "    MINI_ID(text_buffer) *buffer = &context->buffer;");
    emit_c_collect_lines(function_lines, "    (void)buffer;");
    emit_c_collect_fragments(function_lines, declarations);
    emit_c_collect_lines(function_lines, body);
    emit_c_collect_lines(function_lines, "    *result = (MINI_ID(value)) MINI_VALUE_NUMBER(0);");
    emit_c_collect_lines(function_lines, "    return 0;");
    emit_c_collect_lines(function_lines, "}");
    list_set(
        map_get(state, "c_functions"),
        list_length(map_get(state, "c_functions")),
        emit_c_join_lines(function_lines, 2)
    );
    return "";
}

/// Collect Mini function calls from one AST subtree in source order.
fn emit_c_collect_calls(node, calls) {
    kind := map_get(node, "node_kind");
    if kind == AST_CALL {
        list_set(calls, list_length(calls), map_get(node, "callee"));
        children := map_get(node, "arguments");
        position := 0;
        while position < list_length(children) {
            emit_c_collect_calls(list_get(children, position), calls);
            position = position + 1;
        }
    } else if kind == AST_BLOCK {
        children := map_get(node, "statements");
        position := 0;
        while position < list_length(children) {
            emit_c_collect_calls(list_get(children, position), calls);
            position = position + 1;
        }
    } else if kind == AST_BINDING {
        emit_c_collect_calls(map_get(node, "initializer"), calls);
    } else if kind == AST_ASSIGNMENT {
        emit_c_collect_calls(map_get(node, "value"), calls);
    } else if kind == AST_CALL_STATEMENT {
        emit_c_collect_calls(map_get(node, "expression"), calls);
    } else if kind == AST_RETURN {
        emit_c_collect_calls(map_get(node, "value"), calls);
    } else if kind == AST_IF {
        emit_c_collect_calls(map_get(node, "condition"), calls);
        emit_c_collect_calls(map_get(node, "consequent"), calls);
        if map_has(node, "alternate") {
            emit_c_collect_calls(map_get(node, "alternate"), calls);
        }
    } else if kind == AST_WHILE {
        emit_c_collect_calls(map_get(node, "condition"), calls);
        emit_c_collect_calls(map_get(node, "body"), calls);
    } else if kind == AST_GROUP {
        emit_c_collect_calls(map_get(node, "expression"), calls);
    } else if kind == AST_UNARY {
        emit_c_collect_calls(map_get(node, "operand"), calls);
    } else if kind == AST_BINARY {
        emit_c_collect_calls(map_get(node, "left"), calls);
        emit_c_collect_calls(map_get(node, "right"), calls);
    }
    return 0;
}

/// Mark a Mini function and its transitive Mini function dependencies reachable.
fn emit_c_mark_reachable(name, functions, reachable) {
    if !map_has(functions, name) || map_has(reachable, name) || emit_c_host_function_exists(name)
        || emit_c_skip_host_definition(name) {
        return 0;
    }
    map_set(reachable, name, true);
    calls := list_new();
    emit_c_collect_calls(map_get(map_get(functions, name), "body"), calls);
    position := 0;
    while position < list_length(calls) {
        emit_c_mark_reachable(list_get(calls, position), functions, reachable);
        position = position + 1;
    }
    return 0;
}

/// Lower one complete checked Program AST and header name to C source text.
/// Unsupported C forms fail with their source location before an artifact is written.
fn emit_c_program(program, header_name) {
    state := map_new();
    map_set(state, "c_temp", 0);
    map_set(state, "c_arg_count", 0);
    map_set(state, "c_binding_count", 0);
    map_set(state, "c_declarations", list_new());
    map_set(state, "c_conditions", list_new());
    map_set(state, "c_functions", list_new());
    map_set(state, "c_prototypes", list_new());
    files := list_new();
    calls := list_new();
    bodies := map_new();
    bindings := map_new();
    binding_orders := map_new();
    functions := map_new();
    reachable := map_new();
    order := map_get(program, "files");
    file_index := 0;
    while file_index < list_length(order) {
        map_set(bodies, list_get(order, file_index), list_new());
        file_index = file_index + 1;
    }
    nodes := map_get(program, "body");
    position := 0;
    while position < list_length(nodes) {
        node := list_get(nodes, position);
        if map_get(node, "node_kind") == AST_FUNCTION {
            map_set(functions, map_get(node, "name"), node);
        }
        position = position + 1;
    }
    position = 0;
    while position < list_length(nodes) {
        node := list_get(nodes, position);
        if map_get(node, "node_kind") != AST_FUNCTION {
            calls := list_new();
            emit_c_collect_calls(node, calls);
            call_index := 0;
            while call_index < list_length(calls) {
                emit_c_mark_reachable(list_get(calls, call_index), functions, reachable);
                call_index = call_index + 1;
            }
        }
        position = position + 1;
    }
    map_set(state, "c_reachable_functions", reachable);
    position = 0;
    while position < list_length(nodes) {
        node := list_get(nodes, position);
        if map_get(node, "node_kind") == AST_BINDING && map_get(node, "top_level") {
            name := map_get(node, "name");
            if !map_has(bindings, name) {
                binding := number_to_text(map_get(state, "c_binding_count"));
                map_set(state, "c_binding_count", map_get(state, "c_binding_count") + 1);
                map_set(bindings, name, binding);
                map_set(binding_orders, name, map_get(node, "file_order"));
                list_set(
                    map_get(state, "c_declarations"),
                    list_length(map_get(state, "c_declarations")),
                    "    MINI_ID(value) binding_" + binding + ";\n    int initialized_" + binding + ";\n"
                );
            }
        }
        position = position + 1;
    }
    position = 0;
    while position < list_length(nodes) {
        node := list_get(nodes, position);
        if map_get(node, "node_kind") == AST_FUNCTION {
            emit_c_ast_function(node, state, bindings, binding_orders);
        } else {
            file := map_get(node, "file");
            if !map_has(bodies, file) {
                map_set(bodies, file, list_new());
            }
            file_body := map_get(bodies, file);
            list_set(
                file_body,
                list_length(file_body),
                emit_c_ast_statement(node, state, bindings, binding_orders, false)
            );
        }
        position = position + 1;
    }
    file_index = 0;
    while file_index < list_length(order) {
        file := list_get(order, file_index);
        list_set(files, list_length(files), emit_c_file_function(file_index, map_get(bodies, file)));
        list_set(
            calls,
            list_length(calls),
            "    if (MINI_ID(file_" + number_to_text(file_index) + ")(&context) != 0) { status = 1; goto cleanup; }"
        );
        file_index = file_index + 1;
    }
    runtime := emit_c_host_runtime_definitions();
    lines := list_new();
    emit_c_collect_lines(lines, "// Generated by the mini C target.");
    emit_c_collect_lines(lines, emit_c_host_preambles());
    emit_c_collect_lines(lines, "#include \"" + header_name + "\"");
    emit_c_collect_lines(lines, "#include <stdio.h>");
    emit_c_collect_lines(lines, "#include <stdint.h>");
    emit_c_collect_lines(lines, "#include <stdlib.h>");
    emit_c_collect_lines(lines, "#include <string.h>");
    emit_c_collect_lines(lines, emit_c_host_includes());
    list_set(lines, list_length(lines), "");
    emit_c_collect_lines(lines, emit_c_vec_runtime());
    emit_c_collect_lines(lines, emit_c_value_constructor());
    emit_c_collect_lines(lines, runtime);
    emit_c_collect_lines(lines, "typedef struct MINI_ID(context) MINI_ID(context);");
    emit_c_collect_lines(lines, "struct MINI_ID(context) {");
    emit_c_collect_lines(lines, "    MINI_ID(text_buffer) buffer;");
    emit_c_collect_lines(lines, "    MINI_ID(vec) lists;");
    emit_c_collect_fragments(lines, map_get(state, "c_declarations"));
    emit_c_collect_lines(lines, "};");
    list_set(lines, list_length(lines), "");
    emit_c_collect_lines(lines, emit_c_host_runtime_after_context_definitions());
    emit_c_collect_lines(lines, emit_c_host_function_definitions());
    emit_c_collect_fragments(lines, map_get(state, "c_prototypes"));
    list_set(lines, list_length(lines), "");
    emit_c_collect_fragments(lines, map_get(state, "c_functions"));
    emit_c_collect_fragments(lines, map_get(state, "c_conditions"));
    emit_c_collect_fragments(lines, files);
    emit_c_collect_lines(lines, "int main(void) {");
    emit_c_collect_lines(lines, "    MINI_ID(context) context = {0};");
    emit_c_collect_lines(lines, "    int status = 0;");
    emit_c_collect_lines(
        lines,
        "    (void)MINI_ID(list_new); (void)MINI_ID(list_push); (void)MINI_ID(list_pop); (void)MINI_ID(list_truncate);"
    );
    emit_c_collect_lines(lines, "    (void)MINI_ID(add); (void)MINI_ID(equal);");
    emit_c_collect_lines(lines, "    (void)MINI_ID(list_length); (void)MINI_ID(list_get); (void)MINI_ID(list_set);");
    emit_c_collect_lines(
        lines,
        "    (void)MINI_ID(list_copy); (void)MINI_ID(list_join); (void)MINI_ID(text_buffer_append_view);"
    );
    emit_c_collect_fragments(lines, calls);
    emit_c_collect_lines(lines, "    if (fflush(stdout) != 0) status = 1;");
    emit_c_collect_lines(lines, "    goto cleanup;");
    emit_c_collect_lines(lines, "cleanup:");
    emit_c_collect_lines(lines, "    MINI_ID(list_cleanup)(&context);");
    emit_c_collect_lines(lines, "    MINI_ID(text_buffer_free)(&context.buffer);");
    emit_c_collect_lines(lines, "    return status;");
    emit_c_collect_lines(lines, "}");
    return emit_c_join_lines(lines, 1);
}

/// Parse one prepared token list once, then delegate to the AST-only C backend.
fn emit_c_compile(tokens, header_name) {
    return emit_c_program(parser_ast_quiet(tokens), header_name);
}
