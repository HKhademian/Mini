include "common/value.mini";
/// Reference list_copy: shallow copy, or empty list for non-lists.
fn pure_list_copy(items) {
    result := list_new();
    if !value_is_list(items) {
        return result;
    }
    position := 0;
    while position < list_length(items) {
        list_set(result, list_length(result), list_get(items, position));
        position = position + 1;
    }
    return result;
}

/// Reference list_join: join text items with a text separator.
fn pure_list_join(items, separator) {
    if !value_is_list(items) || !value_is_text(separator) {
        return "";
    }
    output := "";
    position := 0;
    while position < list_length(items) {
        if position > 0 {
            output = output + separator;
        }
        item := list_get(items, position);
        if value_is_text(item) {
            output = output + item;
        }
        position = position + 1;
    }
    return output;
}
