/// Reference text_find: return the first code-unit index, or -1.
fn pure_text_find_from(text, needle, start) {
    var text_size = text_length(text);
    var needle_size = text_length(needle);
    if (needle_size == 0) {
        if (start <= text_size) {
            return start;
        }
        return -1;
    }
    var position = start;
    while (position + needle_size <= text_size) {
        var offset = 0;
        var matched = true;
        while (offset < needle_size) {
            if (text_get(text, position + offset) != text_get(needle, offset)) {
                matched = false;
                offset = needle_size;
            } else {
                offset = offset + 1;
            }
        }
        if (matched) {
            return position;
        }
        position = position + 1;
    }
    return -1;
}

/// Reference text_find.
fn pure_text_find(text, needle) {
    if (value_kind(text) != "text" || value_kind(needle) != "text") {
        return -1;
    }
    return pure_text_find_from(text, needle, 0);
}

/// Reference text_slice with negative-index and clamp behavior.
fn pure_text_slice(source, start, end) {
    if (value_kind(source) != "text") {
        return "";
    }
    var size = text_length(source);
    if (start < 0) {
        start = size + start;
    }
    if (end < 0) {
        end = size + end;
    }
    if (start < 0) {
        start = 0;
    }
    if (end < 0) {
        end = 0;
    }
    if (start > size) {
        start = size;
    }
    if (end > size) {
        end = size;
    }
    if (end <= start) {
        return "";
    }
    var output = "";
    var position = start;
    while (position < end) {
        output = output + text_get(source, position);
        position = position + 1;
    }
    return output;
}

/// Reference text_split for text divider and text input.
fn pure_text_split(text, divider) {
    if (value_kind(text) != "text" || value_kind(divider) != "text") {
        return list_new();
    }
    if (divider == "") {
        var whole = list_new();
        list_set(whole, 0, text);
        return whole;
    }
    var result = list_new();
    var start = 0;
    var position = pure_text_find_from(text, divider, start);
    while (position >= 0) {
        list_set(result, list_length(result), pure_text_slice(text, start, position));
        start = position + text_length(divider);
        position = pure_text_find_from(text, divider, start);
    }
    list_set(result, list_length(result), pure_text_slice(text, start, text_length(text)));
    return result;
}
