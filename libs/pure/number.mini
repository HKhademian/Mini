/// Reference numeric add derived from subtraction.

include "common/value.mini";

/// Reference numeric multiply by repeated addition.
fn pure_number_mul(a, b) {
    if !value_is_number(a) || !value_is_number(b) {
        return 0;
    }
    left := a;
    right := b;
    negative := false;
    if left < 0 {
        left = 0 - left;
        negative = !negative;
    }
    if right < 0 {
        right = 0 - right;
        negative = !negative;
    }
    result := 0;
    while right > 0 {
        result = result + left;
        right = right - 1;
    }
    if negative {
        return 0 - result;
    }
    return result;
}

/// Reference numeric division truncated toward zero.
fn pure_number_div(a, b) {
    if !value_is_number(a) || !value_is_number(b) || b == 0 {
        return 0;
    }
    left := a;
    right := b;
    negative := false;
    if left < 0 {
        left = 0 - left;
        negative = !negative;
    }
    if right < 0 {
        right = 0 - right;
        negative = !negative;
    }
    result := 0;
    while left >= right {
        left = left - right;
        result = result + 1;
    }
    if negative {
        return 0 - result;
    }
    return result;
}

/// Reference numeric remainder with the dividend's sign.
fn pure_number_mod(a, b) {
    if !value_is_number(a) || !value_is_number(b) || b == 0 {
        return 0;
    }
    left := a;
    right := b;
    if left < 0 {
        left = 0 - left;
    }
    if right < 0 {
        right = 0 - right;
    }
    while left >= right {
        left = left - right;
    }
    if a < 0 {
        return 0 - left;
    }
    return left;
}

/// Reference numeric floor.
fn pure_number_floor(a) {
    if !value_is_number(a) {
        return 0;
    }
    value := a;
    whole := 0;
    if value >= 0 {
        while value >= 1 {
            value = value - 1;
            whole = whole + 1;
        }
    } else {
        while value < 0 {
            value = value + 1;
            whole = whole - 1;
        }
    }
    return whole;
}

/// Reference numeric power for non-negative integer exponents.
fn pure_number_pow(a, b) {
    if !value_is_number(a) || !value_is_number(b) || b < 0 || pure_number_floor(b) != b {
        return 0;
    }
    result := 1;
    exponent := b;
    while exponent > 0 {
        result = pure_number_mul(result, a);
        exponent = exponent - 1;
    }
    return result;
}

