/// Reference decimal integer parsing for safe integers.
fn pure_number_from_text(text) {
    if !value_is_text(text) || text_length(text) == 0 {
        return 0;
    }
    start := 0;
    negative := false;
    if text_get(text, 0) == "-" {
        negative = true;
        start = 1;
    }
    if start >= text_length(text) {
        return 0;
    }
    result := 0;
    position := start;
    while position < text_length(text) {
        digit := text_find("0123456789", text_get(text, position));
        if digit < 0 {
            return 0;
        }
        result = result + pure_number_mul(result, 9) + digit;
        if result > 9007199254740991 {
            return 0;
        }
        position = position + 1;
    }
    if negative {
        return 0 - result;
    }
    return result;
}

/// Reference canonical decimal formatting for safe integers.
fn pure_number_to_text(value) {
    if !value_is_number(value) {
        return "";
    }
    if value > 9007199254740991 || value < -9007199254740991 {
        return "";
    }
    if value == 0 {
        return "0";
    }
    negative := value < 0;
    if negative {
        value = 0 - value;
    }
    powers := list_new();
    list_set(powers, 0, 1);
    next := 10;
    while next <= value {
        list_set(powers, list_length(powers), next);
        next = pure_number_mul(next, 10);
    }
    digits := "0123456789";
    output := "";
    position := list_length(powers) - 1;
    while position >= 0 {
        power := list_get(powers, position);
        digit := 0;
        while digit < 9 && value >= pure_number_mul(power, digit + 1) {
            digit = digit + 1;
        }
        output = output + text_get(digits, digit);
        value = value - pure_number_mul(power, digit);
        position = position - 1;
    }
    if negative {
        return "-" + output;
    }
    return output;
}
