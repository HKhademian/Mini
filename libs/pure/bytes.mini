include "common/value.mini";
/// Normalize one byte value like the host conversion.
fn pure_byte_at(bytes, index) {
    if !value_is_list(bytes) || index < 0 || index >= list_length(bytes) {
        return 0;
    }
    value := list_get(bytes, index);
    if !value_is_number(value) || number_floor(value) != value {
        return 0;
    }
    byte := number_mod(value, 256);
    if byte < 0 {
        byte = byte + 256;
    }
    return byte;
}

/// Append one byte value.
fn pure_byte_push(bytes, value) {
    list_set(bytes, list_length(bytes), value);
    return 0;
}

/// Reference UTF-8 encoding.
fn pure_text_to_bytes(text) {
    bytes := list_new();
    if !value_is_text(text) {
        return bytes;
    }
    position := 0;
    while position < text_length(text) {
        code := text_code(text_slice(text, position, text_length(text)));
        width := 1;
        if code < 0 {
            code = 65533;
        }
        if code <= 127 {
            pure_byte_push(bytes, code);
        } else {
            if code <= 2047 {
                pure_byte_push(bytes, 192 + number_div(code, 64));
                pure_byte_push(bytes, 128 + number_mod(code, 64));
            } else {
                if code <= 65535 {
                    if code >= 55296 && code <= 57343 {
                        pure_byte_push(bytes, 239);
                        pure_byte_push(bytes, 191);
                        pure_byte_push(bytes, 189);
                    } else {
                        pure_byte_push(bytes, 224 + number_div(code, 4096));
                        pure_byte_push(bytes, 128 + number_mod(number_div(code, 64), 64));
                        pure_byte_push(bytes, 128 + number_mod(code, 64));
                    }
                } else {
                    pure_byte_push(bytes, 240 + number_div(code, 262144));
                    pure_byte_push(bytes, 128 + number_mod(number_div(code, 4096), 64));
                    pure_byte_push(bytes, 128 + number_mod(number_div(code, 64), 64));
                    pure_byte_push(bytes, 128 + number_mod(code, 64));
                    width = 2;
                }
            }
        }
        position = position + width;
    }
    return bytes;
}

/// Reference UTF-8 decoding with replacement for invalid sequences.
fn pure_text_from_bytes(bytes) {
    if !value_is_list(bytes) {
        return "";
    }
    parts := list_new();
    position := 0;
    while position < list_length(bytes) {
        first := pure_byte_at(bytes, position);
        if first < 128 {
            list_set(parts, list_length(parts), text_from_code(first));
            position = position + 1;
        } else {
            if first >= 194 && first <= 223 && position + 1 < list_length(bytes) {
                second := pure_byte_at(bytes, position + 1);
                if second >= 128 && second <= 191 {
                    list_set(parts, list_length(parts), text_from_code(number_mul(first - 192, 64) + (second - 128)));
                    position = position + 2;
                } else {
                    list_set(parts, list_length(parts), text_from_code(65533));
                    position = position + 1;
                }
            } else {
                if first >= 224 && first <= 239 && position + 2 < list_length(bytes) {
                    second := pure_byte_at(bytes, position + 1);
                    third := pure_byte_at(bytes, position + 2);
                    if second >= 128 && second <= 191 && third >= 128 && third <= 191 {
                        list_set(
                            parts,
                            list_length(parts),
                            text_from_code(number_mul(first - 224, 4096) + number_mul(second - 128, 64) + (third - 128))
                        );
                        position = position + 3;
                    } else {
                        list_set(parts, list_length(parts), text_from_code(65533));
                        position = position + 1;
                    }
                } else {
                    if first >= 240 && first <= 244 && position + 3 < list_length(bytes) {
                        second := pure_byte_at(bytes, position + 1);
                        third := pure_byte_at(bytes, position + 2);
                        fourth := pure_byte_at(bytes, position + 3);
                        if second >= 128 && second <= 191 && third >= 128 && third <= 191
                            && fourth >= 128 && fourth <= 191 {
                            list_set(
                                parts,
                                list_length(parts),
                                text_from_code(
                                    number_mul(first - 240, 262144) + number_mul(second - 128, 4096)
                                + number_mul(third - 128, 64) + (fourth - 128)
                                )
                            );
                            position = position + 4;
                        } else {
                            list_set(parts, list_length(parts), text_from_code(65533));
                            position = position + 1;
                        }
                    } else {
                        list_set(parts, list_length(parts), text_from_code(65533));
                        position = position + 1;
                    }
                }
            }
        }
    }
    return list_join(parts, "");
}
