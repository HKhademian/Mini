include "common/value.mini";
/// Reference map_copy: shallow copy, or empty map for non-maps.
fn pure_map_copy(items) {
    result := map_new();
    if !value_is_map(items) {
        return result;
    }
    keys := map_keys(items);
    position := 0;
    while position < list_length(keys) {
        key := list_get(keys, position);
        map_set(result, key, map_get(items, key));
        position = position + 1;
    }
    return result;
}
