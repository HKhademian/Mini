/// Common list algorithms built on representation primitives.

include "./value.mini";

/// Return whether a list contains one text value.
fn list_has_text(items, value) {
    position := 0;
    while position < list_length(items) {
        if list_get(items, position) == value {
            return true;
        }
        position = position + 1;
    }
    return false;
}

/// Join list items from an index with a separator.
fn list_join_from(items, start, separator) {
    parts := list_new();
    position := start;
    while position < list_length(items) {
        list_set(parts, list_length(parts), list_get(items, position));
        position = position + 1;
    }
    return list_join(parts, separator);
}

/// Reverse a list into a new list.
fn list_reverse(items) {
    result := list_new();
    position := list_length(items) - 1;
    while position >= 0 {
        list_set(result, list_length(result), list_get(items, position));
        position = position - 1;
    }
    return result;
}

/// Sort a list into a new list using pairwise comparison.
fn list_sorted(items) {
    result := list_copy(items);
    position := 0;
    while position < list_length(result) {
        cursor := position + 1;
        while cursor < list_length(result) {
            if list_get(result, cursor) < list_get(result, position) {
                hold := list_get(result, position);
                list_set(result, position, list_get(result, cursor));
                list_set(result, cursor, hold);
            }
            cursor = cursor + 1;
        }
        position = position + 1;
    }
    return result;
}

/// Return whether a list contains a value by equality.
fn list_contains(items, value) {
    position := 0;
    while position < list_length(items) {
        if list_get(items, position) == value {
            return true;
        }
        position = position + 1;
    }
    return false;
}

/// Return whether a value is a list containing only text.
fn list_is_text(value) {
    if !value_is_list(value) {
        return false;
    }
    position := 0;
    while position < list_length(value) {
        if value_kind(list_get(value, position)) != "text" {
            return false;
        }
        position = position + 1;
    }
    return true;
}

/// Append one value to a list.
fn list_push_back(items, value) {
    if value_is_list(items) {
        list_set(items, list_length(items), value);
    }
    return 0;
}

/// Insert one value at the start of a list.
fn list_push_front(items, value) {
    if !value_is_list(items) {
        return 0;
    }
    position := list_length(items);
    while position > 0 {
        list_set(items, position, list_get(items, position - 1));
        position = position - 1;
    }
    list_set(items, 0, value);
    return 0;
}

/// Remove and return the final list value, or 0 when the list is empty.
fn list_pop_back(items) {
    if !value_is_list(items) || list_length(items) == 0 {
        return 0;
    }
    length := list_length(items);
    value := list_get(items, length - 1);
    list_truncate(items, length - 1);
    return value;
}

/// Remove and return the first list value, or 0 when the list is empty.
fn list_pop_front(items) {
    if !value_is_list(items) || list_length(items) == 0 {
        return 0;
    }
    length := list_length(items);
    value := list_get(items, 0);
    position := 0;
    while position < length - 1 {
        list_set(items, position, list_get(items, position + 1));
        position = position + 1;
    }
    list_truncate(items, length - 1);
    return value;
}

/// Build a list from any number of supplied arguments.
///
/// fn_args() supplies every argument, so this reads like a list literal without
/// adding syntax. No arguments yields an empty list.
fn list_of() {
    return fn_args();
}

/// Return items after the first count entries.
fn list_rest(items, count) {
    result := list_new();
    position := count;
    while position < list_length(items) {
        list_set(result, list_length(result), list_get(items, position));
        position = position + 1;
    }
    return result;
}
