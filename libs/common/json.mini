import "common/list";
import "common/map";
import "common/number";
import "common/result";
import "common/text";
import "common/value";

/// Read and parse a JSON file into a result map.
fn json_parse_file(path) {
    if !path_is_exists(path) {
        return result_fail("cannot read " + path);
    }
    parsed := json_parse(file_read(path));
    if result_is_fail(parsed) {
        return result_fail("invalid JSON: " + path);
    }
    return result_ok(result_get_value(parsed));
}

/// Build a JSON parse result with the public two-field contract.
fn json_parse_result(ok, value) {
    result := map_new();
    map_set(result, "ok", ok);
    map_set(result, "value", value);
    return result;
}


/// Return whether a character is JSON whitespace.
fn json_space(character) {
    return character == " " || character == "\t" || character == "\n" || character == "\r";
}

/// Skip JSON whitespace.
fn json_skip(state) {
    while map_get(state, "position") < text_length(map_get(state, "text"))
        && json_space(text_get(map_get(state, "text"), map_get(state, "position"))) {
        map_set(state, "position", map_get(state, "position") + 1);
    }
    return 0;
}

/// Mark the parse as failed.
fn json_fail(state) {
    map_set(state, "ok", false);
    return 0;
}

/// Return the current character, or empty text at the end.
fn json_peek(state) {
    position := map_get(state, "position");
    if position >= text_length(map_get(state, "text")) {
        return "";
    }
    return text_get(map_get(state, "text"), position);
}

/// Consume one expected character.
fn json_take(state, expected) {
    if json_peek(state) != expected {
        return json_fail(state);
    }
    map_set(state, "position", map_get(state, "position") + 1);
    return 0;
}

/// Return the numeric value of a hexadecimal digit.
fn json_hex_value(character) {
    digit := text_find("0123456789abcdef", character);
    if digit >= 0 {
        return digit;
    }
    digit = text_find("0123456789ABCDEF", character);
    return digit;
}

/// Parse four hexadecimal digits.
fn json_hex4(state) {
    value := 0;
    count := 0;
    while count < 4 {
        digit := json_hex_value(json_peek(state));
        if digit < 0 {
            json_fail(state);
            return 0;
        }
        value = number_mul(value, 16) + digit;
        map_set(state, "position", map_get(state, "position") + 1);
        count = count + 1;
    }
    return value;
}

/// Parse one JSON string and return its decoded text.
fn json_string(state) {
    json_take(state, "\"");
    parts := list_new();
    while map_get(state, "ok") && map_get(state, "position") < text_length(map_get(state, "text")) {
        character := json_peek(state);
        if character == "\"" {
            map_set(state, "position", map_get(state, "position") + 1);
            return list_join(parts, "");
        }
        if character == "\\" {
            map_set(state, "position", map_get(state, "position") + 1);
            escaped := json_peek(state);
            map_set(state, "position", map_get(state, "position") + 1);
            if escaped == "\"" {
                list_set(parts, list_length(parts), "\"");
            } else {
                if escaped == "\\" {
                    list_set(parts, list_length(parts), "\\");
                } else {
                    if escaped == "/" {
                        list_set(parts, list_length(parts), "/");
                    } else {
                        if escaped == "b" {
                            list_set(parts, list_length(parts), text_from_code(8));
                        } else {
                            if escaped == "f" {
                                list_set(parts, list_length(parts), text_from_code(12));
                            } else {
                                if escaped == "n" {
                                    list_set(parts, list_length(parts), "\n");
                                } else {
                                    if escaped == "r" {
                                        list_set(parts, list_length(parts), "\r");
                                    } else {
                                        if escaped == "t" {
                                            list_set(parts, list_length(parts), "\t");
                                        } else {
                                            if escaped == "u" {
                                                code := json_hex4(state);
                                                if code >= 55296 && code <= 56319 && json_peek(state) == "\\"
                                                    && text_get(map_get(state, "text"), map_get(state, "position") + 1)
                                                    == "u" {
                                                    map_set(state, "position", map_get(state, "position") + 2);
                                                    low := json_hex4(state);
                                                    if low >= 56320 && low <= 57343 {
                                                        code = 65536 + number_mul(code - 55296, 1024) + (low - 56320);
                                                    } else {
                                                        json_fail(state);
                                                    }
                                                }
                                                list_set(parts, list_length(parts), text_from_code(code));
                                            } else {
                                                json_fail(state);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        } else {
            list_set(parts, list_length(parts), character);
            map_set(state, "position", map_get(state, "position") + 1);
        }
    }
    json_fail(state);
    return "";
}

/// Parse one JSON number; integer literals are supported by the Mini fallback.
fn json_number(state) {
    start := map_get(state, "position");
    if json_peek(state) == "-" {
        map_set(state, "position", map_get(state, "position") + 1);
    }
    if text_find("0123456789", json_peek(state)) < 0 {
        json_fail(state);
        return 0;
    }
    while text_find("0123456789", json_peek(state)) >= 0 {
        map_set(state, "position", map_get(state, "position") + 1);
    }
    if json_peek(state) == "." || json_peek(state) == "e" || json_peek(state) == "E" {
        json_fail(state);
        return 0;
    }
    return number_from_text(text_slice(map_get(state, "text"), start, map_get(state, "position")));
}

/// Parse one JSON array.
fn json_array(state) {
    json_take(state, "[");
    result := list_new();
    json_skip(state);
    if json_peek(state) == "]" {
        map_set(state, "position", map_get(state, "position") + 1);
        return result;
    }
    while map_get(state, "ok") {
        value := json_value(state);
        if !map_get(state, "ok") {
            return result;
        }
        list_set(result, list_length(result), value);
        json_skip(state);
        if json_peek(state) == "]" {
            map_set(state, "position", map_get(state, "position") + 1);
            return result;
        }
        json_take(state, ",");
        json_skip(state);
    }
    return result;
}

/// Parse one JSON object.
fn json_object(state) {
    json_take(state, "{");
    result := map_new();
    json_skip(state);
    if json_peek(state) == "}" {
        map_set(state, "position", map_get(state, "position") + 1);
        return result;
    }
    while map_get(state, "ok") {
        json_skip(state);
        key := json_string(state);
        json_skip(state);
        json_take(state, ":");
        json_skip(state);
        value := json_value(state);
        if !map_get(state, "ok") {
            return result;
        }
        map_set(result, key, value);
        json_skip(state);
        if json_peek(state) == "}" {
            map_set(state, "position", map_get(state, "position") + 1);
            return result;
        }
        json_take(state, ",");
    }
    return result;
}

/// Parse one JSON value.
fn json_value(state) {
    json_skip(state);
    character := json_peek(state);
    if character == "\"" {
        return json_string(state);
    }
    if character == "[" {
        return json_array(state);
    }
    if character == "{" {
        return json_object(state);
    }
    if character == "-" || text_find("0123456789", character) >= 0 {
        return json_number(state);
    }
    if text_starts_with(
        text_slice(map_get(state, "text"), map_get(state, "position"), text_length(map_get(state, "text"))),
        "true"
    ) {
        map_set(state, "position", map_get(state, "position") + 4);
        return true;
    }
    if text_starts_with(
        text_slice(map_get(state, "text"), map_get(state, "position"), text_length(map_get(state, "text"))),
        "false"
    ) {
        map_set(state, "position", map_get(state, "position") + 5);
        return false;
    }
    if text_starts_with(
        text_slice(map_get(state, "text"), map_get(state, "position"), text_length(map_get(state, "text"))),
        "null"
    ) {
        map_set(state, "position", map_get(state, "position") + 4);
        return 0;
    }
    json_fail(state);
    return 0;
}

/// Parse JSON into a result map containing ok and value.
fn json_parse(text) {
    state := map_new();
    map_set(state, "text", text);
    map_set(state, "position", 0);
    map_set(state, "ok", true);
    if !value_is_text(text) {
        map_set(state, "ok", false);
        return json_parse_result(false, 0);
    }
    value := json_value(state);
    json_skip(state);
    if map_get(state, "position") != text_length(text) {
        json_fail(state);
    }
    if !map_get(state, "ok") {
        return json_parse_result(false, 0);
    }
    return json_parse_result(true, value);
}

/// Escape one JSON string.
fn json_escape(text) {
    parts := list_of("\"");
    position := 0;
    while position < text_length(text) {
        character := text_get(text, position);
        if character == "\"" {
            list_set(parts, list_length(parts), "\\\"");
        } else {
            if character == "\\" {
                list_set(parts, list_length(parts), "\\\\");
            } else {
                if text_code(character) == 8 {
                    list_set(parts, list_length(parts), "\\b");
                } else {
                    if text_code(character) == 12 {
                        list_set(parts, list_length(parts), "\\f");
                    } else {
                        if character == "\n" {
                            list_set(parts, list_length(parts), "\\n");
                        } else {
                            if character == "\r" {
                                list_set(parts, list_length(parts), "\\r");
                            } else {
                                if character == "\t" {
                                    list_set(parts, list_length(parts), "\\t");
                                } else {
                                    if text_code(character) < 32 {
                                        code := text_code(character);
                                        digits := "0123456789abcdef";
                                        list_set(
                                            parts,
                                            list_length(parts),
                                            "\\u00" + text_get(digits, number_div(code, 16)) + text_get(
                                                digits,
                                                number_mod(code, 16)
                                            )
                                        );
                                    } else {
                                        list_set(parts, list_length(parts), character);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        position = position + 1;
    }
    list_set(parts, list_length(parts), "\"");
    return list_join(parts, "");
}

/// Encode one JSON value into a state map.
fn json_encode(value, seen, state) {
    if value_is_text(value) {
        return json_escape(value);
    }
    if value_is_number(value) {
        if number_to_text(value) == "" {
            return "null";
        }
        return number_to_text(value);
    }
    if value_is_boolean(value) {
        if value {
            return "true";
        }
        return "false";
    }
    if value_is_list(value) || value_is_map(value) {
        if list_contains(seen, value) {
            map_set(state, "ok", false);
            return "";
        }
        list_push_back(seen, value);
        parts := list_new();
        if value_is_list(value) {
            list_set(parts, list_length(parts), "[");
            position := 0;
            while position < list_length(value) {
                if position > 0 {
                    list_set(parts, list_length(parts), ",");
                }
                list_set(parts, list_length(parts), json_encode(list_get(value, position), seen, state));
                if !map_get(state, "ok") {
                    return "";
                }
                position = position + 1;
            }
            list_set(parts, list_length(parts), "]");
        } else {
            list_set(parts, list_length(parts), "{");
            keys := list_sorted(map_keys(value));
            index := 0;
            while index < list_length(keys) {
                if index > 0 {
                    list_set(parts, list_length(parts), ",");
                }
                key := list_get(keys, index);
                list_set(parts, list_length(parts), json_escape(key) + ":");
                list_set(parts, list_length(parts), json_encode(map_get(value, key), seen, state));
                if !map_get(state, "ok") {
                    return "";
                }
                index = index + 1;
            }
            list_set(parts, list_length(parts), "}");
        }
        list_pop_back(seen);
        return list_join(parts, "");
    }
    return "null";
}

/// Serialize one Mini value as compact deterministic JSON.
fn json_to_text(value) {
    state := map_new();
    map_set(state, "ok", true);
    output := json_encode(value, list_new(), state);
    if !map_get(state, "ok") {
        return "";
    }
    return output;
}


import "common/map";
