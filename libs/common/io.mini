/// Common output helpers built on primitive I/O.
//

/// Write every supplied value followed by one newline and return the write result.
import "common/list";
import "common/json";
fn io_write_line() {
    values := fn_args();
    position := 0;
    while position < list_length(values) {
        io_write(list_get(values, position));
        position = position + 1;
    }
    return io_write("\n");
}
