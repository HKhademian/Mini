/// Map helpers built on the map builtins.
include "list.mini";

/// Build a map from alternating key and value arguments.
///
/// A repeated key takes the last supplied value, matching map_set. A trailing
/// key without a value is ignored, so an odd argument count still yields a map.
fn map_of() {
    entries := fn_args();
    result := map_new();
    position := 0;
    while position + 1 < list_length(entries) {
        map_set(result, list_get(entries, position), list_get(entries, position + 1));
        position = position + 2;
    }
    return result;
}
