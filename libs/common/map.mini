/// Map functions with Mini fallbacks and target-provided representation primitives.

import "common/list";
import "common/panic";
import "common/value";

/// Create a fresh map; targets without a map host implementation panic.
fn map_new() {
    return panic("map_new requires a host implementation");
}

/// Read one map value, returning zero when the key is absent.
fn map_get(items, key) {
    return panic("map_get requires a host implementation");
}

/// Store one map value and return zero.
fn map_set(items, key, value) {
    return panic("map_set requires a host implementation");
}

/// Test whether a text key is present in a map.
fn map_has(items, key) {
    return panic("map_has requires a host implementation");
}

/// Return the map's keys as a fresh list.
fn map_keys(items) {
    return panic("map_keys requires a host implementation");
}

/// Delete a key if present and return zero.
fn map_delete(items, key) {
    return panic("map_delete requires a host implementation");
}

/// Return a shallow map copy.
fn map_copy(items) {
    if !value_is_map(items) {
        return map_new();
    }
    result := map_new();
    keys := map_keys(items);
    position := 0;
    while position < list_length(keys) {
        key := list_get(keys, position);
        map_set(result, key, map_get(items, key));
        position = position + 1;
    }
    return result;
}

/// Merge map arguments into a fresh map; later maps replace earlier values.
fn map_merge() {
    sources := fn_args();
    result := map_new();
    source_index := 0;
    while source_index < list_length(sources) {
        source := list_get(sources, source_index);
        if value_is_map(source) {
            keys := map_keys(source);
            key_index := 0;
            while key_index < list_length(keys) {
                key := list_get(keys, key_index);
                map_set(result, key, map_get(source, key));
                key_index = key_index + 1;
            }
        }
        source_index = source_index + 1;
    }
    return result;
}

/// Build a map from alternating key and value arguments.
///
/// A repeated key takes the last supplied value, matching map_set. A key
/// without a value takes 0, so the entry still exists and map_of("k") equals
/// map_of("k", 0).
fn map_of() {
    entries := fn_args();
    result := map_new();
    position := 0;
    while position < list_length(entries) {
        key := list_get(entries, position);
        value := 0;
        if position + 1 < list_length(entries) {
            value = list_get(entries, position + 1);
        }
        map_set(result, key, value);
        position = position + 2;
    }
    return result;
}
