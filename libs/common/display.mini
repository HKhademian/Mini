import "common/json";
import "common/list";
import "common/number";
import "common/value";

/// Convert a value to its display text.
fn to_text(value) {
    kind := value_kind(value);
    if kind == "text" {
        return value;
    }
    if kind == "number" {
        return number_to_text(value);
    }
    if kind == "boolean" {
        if value {
            return "true";
        }
        return "false";
    }
    if kind == "list" || kind == "map" {
        return json_text(value);
    }
    return "0";
}

/// Join display-converted values using a text separator.
fn value_join() {
    values := fn_args();
    if list_length(values) == 0 || !value_is_text(list_get(values, 0)) {
        return "";
    }
    separator := list_get(values, 0);
    output := "";
    position := 1;
    while position < list_length(values) {
        if position > 1 {
            output = output + separator;
        }
        output = output + to_text(list_get(values, position));
        position = position + 1;
    }
    return output;
}
