import "common/list";
import "common/number";
import "common/process-panic";
import "common/value";

/// Return the number of Unicode scalar values; targets without a host implementation panic.
fn text_length(source) {
    return process_panic("text_length requires a host implementation");
}

/// Return one Unicode scalar value as text; targets without a host implementation panic.
fn text_get(source, index) {
    return process_panic("text_get requires a host implementation");
}

/// Return the Unicode scalar at a character index, or zero when unavailable.
fn text_to_code(source, index) {
    return process_panic("text_to_code requires a host implementation");
}

/// Construct one Unicode code point; targets without a host implementation panic.
fn text_from_code(code) {
    return process_panic("text_from_code requires a host implementation");
}

/// Return one Unicode scalar code per character index.
fn text_to_codes(source) {
    codes := list_new();
    if !value_is_text(source) {
        return codes;
    }
    position := 0;
    while position < text_length(source) {
        list_set(codes, list_length(codes), text_to_code(source, position));
        position = position + 1;
    }
    return codes;
}

/// Return one text value per Unicode scalar character index.
fn text_to_chars(source) {
    characters := list_new();
    if !value_is_text(source) {
        return characters;
    }
    position := 0;
    while position < text_length(source) {
        list_set(characters, list_length(characters), text_get(source, position));
        position = position + 1;
    }
    return characters;
}

/// Build text by encoding each valid Unicode scalar code in a list.
fn text_from_codes(codes) {
    if !value_is_list(codes) {
        return "";
    }
    characters := list_new();
    position := 0;
    while position < list_length(codes) {
        list_set(characters, list_length(characters), text_from_code(list_get(codes, position)));
        position = position + 1;
    }
    return list_join("", characters);
}

/// Merge a list of character texts into one text value.
fn text_from_chars(characters) {
    return list_join("", characters);
}

/// Merge text arguments into one text value, ignoring non-text arguments.
fn text_merge() {
    values := fn_args();
    output := "";
    position := 0;
    while position < list_length(values) {
        value := list_get(values, position);
        if value_is_text(value) {
            output = output + value;
        }
        position = position + 1;
    }
    return output;
}

/// Join text arguments with a separator; non-text arguments contribute empty text.
fn text_join() {
    values := fn_args();
    if list_length(values) == 0 {
        return "";
    }
    separator := list_get(values, 0);
    if !value_is_text(separator) {
        return "";
    }
    output := "";
    position := 1;
    while position < list_length(values) {
        if position > 1 {
            output = output + separator;
        }
        value := list_get(values, position);
        if value_is_text(value) {
            output = output + value;
        }
        position = position + 1;
    }
    return output;
}

/// Return lines split on LF or CRLF, retaining a final empty line.
fn text_split_lines(source) {
    lines := text_split(source, "\n");
    position := 0;
    while position < list_length(lines) - 1 {
        line := list_get(lines, position);
        if text_length(line) > 0 && text_get(line, text_length(line) - 1) == "\r" {
            list_set(lines, position, text_slice(line, 0, text_length(line) - 1));
        }
        position = position + 1;
    }
    return lines;
}

/// Slice text by Unicode scalar indexes and zero-based end-exclusive bounds; negative bounds count from the end.
fn text_slice(source, start, end) {
    if value_kind(source) != "text" || value_kind(start) != "number" || value_kind(end) != "number"
        || number_floor(start) != start || number_floor(end) != end {
        return "";
    }
    size := text_length(source);
    if start < 0 {
        start = size + start;
    }
    if end < 0 {
        end = size + end;
    }
    if start < 0 {
        start = 0;
    }
    if end < 0 {
        end = 0;
    }
    if start > size {
        start = size;
    }
    if end > size {
        end = size;
    }
    if end <= start {
        return "";
    }
    parts := list_new();
    position := start;
    while position < end {
        list_set(parts, list_length(parts), text_get(source, position));
        position = position + 1;
    }
    return list_join("", parts);
}

/// Return output lines with nonempty lines prefixed by four spaces and joined by LF.
fn text_indent_output(output) {
    lines := text_split_lines(output);
    result := list_new();
    position := 0;
    while position < list_length(lines) {
        line := list_get(lines, position);
        if text_length(line) > 0 {
            list_set(result, list_length(result), "    " + line);
        }
        position = position + 1;
    }
    return list_join("\n", result);
}

/// Return whether text ends with suffix.
fn text_ends_with(source, suffix) {
    size := text_length(suffix);
    length := text_length(source);
    if size > length {
        return false;
    }
    return text_slice(source, length - size, length) == suffix;
}

/// Return whether character is an ASCII identifier start.
fn text_is_letter(character) {
    return text_find("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz_", character) >= 0;
}

/// Return whether character is a decimal digit.
fn text_is_digit(character) {
    return text_find("0123456789", character) >= 0;
}

/// Return whether character continues an identifier.
fn text_is_identifier_part(character) {
    return text_is_letter(character) || text_is_digit(character);
}

/// Return whether value is one of the accepted two-character symbols.
fn text_is_two_character_symbol(value) {
    return value == "==" || value == "!=" || value == "<=" || value == ">=" || value == "&&" || value == "||"
        || value == ":=";
}

/// Return whether text starts with prefix.
fn text_starts_with(source, prefix) {
    size := text_length(prefix);
    if size > text_length(source) {
        return false;
    }
    return text_slice(source, 0, size) == prefix;
}

/// Remove trailing CR/LF characters.
fn text_chomp(text) {
    length := text_length(text);
    while length > 0 && (text_get(text, length - 1) == "\n" || text_get(text, length - 1) == "\r") {
        length = length - 1;
    }
    return text_slice(text, 0, length);
}

/// Remove trailing spaces, tabs, and CR characters.
fn text_trim_end(text) {
    length := text_length(text);
    while length > 0 {
        character := text_get(text, length - 1);
        if character == " " || character == "\t" || character == "\r" {
            length = length - 1;
        } else {
            return text_slice(text, 0, length);
        }
    }
    return "";
}

/// Remove leading and trailing spaces, tabs, CR, and LF characters.
fn text_trim(text) {
    start := 0;
    end := text_length(text);
    while start < end && text_find(" \t\r\n", text_get(text, start)) >= 0 {
        start = start + 1;
    }
    while end > start && text_find(" \t\r\n", text_get(text, end - 1)) >= 0 {
        end = end - 1;
    }
    return text_slice(text, start, end);
}

/// Search for a match starting at a Unicode scalar offset; return -1 when absent.
fn text_find_from(text, needle, start) {
    text_size := text_length(text);
    needle_size := text_length(needle);
    if needle_size == 0 {
        if start <= text_size {
            return start;
        }
        return -1;
    }
    position := start;
    while position + needle_size <= text_size {
        offset := 0;
        matched := true;
        while offset < needle_size {
            if text_get(text, position + offset) != text_get(needle, offset) {
                matched = false;
                offset = needle_size;
            } else {
                offset = offset + 1;
            }
        }
        if matched {
            return position;
        }
        position = position + 1;
    }
    return -1;
}

/// Return the first Unicode scalar index of a match, or -1.
fn text_find(text, needle) {
    if !value_is_text(text) || !value_is_text(needle) {
        return -1;
    }
    return text_find_from(text, needle, 0);
}

/// Split text around each divider, preserving empty fields.
fn text_split(text, divider) {
    if !value_is_text(text) || !value_is_text(divider) {
        return list_new();
    }
    if divider == "" {
        whole := list_new();
        list_set(whole, 0, text);
        return whole;
    }
    result := list_new();
    start := 0;
    position := text_find_from(text, divider, start);
    while position >= 0 {
        list_set(result, list_length(result), text_slice(text, start, position));
        start = position + text_length(divider);
        position = text_find_from(text, divider, start);
    }
    list_set(result, list_length(result), text_slice(text, start, text_length(text)));
    return result;
}

/// Normalize one byte value for UTF-8 conversion.
fn text_byte_at(bytes, index) {
    if !value_is_list(bytes) || index < 0 || index >= list_length(bytes) {
        return 0;
    }
    value := list_get(bytes, index);
    if !value_is_number(value) || number_floor(value) != value {
        return 0;
    }
    byte := number_mod(value, 256);
    if byte < 0 {
        byte = byte + 256;
    }
    return byte;
}

/// Append one byte value to the result.
fn text_byte_push(bytes, value) {
    list_set(bytes, list_length(bytes), value);
    return 0;
}

/// Encode text as UTF-8 bytes.
fn text_to_bytes(text) {
    bytes := list_new();
    if !value_is_text(text) {
        return bytes;
    }
    position := 0;
    while position < text_length(text) {
        code := text_to_code(text, position);
        if code < 0 {
            code = 65533;
        }
        if code <= 127 {
            text_byte_push(bytes, code);
        } else {
            if code <= 2047 {
                text_byte_push(bytes, 192 + number_div(code, 64));
                text_byte_push(bytes, 128 + number_mod(code, 64));
            } else {
                if code <= 65535 {
                    if code >= 55296 && code <= 57343 {
                        text_byte_push(bytes, 239);
                        text_byte_push(bytes, 191);
                        text_byte_push(bytes, 189);
                    } else {
                        text_byte_push(bytes, 224 + number_div(code, 4096));
                        text_byte_push(bytes, 128 + number_mod(number_div(code, 64), 64));
                        text_byte_push(bytes, 128 + number_mod(code, 64));
                    }
                } else {
                    text_byte_push(bytes, 240 + number_div(code, 262144));
                    text_byte_push(bytes, 128 + number_mod(number_div(code, 4096), 64));
                    text_byte_push(bytes, 128 + number_mod(number_div(code, 64), 64));
                    text_byte_push(bytes, 128 + number_mod(code, 64));
                }
            }
        }
        position = position + 1;
    }
    return bytes;
}

/// Decode UTF-8 bytes, replacing invalid sequences.
fn text_from_bytes(bytes) {
    if !value_is_list(bytes) {
        return "";
    }
    parts := list_new();
    position := 0;
    while position < list_length(bytes) {
        first := text_byte_at(bytes, position);
        if first < 128 {
            list_set(parts, list_length(parts), text_from_code(first));
            position = position + 1;
        } else {
            if first >= 194 && first <= 223 && position + 1 < list_length(bytes) {
                second := text_byte_at(bytes, position + 1);
                if second >= 128 && second <= 191 {
                    list_set(parts, list_length(parts), text_from_code(number_mul(first - 192, 64) + (second - 128)));
                    position = position + 2;
                } else {
                    list_set(parts, list_length(parts), text_from_code(65533));
                    position = position + 1;
                }
            } else {
                if first >= 224 && first <= 239 && position + 2 < list_length(bytes) {
                    second := text_byte_at(bytes, position + 1);
                    third := text_byte_at(bytes, position + 2);
                    if second >= 128 && second <= 191 && third >= 128 && third <= 191 {
                        list_set(
                            parts,
                            list_length(parts),
                            text_from_code(number_mul(first - 224, 4096) + number_mul(second - 128, 64) + (third - 128))
                        );
                        position = position + 3;
                    } else {
                        list_set(parts, list_length(parts), text_from_code(65533));
                        position = position + 1;
                    }
                } else {
                    if first >= 240 && first <= 244 && position + 3 < list_length(bytes) {
                        second := text_byte_at(bytes, position + 1);
                        third := text_byte_at(bytes, position + 2);
                        fourth := text_byte_at(bytes, position + 3);
                        if second >= 128 && second <= 191 && third >= 128 && third <= 191
                            && fourth >= 128 && fourth <= 191 {
                            list_set(
                                parts,
                                list_length(parts),
                                text_from_code(
                                    number_mul(first - 240, 262144) + number_mul(second - 128, 4096)
                                + number_mul(third - 128, 64) + (fourth - 128)
                                )
                            );
                            position = position + 4;
                        } else {
                            list_set(parts, list_length(parts), text_from_code(65533));
                            position = position + 1;
                        }
                    } else {
                        list_set(parts, list_length(parts), text_from_code(65533));
                        position = position + 1;
                    }
                }
            }
        }
    }
    return list_join("", parts);
}
