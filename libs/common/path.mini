import "common/list";
import "./text";

/// Join two path components.
fn path_join(left, right) {
    if left == "" {
        return right;
    }
    if right == "" {
        return left;
    }
    if text_ends_with(left, "/") || text_ends_with(left, "\\") {
        return left + right;
    }
    return left + "/" + right;
}

/// Create an empty file in a fresh temporary directory and return its path.
fn path_temp_file() {
    path := path_join(path_temp_directory(), "file");
    file_write(path, "");
    return path;
}

/// Remove a file when present; leave directories unchanged.
fn file_remove(path) {
    if path != "" && path_is_exists(path) && !path_is_directory(path) {
        return path_remove(path);
    }
    return 0;
}

/// Remove an empty directory when present; leave non-empty paths unchanged.
fn directory_remove(path) {
    if path != "" && path_is_directory(path) && list_length(directory_list(path)) == 0 {
        return path_remove(path);
    }
    return 0;
}

/// Return the parent directory of a path.
fn path_parent(path) {
    position := text_length(path) - 1;
    while position >= 0 {
        character := text_get(path, position);
        if character == "/" || character == "\\" {
            return text_slice(path, 0, position);
        }
        position = position - 1;
    }
    return "";
}

/// Return the final path component.
fn path_basename(path) {
    position := text_length(path) - 1;
    while position >= 0 {
        character := text_get(path, position);
        if character == "/" || character == "\\" {
            return text_slice(path, position + 1, text_length(path));
        }
        position = position - 1;
    }
    return path;
}

/// Return whether a path is absolute.
fn path_is_absolute(path) {
    if text_starts_with(path, "/") {
        return true;
    }
    return text_length(path) > 2 && text_get(path, 1) == ":"
        && (text_get(path, 2) == "/" || text_get(path, 2) == "\\");
}

/// Collapse dot segments in a slash-separated path.
fn path_normalize(path) {
    absolute := text_starts_with(path, "/");
    parts := text_split(path, "/");
    stack := list_new();
    position := 0;
    while position < list_length(parts) {
        part := list_get(parts, position);
        if part == "" || part == "." {
        } else {
            if part == ".." {
                if list_length(stack) > 0 && list_get(stack, list_length(stack) - 1) != ".." {
                    list_set(stack, list_length(stack) - 1, "");
                    list_set(stack, list_length(stack), "");
                    kept := list_new();
                    index := 0;
                    while index < list_length(stack) {
                        if list_get(stack, index) != "" {
                            list_set(kept, list_length(kept), list_get(stack, index));
                        }
                        index = index + 1;
                    }
                    stack = kept;
                } else {
                    if !absolute {
                        list_set(stack, list_length(stack), part);
                    }
                }
            } else {
                list_set(stack, list_length(stack), part);
            }
        }
        position = position + 1;
    }
    output := list_join(stack, "/");
    if absolute {
        return "/" + output;
    }
    return output;
}

/// Resolve a path against a base directory.
fn path_resolve(base, path) {
    if path_is_absolute(path) {
        return path_normalize(path);
    }
    return path_normalize(path_join(base, path));
}
