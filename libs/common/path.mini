include "text.mini";

/// Join two path components.
fn path_join(left, right) {
    if (left == "") {
        return right;
    }
    if (right == "") {
        return left;
    }
    if (text_ends_with(left, "/") || text_ends_with(left, "\\")) {
        return left + right;
    }
    return left + "/" + right;
}

/// Return the parent directory of a path.
fn path_parent(path) {
    var position = text_length(path) - 1;
    while (position >= 0) {
        var character = text_get(path, position);
        if (character == "/" || character == "\\") {
            return text_slice(path, 0, position);
        }
        position = position - 1;
    }
    return "";
}

/// Return the final path component.
fn path_basename(path) {
    var position = text_length(path) - 1;
    while (position >= 0) {
        var character = text_get(path, position);
        if (character == "/" || character == "\\") {
            return text_slice(path, position + 1, text_length(path));
        }
        position = position - 1;
    }
    return path;
}

/// Return whether a path is absolute.
fn path_is_absolute(path) {
    if (text_starts_with(path, "/")) {
        return true;
    }
    return text_length(path) > 2 && text_get(path, 1) == ":"
        && (text_get(path, 2) == "/" || text_get(path, 2) == "\\");
}

/// Collapse dot segments in a slash-separated path.
fn path_normalize(path) {
    var absolute = text_starts_with(path, "/");
    var parts = text_split(path, "/");
    var stack = list_new();
    var position = 0;
    while (position < list_length(parts)) {
        var part = list_get(parts, position);
        if (part == "" || part == ".") {
        } else {
            if (part == "..") {
                if (list_length(stack) > 0 && list_get(stack, list_length(stack) - 1) != "..") {
                    list_set(stack, list_length(stack) - 1, "");
                    list_set(stack, list_length(stack), "");
                    var kept = list_new();
                    var index = 0;
                    while (index < list_length(stack)) {
                        if (list_get(stack, index) != "") {
                            list_set(kept, list_length(kept), list_get(stack, index));
                        }
                        index = index + 1;
                    }
                    stack = kept;
                } else {
                    if (!absolute) {
                        list_set(stack, list_length(stack), part);
                    }
                }
            } else {
                list_set(stack, list_length(stack), part);
            }
        }
        position = position + 1;
    }
    var output = list_to_text(stack, "/");
    if (absolute) {
        return "/" + output;
    }
    return output;
}

/// Resolve a path against a base directory.
fn path_resolve(base, path) {
    if (path_is_absolute(path)) {
        return path_normalize(path);
    }
    return path_normalize(path_join(base, path));
}
