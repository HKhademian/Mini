/// Run case scenarios through the shared case runner.
/// Usage: node dist/test.js [--jobs N] [--verbose | --mute] [FILTER]
///        node dist/test.js --unit [--jobs N] [--verbose | --mute] [FILTER]
///        node dist/test.js --file CASE.json [--jobs N] [--verbose | --mute]
///        node dist/test.js --candidate COMPILER.js [--jobs N] [--verbose | --mute] [FILTER]
/// Shows periodic progress by default; --verbose shows each result and --mute hides progress.

import "core/io";
import "core/file";
import "core/json";
import "core/list";
import "core/map";
import "core/number";
import "util/path";
import "core/process";
import "core/text";
import "util/process";
import "util/io";
import "util/result";
import "./cases";

/// Report usage and stop.
fn test_usage() {
    io_write_error("usage: mini-test [--jobs N] [--verbose | --mute] [FILTER]\n");
    process_exit(1);
    return 0;
}

/// Run selected fixtures and return the process status.
fn test_run(root, filter, file, candidate, verbose, mute, jobs, report_workers) {
    fixtures := list_new();
    if file != "" {
        loaded := case_load_case(file);
        if result_is_fail(loaded) {
            io_write_error(result_get_message(loaded) + "\n");
            process_exit(1);
        }
        list_set(fixtures, 0, map_get(loaded, "fixture"));
    } else {
        selected := case_load_cases(filter, root);
        if result_is_fail(selected) {
            io_write_error(result_get_message(selected) + "\n");
            process_exit(1);
        }
        fixtures = map_get(selected, "fixtures");
    }
    if candidate != "" {
        return test_candidate(fixtures, root, candidate, verbose, mute, jobs, report_workers);
    }
    tasks := list_new();
    pending := 0;
    count := 0;
    fixture_index := 0;
    while fixture_index < list_length(fixtures) {
        fixture := list_get(fixtures, fixture_index);
        definition := map_get(fixture, "definition");
        scenarios := map_get(definition, "cases");
        scenario_index := 0;
        while scenario_index < list_length(scenarios) {
            scenario := list_get(scenarios, scenario_index);
            id := map_get(definition, "id");
            name := map_get(scenario, "name");
            if map_has(definition, "pending") {
                pending = pending + 1;
                if !verbose && !mute {
                    io_write_line("PENDING " + id + "/" + name + ": " + map_get(definition, "pending"));
                }
                task := map_new();
                map_set(task, "kind", "pending");
                map_set(task, "label", id + "/" + name);
                map_set(task, "message", map_get(definition, "pending"));
                list_set(tasks, list_length(tasks), task);
            } else {
                count = count + 1;
                task := map_new();
                map_set(task, "kind", "case");
                map_set(task, "file", map_get(fixture, "path"));
                map_set(task, "scenario", scenario_index);
                map_set(task, "compiler", candidate);
                map_set(task, "label", id + "/" + name);
                if map_get(definition, "kind") == "tool" {
                    map_set(task, "serial", true);
                }
                list_set(tasks, list_length(tasks), task);
            }
            scenario_index = scenario_index + 1;
        }
        fixture_index = fixture_index + 1;
    }
    results := test_run_tasks(tasks, root, jobs, !verbose && !mute, !verbose, report_workers);
    failures := test_report_results(tasks, results, verbose, !verbose);
    io_write(number_to_text(count - failures) + "/" + number_to_text(count) + " scenarios passed\n");
    if pending > 0 {
        io_write(number_to_text(pending) + " scenarios pending\n");
    }
    if failures > 0 || (pending > 0 && (file != "" || count == 0)) {
        return 1;
    }
    return 0;
}

/// Run non-tool cases through a candidate compiler and report the summary.
fn test_candidate(fixtures, root, compiler, verbose, mute, jobs, report_workers) {
    tasks := list_new();
    pending := 0;
    tools := 0;
    count := 0;
    fixture_index := 0;
    while fixture_index < list_length(fixtures) {
        fixture := list_get(fixtures, fixture_index);
        definition := map_get(fixture, "definition");
        kind := map_get(definition, "kind");
        if kind == "tool" {
            tools = tools + 1;
        } else {
            if map_has(definition, "pending") {
                pending = pending + 1;
                if !verbose && !mute {
                    io_write_line("PENDING " + map_get(definition, "id") + ": " + map_get(definition, "pending"));
                }
                task := map_new();
                map_set(task, "kind", "pending");
                map_set(task, "label", map_get(definition, "id"));
                map_set(task, "message", map_get(definition, "pending"));
                list_set(tasks, list_length(tasks), task);
            } else {
                scenarios := map_get(definition, "cases");
                scenario_index := 0;
                while scenario_index < list_length(scenarios) {
                    scenario := list_get(scenarios, scenario_index);
                    task := map_new();
                    map_set(task, "kind", "case");
                    map_set(task, "file", map_get(fixture, "path"));
                    map_set(task, "scenario", scenario_index);
                    map_set(task, "compiler", compiler);
                    map_set(task, "label", map_get(definition, "id") + "/" + map_get(scenario, "name"));
                    list_set(tasks, list_length(tasks), task);
                    count = count + 1;
                    scenario_index = scenario_index + 1;
                }
            }
        }
        fixture_index = fixture_index + 1;
    }
    results := test_run_tasks(tasks, root, jobs, !verbose && !mute, !verbose, report_workers);
    failed := test_report_results(tasks, results, verbose, !verbose);
    passed := count - failed;
    io_write(number_to_text(passed) + "/" + number_to_text(count) + " mini-source scenarios passed\n");
    if pending > 0 {
        io_write(number_to_text(pending) + " cases pending\n");
    }
    if tools > 0 {
        io_write(number_to_text(tools) + " tool cases skipped; run mini test for those\n");
    }
    if failed > 0 {
        return 1;
    }
    return 0;
}

/// Compile and run every matching test/*.test.mini program.
fn test_units(root, filter, verbose, mute, jobs, report_workers) {
    directory := path_join(root, "test");
    entries := directory_list(directory);
    tasks := list_new();
    position := 0;
    while position < list_length(entries) {
        name := list_get(entries, position);
        if text_ends_with(name, ".test.mini") && (filter == "" || text_find(name, filter) >= 0) {
            task := map_new();
            map_set(task, "kind", "unit");
            map_set(task, "name", name);
            map_set(task, "label", name);
            list_set(tasks, list_length(tasks), task);
        }
        position = position + 1;
    }
    results := test_run_tasks(tasks, root, jobs, !verbose && !mute, !verbose, report_workers);
    failed := test_report_results(tasks, results, verbose, !verbose);
    passed := list_length(tasks) - failed;
    io_write(number_to_text(passed) + "/" + number_to_text(list_length(tasks)) + " unit tests passed\n");
    if failed > 0 || list_length(tasks) == 0 {
        return 1;
    }
    return 0;
}

/// Run one queued worker, returning its structured result.
fn test_worker(task, root) {
    if map_get(task, "kind") == "case" {
        loaded := case_load_case(map_get(task, "file"));
        if result_is_fail(loaded) {
            return loaded;
        }
        fixture := map_get(loaded, "fixture");
        scenario := list_get(map_get(map_get(fixture, "definition"), "cases"), map_get(task, "scenario"));
        return case_verify_scenario(fixture, scenario, root, map_get(task, "compiler"));
    }
    return test_unit_one(root, map_get(task, "name"));
}

/// Compile and run one unit-test file.
fn test_unit_one(root, name) {
    compiler := project_compiler_entry(root);
    source := path_join(path_join(root, "test"), name);
    work := path_temp_directory();
    if work == "" {
        return result_fail("cannot create a temporary directory");
    }
    output := path_join(work, "test.generated.js");
    compile_command := compiler;
    compile_args := list_new();
    if text_ends_with(compiler, ".js") {
        compile_command = "node";
        compile_args = list_of(compiler, source, output);
    } else {
        compile_args = list_of(source, output);
    }
    compiled := process_capture(compile_command, compile_args, root, list_new());
    if map_get(compiled, "status") != 0 {
        path_remove(work);
        return result_fail(text_from_bytes(map_get(compiled, "stderr")));
    }
    result := process_capture("node", list_of(output, root), root, list_new());
    path_remove(work);
    if map_get(result, "status") != 0 {
        return result_fail(text_from_bytes(map_get(result, "stderr")));
    }
    return result_ok();
}

/// Run queued tests through the bounded Node worker pool.
fn test_run_tasks(tasks, root, jobs, progress, report_failures, report_workers) {
    work := path_temp_directory();
    if work == "" {
        io_write_error("FAIL test worker pool: cannot create test worker directory\n");
        return test_failed_results(tasks, "cannot create test worker directory");
    }
    request_path := path_join(work, "request.json");
    results_path := path_join(work, "results.json");
    request := map_new();
    map_set(request, "jobs", jobs);
    worker := process_env("MINI_TEST_WORKER");
    if worker == "" {
        worker = path_join(root, "dist/test.js");
    }
    map_set(request, "script", worker);
    map_set(request, "tasks", tasks);
    map_set(request, "progress", progress);
    map_set(request, "reportFailures", report_failures);
    map_set(request, "reportWorkers", report_workers);
    file_write(request_path, json_text(request));
    options := map_new();
    map_set(options, "command", "node");
    map_set(options, "arguments", list_of(path_join(root, "tools/test-pool.ts"), request_path, results_path));
    map_set(options, "mode", "inherit");
    result := process_spawn(options);
    if map_get(result, "status") != 0 {
        path_remove(work);
        message := "test worker pool failed: " + map_get(result, "error");
        io_write_error("FAIL test worker pool: " + message + "\n");
        return test_failed_results(tasks, message);
    }
    if !path_is_exists(results_path) {
        path_remove(work);
        io_write_error("FAIL test worker pool: no results returned\n");
        return test_failed_results(tasks, "test worker pool returned no results");
    }
    parsed := json_value(file_read(results_path));
    path_remove(work);
    if result_is_fail(parsed) {
        io_write_error("FAIL test worker pool: invalid results returned\n");
        return test_failed_results(tasks, "test worker pool returned invalid results");
    }
    return result_get_value(parsed);
}

/// Return one failed outcome per task after a worker-pool error.
fn test_failed_results(tasks, message) {
    failed := list_new();
    position := 0;
    while position < list_length(tasks) {
        outcome := map_new();
        map_set(outcome, "status", 1);
        map_set(outcome, "error", message);
        list_set(failed, position, outcome);
        position = position + 1;
    }
    return failed;
}

/// Print worker results in task order and return the failure count.
fn test_report_results(tasks, results, verbose, failures_reported) {
    failed := 0;
    position := 0;
    while position < list_length(tasks) {
        task := list_get(tasks, position);
        outcome := list_get(results, position);
        if map_get(task, "kind") == "pending" {
            if verbose {
                io_write_line("PENDING " + map_get(task, "label") + ": " + map_get(task, "message"));
            }
        } else {
            worker_result := result_fail("worker did not return a result");
            if map_get(outcome, "status") == 0 {
                parsed := json_value(map_get(outcome, "stdout"));
                if result_is_ok(parsed) {
                    worker_result = result_get_value(parsed);
                }
            }
            label := map_get(task, "label");
            if !result_is_ok(worker_result) {
                failed = failed + 1;
                message := map_get(outcome, "stderr");
                if message == "" {
                    message = map_get(outcome, "error");
                }
                if message == "" {
                    message = result_get_message(worker_result);
                }
                if !failures_reported || verbose {
                    io_write_error("FAIL " + label + ": " + message + "\n");
                }
            } else {
                if verbose {
                    io_write_line("PASS " + label);
                }
            }
        }
        position = position + 1;
    }
    return failed;
}
