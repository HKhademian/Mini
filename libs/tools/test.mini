/// Run case scenarios through the shared case runner.
/// Usage: node dist/test.js [--verbose] [FILTER]
///        node dist/test.js --unit [--verbose] [FILTER]
///        node dist/test.js --file CASE.json [--verbose]
///        node dist/test.js --candidate COMPILER.js [--verbose] [FILTER]
/// Prints scenario summaries by default, showing PASS lines when --verbose is set.

import "core/number";
import "core/map";
import "core/io";
import "core/text";
import "core/list";
import "core/path";
import "core/process";
import "util/process";
import "./cases";
import "util/io";

/// Report usage and stop.
fn test_usage() {
    io_write_error("usage: mini-test [--verbose] [FILTER]\n");
    process_exit(1);
    return 0;
}

/// Run selected fixtures and return the process status.
fn test_run(root, filter, file, candidate, verbose) {
    fixtures := list_new();
    if file != "" {
        loaded := case_load_case(file);
        if result_is_fail(loaded) {
            io_write_error(result_get_message(loaded) + "\n");
            process_exit(1);
        }
        list_set(fixtures, 0, map_get(loaded, "fixture"));
    } else {
        selected := case_load_cases(filter, root);
        if result_is_fail(selected) {
            io_write_error(result_get_message(selected) + "\n");
            process_exit(1);
        }
        fixtures = map_get(selected, "fixtures");
    }
    if candidate != "" {
        return test_candidate(fixtures, root, candidate, verbose);
    }
    failures := 0;
    count := 0;
    pending := 0;
    fixture_index := 0;
    while fixture_index < list_length(fixtures) {
        fixture := list_get(fixtures, fixture_index);
        definition := map_get(fixture, "definition");
        scenarios := map_get(definition, "cases");
        scenario_index := 0;
        while scenario_index < list_length(scenarios) {
            scenario := list_get(scenarios, scenario_index);
            id := map_get(definition, "id");
            name := map_get(scenario, "name");
            if map_has(definition, "pending") {
                pending = pending + 1;
                if verbose {
                    io_write_line("PENDING " + id + "/" + name + ": " + map_get(definition, "pending"));
                }
            } else {
                count = count + 1;
                result := case_verify_scenario(fixture, scenario, root, "");
                if result_is_ok(result) {
                    if verbose {
                        io_write_line("PASS " + id + "/" + name);
                    }
                } else {
                    failures = failures + 1;
                    io_write_error("FAIL " + id + "/" + name + ": " + result_get_message(result) + "\n");
                }
            }
            scenario_index = scenario_index + 1;
        }
        fixture_index = fixture_index + 1;
    }
    io_write(number_to_text(count - failures) + "/" + number_to_text(count) + " scenarios passed\n");
    if pending > 0 {
        io_write(number_to_text(pending) + " scenarios pending\n");
    }
    if failures > 0 || (pending > 0 && (file != "" || count == 0)) {
        return 1;
    }
    return 0;
}

/// Run non-tool cases through a candidate compiler and report the summary.
fn test_candidate(fixtures, root, compiler, verbose) {
    passed := 0;
    failed := 0;
    pending := 0;
    tools := 0;
    fixture_index := 0;
    while fixture_index < list_length(fixtures) {
        fixture := list_get(fixtures, fixture_index);
        definition := map_get(fixture, "definition");
        kind := map_get(definition, "kind");
        if kind == "tool" {
            tools = tools + 1;
        } else {
            if map_has(definition, "pending") {
                pending = pending + 1;
                if verbose {
                    io_write_line("PENDING " + map_get(definition, "id") + ": " + map_get(definition, "pending"));
                }
            } else {
                scenarios := map_get(definition, "cases");
                scenario_index := 0;
                while scenario_index < list_length(scenarios) {
                    scenario := list_get(scenarios, scenario_index);
                    result := case_verify_scenario(fixture, scenario, root, compiler);
                    if result_is_ok(result) {
                        passed = passed + 1;
                        if verbose {
                            io_write_line("PASS " + map_get(definition, "id") + "/" + map_get(scenario, "name"));
                        }
                    } else {
                        failed = failed + 1;
                        io_write_error(
                            "FAIL " + map_get(definition, "id") + "/" + map_get(scenario, "name")
                            + ": " + result_get_message(result) + "\n"
                        );
                    }
                    scenario_index = scenario_index + 1;
                }
            }
        }
        fixture_index = fixture_index + 1;
    }
    io_write(number_to_text(passed) + "/" + number_to_text(passed + failed) + " mini-source scenarios passed\n");
    if pending > 0 {
        io_write(number_to_text(pending) + " cases pending\n");
    }
    if tools > 0 {
        io_write(number_to_text(tools) + " tool cases skipped; run mini test for those\n");
    }
    if failed > 0 {
        return 1;
    }
    return 0;
}

/// Compile and run every matching test/*.test.mini program.
fn test_units(root, filter, verbose) {
    compiler := project_compiler_entry(root);
    directory := path_join(root, "test");
    entries := directory_list(directory);
    passed := 0;
    failed := 0;
    count := 0;
    position := 0;
    while position < list_length(entries) {
        name := list_get(entries, position);
        if text_ends_with(name, ".test.mini") && (filter == "" || text_find(name, filter) >= 0) {
            count = count + 1;
            source := path_join(directory, name);
            work := path_temp_directory();
            output := path_join(work, "test.generated.js");
            compile_command := compiler;
            compile_args := list_new();
            if text_ends_with(compiler, ".js") {
                compile_command = "node";
                compile_args = list_of(compiler, source, output);
            } else {
                compile_args = list_of(source, output);
            }
            compiled := process_capture(compile_command, compile_args, root, list_new());
            if map_get(compiled, "status") != 0 {
                failed = failed + 1;
                io_write_error("FAIL " + name + ": " + text_from_bytes(map_get(compiled, "stderr")));
            } else {
                run_args := list_of(output, root);
                result := process_capture("node", run_args, root, list_new());
                if map_get(result, "status") != 0 {
                    failed = failed + 1;
                    io_write_error("FAIL " + name + ": " + text_from_bytes(map_get(result, "stderr")));
                } else {
                    passed = passed + 1;
                    if verbose {
                        io_write_line("PASS " + name);
                    }
                }
            }
            path_remove(work);
        }
        position = position + 1;
    }
    io_write(number_to_text(passed) + "/" + number_to_text(count) + " unit tests passed\n");
    if failed > 0 || count == 0 {
        return 1;
    }
    return 0;
}
