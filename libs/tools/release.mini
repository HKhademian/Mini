/// Package committed sources into a release directory.
/// Usage: node dist/release.js OUTPUT [COMPONENT_TAG]
/// Never creates or publishes tags. Prints nothing on success.

import "common/io";
import "common/map";
import "common/value";
import "common/list";
import "common/text";
import "common/path";
import "common/process";
import "common/json";
import "common/result";
import "common/project";
import "common/file";
import "common/hash";

/// Report a release error and stop.
fn release_fail(message) {
    io_write_error(message + "\n");
    process_exit(1);
    return 0;
}

/// Remove trailing line endings.

/// Run a command and stop on failure.
fn release_run(command, args, directory) {
    result := process_capture(command, args, directory, list_new());
    if map_get(result, "status") != 0 {
        release_fail(
            command + " " + list_join(args, " ") + " failed:\n"
            + text_from_bytes(map_get(result, "stdout")) + text_from_bytes(map_get(result, "stderr"))
        );
    }
    done := result_ok();
    map_set(done, "stdout", map_get(result, "stdout"));
    map_set(done, "stderr", map_get(result, "stderr"));
    return done;
}

/// Run the extracted repository check and keep its output quiet on success.
fn release_check(check, directory) {
    result := process_capture(process_exec_path(), list_of(check, "--docs"), directory, list_new());
    if map_get(result, "status") != 0 {
        release_fail(
            path_basename(check) + " failed:\n"
            + text_from_bytes(map_get(result, "stdout")) + text_from_bytes(map_get(result, "stderr"))
        );
    }
    return 0;
}

/// Return a one-item text list.
fn release_text_list1(value) {
    items := list_new();
    list_set(items, 0, value);
    return items;
}

/// Read a JSON file or stop.
fn release_json(path) {
    parsed := json_parse_file(path);
    if result_is_fail(parsed) {
        release_fail(result_get_message(parsed));
    }
    return result_get_value(parsed);
}

/// Return the tag component registry key, or empty text.
fn release_component(name) {
    if name == "lang" {
        return "language";
    }
    if name == "mini" || name == "ast" || name == "compiler" || name == "bootstrap"
        || name == "std" || name == "check" || name == "format" || name == "verify"
        || name == "release" || name == "test" || name == "bench" || name == "cli"
        || name == "lsp" || name == "vscode" {
        return name;
    }
    return "";
}

/// Select one component from a grouped tag.
fn release_select(tag, current) {
    parts := text_split(tag, "-v");
    if list_length(parts) != 3 {
        release_fail("invalid component tag: " + tag);
    }
    component := release_component(list_get(parts, 0));
    if component == "" {
        release_fail("invalid component tag: " + tag);
    }
    group := list_get(parts, 1);
    version := list_get(parts, 2);
    if group != map_get(current, "group") {
        release_fail("tag must match assigned group version");
    }
    if value_kind(map_get(current, component)) != "text" || map_get(current, component) != version {
        release_fail("tag must match assigned " + component + " version");
    }
    selected := map_new();
    map_set(selected, "component", component);
    map_set(selected, "group", group);
    map_set(selected, "version", version);
    return selected;
}

/// Return the current compiler source hash.
fn release_compiler_hash(active) {
    sources := map_get(active, "sources");
    parts := list_new();
    position := 0;
    while position < list_length(sources) {
        path := list_get(sources, position);
        list_set(parts, list_length(parts), path + "\n" + file_read(path_join(project_root(), path)));
        position = position + 1;
    }
    return hash_sha256(list_join(parts, "\n"));
}

/// Return the Node version from a probe.
fn release_node_version(root) {
    args := list_new();
    list_set(args, 0, "-v");
    result := process_capture(process_exec_path(), args, root, list_new());
    return text_chomp(text_from_bytes(map_get(result, "stdout")));
}

/// Package a VS Code extension and return its asset identity.
fn release_vscode(directory, output, tooling) {
    current := release_json(path_join(directory, "config/versions.json"));
    version := map_get(current, "vscode");
    if !value_is_text(version) {
        release_fail("VS Code extension version is unassigned");
    }
    packager := path_join(tooling, "editors/vscode/node_modules/@vscode/vsce/vsce");
    bundler := path_join(tooling, "editors/vscode/node_modules/esbuild/bin/esbuild");
    if !path_is_exists(packager) {
        release_fail("install VS Code development dependencies with npm ci in editors/vscode");
    }
    if !path_is_exists(bundler) {
        release_fail("install the VS Code extension bundler with npm ci in editors/vscode");
    }
    extension := path_join(tooling, "editors/vscode");
    directory_create(path_join(extension, "dist"));
    bundle_args := list_of(
        path_join(extension, "src/extension.ts"),
        "--bundle",
        "--platform=node",
        "--format=cjs",
        "--external:vscode",
        "--outfile=" + path_join(extension, "dist/extension.cjs")
    );
    release_run(bundler, bundle_args, extension);
    directory_create(output);
    file := "mini-" + map_get(current, "group") + "-v" + version + ".vsix";
    destination := path_join(output, file);
    if path_is_exists(destination) {
        release_fail("VSIX output already exists");
    }
    package_args := list_of(
        packager,
        "package",
        "--no-dependencies",
        "--allow-missing-repository",
        "--skip-license",
        "--out",
        destination
    );
    release_run(process_exec_path(), package_args, extension);
    asset := map_new();
    map_set(asset, "file", file);
    map_set(asset, "sha256", hash_sha256(file_read_bytes(destination)));
    return asset;
}

/// Write release notes and checksums.
fn release_notes(output, title, label, commit, changelog) {
    short_commit := text_slice(commit, 0, 12);
    source := "\n\nSource commit: [**" + short_commit + "**" + text_slice(commit, 12, text_length(commit)) + "]";
    repository := process_env("GITHUB_REPOSITORY");
    if repository != "" {
        source = source + "(https://github.com/" + repository + "/commit/" + commit + ")";
    } else {
        source = source + "(commit " + commit + ")";
    }
    notes := "# " + title + "\n\nVersion: " + label + source;
    notes = notes + "\n\nBootstrap: verified fixed point\n\n" + changelog;
    file_write(path_join(output, "RELEASE-NOTES.md"), notes);
    return 0;
}

/// Write SHA256SUMS for every current output asset.
fn release_checksums(output) {
    assets := directory_list(output);
    lines := list_new();
    position := 0;
    while position < list_length(assets) {
        name := list_get(assets, position);
        list_set(
            lines,
            list_length(lines),
            hash_sha256(file_read_bytes(path_join(output, name))) + "  " + name + "\n"
        );
        position = position + 1;
    }
    file_write(path_join(output, "SHA256SUMS"), list_join(lines, ""));
    return 0;
}

/// Bootstrap generated tools in an extracted source tree.
fn release_bootstrap(source) {
    args := list_new();
    list_set(args, 0, path_join(source, "bin/bootstrap"));
    release_run(process_exec_path(), args, source);
    return 0;
}

/// Package committed sources and return success.
fn release_prepare(directory, output, tag) {
    if !path_is_absolute(output) {
        output = path_join(directory, output);
    }
    released := 0;
    status := release_run("git", list_of("status", "--porcelain"), directory);
    if text_chomp(text_from_bytes(map_get(status, "stdout"))) != "" {
        release_fail("release needs a clean checkout");
    }
    head := release_run("git", list_of("rev-parse", "HEAD"), directory);
    commit := text_chomp(text_from_bytes(map_get(head, "stdout")));
    current := release_json(path_join(directory, "config/versions.json"));
    active := release_json(path_join(directory, "config/compiler.json"));
    if tag != "" {
        released = release_select(tag, current);
        type := release_run("git", list_of("cat-file", "-t", "refs/tags/" + tag), directory);
        if text_chomp(text_from_bytes(map_get(type, "stdout"))) != "tag" {
            release_fail("release tag must be annotated");
        }
        tagged := release_run("git", list_of("rev-parse", "refs/tags/" + tag + "^{commit}"), directory);
        if text_chomp(text_from_bytes(map_get(tagged, "stdout"))) != commit {
            release_fail("release tag must match the current commit");
        }
    }
    bootstrap_config := release_json(path_join(directory, "config/bootstrap.json"));
    available := value_is_map(bootstrap_config);
    compiler_release := false;
    if released != 0 {
        component := map_get(released, "component");
        compiler_release = component == "mini" || component == "language" || component == "ast"
            || component == "compiler" || component == "bootstrap";
    }
    if !available && compiler_release {
        release_fail("this release requires a verified compiler bootstrap");
    }
    directory_create(output);
    if list_length(directory_list(output)) != 0 {
        release_fail("release output directory must be empty");
    }
    work := path_temp_directory();
    source := path_join(work, "source");
    directory_create(source);
    tracked := path_join(work, "source.tar");
    archive_result := release_run("git", list_of("archive", "--format=tar", commit), directory);
    file_write_bytes(tracked, map_get(archive_result, "stdout"));
    extract_args := list_of("-xf", tracked, "-C", source);
    release_run("tar", extract_args, work);
    release_bootstrap(source);
    release_check(path_join(source, "bin/mini-check"), source);
    bootstrap := 0;
    if available {
        verify_args := list_of(path_join(source, "dist/verify.js"), "--root", source);
        verified := release_run(process_exec_path(), verify_args, source);
        parsed := json_parse(text_from_bytes(map_get(verified, "stdout")));
        if result_is_ok(parsed) {
            bootstrap = result_get_value(parsed);
        }
    }
    label := "snapshot-" + text_slice(commit, 0, 12);
    if tag != "" {
        label = tag;
    }
    title := label;
    vsix := 0;
    if released != 0 && map_get(released, "component") == "vscode" {
        vsix = release_vscode(source, output, directory);
    }
    active_copy := map_new();
    map_set(active_copy, "entry", map_get(active, "entry"));
    map_set(active_copy, "sources", map_get(active, "sources"));
    map_set(active_copy, "example", map_get(active, "example"));
    map_set(active_copy, "hash", release_compiler_hash(active));
    manifest := map_new();
    map_set(manifest, "schemaVersion", 2);
    map_set(manifest, "title", title);
    map_set(manifest, "tag", tag);
    map_set(manifest, "commit", commit);
    map_set(manifest, "group", map_get(current, "group"));
    map_set(manifest, "componentVersions", current);
    map_set(manifest, "releasedComponent", released);
    map_set(manifest, "compiler", active_copy);
    map_set(manifest, "node", release_node_version(directory));
    map_set(manifest, "bootstrap", bootstrap);
    map_set(manifest, "vsix", vsix);
    if path_is_exists(path_join(source, "RELEASE.json")) {
        release_fail("RELEASE.json is reserved for packaged metadata");
    }
    record := json_to_text(manifest) + "\n";
    file_write(path_join(source, "RELEASE.json"), record);
    archive := "minilang-" + label + ".tar.gz";
    pack_args := list_of("-czf", path_join(output, archive), "-C", source, ".");
    release_run("tar", pack_args, work);
    extracted := path_join(work, "extracted");
    directory_create(extracted);
    unpack_args := list_of("-xf", path_join(output, archive), "-C", extracted);
    release_run("tar", unpack_args, work);
    release_check(path_join(extracted, "bin/mini-check"), extracted);
    file_write(path_join(output, "manifest.json"), record);
    release_notes(output, title, label, commit, file_read(path_join(source, "CHANGELOG.md")));
    release_checksums(output);
    path_remove(work);
    return 0;
}
