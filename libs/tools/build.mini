include "common/text.mini";
include "common/list.mini";
include "common/path.mini";
include "common/process.mini";
include "common/json.mini";
include "common/project.mini";
/// Report a build failure and stop.
fn build_fail(message) {
    io_write_error(message + "\n");
    process_exit(1);
    return 0;
}

/// Read the tool manifest and return it.
fn build_manifest(root) {
    parsed := json_parse_file(path_join(root, "tools/mini-tools.json"));
    if result_is_fail(parsed) {
        build_fail(result_get_message(parsed));
    }
    return result_get_value(parsed);
}

/// Return the active compiler entry.
fn build_compiler(root) {
    parsed := json_parse_file(path_join(root, "config/compiler.json"));
    if result_is_fail(parsed) {
        build_fail(result_get_message(parsed));
    }
    return map_get(result_get_value(parsed), "entry");
}

/// Compile one tool source and return its generated text.
fn build_compile(root, compiler, source) {
    work := path_temp_directory();
    output := path_join(work, "tool.generated.js");
    args := list_of(compiler, path_join(root, source), output);
    result := process_capture(process_exec_path(), args, root, list_new());
    if map_get(result, "status") != 0 {
        path_remove(work);
        build_fail(source + " failed:\n" + text_from_bytes(map_get(result, "stderr")));
    }
    generated := file_read(output);
    path_remove(work);
    return generated;
}

/// Make a file executable.
fn build_executable(root, path) {
    args := list_of("755", path_join(root, path));
    process_capture("chmod", args, root, list_new());
    return 0;
}

/// Return launcher text for a manifest entry.
fn build_launcher(launcher) {
    if value_kind(map_get(launcher, "tool")) == "text" {
        return "#!/usr/bin/env node\nimport { pathToFileURL } from 'node:url';\nimport { join } from 'node:path';\n"
            + "await import(pathToFileURL(join(import.meta.dirname, '..', '" + map_get(launcher, "tool") + "')).href);\n";
    }
    return "#!/usr/bin/env node\nimport { pathToFileURL } from 'node:url';\nimport { join } from 'node:path';\n"
        + "await import(pathToFileURL(join(import.meta.dirname, '..', 'dist/mini.js')).href);\n";
}

/// Regenerate every generated tool and launcher.
fn build_all(root) {
    manifest := build_manifest(root);
    compiler := build_compiler(root);
    tools := map_get(manifest, "tools");
    position := 0;
    while position < list_length(tools) {
        tool := list_get(tools, position);
        generated := build_compile(root, compiler, map_get(tool, "source"));
        target := path_join(root, map_get(tool, "generated"));
        directory_create(path_parent(target));
        file_write(target, generated);
        build_executable(root, map_get(tool, "generated"));
        position = position + 1;
    }
    launchers := map_get(manifest, "launchers");
    position = 0;
    while position < list_length(launchers) {
        launcher := list_get(launchers, position);
        name := "bin/" + map_get(launcher, "name");
        file_write(path_join(root, name), build_launcher(launcher));
        build_executable(root, name);
        position = position + 1;
    }
    return 0;
}

/// Reject stale generated tools and launchers.
fn build_check(root) {
    manifest := build_manifest(root);
    compiler := build_compiler(root);
    tools := map_get(manifest, "tools");
    position := 0;
    while position < list_length(tools) {
        tool := list_get(tools, position);
        target := path_join(root, map_get(tool, "generated"));
        generated := build_compile(root, compiler, map_get(tool, "source"));
        if !path_is_exists(target) || file_read(target) != generated {
            build_fail(map_get(tool, "generated") + " is stale; run dist/build.js");
        }
        position = position + 1;
    }
    launchers := map_get(manifest, "launchers");
    position = 0;
    while position < list_length(launchers) {
        launcher := list_get(launchers, position);
        name := "bin/" + map_get(launcher, "name");
        if !path_is_exists(path_join(root, name)) || file_read(path_join(root, name)) != build_launcher(launcher) {
            build_fail(name + " is stale; run dist/build.js");
        }
        position = position + 1;
    }
    return 0;
}

/// Run the build or check mode.
fn build_run(root, check) {
    if check {
        return build_check(root);
    }
    return build_all(root);
}
