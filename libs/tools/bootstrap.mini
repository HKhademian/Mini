import "core/map";
import "core/io";
import "core/text";
import "core/list";
import "core/path";
import "core/process";
import "core/json";
import "util/project";
import "core/file";
import "core/hash";
import "core/result";
import "util/process";
import "compiler/lexer";
import "compiler/parser";
import "compiler/emit-js";
import "util/io";

/// Report a bootstrap failure.
fn bootstrap_fail(message) {
    io_write_error(message + "\n");
    process_exit(1);
    return 0;
}

/// Compile one source in-process and return generated text.
fn bootstrap_compile_text(source) {
    tokens := lex_tokenize(file_read(source), path_basename(source), false);
    expanded := lex_expand_imports(tokens, source, map_new());
    return emit_js_compile(expanded);
}

/// Compile one source with a generated compiler.
fn bootstrap_compile_with(root, compiler, source, output) {
    command := compiler;
    args := list_new();
    if text_ends_with(compiler, ".js") {
        command = "node";
        args = list_of(compiler, source, output);
    } else {
        args = list_of(source, output);
    }
    result := process_capture(command, args, root, list_new());
    if map_get(result, "status") != 0 {
        bootstrap_fail(
            "compile failed with " + command + " (" + number_to_text(map_get(result, "status")) + "): "
            + text_from_bytes(map_get(result, "stdout")) + text_from_bytes(map_get(result, "stderr"))
            + text_from_bytes(map_get(result, "error"))
        );
    }
    return 0;
}

/// Run one generated Node program.
fn bootstrap_run(root, path) {
    args := list_new();
    list_set(args, 0, path);
    result := process_capture("node", args, root, list_new());
    if map_get(result, "status") != 0 {
        bootstrap_fail("run failed: " + text_from_bytes(map_get(result, "stderr")));
    }
    return 0;
}

/// Make a generated file executable.
fn bootstrap_executable(root, path) {
    args := list_of("755", path);
    process_capture("chmod", args, root, list_new());
    return 0;
}

/// Run a child command and stop on failure.
fn bootstrap_step(root, label, command, args, directory) {
    options := map_new();
    map_set(options, "command", command);
    map_set(options, "arguments", args);
    map_set(options, "directory", directory);
    map_set(options, "mode", "inherit");
    result := process_spawn(options);
    if map_get(result, "status") != 0 {
        bootstrap_fail(label + " failed");
    }
    return 0;
}

/// Remove every untracked and ignored item from the project checkout.
fn bootstrap_clean_generated(root) {
    bootstrap_step(root, "remove untracked and ignored project files", "git", list_of("clean", "-ffdx"), root);
    return 0;
}

/// Clean the checkout, rebuild all project components, run checks, and package the local VSIX.
fn bootstrap_clean_all(root) {
    io_write_line("Removing all untracked and ignored project files...");
    bootstrap_clean_generated(root);
    bootstrap_step(root, "root npm ci", "npm", list_of("ci"), root);
    editor := path_join(root, "editors/vscode");
    bootstrap_step(root, "VS Code npm ci", "npm", list_of("ci"), editor);
    bootstrap_all(root);
    node := "node";
    mini := path_join(root, "bin/mini");
    bootstrap_step(root, "repository check", node, list_of(mini, "check"), root);
    bootstrap_step(root, "case suite", node, list_of(mini, "test"), root);
    bootstrap_step(root, "Mini unit suite", node, list_of(mini, "test", "--unit"), root);
    bootstrap_step(root, "LSP tests", node, list_of("--test", "test/lang-server.test.ts"), root);
    bootstrap_step(root, "release tests", node, list_of("--test", "test/release.test.ts"), root);
    bootstrap_step(root, "VS Code TypeScript check", "npm", list_of("run", "check"), editor);
    bootstrap_step(root, "VS Code build", "npm", list_of("run", "build"), editor);
    bootstrap_step(root, "VS Code grammar tests", node, list_of("--test", "test/grammar.test.ts"), editor);
    versions_path := path_join(root, "config/versions.json");
    if !path_is_exists(versions_path) {
        bootstrap_fail("cannot read " + versions_path);
    }
    versions_result := json_value(file_read(versions_path));
    if result_is_fail(versions_result) {
        bootstrap_fail("invalid JSON: " + versions_path);
    }
    versions := result_get_value(versions_result);
    package_name := "mini-" + map_get(versions, "group") + "-v" + map_get(versions, "vscode") + ".vsix";
    output_directory := path_join(root, "dist/rebuild");
    directory_create(output_directory);
    package_path := path_join(output_directory, package_name);
    vsce := path_join(editor, "node_modules/@vscode/vsce/vsce");
    bootstrap_step(
        root,
        "VS Code VSIX package",
        node,
        list_of(
            vsce,
            "package",
            "--no-dependencies",
            "--allow-missing-repository",
            "--skip-license",
            "--out",
            package_path
        ),
        editor
    );
    io_write_line("Clean rebuild and full project checks passed. VSIX: dist/rebuild/" + package_name);
    return 0;
}

/// Rebuild the compiler, verify the fixed point, then rebuild every tool.
fn bootstrap_all(root) {
    work := path_temp_directory();
    source := path_join(root, "tools/compiler.mini");
    first := path_join(work, "compiler1.js");
    second := path_join(work, "compiler2.js");
    file_write(first, bootstrap_compile_text(source));
    bootstrap_executable(root, first);
    bootstrap_compile_with(root, first, source, second);
    if hash_sha256(file_read_bytes(first)) != hash_sha256(file_read_bytes(second)) {
        bootstrap_fail("compiler fixed point mismatch");
    }
    seed := path_join(root, "dist/compile.js");
    path_copy(first, seed);
    bootstrap_executable(root, seed);
    build := path_join(root, "dist/build.js");
    bootstrap_compile_with(root, seed, path_join(root, "tools/build.mini"), build);
    bootstrap_executable(root, build);
    bootstrap_run(root, build);
    path_remove(work);
    io_write_line("bootstrap complete");
    return 0;
}
