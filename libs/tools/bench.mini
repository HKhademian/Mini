/// Run benchmark cases and write one JSON report.
/// Usage: node dist/bench.js OUTPUT [FILTER]
/// Output must not exist; the parent directory is created.

import "core/io";
import "core/json";
import "core/map";
import "core/text";
import "core/list";
import "core/file";
import "core/path";
import "core/hash";
import "core/time";
import "core/process";
import "util/process";
import "util/project";
import "./cases";
import "util/result";

/// Report a benchmark error and stop.
fn bench_fail(message) {
    io_write_error(message + "\n");
    process_exit(1);
    return 0;
}

/// Return the integer half of a nonnegative count.
fn bench_half(value) {
    remainder := value;
    half := 0;
    while remainder >= 2 {
        remainder = remainder - 2;
        half = half + 1;
    }
    return half;
}

/// Return a sorted copy of numeric samples.

/// Return the compiler source hash from configuration.
fn bench_compiler_hash(root) {
    parsed := json_value(file_read(path_join(root, "config/compiler.json")));
    if result_is_fail(parsed) {
        bench_fail("invalid config/compiler.json");
    }
    sources := map_get(result_get_value(parsed), "sources");
    parts := list_new();
    position := 0;
    while position < list_length(sources) {
        path := list_get(sources, position);
        list_set(parts, list_length(parts), path + "\n" + file_read(path_join(root, path)));
        position = position + 1;
    }
    return hash_sha256(list_join("\n", parts));
}

/// Return the repository commit, or empty text outside a checkout.
fn bench_commit(root) {
    if !path_is_exists(path_join(root, ".git")) {
        return "";
    }
    args := list_of("rev-parse", "HEAD");
    result := process_capture("git", args, root, list_new());
    return text_chomp(text_from_bytes(map_get(result, "stdout")));
}

/// Remove trailing line-ending characters.

/// Run benchmark cases and return the number of report rows written.
fn bench_run(root, output, filter) {
    if path_is_exists(output) {
        bench_fail("benchmark output already exists; choose a new report path");
    }
    selected := case_load_cases(filter, root);
    if result_is_fail(selected) {
        bench_fail(result_get_message(selected));
    }
    fixtures := map_get(selected, "fixtures");
    results := list_new();
    fixture_index := 0;
    while fixture_index < list_length(fixtures) {
        fixture := list_get(fixtures, fixture_index);
        definition := map_get(fixture, "definition");
        if map_has(definition, "benchmark") {
            settings := map_get(definition, "benchmark");
            warmups := map_get(settings, "warmups");
            sample_count := map_get(settings, "samples");
            identity := case_case_identity(fixture, root);
            scenarios := map_get(definition, "cases");
            scenario_index := 0;
            while scenario_index < list_length(scenarios) {
                scenario := list_get(scenarios, scenario_index);
                warmup_index := 0;
                while warmup_index < warmups {
                    warmed := case_verify_scenario(fixture, scenario, root, "");
                    if result_is_fail(warmed) {
                        bench_fail(result_get_message(warmed));
                    }
                    warmup_index = warmup_index + 1;
                }
                samples := list_new();
                sample_index := 0;
                while sample_index < sample_count {
                    started := time_millis();
                    measured := case_verify_scenario(fixture, scenario, root, "");
                    if result_is_fail(measured) {
                        bench_fail(result_get_message(measured));
                    }
                    list_set(samples, list_length(samples), time_millis() - started);
                    sample_index = sample_index + 1;
                }
                sorted := list_sorted(samples);
                row := map_new();
                map_set(row, "id", map_get(definition, "id"));
                map_set(row, "scenario", map_get(scenario, "name"));
                map_set(row, "kind", map_get(definition, "kind"));
                map_set(row, "identity", identity);
                map_set(row, "warmups", warmups);
                map_set(row, "milliseconds", samples);
                map_set(row, "medianMilliseconds", list_get(sorted, bench_half(list_length(sorted))));
                list_set(results, list_length(results), row);
                scenario_index = scenario_index + 1;
            }
        }
        fixture_index = fixture_index + 1;
    }
    if list_length(results) == 0 {
        bench_fail("no benchmark cases selected");
    }
    versions_parsed := json_value(file_read(path_join(root, "config/versions.json")));
    report := map_new();
    map_set(report, "commit", bench_commit(root));
    if result_is_ok(versions_parsed) {
        map_set(report, "versions", result_get_value(versions_parsed));
    }
    map_set(report, "compiler", bench_compiler_hash(root));
    map_set(
        report,
        "scope",
        "fresh-process wall time including startup, IO, verification, and compilation for program cases"
    );
    map_set(report, "results", results);
    directory_create(path_parent(output));
    file_write(output, json_text(report) + "\n");
    return list_length(results);
}
