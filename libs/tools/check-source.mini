include "../common/text.mini";
include "../compiler/lexer.mini";
include "../compiler/parser.mini";
include "../compiler/builtins.mini";

/// Validate one mini source text; diagnostics end the process on failure.
fn check_source_text(source, name, base) {
    tokens := tokenize(source, name, false);
    compile(expand_includes(tokens, base, list_new(), map_new()));
    return 0;
}
