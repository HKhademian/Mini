import "common/map";
import "common/text";
import "common/list";
import "compiler/lexer";
import "compiler/parser";
import "compiler/builtins";

/// Validate one mini source text; diagnostics end the process on failure.
fn check_source_text(source, name, base) {
    tokens := lex_tokenize(source, name, false);
    parser_ast(lex_expand_imports(tokens, base, map_new()));
    return 0;
}
