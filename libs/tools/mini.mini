include "../common/text.mini";
include "../common/path.mini";
include "../common/process.mini";
include "../common/json.mini";
include "../common/project.mini";

/// Return the active compiler entry.
fn mini_compiler(root) {
    parsed := json_parse_file(path_join(root, "config/compiler.json"));
    if result_is_fail(parsed) {
        io_write_error(map_get(parsed, "message") + "\n");
        process_exit(1);
    }
    return map_get(map_get(parsed, "value"), "entry");
}

/// Return the version registry.
fn mini_versions(root) {
    parsed := json_parse_file(path_join(root, "config/versions.json"));
    if result_is_fail(parsed) {
        io_write_error(map_get(parsed, "message") + "\n");
        process_exit(1);
    }
    return map_get(parsed, "value");
}

/// Return a release tag for a product key.
fn mini_tag(root, component) {
    current := mini_versions(root);
    return component + "-v" + map_get(current, "group") + "-v" + map_get(current, component);
}

/// Return the product key for a command.
fn mini_component(command) {
    if command == "check" || command == "format" || command == "verify" || command == "release"
        || command == "test" || command == "bench" || command == "lsp" {
        return command;
    }
    if command == "compile" || command == "minic" {
        return "compiler";
    }
    if command == "run" {
        return "cli";
    }
    return "";
}

/// Run a generated tool with inherited standard streams.
fn mini_spawn(root, tool, args) {
    command_args := list_new();
    list_set(command_args, 0, path_join(root, tool));
    position := 0;
    while position < list_length(args) {
        list_set(command_args, list_length(command_args), list_get(args, position));
        position = position + 1;
    }
    options := map_new();
    map_set(options, "command", process_exec_path());
    map_set(options, "arguments", command_args);
    map_set(options, "directory", root);
    map_set(options, "mode", "inherit");
    return map_get(process_spawn(options), "status");
}

/// Return a list from a start index.
fn mini_rest(items, start) {
    result := list_new();
    position := start;
    while position < list_length(items) {
        list_set(result, list_length(result), list_get(items, position));
        position = position + 1;
    }
    return result;
}

/// Fail with a command usage message.
fn mini_usage(message) {
    io_write_error(message + "\n");
    return 1;
}

/// Print the dispatcher help.
fn mini_help() {
    io_write("mini: tiny self-hosting foundation for language projects\n");
    io_write("Usage: mini check [--docs | SOURCE.mini | -] | fmt [--write | --check] SOURCE.mini | run SOURCE.mini [ARG]... | test [FILTER] | bench OUTPUT [FILTER] | verify [CASE.json] | release OUTPUT [TAG] | compile SOURCE.mini [OUTPUT.js] | build [--check] | ci TASK_FILE\n");
    io_write("Aliases: mini-check, mini-format, mini-run, mini-test, mini-bench, mini-verify, mini-release, mini-compile, minic\n");
    return 0;
}

/// Run a selected command and return its status.
fn mini_command(root, command, args) {
    if command == "build" {
        return mini_spawn(root, "dist/build.js", args);
    }
    if command == "ci" {
        return mini_spawn(root, "dist/ci.js", args);
    }
    if command == "check" {
        if list_length(args) == 0 || (list_length(args) == 1 && list_get(args, 0) == "--docs") {
            return mini_spawn(root, "dist/check.js", args);
        }
        if list_length(args) != 1 {
            return mini_usage("usage: mini-check [--docs | SOURCE.mini | -]");
        }
        path := list_get(args, 0);
        if path != "-" && !path_is_exists(path) {
            return mini_usage("cannot read " + path);
        }
        return mini_spawn(root, "dist/check-source.js", args);
    }
    if command == "format" {
        format_path := "";
        position := 0;
        while position < list_length(args) {
            arg := list_get(args, position);
            if arg != "--write" && arg != "--check" {
                format_path = arg;
            }
            position = position + 1;
        }
        if format_path != "" && format_path != "-" && !path_is_exists(format_path) {
            return mini_usage("cannot read " + format_path);
        }
        return mini_spawn(root, "dist/format.js", args);
    }
    if command == "run" {
        if list_length(args) < 1 {
            return mini_usage("usage: mini-run SOURCE.mini [ARG]...");
        }
        source := list_get(args, 0);
        if !text_ends_with(source, ".mini") {
            return mini_usage("Mini source must use .mini");
        }
        run_args := list_new();
        list_set(run_args, 0, mini_compiler(root));
        list_set(run_args, 1, source);
        position := 1;
        while position < list_length(args) {
            list_set(run_args, list_length(run_args), list_get(args, position));
            position = position + 1;
        }
        return mini_spawn(root, "dist/run.js", run_args);
    }
    if command == "test" {
        return mini_spawn(root, "dist/test.js", args);
    }
    if command == "bench" {
        if list_length(args) < 1 {
            return mini_usage("usage: mini-bench OUTPUT [FILTER]");
        }
        return mini_spawn(root, "dist/bench.js", args);
    }
    if command == "verify" {
        if list_length(args) == 0 {
            return mini_spawn(root, "dist/verify.js", list_new());
        }
        file_args := list_new();
        list_set(file_args, 0, "--file");
        list_set(file_args, 1, list_get(args, 0));
        return mini_spawn(root, "dist/test.js", file_args);
    }
    if command == "release" {
        if list_length(args) < 1 {
            return mini_usage("usage: mini-release OUTPUT [TAG]");
        }
        status := mini_spawn(root, "dist/release.js", args);
        if status == 0 {
            io_write("Release prepared.\n");
        }
        return status;
    }
    if command == "compile" {
        compiler := path_join(root, mini_compiler(root));
        if list_length(args) > 0 && list_get(args, 0) == "--tokens" {
            token_args := list_new();
            list_set(token_args, 0, "tokens");
            list_set(token_args, 1, list_get(args, 1));
            return mini_spawn(root, mini_compiler(root), token_args);
        }
        if list_length(args) < 1 {
            return mini_usage("usage: mini-compile SOURCE.mini [OUTPUT.js]");
        }
        source := list_get(args, 0);
        if !text_ends_with(source, ".mini") {
            return mini_usage("Mini source must use .mini");
        }
        output := source + ".js";
        if list_length(args) > 1 {
            output = list_get(args, 1);
        }
        compile_args := list_new();
        list_set(compile_args, 0, source);
        list_set(compile_args, 1, output);
        status := mini_spawn(root, mini_compiler(root), compile_args);
        if status == 0 && text_starts_with(file_read(source), "#!") {
            chmod_args := list_new();
            list_set(chmod_args, 0, "755");
            list_set(chmod_args, 1, output);
            process_capture("chmod", chmod_args, root, list_new());
        }
        return status;
    }
    return mini_usage("unknown command: " + command);
}

/// Run the dispatcher for one executable name and argument list.
fn mini_run(executable, args, root) {
    if executable == "mini.js" || executable == "mini.generated.js" {
        executable = "mini";
    }
    command := executable;
    rest := args;
    if executable == "mini" {
        if list_length(args) == 0 || list_get(args, 0) == "--help" {
            return mini_help();
        }
        if list_get(args, 0) == "--version" {
            io_write(mini_tag(root, "mini") + "\n" + mini_tag(root, "cli") + "\n");
            return 0;
        }
        command = list_get(args, 0);
        rest = mini_rest(args, 1);
    } else {
        if executable == "minic" {
            command = "compile";
        } else {
            if text_starts_with(executable, "mini-") {
                command = text_slice(executable, 5, text_length(executable));
            }
        }
    }
    if command == "fmt" {
        command = "format";
    }
    if list_length(rest) == 1 && list_get(rest, 0) == "--version" {
        component := mini_component(command);
        if component != "" {
            io_write(mini_tag(root, component) + "\n");
            return 0;
        }
    }
    return mini_command(root, command, rest);
}
