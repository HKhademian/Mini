/// Shared case loading and scenario execution for mini tools.
/// Inputs are case manifests under cases/ with separate source and stream files.
/// Results are maps with `ok` and a failure `message`; scenario mismatches never
/// terminate the host process.

import "core/map";
import "core/value";
import "core/list";
import "core/text";
import "core/path";
import "core/process";
import "core/json";
import "core/result";
import "util/project";
import "core/file";
import "core/hash";
import "util/process";
import "util/native";
import "./native";

/// Return a successful result map.

/// Return a failed result map.

/// Return the repository root from the running tool path.

/// Join two path components.

/// Return the parent directory of a path.

/// Return the final path component.

/// Return whether a path is absolute.

/// Collapse dot segments in a slash-separated path.

/// Resolve a path against a base directory.

/// Return whether a list contains a text value.

/// Return whether a value is a list of text.

/// Read and parse a JSON file.

/// Return the accepted case kinds.
fn case_kinds() {
    kinds := list_of("tool", "feature", "reject", "compile", "sample", "example");
    return kinds;
}

/// Return whether a stream has exactly one representation.
fn case_stream_valid(stream) {
    if !value_is_map(stream) {
        return false;
    }
    count := 0;
    if map_has(stream, "text") {
        count = count + 1;
    }
    if map_has(stream, "bytes") {
        count = count + 1;
    }
    if map_has(stream, "file") {
        count = count + 1;
    }
    return count == 1;
}

/// Return the byte list for a stream.
fn case_stream_bytes(stream, directory) {
    if !value_is_map(stream) {
        return result_fail("stream must be an object");
    }
    count := 0;
    if map_has(stream, "text") {
        count = count + 1;
    }
    if map_has(stream, "bytes") {
        count = count + 1;
    }
    if map_has(stream, "file") {
        count = count + 1;
    }
    if count != 1 {
        return result_fail("one stream representation required");
    }
    bytes := list_new();
    if map_has(stream, "text") {
        if value_kind(map_get(stream, "text")) != "text" {
            return result_fail("stream text must be a string");
        }
        bytes = text_to_bytes(map_get(stream, "text"));
    } else {
        if map_has(stream, "bytes") {
            bytes = map_get(stream, "bytes");
            if !value_is_list(bytes) {
                return result_fail("invalid stream bytes");
            }
            position := 0;
            while position < list_length(bytes) {
                value := list_get(bytes, position);
                if !value_is_number(value) || value < 0 || value > 255 {
                    return result_fail("invalid stream bytes");
                }
                position = position + 1;
            }
        } else {
            if value_kind(map_get(stream, "file")) != "text" {
                return result_fail("invalid stream");
            }
            file := path_resolve(directory, map_get(stream, "file"));
            if !path_is_exists(file) {
                return result_fail("cannot read " + file);
            }
            bytes = file_read_bytes(file);
        }
    }
    if map_has(stream, "hash") {
        expected := map_get(stream, "hash");
        if expected != "sha256:" + hash_sha256(bytes) {
            return result_fail("stream hash differs");
        }
    }
    result := result_ok();
    map_set(result, "bytes", bytes);
    return result;
}

/// Return whether two byte lists match.
fn case_bytes_equal(left, right) {
    if list_length(left) != list_length(right) {
        return false;
    }
    position := 0;
    while position < list_length(left) {
        if list_get(left, position) != list_get(right, position) {
            return false;
        }
        position = position + 1;
    }
    return true;
}

/// Return the byte text for a stream, or empty text on failure.
fn case_stream_text(stream, directory) {
    bytes := case_stream_bytes(stream, directory);
    if result_is_fail(bytes) {
        return "";
    }
    return text_from_bytes(map_get(bytes, "bytes"));
}

/// Load and validate one case manifest.
fn case_load_case(path) {
    if !path_is_exists(path) {
        return result_fail("cannot read " + path);
    }
    parsed := json_value(file_read(path));
    if result_is_fail(parsed) {
        return result_fail("invalid JSON: " + path);
    }
    spec := result_get_value(parsed);
    id := map_get(spec, "id");
    if !map_has(spec, "id") || !value_is_text(id) || text_length(id) == 0 {
        return result_fail("case ID required: " + path);
    }
    kind := map_get(spec, "kind");
    if !list_contains(case_kinds(), kind) {
        return result_fail("invalid case kind: " + id);
    }
    if map_has(spec, "target") {
        target := map_get(spec, "target");
        if kind == "tool" || (target != "js" && target != "c") {
            return result_fail("invalid case target: " + id);
        }
    }
    if map_has(spec, "pending")
        && (kind == "tool" || value_kind(map_get(spec, "pending")) != "text" || text_length(map_get(spec, "pending")) == 0) {
        return result_fail("pending needs a language case and reason");
    }
    directory := path_parent(path);
    if kind == "tool" {
        tool := map_get(spec, "tool");
        if !map_has(spec, "tool") || !value_is_text(tool) || text_find(tool, "/") >= 0
            || !path_is_exists(path_join(path_join(project_root(), "bin"), tool)) {
            return result_fail("unknown tool: " + id);
        }
    } else {
        source := map_get(spec, "source");
        if !map_has(spec, "source") || !value_is_text(source) || !text_ends_with(source, ".mini")
            || !path_is_exists(path_resolve(directory, source)) {
            return result_fail("case source missing: " + id);
        }
    }
    if !map_has(spec, "features") || !list_is_text(map_get(spec, "features")) {
        return result_fail("features must be a list: " + id);
    }
    if !map_has(spec, "cases") || value_kind(map_get(spec, "cases")) != "list"
        || list_length(map_get(spec, "cases")) == 0 {
        return result_fail("case scenarios required: " + id);
    }
    scenarios := map_get(spec, "cases");
    names := map_new();
    position := 0;
    while position < list_length(scenarios) {
        scenario := list_get(scenarios, position);
        name := map_get(scenario, "name");
        if !value_is_map(scenario) || !map_has(scenario, "name") || !value_is_text(name)
            || text_length(name) == 0 || map_has(names, name) {
            return result_fail("scenario names must be unique: " + id);
        }
        map_set(names, name, true);
        check := case_validate_scenario(spec, kind, scenario, directory);
        if result_is_fail(check) {
            return check;
        }
        position = position + 1;
    }
    fixture := map_new();
    map_set(fixture, "path", path);
    map_set(fixture, "definition", spec);
    result := result_ok();
    map_set(result, "fixture", fixture);
    return result;
}

/// Return whether a scenario shape is valid.
fn case_validate_scenario(spec, kind, scenario, directory) {
    id := map_get(spec, "id");
    name := map_get(scenario, "name");
    prefix := id + "/" + name + ": ";
    if !map_has(scenario, "exitCode") || value_kind(map_get(scenario, "exitCode")) != "number"
        || map_get(scenario, "exitCode") < 0 || map_get(scenario, "exitCode") > 255 {
        return result_fail(prefix + "invalid exit status");
    }
    if map_has(scenario, "args") && !list_is_text(map_get(scenario, "args")) {
        return result_fail(prefix + "invalid arguments");
    }
    streams := list_of("stdin", "stdout", "stderr");
    position := 0;
    while position < list_length(streams) {
        key := list_get(streams, position);
        if !map_has(scenario, key) {
            return result_fail("invalid stream");
        }
        bytes := case_stream_bytes(map_get(scenario, key), directory);
        if result_is_fail(bytes) {
            return result_fail(result_get_message(bytes));
        }
        position = position + 1;
    }
    runnable := kind == "feature" || kind == "sample" || kind == "example";
    if map_has(scenario, "inputFiles") || map_has(scenario, "outputFiles") {
        if !runnable {
            return result_fail(prefix + "file fixtures need a runnable mini case");
        }
        groups := list_of("inputFiles", "outputFiles");
        position = 0;
        while position < list_length(groups) {
            group_key := list_get(groups, position);
            if map_has(scenario, group_key) {
                files := map_get(scenario, group_key);
                if !value_is_map(files) {
                    return result_fail(prefix + "file fixtures must be an object");
                }
                keys := map_keys(files);
                index := 0;
                while index < list_length(keys) {
                    file_name := list_get(keys, index);
                    if text_length(file_name) == 0 || path_is_absolute(file_name)
                        || text_find(file_name, "..") >= 0 {
                        return result_fail("file fixture paths must stay inside the case workspace");
                    }
                    if !case_stream_valid(map_get(files, file_name)) {
                        return result_fail("invalid stream");
                    }
                    index = index + 1;
                }
            }
            position = position + 1;
        }
    }
    if map_has(scenario, "artifact") && (kind != "compile" || !case_stream_valid(map_get(scenario, "artifact"))) {
        return result_fail(prefix + "only compile cases compare generated artifacts");
    }
    if map_has(scenario, "workspace") && kind != "tool" {
        return result_fail(prefix + "invalid workspace");
    }
    if map_has(scenario, "tag") {
        tag := map_get(scenario, "tag");
        if !map_has(scenario, "workspace") || !value_is_map(tag) || !map_has(tag, "name")
            || value_kind(map_get(tag, "name")) != "text" || !map_has(tag, "annotated")
            || value_kind(map_get(tag, "annotated")) != "boolean" {
            return result_fail(prefix + "invalid fixture tag");
        }
    }
    if map_has(scenario, "files") && !list_is_text(map_get(scenario, "files")) {
        return result_fail(prefix + "invalid artifact paths");
    }
    return result_ok();
}

/// Collect case fixtures below a directory.
fn case_collect(directory, filter, fixtures, ids) {
    entries := directory_list(directory);
    position := 0;
    while position < list_length(entries) {
        name := list_get(entries, position);
        path := path_join(directory, name);
        if path_is_directory(path) {
            nested := case_collect(path, filter, fixtures, ids);
            if result_is_fail(nested) {
                return nested;
            }
        } else {
            if text_ends_with(name, ".case.json") {
                loaded := case_load_case(path);
                if result_is_fail(loaded) {
                    return loaded;
                }
                fixture := map_get(loaded, "fixture");
                id := map_get(map_get(fixture, "definition"), "id");
                if map_has(ids, id) {
                    return result_fail("duplicate case IDs");
                }
                map_set(ids, id, true);
                if filter == "" || text_find(id, filter) >= 0 {
                    list_set(fixtures, list_length(fixtures), fixture);
                }
            }
        }
        position = position + 1;
    }
    return result_ok();
}

/// Load every case matching the filter.
fn case_load_cases(filter, project_root) {
    fixtures := list_new();
    ids := map_new();
    collected := case_collect(path_join(project_root, "cases"), filter, fixtures, ids);
    if result_is_fail(collected) {
        return collected;
    }
    if list_length(fixtures) == 0 {
        return result_fail("no cases match: " + filter);
    }
    result := result_ok();
    map_set(result, "fixtures", fixtures);
    return result;
}

/// Return the active compiler entry from configuration.

/// Run a command with captured output and a 30-second limit.

/// Return whether a workspace entry is excluded from copies.
fn case_entry_excluded(name) {
    return name == ".git" || name == "node_modules" || name == ".cache";
}

/// Copy a project tree while skipping build and dependency directories.
fn case_copy_tree(from, to) {
    if path_is_directory(from) {
        directory_create(to);
        entries := directory_list(from);
        position := 0;
        while position < list_length(entries) {
            name := list_get(entries, position);
            if !case_entry_excluded(name) && !(name == "release" && path_basename(from) == "dist") {
                case_copy_tree(path_join(from, name), path_join(to, name));
            }
            position = position + 1;
        }
    } else {
        path_copy(from, to);
    }
    return 0;
}

/// Run git with the fixture identity settings.
fn case_git(directory, args) {
    git_args := list_of(
        "-c",
        "user.name=Case fixture",
        "-c",
        "user.email=fixture@example.invalid",
        "-c",
        "commit.gpgSign=false",
        "-c",
        "tag.gpgSign=false",
        "-c",
        "maintenance.auto=false",
        "-c",
        "gc.auto=0"
    );
    position := 0;
    while position < list_length(args) {
        list_set(git_args, list_length(git_args), list_get(args, position));
        position = position + 1;
    }
    return process_capture("git", git_args, directory, list_new());
}

/// Return the working directory for a tool scenario.
fn case_tool_workspace(project_root, scenario, work) {
    directory := path_join(work, "project");
    case_copy_tree(project_root, directory);
    init := case_git(directory, list_of("init", "-b", "main"));
    if map_get(init, "status") != 0 {
        return result_fail("git init failed: " + text_from_bytes(map_get(init, "stderr")));
    }
    added := case_git(directory, list_of("add", "."));
    if map_get(added, "status") != 0 {
        return result_fail("git add failed: " + text_from_bytes(map_get(added, "stderr")));
    }
    committed := case_git(directory, list_of("commit", "-m", "case fixture"));
    if map_get(committed, "status") != 0 {
        return result_fail("git commit failed: " + text_from_bytes(map_get(committed, "stderr")));
    }
    if map_has(scenario, "tag") {
        tag := map_get(scenario, "tag");
        tag_args := list_new();
        list_set(tag_args, 0, "tag");
        if map_get(tag, "annotated") {
            list_set(tag_args, 1, "-a");
            list_set(tag_args, 2, map_get(tag, "name"));
            list_set(tag_args, 3, "-m");
            list_set(tag_args, 4, map_get(tag, "name"));
        } else {
            list_set(tag_args, 1, map_get(tag, "name"));
        }
        tagged := case_git(directory, tag_args);
        if map_get(tagged, "status") != 0 {
            return result_fail("git tag failed: " + text_from_bytes(map_get(tagged, "stderr")));
        }
    }
    if map_get(scenario, "workspace") == "dirty" {
        file_write(path_join(directory, "uncommitted.txt"), "dirty\n");
    }
    result := result_ok();
    map_set(result, "directory", directory);
    return result;
}

/// Return a two-item text list.

/// Return a three-item text list.

/// Verify one scenario and return a result map.
fn case_verify_scenario(fixture, scenario, project_root, compiler_override) {
    definition := map_get(fixture, "definition");
    directory := path_parent(map_get(fixture, "path"));
    id := map_get(definition, "id");
    name := map_get(scenario, "name");
    prefix := id + "/" + name + ": ";
    input := case_stream_bytes(map_get(scenario, "stdin"), directory);
    if result_is_fail(input) {
        return result_fail(prefix + result_get_message(input));
    }
    work := path_temp_directory();
    if text_length(work) == 0 {
        return result_fail(prefix + "cannot create a temporary directory");
    }
    result := case_verify_in_work(fixture, scenario, project_root, compiler_override, work, prefix);
    if result_is_fail(result) && map_get(definition, "target") == "c" {
        map_set(result, "workspace", work);
        map_set(result, "message", result_get_message(result) + "\nNative artifacts: " + work);
        return result;
    }
    path_remove(work);
    return result;
}

/// Verify one scenario inside a temporary directory.
fn case_verify_in_work(fixture, scenario, project_root, compiler_override, work, prefix) {
    definition := map_get(fixture, "definition");
    kind := map_get(definition, "kind");
    directory := path_parent(map_get(fixture, "path"));
    input := case_stream_bytes(map_get(scenario, "stdin"), directory);
    args := list_new();
    if map_has(scenario, "args") {
        args = map_get(scenario, "args");
    }
    workspace := project_root;
    result := map_new();
    artifact := "";
    if kind == "tool" {
        if map_has(scenario, "workspace") {
            prepared := case_tool_workspace(project_root, scenario, work);
            if result_is_fail(prepared) {
                return result_fail(prefix + result_get_message(prepared));
            }
            workspace = map_get(prepared, "directory");
        }
        command_args := list_new();
        list_set(command_args, 0, path_join(path_join(workspace, "bin"), map_get(definition, "tool")));
        position := 0;
        while position < list_length(args) {
            list_set(command_args, list_length(command_args), list_get(args, position));
            position = position + 1;
        }
        command := list_get(command_args, 0);
        run_args := list_new();
        command_position := 1;
        while command_position < list_length(command_args) {
            list_set(run_args, list_length(run_args), list_get(command_args, command_position));
            command_position = command_position + 1;
        }
        result = process_capture(command, run_args, workspace, map_get(input, "bytes"));
    } else {
        source := path_resolve(directory, map_get(definition, "source"));
        compiler := compiler_override;
        if compiler == "" {
            compiler = project_compiler_entry(project_root);
        }
        target := "js";
        if map_has(definition, "target") {
            target = map_get(definition, "target");
        }
        output := path_join(work, "program.mini.js");
        compile_command := compiler;
        compile_args := list_new();
        if text_ends_with(compiler, ".js") {
            compile_command = "node";
            compile_args = list_of(compiler, source, output);
        } else {
            compile_args = list_of(source, output);
        }
        if target == "c" {
            output = path_join(work, "program.mini.c");
            if text_ends_with(compiler, ".js") {
                compile_args = list_of(compiler, "--target", "c", source, output);
            } else {
                compile_args = list_of("--target", "c", source, output);
            }
        }
        result = process_capture(compile_command, compile_args, project_root, list_new());
        if target == "c" && map_get(result, "status") == 0
            && (!path_is_exists(output) || !path_is_exists(native_artifact_path(output, ".h"))) {
            return result_fail(prefix + "compilation did not create its C source/header pair");
        }
        if map_get(result, "status") == 0 && path_is_exists(output) {
            artifact = hash_sha256(file_read_bytes(output));
        }
        if kind == "compile" && map_has(scenario, "artifact") {
            expected := case_stream_bytes(map_get(scenario, "artifact"), directory);
            if result_is_fail(expected) {
                return result_fail(prefix + result_get_message(expected));
            }
            if !path_is_exists(output) || !case_bytes_equal(file_read_bytes(output), map_get(expected, "bytes")) {
                return result_fail(prefix + "generated artifact differs");
            }
        }
        if kind == "reject" && (path_is_exists(output)
            || (target == "c" && path_is_exists(native_artifact_path(output, ".h")))) {
            return result_fail(prefix + "rejection created an output artifact");
        }
        if kind != "reject" && kind != "compile" {
            if map_get(result, "status") != 0 {
                return result_fail(prefix + text_from_bytes(map_get(result, "stderr")));
            }
            files := path_join(work, "files");
            directory_create(files);
            prepared_files := case_write_input_files(scenario, directory, files, prefix);
            if result_is_fail(prepared_files) {
                return prepared_files;
            }
            executable := "node";
            run_args := list_new();
            if target == "c" {
                executable = path_join(work, "program");
                native := native_build(output, executable, project_root);
                if map_get(native, "status") != 0 {
                    return result_fail(prefix + map_get(native, "stage") + " failed" + case_diagnostic(native));
                }
                if !path_is_exists(executable) {
                    return result_fail(prefix + "C compilation created no executable");
                }
            } else {
                list_set(run_args, 0, output);
            }
            position := 0;
            while position < list_length(args) {
                list_set(run_args, list_length(run_args), list_get(args, position));
                position = position + 1;
            }
            result = process_capture(executable, run_args, files, map_get(input, "bytes"));
            if target == "c" && text_length(map_get(result, "error")) > 0 {
                return result_fail(prefix + "native execution failed" + case_diagnostic(result));
            }
            checked_files := case_check_output_files(scenario, directory, files, prefix);
            if result_is_fail(checked_files) {
                return checked_files;
            }
        }
    }
    if map_get(result, "status") != map_get(scenario, "exitCode") {
        return result_fail(prefix + "exit status" + case_diagnostic(result));
    }
    stdout := case_stream_bytes(map_get(scenario, "stdout"), directory);
    if !case_bytes_equal(map_get(result, "stdout"), map_get(stdout, "bytes")) {
        return result_fail(prefix + "stdout");
    }
    stderr := case_stream_bytes(map_get(scenario, "stderr"), directory);
    if !case_bytes_equal(map_get(result, "stderr"), map_get(stderr, "bytes")) {
        return result_fail(prefix + "stderr");
    }
    if kind == "reject" {
        if map_get(scenario, "exitCode") == 0 || list_length(map_get(result, "stdout")) != 0 {
            return result_fail(prefix + "rejection result");
        }
    }
    if map_has(scenario, "files") {
        files := map_get(scenario, "files");
        position := 0;
        while position < list_length(files) {
            if !path_is_exists(path_resolve(workspace, list_get(files, position))) {
                return result_fail("missing artifact: " + list_get(files, position));
            }
            position = position + 1;
        }
    }
    done := result_ok();
    map_set(done, "artifact", artifact);
    return done;
}

/// Return a diagnostic suffix for a failed run.
fn case_diagnostic(result) {
    error := map_get(result, "error");
    if text_length(error) > 0 {
        return ": " + error;
    }
    stderr := text_from_bytes(map_get(result, "stderr"));
    if text_length(stderr) > 0 {
        return ": " + stderr;
    }
    return "";
}

/// Write runnable input files and return a result map.
fn case_write_input_files(scenario, directory, files, prefix) {
    if !map_has(scenario, "inputFiles") {
        return result_ok();
    }
    inputs := map_get(scenario, "inputFiles");
    names := map_keys(inputs);
    position := 0;
    while position < list_length(names) {
        name := list_get(names, position);
        stream := case_stream_bytes(map_get(inputs, name), directory);
        if result_is_fail(stream) {
            return result_fail(prefix + result_get_message(stream));
        }
        target := path_join(files, name);
        directory_create(path_parent(target));
        file_write_bytes(target, map_get(stream, "bytes"));
        position = position + 1;
    }
    return result_ok();
}

/// Compare runnable output files and return a result map.
fn case_check_output_files(scenario, directory, files, prefix) {
    if !map_has(scenario, "outputFiles") {
        return result_ok();
    }
    outputs := map_get(scenario, "outputFiles");
    names := map_keys(outputs);
    position := 0;
    while position < list_length(names) {
        name := list_get(names, position);
        expected := case_stream_bytes(map_get(outputs, name), directory);
        if result_is_fail(expected) {
            return result_fail(prefix + result_get_message(expected));
        }
        target := path_join(files, name);
        if !path_is_exists(target) || !case_bytes_equal(file_read_bytes(target), map_get(expected, "bytes")) {
            return result_fail(prefix + "file " + name);
        }
        position = position + 1;
    }
    return result_ok();
}

/// Return the identity hashes for a case fixture.
fn case_case_identity(fixture, project_root) {
    definition := map_get(fixture, "definition");
    directory := path_parent(map_get(fixture, "path"));
    source := "";
    if map_get(definition, "kind") == "tool" {
        source = path_join(path_join(project_root, "bin"), map_get(definition, "tool"));
    } else {
        source = path_resolve(directory, map_get(definition, "source"));
    }
    streams := list_new();
    scenarios := map_get(definition, "cases");
    position := 0;
    while position < list_length(scenarios) {
        scenario := list_get(scenarios, position);
        entry := map_new();
        map_set(entry, "name", map_get(scenario, "name"));
        map_set(
            entry,
            "stdin",
            hash_sha256(map_get(case_stream_bytes(map_get(scenario, "stdin"), directory), "bytes"))
        );
        map_set(
            entry,
            "stdout",
            hash_sha256(map_get(case_stream_bytes(map_get(scenario, "stdout"), directory), "bytes"))
        );
        map_set(
            entry,
            "stderr",
            hash_sha256(map_get(case_stream_bytes(map_get(scenario, "stderr"), directory), "bytes"))
        );
        if map_has(scenario, "artifact") {
            map_set(
                entry,
                "artifact",
                hash_sha256(map_get(case_stream_bytes(map_get(scenario, "artifact"), directory), "bytes"))
            );
        }
        if map_has(scenario, "inputFiles") {
            map_set(entry, "inputFiles", case_file_hashes(map_get(scenario, "inputFiles"), directory));
        }
        if map_has(scenario, "outputFiles") {
            map_set(entry, "outputFiles", case_file_hashes(map_get(scenario, "outputFiles"), directory));
        }
        list_set(streams, list_length(streams), entry);
        position = position + 1;
    }
    identity := map_new();
    map_set(identity, "manifest", hash_sha256(file_read_bytes(map_get(fixture, "path"))));
    map_set(identity, "source", hash_sha256(file_read_bytes(source)));
    map_set(identity, "streams", streams);
    return identity;
}

/// Return hashes for a file fixture map.
fn case_file_hashes(files, directory) {
    hashes := map_new();
    names := map_keys(files);
    position := 0;
    while position < list_length(names) {
        name := list_get(names, position);
        map_set(
            hashes,
            name,
            hash_sha256(map_get(case_stream_bytes(map_get(files, name), directory), "bytes"))
        );
        position = position + 1;
    }
    return hashes;
}
