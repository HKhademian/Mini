include "../common/io.mini";
include "../common/value.mini";
include "../common/list.mini";
include "../common/text.mini";
include "./cases.mini";
/// Run repository checks: strict TypeScript (unless --docs), generated tools,
/// versions, editor metadata, cases, documents, portable paths, and bootstrap.
/// Usage: node dist/check.js [--docs]

/// Report a check failure and stop.
fn check_fail(message) {
    io_write_error(message + "\n");
    process_exit(1);
    return 0;
}

/// Run a command with inherited standard streams.
fn check_inherit(command, args, directory) {
    options := map_new();
    map_set(options, "command", command);
    map_set(options, "arguments", args);
    map_set(options, "directory", directory);
    map_set(options, "mode", "inherit");
    return process_spawn(options);
}

/// Find needle at or after offset.
fn check_find_from(text, needle, offset) {
    position := text_find(text_slice(text, offset, text_length(text)), needle);
    if position < 0 {
        return -1;
    }
    return offset + position;
}

/// Return whether text is decimal digits without a leading zero unless zero.
fn check_digits(text) {
    if text_length(text) == 0 {
        return false;
    }
    if text_length(text) > 1 && text_get(text, 0) == "0" {
        return false;
    }
    position := 0;
    while position < text_length(text) {
        if text_find("0123456789", text_get(text, position)) < 0 {
            return false;
        }
        position = position + 1;
    }
    return true;
}

/// Return whether a dotted numeric version has three parts.
fn check_plain_version(text) {
    parts := text_split(text, ".");
    if list_length(parts) != 3 {
        return false;
    }
    position := 0;
    while position < list_length(parts) {
        if !check_digits(list_get(parts, position)) {
            return false;
        }
        position = position + 1;
    }
    return true;
}

/// Return whether a product version is valid.
fn check_product_version(text) {
    parts := text_split(text, "-");
    if list_length(parts) == 1 {
        return check_plain_version(text);
    }
    if list_length(parts) != 2 || !check_plain_version(list_get(parts, 0)) {
        return false;
    }
    pre := text_split(list_get(parts, 1), ".");
    if list_length(pre) != 2 {
        return false;
    }
    stage := list_get(pre, 0);
    if stage != "alpha" && stage != "beta" && stage != "rc" {
        return false;
    }
    return check_digits(list_get(pre, 1));
}

/// Return a sorted text list.

/// Return sorted map keys.
fn check_keys(value) {
    return list_sorted(map_keys(value));
}

/// Read a JSON file and stop on failure.
fn check_json(path) {
    parsed := json_parse_file(path);
    if result_is_fail(parsed) {
        check_fail(result_get_message(parsed));
    }
    return result_get_value(parsed);
}

/// Compare two text lists element by element.
fn check_same_list(left, right) {
    if list_length(left) != list_length(right) {
        return false;
    }
    position := 0;
    while position < list_length(left) {
        if list_get(left, position) != list_get(right, position) {
            return false;
        }
        position = position + 1;
    }
    return true;
}

/// Count code fence markers and verify links in one document.
fn check_document(path) {
    text := file_read(path);
    lines := split_lines(text);
    in_fence := false;
    directory := path_parent(path);
    position := 0;
    while position < list_length(lines) {
        line := list_get(lines, position);
        if text_starts_with(line, "```") {
            in_fence = !in_fence;
        } else {
            if !in_fence {
                cursor := check_find_from(line, "](", 0);
                while cursor >= 0 {
                    start := cursor + 2;
                    end := check_find_from(line, ")", start);
                    if end < 0 {
                        end = text_length(line);
                    }
                    target := text_slice(line, start, end);
                    hash := text_find(target, "#");
                    if hash >= 0 {
                        target = text_slice(target, 0, hash);
                    }
                    if text_length(target) > 0 && !check_is_url(target)
                        && !path_is_exists(path_resolve(directory, target)) {
                        check_fail("broken local link in " + path + ": " + target);
                    }
                    cursor = check_find_from(line, "](", end);
                }
            }
        }
        position = position + 1;
    }
    if in_fence {
        check_fail("unbalanced code fence: " + path);
    }
    return 0;
}

/// Return whether a link target has a URL scheme.
fn check_is_url(target) {
    colon := text_find(target, ":");
    if colon <= 0 {
        return false;
    }
    prefix := text_slice(target, 0, colon);
    position := 0;
    while position < text_length(prefix) {
        character := text_get(prefix, position);
        if text_find("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ", character) < 0 {
            return false;
        }
        position = position + 1;
    }
    return true;
}

/// Walk documents below a directory.
fn check_documents(directory) {
    entries := directory_list(directory);
    position := 0;
    while position < list_length(entries) {
        name := list_get(entries, position);
        path := path_join(directory, name);
        if case_entry_excluded(name) {
        } else {
            if path_is_directory(path) {
                check_documents(path);
            } else {
                if text_ends_with(name, ".md") || text_ends_with(name, ".mdc") {
                    check_document(path);
                }
            }
        }
        position = position + 1;
    }
    return 0;
}

/// Return whether a file name has a checked extension.
fn check_portable_file(name) {
    suffixes := list_of(".json", ".ts", ".md", ".mdc", ".mini", ".yml", ".yaml", ".stdout", ".stderr", ".stdin", ".svg", ".js");
    position := 0;
    while position < list_length(suffixes) {
        if text_ends_with(name, list_get(suffixes, position)) {
            return true;
        }
        position = position + 1;
    }
    return false;
}

/// Reject committed absolute home paths.
fn check_portable_paths(directory) {
    entries := directory_list(directory);
    position := 0;
    while position < list_length(entries) {
        name := list_get(entries, position);
        path := path_join(directory, name);
        if case_entry_excluded(name) {
        } else {
            if path_is_directory(path) {
                check_portable_paths(path);
            } else {
                if check_portable_file(name) {
                    text := file_read(path);
                    users := "/" + "Users" + "/";
                    homes := "/" + "home" + "/";
                    windows := "C:" + "\\" + "Users" + "\\";
                    home_variable := "$" + "HOME/";
                    if text_find(text, users) >= 0 || text_find(text, homes) >= 0
                        || text_find(text, windows) >= 0 || text_find(text, home_variable) >= 0 {
                        check_fail("absolute home path in " + path);
                    }
                }
            }
        }
        position = position + 1;
    }
    return 0;
}

/// Check every sample and example has a non-tool case source.
fn check_sample_cases(root, fixtures) {
    covered := map_new();
    position := 0;
    while position < list_length(fixtures) {
        fixture := list_get(fixtures, position);
        definition := map_get(fixture, "definition");
        if map_get(definition, "kind") != "tool" {
            source := path_resolve(path_parent(map_get(fixture, "path")), map_get(definition, "source"));
            map_set(covered, source, true);
        }
        position = position + 1;
    }
    directories := list_of("samples", "examples");
    position = 0;
    while position < list_length(directories) {
        name := list_get(directories, position);
        directory := path_join(root, name);
        if path_is_exists(directory) {
            check_sample_walk(directory, name, covered);
        }
        position = position + 1;
    }
    return 0;
}

/// Walk one sample directory and require case coverage.
fn check_sample_walk(directory, relative, covered) {
    entries := directory_list(directory);
    position := 0;
    while position < list_length(entries) {
        name := list_get(entries, position);
        path := path_join(directory, name);
        if path_is_directory(path) {
            check_sample_walk(path, relative + "/" + name, covered);
        } else {
            if text_ends_with(name, ".mini") && !map_has(covered, path) {
                check_fail("missing case: " + relative + "/" + name);
            }
        }
        position = position + 1;
    }
    return 0;
}

/// Check the version registry and editor metadata.
fn check_versions(root) {
    current := check_json(path_join(root, "config/versions.json"));
    expected := list_new();
    names := list_of("group", "mini", "language", "compiler", "bootstrap", "std", "check", "verify", "release", "test", "bench", "cli", "vscode", "builtins", "format", "lsp");
    position := 0;
    while position < list_length(names) {
        list_set(expected, position, list_get(names, position));
        position = position + 1;
    }
    if !check_same_list(check_keys(current), list_sorted(expected)) {
        check_fail("invalid version registry keys");
    }
    group := map_get(current, "group");
    if !value_is_text(group) || !check_plain_version(group) {
        check_fail("group requires MAJOR.MINOR.PATCH");
    }
    position = 0;
    while position < list_length(expected) {
        key := list_get(expected, position);
        version := map_get(current, key);
        if key != "group" && !value_is_number(version) && !value_is_text(version) {
            check_fail("invalid version: " + key);
        }
        if value_is_text(version) && !check_product_version(version) {
            check_fail("invalid version: " + version);
        }
        position = position + 1;
    }
    editor := check_json(path_join(root, "editors/vscode/package.json"));
    lock := check_json(path_join(root, "editors/vscode/package-lock.json"));
    editor_version := map_get(editor, "version");
    lock_package := map_get(map_get(lock, "packages"), "");
    if editor_version != map_get(current, "vscode") {
        check_fail("VS Code version must match the registry");
    }
    if text_find(editor_version, "-") >= 0 {
        check_fail("VS Code versions require plain MAJOR.MINOR.PATCH");
    }
    if map_get(lock, "version") != editor_version {
        check_fail("VS Code lockfile version differs");
    }
    if map_get(lock_package, "version") != editor_version {
        check_fail("VS Code lockfile package version differs");
    }
    return 0;
}

/// Check the Node runtime version.
fn check_node(root) {
    args := list_new();
    list_set(args, 0, "-v");
    result := process_capture(process_exec_path(), args, root, list_new());
    version := text_from_bytes(map_get(result, "stdout"));
    if !text_starts_with(version, "v") {
        check_fail("use Node 22.18.0 or newer");
    }
    parts := text_split(text_slice(version, 1, text_length(version)), ".");
    if list_length(parts) < 2 {
        check_fail("use Node 22.18.0 or newer");
    }
    major := number_from_text(list_get(parts, 0));
    minor := number_from_text(list_get(parts, 1));
    if major < 22 || (major == 22 && minor < 18) {
        check_fail("use Node 22.18.0 or newer");
    }
    return 0;
}

/// Run repository checks and return success.
fn check_repository(root, docs_only) {
    if !docs_only {
        tsc := list_of(path_join(root, "node_modules/typescript/bin/tsc"), "--noEmit");
        typed := check_inherit(process_exec_path(), tsc, root);
        if map_get(typed, "status") != 0 {
            process_exit(map_get(typed, "status"));
        }
    }
    tools := list_of(path_join(root, "dist/build.js"), "--check");
    verified_tools := check_inherit(process_exec_path(), tools, root);
    if map_get(verified_tools, "status") != 0 {
        process_exit(map_get(verified_tools, "status"));
    }
    seed := path_join(root, "bin/bootstrap");
    generated_seed := path_join(root, "dist/bootstrap.js");
    if !path_is_exists(seed) || !path_is_exists(generated_seed) || file_read(seed) != file_read(generated_seed) {
        check_fail("bin/bootstrap is stale; run ./bin/bootstrap or rebuild the seed");
    }
    check_versions(root);
    check_node(root);
    loaded := case_load_cases("", root);
    if result_is_fail(loaded) {
        check_fail(result_get_message(loaded));
    }
    check_sample_cases(root, map_get(loaded, "fixtures"));
    check_documents(root);
    check_portable_paths(root);
    bootstrap := check_json(path_join(root, "config/bootstrap.json"));
    if !value_is_map(bootstrap) {
        check_fail("self-hosted bootstrap unavailable; promote a generated compiler");
    }
    active := check_json(path_join(root, "config/compiler.json"));
    if map_get(active, "entry") != map_get(bootstrap, "compiler") {
        check_fail("active compiler must be the generated bootstrap");
    }
    verify := list_of(path_join(root, "dist/verify.js"), root);
    verified := process_capture(process_exec_path(), verify, root, list_new());
    if map_get(verified, "status") != 0 {
        io_write_error(text_from_bytes(map_get(verified, "stderr")));
        process_exit(map_get(verified, "status"));
    }
    io_write_line("Repository checks and bootstrap fixed point passed.");
    return 0;
}
