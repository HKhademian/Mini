include "../common/value.mini";
include "../common/list.mini";
include "../common/text.mini";
include "./cases.mini";
/// Verify the promoted bootstrap fixed point and its example case.
/// Usage: node dist/verify.js [PROJECT_ROOT]
/// Prints one compact JSON object with source, compiler, generation, example,
/// and artifact hashes. Exits 1 on any mismatch.

/// Report a verification failure and stop.
fn verify_fail(message) {
    io_write_error(message + "\n");
    process_exit(1);
    return 0;
}

/// Return a text field from a parsed JSON map, or empty text.
fn verify_text(value, key) {
    if !map_has(value, key) {
        return "";
    }
    field := map_get(value, key);
    if !value_is_text(field) {
        return "";
    }
    return field;
}

/// Verify the promoted bootstrap and return its JSON identity record.
fn verify_bootstrap(root) {
    bootstrap_path := path_join(root, "config/bootstrap.json");
    if !path_is_exists(bootstrap_path) {
        verify_fail("Self-hosted bootstrap unavailable: finish and promote the mini-written compiler first.");
    }
    parsed := json_parse(file_read(bootstrap_path));
    if result_is_fail(parsed) || value_kind(result_get_value(parsed)) != "map" {
        verify_fail("invalid config/bootstrap.json");
    }
    config := result_get_value(parsed);
    compiler := verify_text(config, "compiler");
    source := verify_text(config, "source");
    example := verify_text(config, "example");
    if compiler == "" || source == "" || example == "" {
        verify_fail("bootstrap.json needs compiler, source, and example");
    }
    versions_parsed := json_parse(file_read(path_join(root, "config/versions.json")));
    if result_is_fail(versions_parsed) {
        verify_fail("invalid config/versions.json");
    }
    current := result_get_value(versions_parsed);
    if verify_text(current, "language") == "" || verify_text(current, "compiler") == ""
        || verify_text(current, "bootstrap") == "" {
        verify_fail("assign the language, compiler, and bootstrap versions before verifying the bootstrap");
    }
    source_path := path_join(root, source);
    seed_path := path_join(root, compiler);
    source_bytes := file_read_bytes(source_path);
    seed_bytes := file_read_bytes(seed_path);
    work := path_temp_directory();
    if text_length(work) == 0 {
        verify_fail("cannot create a temporary directory");
    }
    file_write(path_join(work, "package.json"), "{\"type\":\"module\"}\n");
    previous := path_join(work, "compiler0.js");
    file_write_bytes(previous, seed_bytes);
    generations := list_new();
    stage := 1;
    while stage <= 3 {
        next := path_join(work, "compiler" + number_to_text(stage) + ".js");
        compile_args := list_of(previous, source_path, next);
        result := process_capture(process_exec_path(), compile_args, work, list_new());
        if map_get(result, "status") != 0 {
            path_remove(work);
            verify_fail("bootstrap generation " + number_to_text(stage) + " failed: " + text_from_bytes(map_get(result, "stderr")));
        }
        output := file_read_bytes(next);
        if !case_bytes_equal(output, seed_bytes) {
            path_remove(work);
            verify_fail("bootstrap differs from generation " + number_to_text(stage)
                + "; regenerate and promote the matching compiler");
        }
        list_set(generations, list_length(generations), hash_sha256(output));
        previous = next;
        stage = stage + 1;
    }
    case_path := path_resolve(root, example);
    loaded := case_load_case(case_path);
    if result_is_fail(loaded) {
        path_remove(work);
        verify_fail(result_get_message(loaded));
    }
    fixture := map_get(loaded, "fixture");
    definition := map_get(fixture, "definition");
    if map_get(definition, "kind") != "example" {
        path_remove(work);
        verify_fail("bootstrap example must be an example case");
    }
    artifacts := list_new();
    scenarios := map_get(definition, "cases");
    position := 0;
    while position < list_length(scenarios) {
        verified := case_verify_scenario(fixture, list_get(scenarios, position), root, previous);
        if result_is_fail(verified) {
            path_remove(work);
            verify_fail(result_get_message(verified));
        }
        list_set(artifacts, list_length(artifacts), map_get(verified, "artifact"));
        position = position + 1;
    }
    record := map_new();
    map_set(record, "source", hash_sha256(source_bytes));
    map_set(record, "compiler", hash_sha256(seed_bytes));
    map_set(record, "generations", generations);
    map_set(record, "example", case_case_identity(fixture, root));
    map_set(record, "artifacts", artifacts);
    path_remove(work);
    return json_to_text(record) + "\n";
}
