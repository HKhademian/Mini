/// Return whether a list contains one text value.
fn list_has_text(items, value) {
    var position = 0;
    while (position < list_length(items)) {
        if (list_get(items, position) == value) {
            return true;
        }
        position = position + 1;
    }
    return false;
}

/// Join list items from an index with a separator.
fn list_join_from(items, start, separator) {
    var parts = list_new();
    var position = start;
    while (position < list_length(items)) {
        list_set(parts, list_length(parts), list_get(items, position));
        position = position + 1;
    }
    return list_to_text(parts, separator);
}

/// Reverse a list into a new list.
fn list_reverse(items) {
    var result = list_new();
    var position = list_length(items) - 1;
    while (position >= 0) {
        list_set(result, list_length(result), list_get(items, position));
        position = position - 1;
    }
    return result;
}

/// Sort a list into a new list using pairwise comparison.
fn list_sorted(items) {
    var result = list_copy(items);
    var position = 0;
    while (position < list_length(result)) {
        var cursor = position + 1;
        while (cursor < list_length(result)) {
            if (list_get(result, cursor) < list_get(result, position)) {
                var hold = list_get(result, position);
                list_set(result, position, list_get(result, cursor));
                list_set(result, cursor, hold);
            }
            cursor = cursor + 1;
        }
        position = position + 1;
    }
    return result;
}
