/// Queue portable tone requests for the active audio host.

import "core/list";

audio_tone_values := list_new();

/// Queue a tone in hertz, milliseconds, and volume percent from zero to one hundred.
/// Invalid frequencies, durations, and volumes are ignored.
fn audio_tone(frequency, duration_ms, volume_percent) {
    if frequency < 20 || frequency > 20000 || duration_ms <= 0 || duration_ms > 3000 || volume_percent <= 0 || volume_percent > 100 {
        return 0;
    }
    list_push_back(audio_tone_values, frequency);
    list_push_back(audio_tone_values, duration_ms);
    list_push_back(audio_tone_values, volume_percent);
    return 0;
}

/// Return queued tone triples and clear the queue for the host.
fn audio_tone_drain() {
    tones := list_copy(audio_tone_values);
    list_truncate(audio_tone_values, 0);
    return tones;
}
