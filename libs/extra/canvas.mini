/// Store the canvas title, dimensions, and most recently drawn pixel list.

import "core/list";

canvas_width_value := 0;
canvas_height_value := 0;
canvas_title_value := "";
canvas_pixels_value := list_new();

/// Select an animated canvas host and set its title.
fn canvas_play(title) {
    canvas_title_value = title;
    return 0;
}

/// Store one row-major frame and its dimensions using packed RGB color values.
fn canvas_draw(width, height, pixels) {
    canvas_width_value = width;
    canvas_height_value = height;
    canvas_pixels_value = pixels;
    return 0;
}

/// Return the most recently drawn frame width.
fn canvas_get_width() {
    return canvas_width_value;
}

/// Return the most recently drawn frame height.
fn canvas_get_height() {
    return canvas_height_value;
}

/// Return the play title.
fn canvas_get_title() {
    return canvas_title_value;
}

/// Return the stored row-major frame list without copying it.
fn canvas_get_pixels() {
    return canvas_pixels_value;
}
