import "core/map";
import "./value";

/// Return a successful result map.
///
/// Both arguments are optional. A missing value is 0, so result_ok() is a bare
/// success, and no call site supplies a message yet, so its default is empty
/// text.
fn result_ok(value, message) {
    result := map_new();
    map_set(result, "ok", true);
    map_set(result, "value", value);
    map_set(result, "message", message);
    return result;
}

/// Return a failed result map.
fn result_fail(message) {
    result := map_new();
    map_set(result, "ok", false);
    map_set(result, "value", 0);
    map_set(result, "message", message);
    return result;
}

/// Return whether a value is a successful result map.
fn result_is_ok(result) {
    if !value_is_map(result) {
        return false;
    }
    return map_get(result, "ok") == true;
}

/// Return whether a value is a failed result map.
fn result_is_fail(result) {
    return !result_is_ok(result);
}

/// Return a result message, or empty text for non-results.
fn result_get_message(result) {
    if !value_is_map(result) {
        return "";
    }
    return map_get(result, "message");
}

/// Set a result message and return the result.
fn result_set_message(result, message) {
    if value_is_map(result) {
        map_set(result, "message", message);
    }
    return result;
}

/// Return a result value, or numeric zero for non-results.
fn result_get_value(result) {
    if !value_is_map(result) {
        return 0;
    }
    return map_get(result, "value");
}

/// Set a result value and return the result.
fn result_set_value(result, value) {
    if value_is_map(result) {
        map_set(result, "value", value);
    }
    return result;
}
