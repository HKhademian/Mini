import "core/json";
import "core/list";
import "core/number";
import "core/value";

/// Return text unchanged, or empty text for a non-text value.
fn text_to_text(value) {
    if value_is_text(value) {
        return value;
    }
    return "";
}

/// Return compact JSON text for a list, or empty text for a non-list value.
fn list_to_text(value) {
    if value_is_list(value) {
        return json_text(value);
    }
    return "";
}

/// Convert a value to its display text.
fn value_to_text(value) {
    kind := value_kind(value);
    if kind == "text" {
        return text_to_text(value);
    }
    if kind == "number" {
        return number_to_text(value);
    }
    if kind == "boolean" {
        if value {
            return "true";
        }
        return "false";
    }
    if kind == "list" {
        return list_to_text(value);
    }
    if kind == "map" {
        return json_text(value);
    }
    return "0";
}

/// Return the shared display text for any value.
fn to_text(value) {
    return value_to_text(value);
}

/// Join display-converted values using a text separator.
fn value_join() {
    values := fn_args();
    if list_length(values) == 0 || !value_is_text(list_get(values, 0)) {
        return "";
    }
    separator := list_get(values, 0);
    output := "";
    position := 1;
    while position < list_length(values) {
        if position > 1 {
            output = output + separator;
        }
        output = output + value_to_text(list_get(values, position));
        position = position + 1;
    }
    return output;
}
