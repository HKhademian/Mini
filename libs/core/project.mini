import "core/map";
import "./path";
import "./json";
import "./result";
import "core/process";
import "core/file";

/// Return the repository root from the running tool path.
fn project_root() {
    script := process_script_path();
    base := path_parent(path_parent(script));
    if path_basename(base) == "dist" {
        return path_parent(base);
    }
    return base;
}

/// Return the active compiler entry from configuration.
fn project_compiler_entry(root) {
    path := path_join(root, "config/compiler.json");
    if !path_is_exists(path) {
        return "";
    }
    parsed := json_value(file_read(path));
    if result_is_fail(parsed) {
        return "";
    }
    return map_get(result_get_value(parsed), "entry");
}
