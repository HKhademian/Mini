include "value.mini";
/// Return a successful result map.
fn result_ok() {
    var result = map_new();
    map_set(result, "ok", true);
    map_set(result, "message", "");
    return result;
}

/// Return a failed result map.
fn result_fail(message) {
    var result = map_new();
    map_set(result, "ok", false);
    map_set(result, "message", message);
    return result;
}

/// Return whether a value is a successful result map.
fn result_is_ok(result) {
    if (!value_is_map(result)) {
        return false;
    }
    return map_get(result, "ok") == true;
}

/// Return whether a value is a failed result map.
fn result_is_fail(result) {
    return !result_is_ok(result);
}
