/// Copy a map and show that changing the copy leaves the original intact.

import "common/map";
include "common/io.mini";

original := map_new();
map_set(original, "name", "original");
copy := map_copy(original);
map_set(copy, "name", "copy");
io_write_line(map_get(original, "name"));
io_write_line(map_get(copy, "name"));
