/// Write a note in a fresh temporary directory, read it back, and clean up.

import "core/io";
import "util/path";
import "core/file";

directory := path_temp_directory();
file_write(directory + "/note.txt", "Mini\n");
saved := file_read(directory + "/note.txt");
file_remove(directory + "/note.txt");
directory_remove(directory);
io_write(saved);
