/// Print each command-line argument on its own line.

import "common/list";
import "common/io";

args := fn_args();
io_write_line("Arguments (", list_length(args), "):");
position := 0;
while position < list_length(args) {
    io_write_line("- [", list_get(args, position), "]");
    position = position + 1;
}
