/// Join the command-line text arguments and write them to stdout.

/// Return items separated by pipes; leave the list unchanged and return empty text for no items.
fn join(items) {
    var output = "";
    var position = 0;
    while (position < list_length(items)) {
        if (position > 0) {
            output = output + "|";
        }
        output = output + list_get(items, position);
        position = position + 1;
    }
    return output;
}
var args = process_args();
io_write(join(args));
