/// Show empty-text and zero read fallbacks, list gaps, and indexing from the end.

import "common/list";
import "common/map";
import "common/io";

io_write_line("character: " + text_get("hello", 1));
if text_get(0, 1) == "" && text_get("hello", 2000) == "" {
    io_write_line("unavailable text: empty");
}
if list_get(0, 2000) == 0 {
    io_write_line("unavailable list value: zero");
}
items := list_new();
list_set(items, 2, "last");
if list_get(items, 0) == 0 {
    io_write_line("gap reads zero");
}
io_write_line("last: " + list_get(items, -1));
if map_get(map_new(), "missing") == 0 {
    io_write_line("missing map value: zero");
}
