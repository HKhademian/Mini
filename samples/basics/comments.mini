/// Show documentation comments on a function and line comments in its body.

import "core/io";
import "util/io";

/// Return 1 for any supplied values a and b; neither argument is changed.
fn mine(a, b) {
    // Both arguments are deliberately unused in this documentation example.
    return 1;
}

if mine(4, 5) == 1 {
    io_write_line("documented function"); /// Documentation can also follow code.
}
