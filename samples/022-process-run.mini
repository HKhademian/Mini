/// Run Node once, capture its output and status, and print them.

import "core/list";
import "core/map";
import "core/io";
import "core/process";
import "util/process";
import "util/io";

args := list_new();
list_set(args, 0, "-e");
list_set(args, 1, "process.stdout.write(\"sample\")");
result := process_run("node", args, "capture");
io_write_line(map_get(result, "stdout"), " ", map_get(result, "status"));
