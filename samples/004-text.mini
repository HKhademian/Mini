/// Read stdin, replace each tab or line-ending character with a space, and print it.

import "common/io";

/// Return normalized text without changing source; ordinary characters are retained.
import "common/text";
fn normalize(source) {
    output := "";
    position := 0;
    current := "";
    while position < text_length(source) {
        current = text_get(source, position);
        if current == "\t" || current == "\r" || current == "\n" {
            output = output + " ";
        } else {
            output = output + current;
        }
        position = position + 1;
    }
    return output;
}
io_write(normalize(io_read_all()));
