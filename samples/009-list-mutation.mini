var items = list_new();
list_set(items, 0, "first");
list_set(items, 1, "second");
list_set(items, -1, "last");
list_set(items, -3, "ignored");
write(list_at(items, 0) + "|" + list_at(items, 1) + "\n");

list_set(items, 2, 7);
list_set(items, 3, true);
if (list_length(items) == 4 && list_at(items, 2) == 7 && list_at(items, 3)) {
    write("mixed values\n");
}

var nested = list_new();
list_set(nested, 0, "nested");
list_set(items, 4, nested);
write(list_at(list_at(items, 4), 0));
write("\n");
