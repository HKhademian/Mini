/// Paint a persistent trail by moving the pointer across a ten-by-ten canvas.

import "core/io";
import "core/list";
import "core/number";
import "extra/board";
import "extra/canvas";
import "util/io";

screen_size := 10;
background := pixel_rgb(8, 18, 34);
trail_color := pixel_rgb(90, 220, 185);
trail := pixel_board_new(screen_size, screen_size, background);
pointer_column := number_div(screen_size, 2);
pointer_row := number_div(screen_size, 2);

/// Draw the saved trail and current pointer position.
fn pixel_cursor_draw_render() {
    board := list_copy(trail);
    pixel_board_set(board, screen_size, screen_size, pointer_column, pointer_row, pixel_rgb(255, 220, 96));
    pixel_board_draw(screen_size, screen_size, board);
}

/// Paint the cell under the pointer and remember it for the trail.
fn canvas_on_pointer_move(column, row) {
    pointer_column = column;
    pointer_row = row;
    pixel_board_set(trail, screen_size, screen_size, column, row, trail_color);
}

/// Keep the latest trail visible while the pointer is still. Elapsed time is provided in seconds.
fn canvas_on_update(dt) {
    pixel_cursor_draw_render();
}

/// Print an empty initial board with the pointer centered.
fn pixel_cursor_draw_print() {
    row := 0;
    while row < screen_size {
        column := 0;
        line := "";
        while column < screen_size {
            if column == pointer_column && row == pointer_row {
                line = line + "*";
            } else {
                line = line + ".";
            }
            column = column + 1;
        }
        io_write_line(line);
        row = row + 1;
    }
}

pixel_cursor_draw_render();
canvas_play("Draw with Pointer · Move to Paint");
pixel_cursor_draw_print();
