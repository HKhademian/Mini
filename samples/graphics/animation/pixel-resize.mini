/// Resize the same canvas as the frame changes on each update.

import "core/io";
import "core/number";
import "extra/board";
import "extra/canvas";
import "util/io";

minimum_size := 5;
maximum_size := 9;
playback_fps := 60;
animation_fps := 3;
frames_per_step := number_div(playback_fps, animation_fps);
background := pixel_rgb(14, 24, 52);
outline := pixel_rgb(54, 116, 220);
center := pixel_rgb(255, 220, 104);
screen_size := minimum_size;
size_direction := 1;
update_ticks := 0;

/// Draw the current size as a frame on the same canvas.
fn pixel_resize_draw() {
    board := pixel_board_new(screen_size, screen_size, background);
    edge := screen_size - 1;
    position := 0;
    while position < screen_size {
        pixel_board_set(board, screen_size, screen_size, position, 0, outline);
        pixel_board_set(board, screen_size, screen_size, position, edge, outline);
        pixel_board_set(board, screen_size, screen_size, 0, position, outline);
        pixel_board_set(board, screen_size, screen_size, edge, position, outline);
        position = position + 1;
    }
    pixel_board_set(board, screen_size, screen_size, number_div(screen_size, 2), number_div(screen_size, 2), center);
    canvas_draw(screen_size, screen_size, board);
}

/// Change the frame size at three steps per second while keeping one canvas.
fn canvas_on_update(dt) {
    update_ticks = update_ticks + 1;
    if update_ticks >= frames_per_step {
        update_ticks = 0;
        screen_size = screen_size + size_direction;
        if screen_size >= maximum_size {
            size_direction = 0 - 1;
        } else if screen_size <= minimum_size {
            size_direction = 1;
        }
    }
    pixel_resize_draw();
}

pixel_resize_draw();
canvas_play("Dynamic Canvas Size · 3 steps per second");
io_write_line("The same canvas grows from five to nine pixels wide.");
