/// EML (exp(x) - ln(y)) complex fixed-point library, stack machine, and converter.
/// Uses 6-decimal-place fixed-point arithmetic (SCALE = 1000000) so it runs on
/// MiniLang's integer-only numeric model.

import "core/list";
import "core/map";
import "core/number";
import "core/process";
import "core/text";
import "util/io";

fn eml_scale() {
    return 1000000;
}

fn eml_pi() {
    return 3141593;
}

fn eml_ln2() {
    return 693147;
}

fn eml_abs(x) {
    if x < 0 {
        return 0 - x;
    }
    return x;
}

/// Fast truncating integer division using binary doubling (avoids slow repeated subtraction).
fn eml_idiv(a, b) {
    if b == 0 {
        return 0;
    }
    neg := false;
    left := a;
    right := b;
    if left < 0 {
        left = 0 - left;
        neg = !neg;
    }
    if right < 0 {
        right = 0 - right;
        neg = !neg;
    }
    if left < right {
        return 0;
    }
    q := 0;
    while left >= right {
        d := right;
        m := 1;
        while d + d <= left {
            d = d + d;
            m = m + m;
        }
        left = left - d;
        q = q + m;
    }
    if neg {
        return 0 - q;
    }
    return q;
}

/// Fast integer multiplication using Russian peasant doubling.
fn eml_imul(a, b) {
    if a == 0 || b == 0 {
        return 0;
    }
    neg := false;
    left := a;
    right := b;
    if left < 0 {
        left = 0 - left;
        neg = !neg;
    }
    if right < 0 {
        right = 0 - right;
        neg = !neg;
    }
    res := 0;
    while right > 0 {
        // Check parity using repeated doubling is not needed; use bit-by-bit via number_mod(right, 2) or halving:
        half := eml_idiv(right, 2);
        if half + half != right {
            res = res + left;
        }
        left = left + left;
        right = half;
    }
    if neg {
        return 0 - res;
    }
    return res;
}

fn eml_fp_mul(a, b) {
    return eml_idiv(eml_imul(a, b), eml_scale());
}

fn eml_fp_div(a, b) {
    if b == 0 {
        return 0;
    }
    return eml_idiv(eml_imul(a, eml_scale()), b);
}

fn eml_fp_round_div(a, b) {
    if b == 0 {
        return 0;
    }
    // Round toward nearest integer.
    if (a >= 0 && b > 0) || (a < 0 && b < 0) {
        return eml_idiv(a + a + b, b + b);
    }
    return eml_idiv(a + a - b, b + b);
}

fn eml_real_sqrt(x) {
    if x <= 0 {
        return 0;
    }
    s := eml_scale();
    g := s;
    if x > s {
        g = x;
    }
    i := 0;
    while i < 24 {
        g = eml_idiv(g + eml_fp_div(x, g), 2);
        i = i + 1;
    }
    return g;
}

fn eml_real_exp(x) {
    s := eml_scale();
    l2 := eml_ln2();
    k := eml_fp_round_div(x, l2);
    r := x - eml_imul(k, l2);
    sum := s;
    term := s;
    n := 1;
    while n <= 16 {
        term = eml_idiv(eml_imul(term, r), eml_imul(n, s));
        sum = sum + term;
        n = n + 1;
    }
    if k > 0 {
        i := 0;
        while i < k {
            sum = sum + sum;
            i = i + 1;
        }
    } else {
        if k < 0 {
            i := 0;
            while i > k {
                sum = eml_idiv(sum, 2);
                i = i - 1;
            }
        }
    }
    return sum;
}

fn eml_real_ln(x) {
    if x <= 0 {
        return 0;
    }
    s := eml_scale();
    sqrt2 := 1414214;
    inv_sqrt2 := 707107;
    v := x;
    k := 0;
    while v >= sqrt2 {
        v = eml_idiv(v, 2);
        k = k + 1;
    }
    while v < inv_sqrt2 {
        v = v + v;
        k = k - 1;
    }
    u := eml_fp_div(v - s, v + s);
    u2 := eml_fp_mul(u, u);
    term := u;
    sum := u;
    n := 3;
    while n <= 27 {
        term = eml_fp_mul(term, u2);
        sum = sum + eml_idiv(term, n);
        n = n + 2;
    }
    return sum + sum + eml_imul(k, eml_ln2());
}

fn eml_wrap_angle(x) {
    two_pi := eml_pi() + eml_pi();
    k := eml_fp_round_div(x, two_pi);
    return x - eml_imul(k, two_pi);
}

fn eml_real_sin(x) {
    r := eml_wrap_angle(x);
    r2 := eml_fp_mul(r, r);
    term := r;
    sum := r;
    n := 1;
    while n <= 10 {
        denom := eml_imul(n + n, n + n + 1);
        term = eml_idiv((0 - eml_fp_mul(term, r2)), denom);
        sum = sum + term;
        n = n + 1;
    }
    return sum;
}

fn eml_real_cos(x) {
    s := eml_scale();
    r := eml_wrap_angle(x);
    r2 := eml_fp_mul(r, r);
    term := s;
    sum := s;
    n := 1;
    while n <= 10 {
        denom := eml_imul(n + n - 1, n + n);
        term = eml_idiv((0 - eml_fp_mul(term, r2)), denom);
        sum = sum + term;
        n = n + 1;
    }
    return sum;
}

fn eml_real_atan(x) {
    s := eml_scale();
    if x < 0 {
        return 0 - eml_real_atan(0 - x);
    }
    if x > s {
        return eml_idiv(eml_pi(), 2) - eml_real_atan(eml_fp_div(s, x));
    }
    t1 := eml_fp_div(x, s + eml_real_sqrt(s + eml_fp_mul(x, x)));
    t2 := eml_fp_div(t1, s + eml_real_sqrt(s + eml_fp_mul(t1, t1)));
    t2sq := eml_fp_mul(t2, t2);
    term := t2;
    sum := t2;
    n := 1;
    while n <= 9 {
        term = 0 - eml_fp_mul(term, t2sq);
        sum = sum + eml_idiv(term, n + n + 1);
        n = n + 1;
    }
    return sum + sum + sum + sum;
}

fn eml_real_atan2(y, x) {
    half_pi := eml_idiv(eml_pi(), 2);
    if x > 0 {
        return eml_real_atan(eml_fp_div(y, x));
    }
    if x < 0 && y >= 0 {
        return eml_real_atan(eml_fp_div(y, x)) + eml_pi();
    }
    if x < 0 && y < 0 {
        return eml_real_atan(eml_fp_div(y, x)) - eml_pi();
    }
    if x == 0 && y > 0 {
        return half_pi;
    }
    if x == 0 && y < 0 {
        return 0 - half_pi;
    }
    return 0;
}

/// Construct a complex number [re, im] in fixed-point units.
fn eml_c_make(re, im) {
    z := list_new();
    list_push_back(z, re);
    list_push_back(z, im);
    return z;
}

fn eml_c_re(z) {
    return list_get(z, 0);
}

fn eml_c_im(z) {
    return list_get(z, 1);
}

fn eml_c_one() {
    return eml_c_make(eml_scale(), 0);
}

fn eml_c_sub(a, b) {
    return eml_c_make(eml_c_re(a) - eml_c_re(b), eml_c_im(a) - eml_c_im(b));
}

fn eml_c_exp(z) {
    ea := eml_real_exp(eml_c_re(z));
    im := eml_c_im(z);
    return eml_c_make(eml_fp_mul(ea, eml_real_cos(im)), eml_fp_mul(ea, eml_real_sin(im)));
}

fn eml_c_ln(z) {
    re := eml_c_re(z);
    im := eml_c_im(z);
    r := eml_real_sqrt(eml_fp_mul(re, re) + eml_fp_mul(im, im));
    theta := eml_real_atan2(im, re);
    return eml_c_make(eml_real_ln(r), theta);
}

/// Core primitive: eml(x, y) = exp(x) - ln(y).
fn eml(x, y) {
    return eml_c_sub(eml_c_exp(x), eml_c_ln(y));
}

fn eml_fp_text(v) {
    s := eml_scale();
    if eml_abs(v) <= 5 {
        return "0";
    }
    sign := "";
    av := v;
    if av < 0 {
        sign = "-";
        av = 0 - av;
    }
    whole := eml_idiv(av, s);
    frac := av - eml_imul(whole, s);
    if frac <= 5 {
        return sign + number_to_text(whole);
    }
    if s - frac <= 5 {
        return sign + number_to_text(whole + 1);
    }
    frac_str := number_to_text(frac);
    while text_length(frac_str) < 6 {
        frac_str = "0" + frac_str;
    }
    return sign + number_to_text(whole) + "." + frac_str;
}

/// Format a complex number cleanly.
fn eml_c_text(z) {
    re := eml_c_re(z);
    im := eml_c_im(z);
    if eml_abs(im) <= 5 {
        return eml_fp_text(re);
    }
    return eml_fp_text(re) + " + i * " + eml_fp_text(im);
}

/// Run a '-'/1 (push 1) and '.'/0 (push eml(pop, pop)) stream program.
fn eml_run_stream(program) {
    stack := list_new();
    loose := false;
    underflows := 0;
    ops := 0;
    size := text_length(program);
    i := 0;
    while i < size {
        ch := text_get(program, i);
        if ch == "-" || ch == "1" {
            list_push_back(stack, eml_c_one());
            ops = ops + 1;
        } else {
            if ch == "." || ch == "0" {
                y := eml_c_one();
                if list_length(stack) > 0 {
                    y = list_pop_back(stack);
                } else {
                    loose = true;
                    underflows = underflows + 1;
                }
                x := eml_c_one();
                if list_length(stack) > 0 {
                    x = list_pop_back(stack);
                } else {
                    loose = true;
                    underflows = underflows + 1;
                }
                list_push_back(stack, eml(x, y));
                ops = ops + 1;
            }
        }
        i = i + 1;
    }
    depth := list_length(stack);
    if depth != 1 {
        loose = true;
    }
    tos := eml_c_one();
    if depth > 0 {
        tos = list_get(stack, depth - 1);
    }
    result := map_new();
    map_set(result, "tos", tos);
    map_set(result, "depth", depth);
    map_set(result, "loose", loose);
    map_set(result, "underflows", underflows);
    map_set(result, "ops", ops);
    return result;
}

// --- EML Converter: builds both eml(...) tree and '-'/'.' stream ---

fn eml_node(tree, stream, bits) {
    node := map_new();
    map_set(node, "tree", tree);
    map_set(node, "stream", stream);
    map_set(node, "bits", bits);
    return node;
}

fn eml_node_one() {
    return eml_node("1", "-", "1");
}

fn eml_node_eml(x, y) {
    return eml_node(
        "eml(" + map_get(x, "tree") + ", " + map_get(y, "tree") + ")",
        map_get(x, "stream") + map_get(y, "stream") + ".",
        map_get(x, "bits") + map_get(y, "bits") + "0"
    );
}

fn eml_node_e() {
    return eml_node_eml(eml_node_one(), eml_node_one());
}

fn eml_node_zero() {
    return eml_node_eml(eml_node_one(), eml_node_eml(eml_node_e(), eml_node_one()));
}

fn eml_node_exp(x) {
    return eml_node_eml(x, eml_node_one());
}

fn eml_node_ln(x) {
    return eml_node_eml(eml_node_one(), eml_node_eml(eml_node_eml(eml_node_one(), x), eml_node_one()));
}

fn eml_node_sub(x, y) {
    return eml_node_eml(eml_node_ln(x), eml_node_exp(y));
}

fn eml_node_minus_one() {
    e := eml_node_e();
    return eml_node_sub(eml_node_eml(eml_node_one(), e), e);
}

fn eml_node_neg(x) {
    if map_get(x, "tree") == "1" {
        return eml_node_minus_one();
    }
    return eml_node_sub(eml_node_eml(eml_node_zero(), eml_node_exp(x)), eml_node_one());
}

fn eml_node_add(x, y) {
    return eml_node_sub(x, eml_node_neg(y));
}

fn eml_node_mul(x, y) {
    return eml_node_exp(eml_node_add(eml_node_ln(x), eml_node_ln(y)));
}

fn eml_node_div(x, y) {
    return eml_node_exp(eml_node_sub(eml_node_ln(x), eml_node_ln(y)));
}

fn eml_node_nat(n) {
    if n == 0 {
        return eml_node_zero();
    }
    if n == 1 {
        return eml_node_one();
    }
    acc := eml_node_one();
    i := 1;
    while i < n {
        acc = eml_node_add(acc, eml_node_one());
        i = i + 1;
    }
    return acc;
}

fn eml_is_digit(ch) {
    code := text_to_code(ch, 0);
    return code >= 48 && code <= 57;
}

fn eml_is_alpha(ch) {
    code := text_to_code(ch, 0);
    return (code >= 65 && code <= 90) || (code >= 97 && code <= 122);
}

fn eml_tokenize(src) {
    tokens := list_new();
    size := text_length(src);
    i := 0;
    while i < size {
        ch := text_get(src, i);
        if ch == " " || ch == "\t" || ch == "\n" || ch == "\r" {
            i = i + 1;
        } else {
            if eml_is_digit(ch) {
                start := i;
                i = i + 1;
                while i < size && eml_is_digit(text_get(src, i)) {
                    i = i + 1;
                }
                tok := map_new();
                map_set(tok, "kind", "num");
                map_set(tok, "text", text_slice(src, start, i));
                list_push_back(tokens, tok);
            } else {
                if eml_is_alpha(ch) {
                    start := i;
                    i = i + 1;
                    while i < size && eml_is_alpha(text_get(src, i)) {
                        i = i + 1;
                    }
                    tok := map_new();
                    map_set(tok, "kind", "id");
                    map_set(tok, "text", text_slice(src, start, i));
                    list_push_back(tokens, tok);
                } else {
                    if ch == "+" || ch == "-" || ch == "*" || ch == "/" || ch == "(" || ch == ")" || ch == "," {
                        tok := map_new();
                        map_set(tok, "kind", "sym");
                        map_set(tok, "text", ch);
                        list_push_back(tokens, tok);
                        i = i + 1;
                    } else {
                        process_panic("unsupported character in expression: " + ch);
                    }
                }
            }
        }
    }
    return tokens;
}

fn eml_parse_int(s) {
    size := text_length(s);
    i := 0;
    val := 0;
    while i < size {
        d := text_to_code(text_get(s, i), 0) - 48;
        val = eml_imul(val, 10) + d;
        i = i + 1;
    }
    return val;
}

fn eml_prec(op) {
    if op == "+" || op == "-" {
        return 10;
    }
    if op == "*" || op == "/" {
        return 20;
    }
    return 0;
}

fn eml_parse_expr(tokens, start, min_prec) {
    count := list_length(tokens);
    if start >= count {
        process_panic("unexpected end of expression");
    }
    tok := list_get(tokens, start);
    kind := map_get(tok, "kind");
    txt := map_get(tok, "text");
    pos := start + 1;
    node := eml_node_one();

    if kind == "num" {
        node = eml_node_nat(eml_parse_int(txt));
    } else {
        if kind == "id" {
            if txt == "e" {
                node = eml_node_e();
            } else {
                if pos < count && map_get(list_get(tokens, pos), "text") == "(" {
                    pos = pos + 1;
                    first := eml_parse_expr(tokens, pos, 0);
                    first_node := map_get(first, "node");
                    pos = map_get(first, "next");
                    if txt == "exp" {
                        node = eml_node_exp(first_node);
                    } else {
                        if txt == "ln" {
                            node = eml_node_ln(first_node);
                        } else {
                            if txt == "eml" {
                                if pos >= count || map_get(list_get(tokens, pos), "text") != "," {
                                    process_panic("expected ',' in eml(x, y)");
                                }
                                second := eml_parse_expr(tokens, pos + 1, 0);
                                node = eml_node_eml(first_node, map_get(second, "node"));
                                pos = map_get(second, "next");
                            } else {
                                process_panic("unknown function: " + txt);
                            }
                        }
                    }
                    if pos >= count || map_get(list_get(tokens, pos), "text") != ")" {
                        process_panic("expected ')'");
                    }
                    pos = pos + 1;
                } else {
                    process_panic("unknown identifier: " + txt);
                }
            }
        } else {
            if txt == "-" {
                inner := eml_parse_expr(tokens, pos, 30);
                node = eml_node_neg(map_get(inner, "node"));
                pos = map_get(inner, "next");
            } else {
                if txt == "(" {
                    inner := eml_parse_expr(tokens, pos, 0);
                    node = map_get(inner, "node");
                    pos = map_get(inner, "next");
                    if pos >= count || map_get(list_get(tokens, pos), "text") != ")" {
                        process_panic("expected ')'");
                    }
                    pos = pos + 1;
                } else {
                    process_panic("unexpected token: " + txt);
                }
            }
        }
    }

    done := false;
    while pos < count && !done {
        op := map_get(list_get(tokens, pos), "text");
        p := eml_prec(op);
        if p == 0 || p < min_prec {
            done = true;
        } else {
            rhs := eml_parse_expr(tokens, pos + 1, p + 1);
            rhs_node := map_get(rhs, "node");
            if op == "+" {
                node = eml_node_add(node, rhs_node);
            } else {
                if op == "-" {
                    node = eml_node_sub(node, rhs_node);
                } else {
                    if op == "*" {
                        node = eml_node_mul(node, rhs_node);
                    } else {
                        node = eml_node_div(node, rhs_node);
                    }
                }
            }
            pos = map_get(rhs, "next");
        }
    }

    out := map_new();
    map_set(out, "node", node);
    map_set(out, "next", pos);
    return out;
}

/// Convert an arithmetic/math expression into a pure eml(..., 1) tree and stream.
fn eml_convert(expr) {
    tokens := eml_tokenize(expr);
    parsed := eml_parse_expr(tokens, 0, 0);
    if map_get(parsed, "next") != list_length(tokens) {
        process_panic("unexpected trailing token");
    }
    return map_get(parsed, "node");
}
