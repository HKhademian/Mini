/// Read text and report whether it contains the two sample words.

import "core/text";
import "core/io";
import "util/io";

source := io_read_all();
if text_find(source, "Mini") >= 0 {
    io_write_line("has Mini");
} else {
    io_write_line("no Mini");
}
if text_find(source, "Lang") >= 0 {
    io_write_line("has Lang");
} else {
    io_write_line("no Lang");
}
