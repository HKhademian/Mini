/// Read text and print slices that demonstrate bounds and negative indices.

include "common/io.mini";

source := io_read_all();
io_write_line(text_slice(source, 0, 3));
io_write_line(text_slice(source, 1, 4));
io_write_line(text_slice(source, -2, -1));
io_write_line(text_slice(source, 2, 100));
io_write_line(text_slice(source, 4, 2));
