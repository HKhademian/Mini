/// Shoot down a compact formation before it reaches the player.

import "core/io";
import "core/list";
import "core/number";
import "extra/board";
import "extra/canvas";
import "util/io";

screen_size := 10;
screen_edge := screen_size - 1;
player_y := screen_edge - 1;
player_x := number_div(screen_size, 2);
playback_fps := 60;
invader_fps := 2;
bullet_fps := 4;
frames_per_invader_step := number_div(playback_fps, invader_fps);
frames_per_bullet_step := number_div(playback_fps, bullet_fps);
invaders := list_of(2, 4, 6, 8);
invader_count := list_length(invaders);
formation_left := 2;
formation_right := 8;
formation_direction := 1;
invader_y := 2;
invader_ticks := 0;
bullet_ticks := 0;
bullet_x := 0;
bullet_y := 0;
bullet_active := false;
kills := 0;
game_over := false;
game_won := false;
space_color := pixel_rgb(3, 10, 24);
invader_color := pixel_rgb(100, 240, 144);
player_color := pixel_rgb(94, 206, 255);
bullet_color := pixel_rgb(255, 236, 110);
hud_color := pixel_rgb(94, 130, 168);

/// Move the formation horizontally and step down at the board edges.
fn space_invaders_move_formation() {
    next_left := formation_left + formation_direction;
    next_right := formation_right + formation_direction;
    if next_left < 1 || next_right > screen_edge - 1 {
        formation_direction = 0 - formation_direction;
        invader_y = invader_y + 1;
    } else {
        formation_left = next_left;
        formation_right = next_right;
        invader_index := 0;
        while invader_index < invader_count {
            position := list_get(invaders, invader_index);
            if position >= 0 {
                list_set(invaders, invader_index, position + formation_direction);
            }
            invader_index = invader_index + 1;
        }
    }
    if invader_y >= player_y - 1 {
        game_over = true;
    }
}

/// Draw the surviving invaders, player, bullet, and remaining formation lights.
fn space_invaders_render() {
    board := pixel_board_new(screen_size, screen_size, space_color);
    hud_index := 0;
    while hud_index < invader_count - kills {
        pixel_board_set(board, screen_size, screen_size, hud_index, 0, hud_color);
        hud_index = hud_index + 1;
    }
    invader_index := 0;
    while invader_index < invader_count {
        position := list_get(invaders, invader_index);
        if position >= 0 {
            pixel_board_set(board, screen_size, screen_size, position, invader_y, invader_color);
        }
        invader_index = invader_index + 1;
    }
    if bullet_active {
        pixel_board_set(board, screen_size, screen_size, bullet_x, bullet_y, bullet_color);
    }
    pixel_board_set(board, screen_size, screen_size, player_x, player_y, player_color);
    pixel_board_draw(screen_size, screen_size, board);
}

/// Advance one bullet step, removing the first alien it reaches.
fn space_invaders_advance_bullet() {
    bullet_y = bullet_y - 1;
    if bullet_y < 1 {
        bullet_active = false;
        return 0;
    }
    invader_index := 0;
    while invader_index < invader_count {
        if list_get(invaders, invader_index) == bullet_x && invader_y == bullet_y {
            list_set(invaders, invader_index, 0 - 1);
            kills = kills + 1;
            bullet_active = false;
            if kills >= invader_count {
                game_won = true;
            }
            return 0;
        }
        invader_index = invader_index + 1;
    }
}

/// Advance invaders and the bullet at their configured speeds. Elapsed time is provided in seconds.
fn canvas_on_update(dt) {
    if !game_over && !game_won {
        invader_ticks = invader_ticks + 1;
        if invader_ticks >= frames_per_invader_step {
            invader_ticks = 0;
            space_invaders_move_formation();
        }
        if bullet_active {
            bullet_ticks = bullet_ticks + 1;
            if bullet_ticks >= frames_per_bullet_step {
                bullet_ticks = 0;
                space_invaders_advance_bullet();
            }
        }
    }
    space_invaders_render();
    if game_over || game_won {
        return 1;
    }
}

/// Move with left/right or A/D and fire with Space.
fn canvas_on_key_down(key) {
    if game_over || game_won {
        return 0;
    }
    if (key == "ArrowLeft" || key == "a") && player_x > 0 {
        player_x = player_x - 1;
    } else if (key == "ArrowRight" || key == "d") && player_x < screen_edge {
        player_x = player_x + 1;
    } else if key == " " && !bullet_active {
        bullet_x = player_x;
        bullet_y = player_y - 1;
        bullet_active = true;
        bullet_ticks = 0;
    }
}

/// Print the opening formation for command-line runs.
fn space_invaders_print() {
    row := 0;
    while row < screen_size {
        column := 0;
        line := "";
        while column < screen_size {
            if row == player_y && column == player_x {
                line = line + "A";
            } else if row == invader_y && (column == 2 || column == 4 || column == 6 || column == 8) {
                line = line + "V";
            } else {
                line = line + ".";
            }
            column = column + 1;
        }
        io_write_line(line);
        row = row + 1;
    }
}

space_invaders_render();
canvas_play("Space Invaders · Arrows and Space");
space_invaders_print();
