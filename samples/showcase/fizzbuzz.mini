/// Classic division and branching.

include "common/io.mini";

n := 1;
while n <= 15 {
    if number_mod(n, 15) == 0 {
        io_write_line("FizzBuzz");
    } else {
        if number_mod(n, 3) == 0 {
            io_write_line("Fizz");
        } else {
            if number_mod(n, 5) == 0 {
                io_write_line("Buzz");
            } else {
                io_write_line(number_to_text(n));
            }
        }
    }
    n = n + 1;
}
