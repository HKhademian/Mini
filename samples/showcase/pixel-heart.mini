/// Render a small red heart from a ten-by-ten text pattern.

import "core/io";
import "core/list";
import "extra/board";
import "extra/canvas";
import "util/io";

screen_size := 10;
black := pixel_rgb(0, 0, 0);
red := pixel_rgb(255, 48, 72);
heart_rows := list_of(
    "..........",
    "..##..##..",
    ".########.",
    "##########",
    "##########",
    ".########.",
    "..######..",
    "...####...",
    "....##....",
    ".........."
);

board := pixel_board_new(screen_size, screen_size, black);

row := 0;
while row < screen_size {
    column := 0;
    while column < screen_size {
        if text_get(list_get(heart_rows, row), column) == "#" {
            pixel_board_set(board, screen_size, screen_size, column, row, red);
        }
        column = column + 1;
    }
    row = row + 1;
}
canvas_draw(screen_size, screen_size, board);

/// Print the heart pattern for command-line runs.
fn pixel_heart_print() {
    row := 0;
    while row < screen_size {
        io_write_line(list_get(heart_rows, row));
        row = row + 1;
    }
}
pixel_heart_print();
