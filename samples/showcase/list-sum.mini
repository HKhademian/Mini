/// Accumulate numbers in a loop.

include "common/io.mini";

values := list_new();
list_set(values, 0, 4);
list_set(values, 1, 8);
list_set(values, 2, 15);
sum := 0;
index := 0;
while index < list_length(values) {
    sum = sum + list_get(values, index);
    index = index + 1;
}
io_write_line(number_to_text(sum));
