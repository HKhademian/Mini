/// Shift character codes by one.

import "core/text";
import "core/io";
import "util/io";

source := "MINI";
output := "";
index := 0;
while index < text_length(source) {
    code := text_to_code(text_get(source, index), 0);
    output = output + text_from_code(code + 1);
    index = index + 1;
}
io_write_line(output);
