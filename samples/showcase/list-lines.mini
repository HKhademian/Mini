/// Split text into lines and join them again.

import "common/text";
import "common/list";
import "common/io";

source := "red\ngreen\nblue";
lines := text_split(source, "\n");
output := "";
index := 0;
while index < list_length(lines) {
    if index > 0 {
        output = output + "|";
    }
    output = output + list_get(lines, index);
    index = index + 1;
}
io_write_line(output);
