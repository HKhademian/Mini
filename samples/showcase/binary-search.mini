/// Find a value in a sorted list.
var values = list_new();
list_set(values, 0, 2);
list_set(values, 1, 4);
list_set(values, 2, 8);
list_set(values, 3, 16);
list_set(values, 4, 32);
list_set(values, 5, 64);
var target = 16;
var low = 0;
var high = list_length(values) - 1;
var found = -1;
while (low <= high) {
    var middle = number_div(low + high, 2);
    var current = list_get(values, middle);
    if (current == target) {
        found = middle;
        low = high + 1;
    } else {
        if (current < target) {
            low = middle + 1;
        } else {
            high = middle - 1;
        }
    }
}
io_write(number_to_text(found) + "\n");
