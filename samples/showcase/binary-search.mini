/// Find a value in a sorted list.

import "common/number";
import "common/list";
import "common/io";

values := list_new();
list_set(values, 0, 2);
list_set(values, 1, 4);
list_set(values, 2, 8);
list_set(values, 3, 16);
list_set(values, 4, 32);
list_set(values, 5, 64);
target := 16;
low := 0;
high := list_length(values) - 1;
found := -1;
while low <= high {
    middle := number_div(low + high, 2);
    current := list_get(values, middle);
    if current == target {
        found = middle;
        low = high + 1;
    } else {
        if current < target {
            low = middle + 1;
        } else {
            high = middle - 1;
        }
    }
}
io_write_line(found);
