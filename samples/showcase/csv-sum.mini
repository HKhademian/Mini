include "common/io.mini";
/// Parse numbers from CSV text and add them.
csv := "4,8,15,16,23,42";
fields := text_split(csv, ",");
total := 0;
index := 0;
while index < list_length(fields) {
    total = total + number_from_text(list_get(fields, index));
    index = index + 1;
}
io_write_line(number_to_text(total));
