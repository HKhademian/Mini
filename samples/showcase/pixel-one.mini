/// Show one white pixel on a ten-by-ten black canvas.

import "core/io";
import "core/number";
import "util/board";
import "util/canvas";
import "util/io";

screen_size := 10;
screen_center := number_div(screen_size, 2);
black := pixel_rgb(0, 0, 0);
white := pixel_rgb(255, 255, 255);

board := pixel_board_new(screen_size, screen_size, black);
pixel_board_set(board, screen_size, screen_size, screen_center, screen_center, white);
canvas_draw(screen_size, screen_size, board);

/// Print the initial frame as a text fallback for the command line.
fn pixel_one_print() {
    row := 0;
    while row < screen_size {
        column := 0;
        line := "";
        while column < screen_size {
            if column == screen_center && row == screen_center {
                line = line + "*";
            } else {
                line = line + ".";
            }
            column = column + 1;
        }
        io_write_line(line);
        row = row + 1;
    }
}

pixel_one_print();
