/// Show one white pixel on a ten-by-ten black canvas.

import "common/io";
import "common/pixel-board";
import "common/play";

black := pixel_rgb(0, 0, 0);
white := pixel_rgb(255, 255, 255);

/// Draw one frame containing only the center pixel, then stop.
fn mini_play_update() {
    board := pixel_board_new(10, 10, black);
    pixel_board_set(board, 10, 10, 5, 5, white);
    pixel_board_render(10, 10, board);
    return 1;
}

/// Print the initial frame as a text fallback for the command line.
fn pixel_one_print() {
    row := 0;
    while row < 10 {
        column := 0;
        line := "";
        while column < 10 {
            if column == 5 && row == 5 {
                line = line + "*";
            } else {
                line = line + ".";
            }
            column = column + 1;
        }
        io_write_line(line);
        row = row + 1;
    }
}

mini_play(10, 10, "One Pixel");
pixel_one_print();
