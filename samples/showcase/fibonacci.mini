include "common/io.mini";
/// An iterative sequence.
fn fib(n) {
    a := 0;
    b := 1;
    i := 0;
    while i < n {
        next := a + b;
        a = b;
        b = next;
        i = i + 1;
    }
    return a;
}
index := 0;
while index < 10 {
    io_write(number_to_text(fib(index)) + " ");
    index = index + 1;
}
io_write_line("");
