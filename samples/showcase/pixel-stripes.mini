/// Render alternating vertical color stripes on a ten-by-ten canvas.

import "core/io";
import "core/number";
import "util/board";
import "util/canvas";
import "util/io";

screen_size := 10;
warm_color := pixel_rgb(255, 112, 92);
cool_color := pixel_rgb(82, 174, 230);
board := pixel_board_new(screen_size, screen_size, warm_color);

row := 0;
while row < screen_size {
    column := 0;
    while column < screen_size {
        if number_mod(column, 2) == 1 {
            pixel_board_set(board, screen_size, screen_size, column, row, cool_color);
        }
        column = column + 1;
    }
    row = row + 1;
}

canvas_draw(screen_size, screen_size, board);

/// Print the stripes as a text fallback for command-line runs.
fn pixel_stripes_print() {
    row := 0;
    while row < screen_size {
        column := 0;
        line := "";
        while column < screen_size {
            if number_mod(column, 2) == 0 {
                line = line + "#";
            } else {
                line = line + ".";
            }
            column = column + 1;
        }
        io_write_line(line);
        row = row + 1;
    }
}

pixel_stripes_print();
