/// Scan a list and keep the best value.

import "core/list";
import "core/io";

values := list_new();
list_set(values, 0, 4);
list_set(values, 1, 9);
list_set(values, 2, 2);
best := list_get(values, 0);
index := 1;
while index < list_length(values) {
    current := list_get(values, index);
    if current > best {
        best = current;
    }
    index = index + 1;
}
io_write_line(best);
