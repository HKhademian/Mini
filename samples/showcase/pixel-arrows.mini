/// Move a pixel around a ten-by-ten canvas with arrows or WASD.

import "core/io";
import "util/board";
import "core/play";

screen_size := 10;
screen_edge := screen_size - 1;
black := pixel_rgb(0, 0, 0);
player_color := pixel_rgb(255, 220, 40);
goal_color := pixel_rgb(70, 240, 130);
player_x := 1;
player_y := screen_edge - 1;
goal_x := screen_edge - 1;
goal_y := 1;

/// Render the player and a fixed goal; falling through keeps the session open.
fn mini_play_update() {
    board := pixel_board_new(screen_size, screen_size, black);
    pixel_board_set(board, screen_size, screen_size, goal_x, goal_y, goal_color);
    pixel_board_set(board, screen_size, screen_size, player_x, player_y, player_color);
    pixel_board_render(screen_size, screen_size, board);
}

/// Move one cell for an arrow or WASD key while staying inside the board.
fn mini_play_onKeyDown(key) {
    if (key == "ArrowLeft" || key == "a") && player_x > 0 {
        player_x = player_x - 1;
    }
    if (key == "ArrowRight" || key == "d") && player_x < screen_edge {
        player_x = player_x + 1;
    }
    if (key == "ArrowUp" || key == "w") && player_y > 0 {
        player_y = player_y - 1;
    }
    if (key == "ArrowDown" || key == "s") && player_y < screen_edge {
        player_y = player_y + 1;
    }
}

/// Print the initial player and goal positions for command-line runs.
fn pixel_arrows_print() {
    row := 0;
    while row < screen_size {
        column := 0;
        line := "";
        while column < screen_size {
            if column == player_x && row == player_y {
                line = line + "@";
            } else if column == goal_x && row == goal_y {
                line = line + "G";
            } else {
                line = line + ".";
            }
            column = column + 1;
        }
        io_write_line(line);
        row = row + 1;
    }
}

mini_play(screen_size, screen_size, "Arrow Keys");
pixel_arrows_print();
