/// Walk a list backwards and join the items.

include "common/io.mini";

values := list_new();
list_set(values, 0, "one");
list_set(values, 1, "two");
list_set(values, 2, "three");
output := "";
index := list_length(values) - 1;
while index >= 0 {
    output = output + list_get(values, index);
    if index > 0 {
        output = output + " ";
    }
    index = index - 1;
}
io_write_line(output);
