/// Print one compact Breakout board as a ten-by-ten text grid.

import "common/io";

/// Return the tile at one board position.
fn breakout_tile(column, row) {
    if column == 0 || column == 9 || row == 0 || row == 9 {
        return "#";
    }
    if row < 3 {
        return "#";
    }
    if column == 4 && row == 6 {
        return "o";
    }
    if row == 8 && column >= 4 && column <= 6 {
        return "=";
    }
    return ".";
}

/// Build and print each row of the board.
fn breakout_render() {
    row := 0;
    while row < 10 {
        line := "";
        column := 0;
        while column < 10 {
            line = line + breakout_tile(column, row);
            column = column + 1;
        }
        io_write_line(line);
        row = row + 1;
    }
}

breakout_render();
