/// Animate Breakout on a ten-by-ten pixel board and print its initial text frame.

import "common/io";
import "common/pixel-board";
import "common/play";

ball_x := 4;
ball_y := 6;
ball_dx := 1;
ball_dy := -1;
paddle_x := 4;
update_ticks := 0;
wall_color := pixel_rgb(51, 51, 51);
brick_color := pixel_rgb(255, 99, 89);
paddle_color := pixel_rgb(0, 255, 255);
ball_color := pixel_rgb(255, 255, 255);

/// Return the tile at one board position.
fn breakout_tile(column, row) {
    if column == 0 || column == 9 || row == 0 || row == 9 {
        return "#";
    }
    if row < 3 {
        return "#";
    }
    if column == ball_x && row == ball_y {
        return "o";
    }
    if row == 8 && column >= paddle_x && column <= paddle_x + 2 {
        return "=";
    }
    return ".";
}

/// Build a row-major pixel board from the current Breakout state.
fn breakout_render_pixels() {
    board := pixel_board_new(10, 10, 0);

    position := 0;
    while position < 10 {
        pixel_board_set(board, 10, 10, position, 0, wall_color);
        pixel_board_set(board, 10, 10, position, 9, wall_color);
        pixel_board_set(board, 10, 10, 0, position, wall_color);
        pixel_board_set(board, 10, 10, 9, position, wall_color);
        position = position + 1;
    }

    row := 1;
    while row < 3 {
        column := 1;
        while column < 9 {
            pixel_board_set(board, 10, 10, column, row, brick_color);
            column = column + 1;
        }
        row = row + 1;
    }
    pixel_board_set(board, 10, 10, ball_x, ball_y, ball_color);
    pixel_board_set(board, 10, 10, paddle_x, 8, paddle_color);
    pixel_board_set(board, 10, 10, paddle_x + 1, 8, paddle_color);
    pixel_board_set(board, 10, 10, paddle_x + 2, 8, paddle_color);
    pixel_board_render(10, 10, board);
}

/// Advance the ball and emit one ten-by-ten frame; return zero to continue.
fn mini_play_update() {
    update_ticks = update_ticks + 1;
    if update_ticks >= 8 {
        update_ticks = 0;
        ball_x = ball_x + ball_dx;
        ball_y = ball_y + ball_dy;
        if ball_x <= 1 || ball_x >= 8 {
            ball_dx = 0 - ball_dx;
        }
        if ball_y <= 1 {
            ball_dy = 1;
        }
        if ball_y >= 7 {
            if ball_x >= paddle_x && ball_x <= paddle_x + 2 {
                ball_y = 6;
                ball_dy = 0 - 1;
            } else {
                return 1;
            }
        }
    }

    breakout_render_pixels();
}

/// Move the paddle one cell for a left or right key press.
fn mini_play_onKeyDown(key) {
    if (key == "ArrowLeft" || key == "a") && paddle_x > 1 {
        paddle_x = paddle_x - 1;
    }
    if (key == "ArrowRight" || key == "d") && paddle_x < 6 {
        paddle_x = paddle_x + 1;
    }
}

/// Build and print each row of the board.
fn breakout_render() {
    row := 0;
    while row < 10 {
        line := "";
        column := 0;
        while column < 10 {
            line = line + breakout_tile(column, row);
            column = column + 1;
        }
        io_write_line(line);
        row = row + 1;
    }
}

mini_play(10, 10, "Breakout");
breakout_render();
