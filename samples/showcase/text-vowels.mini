/// Combine a loop with character comparisons.

include "common/io.mini";

text := "self hosting";
index := 0;
count := 0;
while index < text_length(text) {
    ch := text_get(text, index);
    if ch == "a" || ch == "e" || ch == "i" || ch == "o" || ch == "u" {
        count = count + 1;
    }
    index = index + 1;
}
io_write_line(number_to_text(count));
