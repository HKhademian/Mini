/// Cross three lanes of traffic that move at independently configured speeds.

import "core/io";
import "core/list";
import "core/number";
import "util/board";
import "util/canvas";
import "util/io";

screen_size := 10;
screen_edge := screen_size - 1;
playback_fps := 60;
lane_one_fps := 2;
lane_two_fps := 3;
lane_three_fps := 4;
lane_rows := list_of(2, 4, 6);
lane_frames := list_of(
    number_div(playback_fps, lane_one_fps),
    number_div(playback_fps, lane_two_fps),
    number_div(playback_fps, lane_three_fps)
);
car_columns := list_of(1, 5, 8);
car_directions := list_of(1, 0 - 1, 1);
lane_ticks := list_of(0, 0, 0);
player_x := number_div(screen_size, 2);
player_y := screen_edge;
player_start_x := player_x;
game_won := false;
grass_color := pixel_rgb(20, 66, 48);
road_color := pixel_rgb(30, 36, 48);
line_color := pixel_rgb(108, 116, 126);
player_color := pixel_rgb(255, 224, 82);
car_one_color := pixel_rgb(255, 112, 92);
car_two_color := pixel_rgb(96, 190, 255);
car_three_color := pixel_rgb(255, 192, 78);
goal_color := pixel_rgb(94, 232, 142);

/// Return the color for one traffic lane.
fn freeway_car_color(lane) {
    if lane == 0 {
        return car_one_color;
    }
    if lane == 1 {
        return car_two_color;
    }
    return car_three_color;
}

/// Report whether a moving vehicle occupies the player's cell.
fn freeway_car_at(column, row) {
    lane := 0;
    while lane < list_length(lane_rows) {
        if row == list_get(lane_rows, lane) {
            front := list_get(car_columns, lane);
            back := number_mod(front + 1, screen_size);
            if column == front || column == back {
                return true;
            }
        }
        lane = lane + 1;
    }
    return false;
}

/// Draw grass, lane markings, moving cars, and the player.
fn freeway_render() {
    board := pixel_board_new(screen_size, screen_size, grass_color);
    lane := 0;
    while lane < list_length(lane_rows) {
        row := list_get(lane_rows, lane);
        column := 0;
        while column < screen_size {
            pixel_board_set(board, screen_size, screen_size, column, row, road_color);
            column = column + 1;
        }
        front := list_get(car_columns, lane);
        back := number_mod(front + 1, screen_size);
        color := freeway_car_color(lane);
        pixel_board_set(board, screen_size, screen_size, front, row, color);
        pixel_board_set(board, screen_size, screen_size, back, row, color);
        lane = lane + 1;
    }
    column := 0;
    while column < screen_size {
        pixel_board_set(board, screen_size, screen_size, column, 0, line_color);
        column = column + 1;
    }
    pixel_board_set(board, screen_size, screen_size, player_start_x, 0, goal_color);
    pixel_board_set(board, screen_size, screen_size, player_x, player_y, player_color);
    pixel_board_draw(screen_size, screen_size, board);
}

/// Advance each lane at its own speed and send the player back after a hit. Elapsed time is provided in seconds.
fn canvas_on_update(dt) {
    if !game_won {
        lane := 0;
        while lane < list_length(lane_rows) {
            ticks := list_get(lane_ticks, lane) + 1;
            if ticks >= list_get(lane_frames, lane) {
                ticks = 0;
                next_column := list_get(car_columns, lane) + list_get(car_directions, lane);
                list_set(car_columns, lane, number_mod(next_column + screen_size, screen_size));
            }
            list_set(lane_ticks, lane, ticks);
            lane = lane + 1;
        }

        if freeway_car_at(player_x, player_y) {
            player_x = player_start_x;
            player_y = screen_edge;
        }
    }

    freeway_render();
    if game_won {
        return 1;
    }
}

/// Step the player up or sideways with arrows or WASD.
fn canvas_on_key_down(key) {
    if game_won {
        return 0;
    }
    if (key == "ArrowUp" || key == "w") && player_y > 0 {
        player_y = player_y - 1;
    } else if (key == "ArrowDown" || key == "s") && player_y < screen_edge {
        player_y = player_y + 1;
    } else if (key == "ArrowLeft" || key == "a") && player_x > 0 {
        player_x = player_x - 1;
    } else if (key == "ArrowRight" || key == "d") && player_x < screen_edge {
        player_x = player_x + 1;
    }
    if player_y == 0 {
        game_won = true;
    } else if freeway_car_at(player_x, player_y) {
        player_x = player_start_x;
        player_y = screen_edge;
    }
}

/// Print the opening traffic frame for command-line runs.
fn freeway_print() {
    row := 0;
    while row < screen_size {
        column := 0;
        line := "";
        while column < screen_size {
            if column == player_x && row == player_y {
                line = line + "@";
            } else if freeway_car_at(column, row) {
                line = line + "=";
            } else if row == 0 {
                if column == player_start_x {
                    line = line + "G";
                } else {
                    line = line + "-";
                }
            } else {
                line = line + ".";
            }
            column = column + 1;
        }
        io_write_line(line);
        row = row + 1;
    }
}

freeway_render();
canvas_play(screen_size, screen_size, "Freeway · Arrows or WASD");
freeway_print();
