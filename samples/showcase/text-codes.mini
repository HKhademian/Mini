/// Convert between characters and code points, then print mixed values directly.

import "core/display";
import "core/value";
import "core/text";
import "core/number";
import "core/io";

text := "A!";
character := text_get(text, 0);
code := text_to_code(character, 0);
io_write_line(character, " -> ", code, " -> ", text_from_code(code));
io_write_line("number text: ", number_to_text(code), " | display text: ", value_to_text(code));
