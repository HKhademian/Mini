import "core/text";
import "core/io";

/// Reverse text and compare.
fn reverse(text) {
    output := "";
    index := text_length(text) - 1;
    while index >= 0 {
        output = output + text_get(text, index);
        index = index - 1;
    }
    return output;
}
word := "level";
if word == reverse(word) {
    io_write_line("palindrome");
} else {
    io_write_line("different");
}
