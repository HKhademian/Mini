/// Animate Frogger on a ten-by-ten pixel board and print its initial text frame.

import "common/io";
import "util/board";
import "common/play";

screen_size := 10;
screen_edge := screen_size - 1;
frog_x := 4;
frog_y := screen_edge;
car_a_x := 1;
car_b_x := 7;
car_c_x := 3;
car_d_x := 4;
update_ticks := 0;
grass_color := pixel_rgb(0, 128, 0);
water_color := pixel_rgb(0, 80, 200);
log_color := pixel_rgb(153, 90, 40);
road_color := pixel_rgb(51, 51, 51);
car_color := pixel_rgb(255, 0, 0);
goal_color := pixel_rgb(255, 255, 0);
frog_color := pixel_rgb(0, 255, 0);

/// Return the tile at one board position.
fn frogger_tile(column, row) {
    if column == frog_x && row == frog_y {
        return "F";
    }
    if row == 0 && column >= 4 && column <= 5 {
        return "H";
    }
    if row == 1 {
        if column >= 2 && column <= 5 {
            return "=";
        }
        return "~";
    }
    if row == 2 {
        if column >= 5 && column <= 8 {
            return "=";
        }
        return "~";
    }
    if row == 4 {
        if column == car_a_x || column == car_a_x + 1 {
            return ">";
        }
        if column == car_b_x {
            return ">";
        }
    }
    if row == 5 {
        if column >= 3 && column <= 5 {
            return "<";
        }
    }
    if row == 7 {
        if column == car_d_x || column == car_d_x + 1 {
            return ">";
        }
    }
    if row == 8 && column >= car_d_x && column <= car_d_x + 2 {
        return "<";
    }
    if row == 3 || row == 6 || row == screen_edge {
        return ".";
    }
    if row >= 4 {
        return ".";
    }
    return " ";
}

/// Fill one full board row with a color.
fn frogger_fill_row(board, row, color) {
    column := 0;
    while column < screen_size {
        pixel_board_set(board, screen_size, screen_size, column, row, color);
        column = column + 1;
    }
}

/// Build a row-major pixel board from the current Frogger state.
fn frogger_render_pixels() {
    board := pixel_board_new(screen_size, screen_size, grass_color);

    pixel_board_set(board, screen_size, screen_size, 4, 0, goal_color);
    pixel_board_set(board, screen_size, screen_size, 5, 0, goal_color);
    frogger_fill_row(board, 1, water_color);
    frogger_fill_row(board, 2, water_color);
    column := 2;
    while column < 6 {
        pixel_board_set(board, screen_size, screen_size, column, 1, log_color);
        column = column + 1;
    }
    column = 5;
    while column < screen_edge {
        pixel_board_set(board, screen_size, screen_size, column, 2, log_color);
        column = column + 1;
    }

    frogger_fill_row(board, 4, road_color);
    frogger_fill_row(board, 5, road_color);
    frogger_fill_row(board, 7, road_color);
    frogger_fill_row(board, 8, road_color);
    pixel_board_set(board, screen_size, screen_size, car_a_x, 4, car_color);
    pixel_board_set(board, screen_size, screen_size, car_a_x + 1, 4, car_color);
    pixel_board_set(board, screen_size, screen_size, car_b_x, 4, car_color);
    column = car_c_x;
    while column <= car_c_x + 2 {
        pixel_board_set(board, screen_size, screen_size, column, 5, car_color);
        column = column + 1;
    }
    pixel_board_set(board, screen_size, screen_size, car_d_x, 7, car_color);
    pixel_board_set(board, screen_size, screen_size, car_d_x + 1, 7, car_color);
    column = car_d_x;
    while column <= car_d_x + 2 {
        pixel_board_set(board, screen_size, screen_size, column, 8, car_color);
        column = column + 1;
    }
    pixel_board_set(board, screen_size, screen_size, frog_x, frog_y, frog_color);
    pixel_board_render(screen_size, screen_size, board);
}

/// Move traffic and emit one ten-by-ten frame; return zero to continue.
fn mini_play_update() {
    update_ticks = update_ticks + 1;
    if update_ticks >= 8 {
        update_ticks = 0;
        car_a_x = car_a_x + 1;
        if car_a_x > 7 {
            car_a_x = 1;
        }
        car_b_x = car_b_x - 1;
        if car_b_x < 1 {
            car_b_x = 8;
        }
        car_c_x = car_c_x + 1;
        if car_c_x > 6 {
            car_c_x = 1;
        }
        car_d_x = car_d_x - 1;
        if car_d_x < 1 {
            car_d_x = 8;
        }
    }

    frogger_render_pixels();
    if frog_y == 0 {
        return 1;
    }
}

/// Move Frogger one cell in response to a directional key press.
fn mini_play_onKeyDown(key) {
    if (key == "ArrowLeft" || key == "a") && frog_x > 0 {
        frog_x = frog_x - 1;
    }
    if (key == "ArrowRight" || key == "d") && frog_x < screen_edge {
        frog_x = frog_x + 1;
    }
    if (key == "ArrowUp" || key == "w") && frog_y > 0 {
        frog_y = frog_y - 1;
    }
    if (key == "ArrowDown" || key == "s") && frog_y < screen_edge {
        frog_y = frog_y + 1;
    }
}

/// Build and print each row of the board.
fn frogger_render() {
    row := 0;
    while row < screen_size {
        line := "";
        column := 0;
        while column < screen_size {
            line = line + frogger_tile(column, row);
            column = column + 1;
        }
        io_write_line(line);
        row = row + 1;
    }
}

mini_play(screen_size, screen_size, "Frogger");
frogger_render();
