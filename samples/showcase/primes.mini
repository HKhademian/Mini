import "core/number";
import "core/io";
import "util/io";

/// Trial division up to a limit.
fn is_prime(n) {
    if n < 2 {
        return false;
    }
    divisor := 2;
    while divisor < n {
        if number_mod(n, divisor) == 0 {
            return false;
        }
        divisor = divisor + 1;
    }
    return true;
}
value := 2;
while value <= 30 {
    if is_prime(value) {
        io_write(value, " ");
    }
    value = value + 1;
}
io_write_line("");
