/// Trial division up to a limit.
fn is_prime(n) {
    if n < 2 {
        return false;
    }
    var divisor = 2;
    while divisor < n {
        if number_mod(n, divisor) == 0 {
            return false;
        }
        divisor = divisor + 1;
    }
    return true;
}
var value = 2;
while value <= 30 {
    if is_prime(value) {
        io_write(number_to_text(value) + " ");
    }
    value = value + 1;
}
io_write("\n");
