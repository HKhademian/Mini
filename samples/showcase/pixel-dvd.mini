/// Move one bright pixel around an 11-by-13 blue screen like a tiny DVD screensaver.

import "core/io";
import "core/number";
import "util/board";
import "util/canvas";
import "util/io";

screen_width := 11;
screen_height := 13;
screen_width_edge := screen_width - 1;
screen_height_edge := screen_height - 1;
playback_fps := 60;
animation_fps := 3;
frames_per_step := number_div(playback_fps, animation_fps);
blue := pixel_rgb(8, 32, 112);
white := pixel_rgb(255, 245, 220);
pixel_x := 3;
pixel_y := 7;
pixel_dx := 1;
pixel_dy := 1;
update_ticks := 0;

/// Advance one tile with wraparound at the configured animation speed, then draw it.
fn canvas_update() {
    board := pixel_board_new(screen_width, screen_height, blue);
    pixel_board_set(board, screen_width, screen_height, pixel_x, pixel_y, white);
    pixel_board_render(screen_width, screen_height, board);

    update_ticks = update_ticks + 1;
    if update_ticks >= frames_per_step {
        update_ticks = 0;
        pixel_x = pixel_x + pixel_dx;
        pixel_y = pixel_y + pixel_dy;
        if pixel_x < 0 {
            pixel_x = screen_width_edge;
        } else if pixel_x > screen_width_edge {
            pixel_x = 0;
        }
        if pixel_y < 0 {
            pixel_y = screen_height_edge;
        } else if pixel_y > screen_height_edge {
            pixel_y = 0;
        }
    }
}

/// Print the first frame for command-line runs.
fn pixel_dvd_print() {
    row := 0;
    while row < screen_height {
        col := 0;
        line := "";
        while col < screen_width {
            if row == pixel_y && col == pixel_x {
                line = line + "*";
            } else {
                line = line + ".";
            }
            col = col + 1;
        }
        io_write_line(line);
        row = row + 1;
    }
}

canvas_play(screen_width, screen_height, "DVD Pixel");
pixel_dvd_print();
