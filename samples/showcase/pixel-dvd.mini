/// Bounce one bright pixel over a blue screen like a tiny DVD screensaver.

import "common/io";
import "util/board";
import "common/play";

screen_size := 10;
screen_edge := screen_size - 1;
blue := pixel_rgb(8, 32, 112);
white := pixel_rgb(255, 245, 220);
pixel_x := 1;
pixel_y := 1;
pixel_dx := 1;
pixel_dy := 1;

/// Draw the pixel, then bounce its next position off each screen edge.
fn mini_play_update() {
    board := pixel_board_new(screen_size, screen_size, blue);
    pixel_board_set(board, screen_size, screen_size, pixel_x, pixel_y, white);
    pixel_board_render(screen_size, screen_size, board);

    if pixel_x + pixel_dx < 0 || pixel_x + pixel_dx > screen_edge {
        pixel_dx = 0 - pixel_dx;
    }
    if pixel_y + pixel_dy < 0 || pixel_y + pixel_dy > screen_edge {
        pixel_dy = 0 - pixel_dy;
    }
    pixel_x = pixel_x + pixel_dx;
    pixel_y = pixel_y + pixel_dy;
}

/// Print the first frame for command-line runs.
fn pixel_dvd_print() {
    row := 0;
    while row < screen_size {
        if row == 1 {
            io_write_line(".*........");
        } else {
            io_write_line("..........");
        }
        row = row + 1;
    }
}

mini_play(screen_size, screen_size, "DVD Pixel");
pixel_dvd_print();
