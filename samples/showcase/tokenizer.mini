/// Split source text into words and symbols.
var source = "var x=1;";
var index = 0;
var token = "";
while index < text_length(source) {
    var ch = text_get(source, index);
    if ch == " " || ch == "=" || ch == ";" {
        if token != "" {
            io_write(token + "\n");
            token = "";
        }
        if ch != " " {
            io_write(ch + "\n");
        }
    } else {
        token = token + ch;
    }
    index = index + 1;
}
if token != "" {
    io_write(token + "\n");
}
