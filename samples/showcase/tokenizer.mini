include "../../libs/common/io.mini";
/// Split source text into words and symbols.
source := "x:=1;";
index := 0;
token := "";
while index < text_length(source) {
    ch := text_get(source, index);
    if ch == " " || ch == "=" || ch == ";" {
        if token != "" {
            io_write_line(token);
            token = "";
        }
        if ch != " " {
            io_write_line(ch);
        }
    } else {
        token = token + ch;
    }
    index = index + 1;
}
if token != "" {
    io_write_line(token);
}
