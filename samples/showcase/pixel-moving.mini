/// Move one pixel across a ten-by-ten canvas and bounce at its edges.

import "core/io";
import "core/number";
import "util/board";
import "util/canvas";
import "util/io";

screen_size := 10;
playback_fps := 60;
animation_fps := 5;
frames_per_step := number_div(playback_fps, animation_fps);
black := pixel_rgb(0, 0, 0);
cyan := pixel_rgb(60, 230, 255);
pixel_x := 1;
pixel_y := number_div(screen_size, 2);
pixel_direction := 1;
update_ticks := 0;

/// Advance one tile at the configured animation speed, then render it.
fn canvas_update() {
    board := pixel_board_new(screen_size, screen_size, black);
    pixel_board_set(board, screen_size, screen_size, pixel_x, pixel_y, cyan);
    pixel_board_render(screen_size, screen_size, board);

    update_ticks = update_ticks + 1;
    if update_ticks >= frames_per_step {
        update_ticks = 0;
        if pixel_x + pixel_direction < 0 || pixel_x + pixel_direction >= screen_size {
            pixel_direction = 0 - pixel_direction;
        }
        pixel_x = pixel_x + pixel_direction;
    }
}

/// Print the first frame for command-line runs.
fn pixel_moving_print() {
    row := 0;
    while row < screen_size {
        if row == pixel_y {
            io_write_line(".*........");
        } else {
            io_write_line("..........");
        }
        row = row + 1;
    }
}

canvas_play(screen_size, screen_size, "Moving Pixel");
pixel_moving_print();
