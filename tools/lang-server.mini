#!/usr/bin/env node

import "common/list";
import "common/io";
import "tools/lang-server";
import "common/process";

/// Parse arguments and serve the language protocol.
fn main(args) {
    if list_length(args) == 1 && list_get(args, 0) == "--version" {
        io_write_line(lsp_version());
        return 0;
    }
    if list_length(args) != 0 {
        lsp_log("usage: mini-lang-server [--version]");
        process_exit(1);
    }
    process_exit(lsp_serve());
    return 0;
}

main(fn_args());
