#!/usr/bin/env node

import "common/list";
import "tools/format";

/// Report a command error and stop.
fn format_fail(message) {
    io_write_error(message + "\n");
    process_exit(1);
    return 0;
}

/// Validate arguments, format the selected source, and apply the selected mode.
fn main(args) {
    mode := "stdout";
    has_path := false;
    path := "";
    position := 0;
    while position < list_length(args) {
        arg := list_get(args, position);
        if arg == "--write" || arg == "--check" {
            if mode != "stdout" {
                format_fail("usage: mini-format [--write | --check] SOURCE.mini");
            }
            if arg == "--write" {
                mode = "write";
            } else {
                mode = "check";
            }
        } else {
            if has_path {
                format_fail("usage: mini-format [--write | --check] SOURCE.mini");
            }
            has_path = true;
            path = arg;
        }
        position = position + 1;
    }
    if !has_path {
        format_fail("usage: mini-format [--write | --check] SOURCE.mini");
    }
    if mode == "write" && path == "-" {
        format_fail("--write does not accept stdin");
    }
    if path != "-" && !path_is_exists(path) {
        format_fail("cannot read " + path);
    }
    if path != "-" && !text_ends_with(path, ".mini") {
        format_fail("mini source must use .mini");
    }
    name := path;
    source := "";
    if path == "-" {
        name = "<stdin>";
        source = io_read_all();
    } else {
        source = file_read(path);
    }
    base := "";
    if path != "-" {
        base = path;
    }
    formatted := format_source(source, name, base);
    if mode == "check" {
        if formatted != source {
            format_fail(name + ": not formatted");
        }
        return 0;
    }
    if mode == "write" {
        if formatted != source {
            file_write(path, formatted);
        }
        return 0;
    }
    io_write(formatted);
    return 0;
}

main(fn_args());
