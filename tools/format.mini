#!/usr/bin/env node
include "../libs/format.mini";

/// Report a command error and stop.
fn format_fail(message) {
    io_write_error(message + "\n");
    process_exit(1);
    return 0;
}

/// Validate arguments, format the selected source, and apply the selected mode.
fn main() {
    var args = process_args();
    var mode = "stdout";
    var has_path = false;
    var path = "";
    var position = 0;
    while (position < list_length(args)) {
        var arg = list_get(args, position);
        if (arg == "--write" || arg == "--check") {
            if (mode != "stdout") {
                format_fail("usage: mini-format [--write | --check] SOURCE.mini");
            }
            if (arg == "--write") {
                mode = "write";
            } else {
                mode = "check";
            }
        } else {
            if (has_path) {
                format_fail("usage: mini-format [--write | --check] SOURCE.mini");
            }
            has_path = true;
            path = arg;
        }
        position = position + 1;
    }
    if (!has_path) {
        format_fail("usage: mini-format [--write | --check] SOURCE.mini");
    }
    if (mode == "write" && path == "-") {
        format_fail("--write does not accept stdin");
    }
    if (path != "-" && !text_ends_with(path, ".mini")) {
        format_fail("Mini source must use .mini");
    }
    var name = path;
    var source = "";
    if (path == "-") {
        name = "<stdin>";
        source = io_read_all();
    } else {
        source = file_read(path);
    }
    var base = "";
    if (path != "-") {
        base = path;
    }
    var formatted = format_source(source, name, base);
    if (mode == "check") {
        if (formatted != source) {
            format_fail(name + ": not formatted");
        }
        return 0;
    }
    if (mode == "write") {
        if (formatted != source) {
            file_write(path, formatted);
        }
        return 0;
    }
    io_write(formatted);
    return 0;
}

main();