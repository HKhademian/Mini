#!/usr/bin/env node
include "../libs/check.mini";

/// Parse arguments and run repository checks.
fn main() {
    var args = process_args();
    var docs_only = false;
    if (list_length(args) == 1 && list_get(args, 0) == "--docs") {
        docs_only = true;
    } else {
        if (list_length(args) != 0) {
            write_error("usage: mini-check [--docs | SOURCE.mini | -]\n");
            process_exit(1);
        }
    }
    check_repository(case_root(), docs_only);
    return 0;
}

main();
