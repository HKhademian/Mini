#!/usr/bin/env node
include "tools/check.mini";

/// Parse arguments and run repository checks.
fn main(args) {
    docs_only := false;
    if list_length(args) == 1 && list_get(args, 0) == "--docs" {
        docs_only = true;
    } else {
        if list_length(args) != 0 {
            io_write_error("usage: mini-check [--docs | SOURCE.mini | -]\n");
            process_exit(1);
        }
    }
    check_repository(project_root(), docs_only);
    return 0;
}

main(fn_args());
