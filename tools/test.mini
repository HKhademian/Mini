#!/usr/bin/env node
import "core/io";
import "core/json";
import "core/list";
import "core/number";
import "core/process";
import "core/text";
import "tools/test";
import "util/project";
import "util/result";

/// Parse arguments and run selected case scenarios.
fn main(args) {
    verbose := false;
    jobs := 4;
    inherited_jobs := number_from_text(process_env("MINI_TEST_JOBS"));
    if inherited_jobs > 0 {
        jobs = inherited_jobs;
    }
    clean_args := list_new();
    position := 0;
    while position < list_length(args) {
        arg := list_get(args, position);
        if arg == "--verbose" || arg == "-v" {
            verbose = true;
        } else {
            if arg == "--jobs" {
                position = position + 1;
                if position >= list_length(args) {
                    io_write_error("--jobs requires a positive number\n");
                    process_exit(1);
                }
                jobs = number_from_text(list_get(args, position));
                if jobs < 1 {
                    io_write_error("--jobs requires a positive number\n");
                    process_exit(1);
                }
            } else {
                if text_starts_with(arg, "--jobs=") {
                    jobs = number_from_text(text_slice(arg, 7, text_length(arg)));
                    if jobs < 1 {
                        io_write_error("--jobs requires a positive number\n");
                        process_exit(1);
                    }
                } else {
                    list_set(clean_args, list_length(clean_args), arg);
                }
            }
        }
        position = position + 1;
    }
    if list_length(clean_args) > 0 && list_get(clean_args, 0) == "--_worker" {
        if list_length(clean_args) != 2 {
            process_exit(1);
        }
        parsed := json_value(list_get(clean_args, 1));
        if result_is_fail(parsed) {
            process_exit(1);
        }
        io_write(json_text(test_worker(result_get_value(parsed), project_root())));
        return 0;
    }
    if list_length(clean_args) >= 1 && list_get(clean_args, 0) == "--unit" {
        if list_length(clean_args) > 2 {
            io_write_error("usage: mini-test [--jobs N] [--verbose] [FILTER] | --unit [--jobs N] [--verbose] [FILTER]\n");
            process_exit(1);
        }
        filter := "";
        if list_length(clean_args) == 2 {
            filter = list_get(clean_args, 1);
        }
        process_exit(test_units(project_root(), filter, verbose, jobs));
        return 0;
    }
    filter := "";
    file := "";
    candidate := "";
    if list_length(clean_args) == 1 {
        filter = list_get(clean_args, 0);
    } else {
        if list_length(clean_args) == 2 && list_get(clean_args, 0) == "--file" {
            file = list_get(clean_args, 1);
        } else {
            if list_length(clean_args) >= 2 && list_get(clean_args, 0) == "--candidate" {
                candidate = list_get(clean_args, 1);
                if list_length(clean_args) > 3 {
                    io_write_error("usage: mini-test [--jobs N] [--verbose] [FILTER]\n");
                    process_exit(1);
                }
                if list_length(clean_args) == 3 {
                    filter = list_get(clean_args, 2);
                }
            } else {
                if list_length(clean_args) != 0 {
                    io_write_error("usage: mini-test [--jobs N] [--verbose] [FILTER]\n");
                    process_exit(1);
                }
            }
        }
    }
    process_exit(test_run(project_root(), filter, file, candidate, verbose, jobs));
    return 0;
}

main(fn_args());
