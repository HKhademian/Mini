#!/usr/bin/env node
/// Run case scenarios through the shared case runner.
/// Usage: node tools/test.generated.ts [FILTER]
///        node tools/test.generated.ts --file CASE.json
///        node tools/test.generated.ts --candidate COMPILER.ts [FILTER]
/// Prints PASS, PENDING, or FAIL for each scenario and exits 1 on mismatch.

/// Report usage and stop.
fn test_usage() {
    write_error("usage: mini-test [FILTER]\n");
    process_exit(1);
    return 0;
}

/// Run every selected fixture in normal or candidate mode.
fn main() {
    var args = process_args();
    var filter = "";
    var file = "";
    var candidate = "";
    if (list_length(args) == 1) {
        filter = list_get(args, 0);
    } else {
        if (list_length(args) == 2 && list_get(args, 0) == "--file") {
            file = list_get(args, 1);
        } else {
            if (list_length(args) >= 2 && list_get(args, 0) == "--candidate") {
                candidate = list_get(args, 1);
                if (list_length(args) > 3) {
                    test_usage();
                }
                if (list_length(args) == 3) {
                    filter = list_get(args, 2);
                }
            } else {
                if (list_length(args) != 0) {
                    test_usage();
                }
            }
        }
    }
    var root = case_root();
    var fixtures = list_new();
    if (file != "") {
        var loaded = case_load_case(file);
        if (!map_get(loaded, "ok")) {
            write_error(map_get(loaded, "message") + "\n");
            process_exit(1);
        }
        list_set(fixtures, 0, map_get(loaded, "fixture"));
    } else {
        var selected = case_load_cases(filter, root);
        if (!map_get(selected, "ok")) {
            write_error(map_get(selected, "message") + "\n");
            process_exit(1);
        }
        fixtures = map_get(selected, "fixtures");
    }
    if (candidate != "") {
        process_exit(test_candidate(fixtures, root, candidate));
    }
    var failures = 0;
    var count = 0;
    var pending = 0;
    var fixture_index = 0;
    while (fixture_index < list_length(fixtures)) {
        var fixture = list_get(fixtures, fixture_index);
        var definition = map_get(fixture, "definition");
        var scenarios = map_get(definition, "cases");
        var scenario_index = 0;
        while (scenario_index < list_length(scenarios)) {
            var scenario = list_get(scenarios, scenario_index);
            var id = map_get(definition, "id");
            var name = map_get(scenario, "name");
            if (map_has(definition, "pending")) {
                pending = pending + 1;
                write("PENDING " + id + "/" + name + ": " + map_get(definition, "pending") + "\n");
            } else {
                count = count + 1;
                var result = case_verify_scenario(fixture, scenario, root, "");
                if (map_get(result, "ok")) {
                    write("PASS " + id + "/" + name + "\n");
                } else {
                    failures = failures + 1;
                    write_error("FAIL " + id + "/" + name + ": " + map_get(result, "message") + "\n");
                }
            }
            scenario_index = scenario_index + 1;
        }
        fixture_index = fixture_index + 1;
    }
    write(number_to_text(count - failures) + "/" + number_to_text(count) + " scenarios passed\n");
    if (pending > 0) {
        write(number_to_text(pending) + " scenarios pending\n");
    }
    if (failures > 0 || (pending > 0 && (file != "" || count == 0))) {
        process_exit(1);
    }
    return 0;
}

/// Run non-tool cases through a candidate compiler and report the summary.
fn test_candidate(fixtures, root, compiler) {
    var passed = 0;
    var failed = 0;
    var pending = 0;
    var tools = 0;
    var fixture_index = 0;
    while (fixture_index < list_length(fixtures)) {
        var fixture = list_get(fixtures, fixture_index);
        var definition = map_get(fixture, "definition");
        var kind = map_get(definition, "kind");
        if (kind == "tool") {
            tools = tools + 1;
        } else {
            if (map_has(definition, "pending")) {
                pending = pending + 1;
            } else {
                var scenarios = map_get(definition, "cases");
                var scenario_index = 0;
                while (scenario_index < list_length(scenarios)) {
                    var scenario = list_get(scenarios, scenario_index);
                    var result = case_verify_scenario(fixture, scenario, root, compiler);
                    if (map_get(result, "ok")) {
                        passed = passed + 1;
                    } else {
                        failed = failed + 1;
                        write_error("FAIL " + map_get(definition, "id") + "/" + map_get(scenario, "name")
                            + ": " + map_get(result, "message") + "\n");
                    }
                    scenario_index = scenario_index + 1;
                }
            }
        }
        fixture_index = fixture_index + 1;
    }
    write(number_to_text(passed) + "/" + number_to_text(passed + failed) + " Mini-source scenarios passed\n");
    if (pending > 0) {
        write(number_to_text(pending) + " cases pending\n");
    }
    if (tools > 0) {
        write(number_to_text(tools) + " tool cases skipped; run mini test for those\n");
    }
    if (failed > 0) {
        return 1;
    }
    return 0;
}

main();
