#!/usr/bin/env node
import "core/io";
import "core/list";
import "tools/test";
import "core/process";
import "util/project";

/// Parse arguments and run selected case scenarios.
fn main(args) {
    verbose := false;
    clean_args := list_new();
    position := 0;
    while position < list_length(args) {
        arg := list_get(args, position);
        if arg == "--verbose" || arg == "-v" {
            verbose = true;
        } else {
            list_set(clean_args, list_length(clean_args), arg);
        }
        position = position + 1;
    }
    if list_length(clean_args) >= 1 && list_get(clean_args, 0) == "--unit" {
        if list_length(clean_args) > 2 {
            io_write_error("usage: mini-test [--verbose] [FILTER] | --unit [--verbose] [FILTER]\n");
            process_exit(1);
        }
        filter := "";
        if list_length(clean_args) == 2 {
            filter = list_get(clean_args, 1);
        }
        process_exit(test_units(project_root(), filter, verbose));
        return 0;
    }
    filter := "";
    file := "";
    candidate := "";
    if list_length(clean_args) == 1 {
        filter = list_get(clean_args, 0);
    } else {
        if list_length(clean_args) == 2 && list_get(clean_args, 0) == "--file" {
            file = list_get(clean_args, 1);
        } else {
            if list_length(clean_args) >= 2 && list_get(clean_args, 0) == "--candidate" {
                candidate = list_get(clean_args, 1);
                if list_length(clean_args) > 3 {
                    io_write_error("usage: mini-test [--verbose] [FILTER]\n");
                    process_exit(1);
                }
                if list_length(clean_args) == 3 {
                    filter = list_get(clean_args, 2);
                }
            } else {
                if list_length(clean_args) != 0 {
                    io_write_error("usage: mini-test [--verbose] [FILTER]\n");
                    process_exit(1);
                }
            }
        }
    }
    process_exit(test_run(project_root(), filter, file, candidate, verbose));
    return 0;
}

main(fn_args());
