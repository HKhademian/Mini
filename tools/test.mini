#!/usr/bin/env node
include "../libs/test.mini";

/// Parse arguments and run selected case scenarios.
fn main() {
    var args = process_args();
    var filter = "";
    var file = "";
    var candidate = "";
    if (list_length(args) >= 1 && list_get(args, 0) == "--unit") {
        if (list_length(args) > 2) {
            io_write_error("usage: mini-test [FILTER] | --unit [FILTER]\n");
            process_exit(1);
        }
        if (list_length(args) == 2) {
            filter = list_get(args, 1);
        }
        process_exit(test_units(project_root(), filter));
        return 0;
    }
    if (list_length(args) == 1) {
        filter = list_get(args, 0);
    } else {
        if (list_length(args) == 2 && list_get(args, 0) == "--file") {
            file = list_get(args, 1);
        } else {
            if (list_length(args) >= 2 && list_get(args, 0) == "--candidate") {
                candidate = list_get(args, 1);
                if (list_length(args) > 3) {
                    io_write_error("usage: mini-test [FILTER]\n");
                    process_exit(1);
                }
                if (list_length(args) == 3) {
                    filter = list_get(args, 2);
                }
            } else {
                if (list_length(args) != 0) {
                    io_write_error("usage: mini-test [FILTER]\n");
                    process_exit(1);
                }
            }
        }
    }
    process_exit(test_run(project_root(), filter, file, candidate));
    return 0;
}

main();
