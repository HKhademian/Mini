#!/usr/bin/env node
include "text.mini";
include "cases.mini";
/// Verify the promoted bootstrap fixed point and its example case.
/// Usage: node tools/verify.generated.ts [PROJECT_ROOT]
/// Prints one compact JSON object with source, compiler, generation, example,
/// and artifact hashes. Exits 1 on any mismatch.

/// Report a verification failure and stop.
fn verify_fail(message) {
    write_error(message + "\n");
    process_exit(1);
    return 0;
}

/// Return a text field from a parsed JSON map, or empty text.
fn verify_text(value, key) {
    if (!map_has(value, key)) {
        return "";
    }
    var field = map_get(value, key);
    if (value_kind(field) != "text") {
        return "";
    }
    return field;
}

/// Verify the bootstrap and print its identities.
fn main() {
    var args = process_args();
    if (list_length(args) > 1) {
        verify_fail("usage: mini-verify");
    }
    var root = case_root();
    if (list_length(args) == 1) {
        root = list_get(args, 0);
    }
    var bootstrap_path = case_path_join(root, "config/bootstrap.json");
    if (!path_exists(bootstrap_path)) {
        verify_fail("Self-hosted bootstrap unavailable: finish and promote the Mini-written compiler first.");
    }
    var parsed = json_parse(file_read(bootstrap_path));
    if (!map_get(parsed, "ok") || value_kind(map_get(parsed, "value")) != "map") {
        verify_fail("invalid config/bootstrap.json");
    }
    var config = map_get(parsed, "value");
    var compiler = verify_text(config, "compiler");
    var source = verify_text(config, "source");
    var example = verify_text(config, "example");
    if (compiler == "" || source == "" || example == "") {
        verify_fail("bootstrap.json needs compiler, source, and example");
    }
    var versions_parsed = json_parse(file_read(case_path_join(root, "config/versions.json")));
    if (!map_get(versions_parsed, "ok")) {
        verify_fail("invalid config/versions.json");
    }
    var current = map_get(versions_parsed, "value");
    if (verify_text(current, "language") == "" || verify_text(current, "compiler") == ""
        || verify_text(current, "bootstrap") == "") {
        verify_fail("assign the language, compiler, and bootstrap versions before verifying the bootstrap");
    }
    var source_path = case_path_join(root, source);
    var seed_path = case_path_join(root, compiler);
    var source_bytes = file_read_bytes(source_path);
    var seed_bytes = file_read_bytes(seed_path);
    var work = directory_temp();
    if (text_length(work) == 0) {
        verify_fail("cannot create a temporary directory");
    }
    file_write(case_path_join(work, "package.json"), "{\"type\":\"module\"}\n");
    var previous = case_path_join(work, "compiler0.ts");
    file_write_bytes(previous, seed_bytes);
    var generations = list_new();
    var stage = 1;
    while (stage <= 3) {
        var next = case_path_join(work, "compiler" + number_to_text(stage) + ".ts");
        var compile_args = list_new();
        list_set(compile_args, 0, previous);
        list_set(compile_args, 1, "compile");
        list_set(compile_args, 2, source_path);
        list_set(compile_args, 3, next);
        var result = case_run(process_exec_path(), compile_args, work, list_new());
        if (map_get(result, "status") != 0) {
            path_remove(work);
            verify_fail("bootstrap generation " + number_to_text(stage) + " failed: " + text_from_bytes(map_get(result, "stderr")));
        }
        var output = file_read_bytes(next);
        if (!case_bytes_equal(output, seed_bytes)) {
            path_remove(work);
            verify_fail("bootstrap differs from generation " + number_to_text(stage)
                + "; regenerate and promote the matching compiler");
        }
        list_set(generations, list_length(generations), hash_sha256(output));
        previous = next;
        stage = stage + 1;
    }
    var case_path = case_path_resolve(root, example);
    var loaded = case_load_case(case_path);
    if (!map_get(loaded, "ok")) {
        path_remove(work);
        verify_fail(map_get(loaded, "message"));
    }
    var fixture = map_get(loaded, "fixture");
    var definition = map_get(fixture, "definition");
    if (map_get(definition, "kind") != "example") {
        path_remove(work);
        verify_fail("bootstrap example must be an example case");
    }
    var artifacts = list_new();
    var scenarios = map_get(definition, "cases");
    var position = 0;
    while (position < list_length(scenarios)) {
        var verified = case_verify_scenario(fixture, list_get(scenarios, position), root, previous);
        if (!map_get(verified, "ok")) {
            path_remove(work);
            verify_fail(map_get(verified, "message"));
        }
        list_set(artifacts, list_length(artifacts), map_get(verified, "artifact"));
        position = position + 1;
    }
    var record = map_new();
    map_set(record, "source", hash_sha256(source_bytes));
    map_set(record, "compiler", hash_sha256(seed_bytes));
    map_set(record, "generations", generations);
    map_set(record, "example", case_case_identity(fixture, root));
    map_set(record, "artifacts", artifacts);
    path_remove(work);
    write(json_to_text(record) + "\n");
    return 0;
}

main();
