#!/usr/bin/env node
include "../libs/verify.mini";

/// Parse arguments and print the bootstrap identity record.
fn main() {
    var args = process_args();
    if (list_length(args) > 1) {
        write_error("usage: mini-verify\n");
        process_exit(1);
    }
    var root = case_root();
    if (list_length(args) == 1) {
        root = list_get(args, 0);
    }
    write(verify_bootstrap(root));
    return 0;
}

main();
