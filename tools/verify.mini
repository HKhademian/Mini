#!/usr/bin/env node
import "core/io";
import "core/list";
import "core/process";
import "util/project";
import "tools/test";
import "tools/verify";

/// Consume verify options, then check one case or the bootstrap.
fn main(args) {
    verbose := false;
    rest := list_new();
    position := 0;
    while position < list_length(args) {
        arg := list_get(args, position);
        if arg == "--verbose" || arg == "-v" {
            verbose = true;
        } else {
            list_set(rest, list_length(rest), arg);
        }
        position = position + 1;
    }
    root := project_root();
    if list_length(rest) == 2 && list_get(rest, 0) == "--root" {
        root = list_get(rest, 1);
        io_write(verify_bootstrap(root));
        return 0;
    }
    if list_length(rest) == 0 {
        io_write(verify_bootstrap(root));
        return 0;
    }
    if list_length(rest) != 1 {
        io_write_error("usage: mini-verify [--verbose] [CASE.json]\n");
        process_exit(1);
    }
    process_exit(test_run(root, "", list_get(rest, 0), "", verbose, !verbose, 0, false));
    return 0;
}

main(fn_args());
