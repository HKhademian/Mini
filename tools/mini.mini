#!/usr/bin/env node
import "core/path";
import "tools/mini";
import "core/process";
import "core/project";

/// Dispatch the invoked command.
fn main(args) {
    script := process_script_path();
    executable := path_basename(script);
    process_exit(mini_run(executable, args, project_root()));
    return 0;
}

main(fn_args());
