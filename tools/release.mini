#!/usr/bin/env node

import "common/io";
import "common/list";
import "common/path";
import "tools/release";
import "common/process";
import "common/project";

/// Parse arguments and package a release.
fn main(args) {
    if list_length(args) < 1 || list_length(args) > 2 {
        io_write_error("usage: mini-release OUTPUT [TAG]\n");
        process_exit(1);
    }
    directory := project_root();
    output := path_normalize(list_get(args, 0));
    tag := "";
    if list_length(args) == 2 {
        tag = list_get(args, 1);
    }
    release_prepare(directory, output, tag);
    return 0;
}

main(fn_args());
