#!/usr/bin/env node
include "tools/build.mini";

/// Parse arguments and build or check generated artifacts.
fn main(args) {
    if list_length(args) > 1 || (list_length(args) == 1 && list_get(args, 0) != "--check") {
        io_write_error("usage: dist/build.js [--check]\n");
        process_exit(1);
    }
    check := list_length(args) == 1;
    build_run(project_root(), check);
    return 0;
}

main(fn_args());
