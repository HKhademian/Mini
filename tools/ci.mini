#!/usr/bin/env node

import "common/io";
import "common/list";
import "tools/ci";

/// Read the task file and run the selected CI task.
fn main(args) {
    if list_length(args) != 1 {
        io_write_error("usage: dist/ci.js TASK_FILE\n");
        process_exit(1);
    }
    task := ci_task_name(file_read(list_get(args, 0)));
    process_exit(ci_task(ci_root(), task));
    return 0;
}

main(fn_args());
