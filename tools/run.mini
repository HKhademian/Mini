#!/usr/bin/env node

import "common/io";
import "common/list";
import "tools/run";
import "common/process";

/// Parse internal arguments and run the selected program.
fn main(args) {
    if list_length(args) < 2 {
        io_write_error("usage: mini-run SOURCE.mini [ARG]...\n");
        process_exit(1);
    }
    if !text_ends_with(list_get(args, 1), ".mini") {
        io_write_error("mini source must use .mini\n");
        process_exit(1);
    }
    forwarded := list_new();
    position := 2;
    while position < list_length(args) {
        list_set(forwarded, list_length(forwarded), list_get(args, position));
        position = position + 1;
    }
    process_exit(run_program(list_get(args, 0), list_get(args, 1), forwarded));
    return 0;
}

main(fn_args());
