#!/usr/bin/env node
include "../libs/bench.mini";

/// Parse arguments, run benchmarks, and report the output path.
fn main() {
    var args = process_args();
    if (list_length(args) < 1 || list_length(args) > 2) {
        write_error("usage: mini-bench OUTPUT [FILTER]\n");
        process_exit(1);
    }
    var root = case_root();
    var output = case_path_resolve("", list_get(args, 0));
    var filter = "";
    if (list_length(args) == 2) {
        filter = list_get(args, 1);
    }
    var count = bench_run(root, output, filter);
    write("Wrote " + number_to_text(count) + " benchmark results to " + output + "\n");
    return 0;
}

main();
