#!/usr/bin/env node

import "common/list";
import "common/io";
import "tools/bench";

/// Parse arguments, run benchmarks, and report the output path.
fn main(args) {
    if list_length(args) < 1 || list_length(args) > 2 {
        io_write_error("usage: mini-bench OUTPUT [FILTER]\n");
        process_exit(1);
    }
    root := project_root();
    output := path_resolve("", list_get(args, 0));
    filter := "";
    if list_length(args) == 2 {
        filter = list_get(args, 1);
    }
    count := bench_run(root, output, filter);
    io_write_line("Wrote " + number_to_text(count) + " benchmark results to " + output);
    return 0;
}

main(fn_args());
