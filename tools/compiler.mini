#!/usr/bin/env node
/// Compose the mini compiler from its source files.

include "common/io.mini";
include "common/text.mini";
include "compiler/lexer.mini";
include "compiler/parser.mini";
include "compiler/builtins.mini";

/// Return token JSON with two-space indentation and a final newline.
fn token_json(tokens) {
    output := "[";
    position := 0;
    while position < list_length(tokens) {
        if position > 0 {
            output = output + ",";
        }
        token := list_get(tokens, position);
        output = output + "\n  {";
        output = output + "\n    \"kind\": " + json_to_text(map_get(token, "kind")) + ",";
        output = output + "\n    \"text\": " + json_to_text(map_get(token, "text")) + ",";
        output = output + "\n    \"source\": " + json_to_text(map_get(token, "source")) + ",";
        output = output + "\n    \"start\": " + number_to_text(map_get(token, "start")) + ",";
        output = output + "\n    \"end\": " + number_to_text(map_get(token, "end")) + ",";
        output = output + "\n    \"line\": " + number_to_text(map_get(token, "line")) + ",";
        output = output + "\n    \"column\": " + number_to_text(map_get(token, "column")) + ",";
        output = output + "\n    \"context\": " + json_to_text(map_get(token, "context"));
        output = output + "\n  }";
        position = position + 1;
    }
    if list_length(tokens) > 0 {
        output = output + "\n";
    }
    return output + "]\n";
}

/// Return a list without its first item.
fn compiler_tail(items) {
    result := list_new();
    position := 1;
    while position < list_length(items) {
        list_set(result, list_length(result), list_get(items, position));
        position = position + 1;
    }
    return result;
}

/// Append tokens, dropping their end marker.
fn compiler_append_body(output, tokens) {
    position := 0;
    while position < list_length(tokens) && map_get(list_get(tokens, position), "kind") != "eof" {
        list_set(output, list_length(output), list_get(tokens, position));
        position = position + 1;
    }
    return output;
}

/// Return the compiler command usage text.
fn compiler_usage() {
    return "usage: mini [--reference | --program-only] SOURCE.mini [OUTPUT.js] | tokens [--comments] SOURCE.mini | metadata\n";
}

/// Run the mini compiler command interface.
fn main(args) {
    reference_mode = false;
    program_only := false;
    if list_length(args) > 0 && list_get(args, 0) == "--reference" {
        reference_mode = true;
        args = compiler_tail(args);
    }
    if list_length(args) > 0 && list_get(args, 0) == "--program-only" {
        program_only = true;
        args = compiler_tail(args);
    }
    command := list_get(args, 0);
    include_comments := false;
    offset := 0;
    if command == "tokens" && list_get(args, 1) == "--comments" {
        include_comments = true;
        offset = 1;
    }
    if command == "metadata" && list_length(args) == 1 {
        entries := list_new();
        names := builtin_names();
        index := 0;
        while index < list_length(names) {
            name := list_get(names, index);
            entry := map_new();
            map_set(entry, "name", name);
            map_set(entry, "parameters", builtin_parameters(name));
            map_set(entry, "result", builtin_result(name));
            map_set(entry, "class", builtin_class(name));
            map_set(entry, "reference", builtin_reference_target(name));
            list_set(entries, list_length(entries), entry);
            index = index + 1;
        }
        metadata := map_new();
        map_set(metadata, "builtins", entries);
        io_write_line(json_to_text(metadata));
        return 0;
    }
    if command == "tokens" {
        count := list_length(args) - offset;
        token_source := list_get(args, 1 + offset);
        if count < 2 || count > 3 || !text_ends_with(token_source, ".mini") {
            io_write_error(compiler_usage());
            process_exit(1);
        }
        tokens := lex_tokenize(file_read(token_source), path_basename(token_source), include_comments);
        io_write(token_json(tokens));
        return 0;
    }
    // The dispatcher owns the `compile` command word, so this entry takes one
    // source and an optional output only.
    source := command;
    output := list_get(args, 1);
    if list_length(args) > 2 {
        io_write_error(compiler_usage());
        process_exit(1);
    }
    if source == 0 || !text_ends_with(source, ".mini") {
        io_write_error(compiler_usage());
        process_exit(1);
    }
    tokens := lex_tokenize(file_read(source), path_basename(source), false);
    target := source + ".js";
    if output != 0 {
        target = output;
    }
    expanded := lex_expand_includes(tokens, source, list_new(), map_new());
    if reference_mode {
        root := path_parent(path_parent(process_script_path()));
        pure_path := root + "/libs/pure/reference.mini";
        pure_tokens := lex_expand_includes(lex_tokenize(file_read(pure_path), "libs/pure/reference.mini", false), pure_path, list_new(), map_new());
        combined := list_new();
        compiler_append_body(combined, expanded);
        compiler_append_body(combined, pure_tokens);
        list_set(combined, list_length(combined), list_get(expanded, list_length(expanded) - 1));
        expanded = combined;
    }
    if program_only {
        file_write(target, parser_compile_program(expanded));
        return 0;
    }
    file_write(target, parser_compile(expanded));
    return 0;
}

main(fn_args());
