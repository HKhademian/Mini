#!/usr/bin/env node
/// Compose the Mini compiler from its source files.
include "../libs/compiler/constants.mini";
include "../libs/text.mini";
include "../libs/compiler/lexer.mini";
include "../libs/compiler/parser.mini";
include "../libs/compiler/builtins.mini";

/// Return token JSON with two-space indentation and a final newline.
fn token_json(tokens) {
    var output = "[";
    var position = 0;
    while (position < list_length(tokens)) {
        if (position > 0) {
            output = output + ",";
        }
        var token = list_get(tokens, position);
        output = output + "\n  {";
        output = output + "\n    \"kind\": " + json_to_text(map_get(token, "kind")) + ",";
        output = output + "\n    \"text\": " + json_to_text(map_get(token, "text")) + ",";
        output = output + "\n    \"source\": " + json_to_text(map_get(token, "source")) + ",";
        output = output + "\n    \"start\": " + number_to_text(map_get(token, "start")) + ",";
        output = output + "\n    \"end\": " + number_to_text(map_get(token, "end")) + ",";
        output = output + "\n    \"line\": " + number_to_text(map_get(token, "line")) + ",";
        output = output + "\n    \"column\": " + number_to_text(map_get(token, "column")) + ",";
        output = output + "\n    \"context\": " + json_to_text(map_get(token, "context"));
        output = output + "\n  }";
        position = position + 1;
    }
    if (list_length(tokens) > 0) {
        output = output + "\n";
    }
    return output + "]\n";
}

/// Run the Mini compiler command interface.
fn main() {
    var args = process_args();
    var command = list_get(args, 0);
    var include_comments = false;
    var offset = 0;
    if (command == "tokens" && list_get(args, 1) == "--comments") {
        include_comments = true;
        offset = 1;
    }
    if (command == "metadata" && list_length(args) == 1) {
        var entries = list_new();
        var names = builtin_names();
        var index = 0;
        while (index < list_length(names)) {
            var name = list_get(names, index);
            var entry = map_new();
            map_set(entry, "name", name);
            map_set(entry, "parameters", builtin_parameters(name));
            map_set(entry, "result", builtin_result(name));
            list_set(entries, list_length(entries), entry);
            index = index + 1;
        }
        var metadata = map_new();
        map_set(metadata, "builtins", entries);
        io_write(json_to_text(metadata) + "\n");
        return 0;
    }
    if (command == "tokens") {
        var count = list_length(args) - offset;
        var token_source = list_get(args, 1 + offset);
        if (count < 2 || count > 3 || !text_ends_with(token_source, ".mini")) {
            io_write_error("usage: mini SOURCE.mini [OUTPUT.ts] | compile SOURCE.mini [OUTPUT.ts] | tokens [--comments] SOURCE.mini | metadata\n");
            process_exit(1);
        }
        var tokens = tokenize(file_read(token_source), basename(token_source), include_comments);
        io_write(token_json(tokens));
        return 0;
    }
    var source = command;
    var output = list_get(args, 1);
    if (command == "compile") {
        source = list_get(args, 1);
        output = list_get(args, 2);
        if (list_length(args) > 3) {
            io_write_error("usage: mini SOURCE.mini [OUTPUT.ts] | compile SOURCE.mini [OUTPUT.ts] | tokens [--comments] SOURCE.mini | metadata\n");
            process_exit(1);
        }
    } else {
        if (list_length(args) > 2) {
            io_write_error("usage: mini SOURCE.mini [OUTPUT.ts] | compile SOURCE.mini [OUTPUT.ts] | tokens [--comments] SOURCE.mini | metadata\n");
            process_exit(1);
        }
    }
    if (source == 0 || !text_ends_with(source, ".mini")) {
        io_write_error("usage: mini SOURCE.mini [OUTPUT.ts] | compile SOURCE.mini [OUTPUT.ts] | tokens [--comments] SOURCE.mini | metadata\n");
        process_exit(1);
    }
    var tokens = tokenize(file_read(source), basename(source), false);
    var target = source + ".ts";
    if (output != 0) {
        target = output;
    }
    var expanded = expand_includes(tokens, source, list_new(), map_new());
    file_write(target, compile(expanded));
    return 0;
}

main();
