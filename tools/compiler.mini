#!/usr/bin/env node

/// Compose the mini compiler from its source files.

import "common/json";
import "common/number";
import "common/list";
import "common/map";
import "common/io";
import "common/file";
import "common/path";
import "common/text";
import "common/native";
import "compiler/lexer";
import "compiler/parser";
import "compiler/emit-js";
import "compiler/emit-c";
import "common/process";

/// Return token JSON with two-space indentation and a final newline.
fn token_json(tokens) {
    if list_length(tokens) == 0 {
        return list_join(list_of("[]", ""), "\n");
    }
    lines := list_new();
    list_set(lines, 0, "[");
    position := 0;
    while position < list_length(tokens) {
        token := list_get(tokens, position);
        object_lines := list_of(
            "  {",
            "    \"kind\": " + json_to_text(map_get(token, "kind")) + ",",
            "    \"text\": " + json_to_text(map_get(token, "text")) + ",",
            "    \"source\": " + json_to_text(map_get(token, "source")) + ",",
            "    \"start\": " + number_to_text(map_get(token, "start")) + ",",
            "    \"end\": " + number_to_text(map_get(token, "end")) + ",",
            "    \"line\": " + number_to_text(map_get(token, "line")) + ",",
            "    \"column\": " + number_to_text(map_get(token, "column")) + ",",
            "    \"context\": " + json_to_text(map_get(token, "context")),
            "  }"
        );
        if position + 1 < list_length(tokens) {
            list_set(object_lines, 9, "  },");
        }
        item := list_join(object_lines, "\n");
        list_set(lines, list_length(lines), item);
        position = position + 1;
    }
    list_set(lines, list_length(lines), "]");
    list_set(lines, list_length(lines), "");
    return list_join(lines, "\n");
}

/// Return a list without its first item.
fn compiler_tail(items) {
    result := list_new();
    position := 1;
    while position < list_length(items) {
        list_set(result, list_length(result), list_get(items, position));
        position = position + 1;
    }
    return result;
}

/// Append tokens, dropping their end marker.
fn compiler_append_body(output, tokens) {
    position := 0;
    while position < list_length(tokens) && map_get(list_get(tokens, position), "kind") != "eof" {
        list_set(output, list_length(output), list_get(tokens, position));
        position = position + 1;
    }
    return output;
}

/// Return the compiler command usage text.
fn compiler_usage() {
    return "usage: mini [--target js|c] [--reference | --program-only] SOURCE.mini [OUTPUT] | tokens [--comments] SOURCE.mini\n";
}

/// Run the mini compiler command interface.
fn main(args) {
    reference_mode = false;
    program_only := false;
    target_name := "js";
    if list_length(args) > 0 && list_get(args, 0) == "--target" {
        target_name = list_get(args, 1);
        if target_name != "js" && target_name != "c" {
            io_write_error(compiler_usage());
            process_exit(1);
        }
        args = compiler_tail(compiler_tail(args));
    }
    if list_length(args) > 0 && list_get(args, 0) == "--reference" {
        reference_mode = true;
        args = compiler_tail(args);
    }
    if list_length(args) > 0 && list_get(args, 0) == "--program-only" {
        program_only = true;
        args = compiler_tail(args);
    }
    if target_name == "c" && (reference_mode || program_only) {
        io_write_error("C target does not support --reference or --program-only\n");
        process_exit(1);
    }
    command := list_get(args, 0);
    if target_name == "c" && command == "tokens" {
        io_write_error(compiler_usage());
        process_exit(1);
    }
    include_comments := false;
    offset := 0;
    if command == "tokens" && list_get(args, 1) == "--comments" {
        include_comments = true;
        offset = 1;
    }
    if command == "tokens" {
        count := list_length(args) - offset;
        token_source := list_get(args, 1 + offset);
        if count < 2 || count > 3 || !text_ends_with(token_source, ".mini") {
            io_write_error(compiler_usage());
            process_exit(1);
        }
        tokens := lex_tokenize(file_read(token_source), path_basename(token_source), include_comments);
        io_write(token_json(tokens));
        return 0;
    }
    // The dispatcher owns the `compile` command word, so this entry takes one
    // source and an optional output only.
    source := command;
    output := list_get(args, 1);
    if list_length(args) > 2 {
        io_write_error(compiler_usage());
        process_exit(1);
    }
    if source == 0 || !text_ends_with(source, ".mini") {
        io_write_error(compiler_usage());
        process_exit(1);
    }
    tokens := lex_tokenize(file_read(source), path_basename(source), false);
    target := source + ".js";
    if target_name == "c" {
        target = source + ".c";
    }
    if output != 0 {
        target = output;
    }
    seen := map_new();
    expanded := lex_expand_imports(tokens, source, seen);
    if target_name == "c" {
        header := native_artifact_path(target, ".h");
        code := emit_c_compile(expanded, path_basename(header));
        file_write(header, emit_c_header(path_basename(header)));
        file_write(target, code);
        return 0;
    }
    if program_only {
        file_write(target, emit_js_compile_program_only(expanded));
        return 0;
    }
    file_write(target, emit_js_compile(expanded));
    return 0;
}

main(fn_args());
