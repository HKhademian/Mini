#!/usr/bin/env node
include "tools/check-source.mini";

/// Report a command error and stop.
fn check_source_fail(message) {
    io_write_error(message + "\n");
    process_exit(1);
    return 0;
}

/// Validate arguments and check the selected source.
fn main(args) {
    if list_length(args) != 1 {
        check_source_fail("usage: mini-check [--docs | SOURCE.mini | -]");
    }
    path := list_get(args, 0);
    name := path;
    source := "";
    if path == "-" {
        name = "<stdin>";
        source = io_read_all();
    } else {
        if !path_is_exists(path) {
            check_source_fail("cannot read " + path);
        }
        if !text_ends_with(path, ".mini") {
            check_source_fail("mini source must use .mini");
        }
        source = file_read(path);
    }
    tokens := lex_tokenize(source, name, false);
    base := "";
    if path != "-" {
        base = path;
    }
    parser_ast(lex_expand_includes(tokens, base, list_new(), map_new()));
    return 0;
}

main(fn_args());
