function split_lines(source) {

    let lines = $mini_text_split(source, "\n");
    let position = 0;
    while ((position < ((lines).length - 1))) {
        let line = $mini_list_get(lines, position);
        if ((((line).length > 0) && ($mini_text_get(line, ((line).length - 1)) === "\r"))) {
            $mini_list_set(lines, position, $mini_text_slice(line, 0, ((line).length - 1)));
        }
        position = (position + 1);
    }
    return lines;
}
function indent_output(output) {

    let lines = split_lines(output);
    let result = [];
    let position = 0;
    while ((position < (lines).length)) {
        let line = $mini_list_get(lines, position);
        if (((line).length > 0)) {
            $mini_list_set(result, (result).length, ("    " + line));
        }
        position = (position + 1);
    }
    return $mini_list_join(result, "\n");
}
function text_ends_with(source, suffix) {

    let size = (suffix).length;
    let length = (source).length;
    if ((size > length)) {
        return false;
    }
    return ($mini_text_slice(source, (length - size), length) === suffix);
}
function is_letter(character) {

    return ($mini_text_find("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz_", character) >= 0);
}
function is_digit(character) {

    return ($mini_text_find("0123456789", character) >= 0);
}
function is_identifier_part(character) {

    return (is_letter(character) || is_digit(character));
}
function is_two_character_symbol(value) {

    return (((((((value === "==") || (value === "!=")) || (value === "<=")) || (value === ">=")) || (value === "&&")) || (value === "||")) || (value === ":="));
}
function text_starts_with(source, prefix) {

    let size = (prefix).length;
    if ((size > (source).length)) {
        return false;
    }
    return ($mini_text_slice(source, 0, size) === prefix);
}
function text_chomp(text) {

    let length = (text).length;
    while (((length > 0) && (($mini_text_get(text, (length - 1)) === "\n") || ($mini_text_get(text, (length - 1)) === "\r")))) {
        length = (length - 1);
    }
    return $mini_text_slice(text, 0, length);
}
function text_trim_end(text) {

    let length = (text).length;
    while ((length > 0)) {
        let character = $mini_text_get(text, (length - 1));
        if ((((character === " ") || (character === "\t")) || (character === "\r"))) {
            length = (length - 1);
        } else {
            return $mini_text_slice(text, 0, length);
        }
    }
    return "";
}
function text_trim(text) {

    let start = 0;
    let end = (text).length;
    while (((start < end) && ($mini_text_find(" \t\r\n", $mini_text_get(text, start)) >= 0))) {
        start = (start + 1);
    }
    while (((end > start) && ($mini_text_find(" \t\r\n", $mini_text_get(text, (end - 1))) >= 0))) {
        end = (end - 1);
    }
    return $mini_text_slice(text, start, end);
}
function value_is_text(value) {

    return ($mini_value_kind(value) === "text");
}
function value_is_number(value) {

    return ($mini_value_kind(value) === "number");
}
function value_is_boolean(value) {

    return ($mini_value_kind(value) === "boolean");
}
function value_is_list(value) {

    return ($mini_value_kind(value) === "list");
}
function value_is_map(value) {

    return ($mini_value_kind(value) === "map");
}
function list_has_text(items, value) {

    let position = 0;
    while ((position < (items).length)) {
        if (($mini_list_get(items, position) === value)) {
            return true;
        }
        position = (position + 1);
    }
    return false;
}
function list_join_from(items, start, separator) {

    let parts = [];
    let position = start;
    while ((position < (items).length)) {
        $mini_list_set(parts, (parts).length, $mini_list_get(items, position));
        position = (position + 1);
    }
    return $mini_list_join(parts, separator);
}
function list_reverse(items) {

    let result = [];
    let position = ((items).length - 1);
    while ((position >= 0)) {
        $mini_list_set(result, (result).length, $mini_list_get(items, position));
        position = (position - 1);
    }
    return result;
}
function list_sorted(items) {

    let result = $mini_list_copy(items);
    let position = 0;
    while ((position < (result).length)) {
        let cursor = (position + 1);
        while ((cursor < (result).length)) {
            if (($mini_list_get(result, cursor) < $mini_list_get(result, position))) {
                let hold = $mini_list_get(result, position);
                $mini_list_set(result, position, $mini_list_get(result, cursor));
                $mini_list_set(result, cursor, hold);
            }
            cursor = (cursor + 1);
        }
        position = (position + 1);
    }
    return result;
}
function list_contains(items, value) {

    let position = 0;
    while ((position < (items).length)) {
        if (($mini_list_get(items, position) === value)) {
            return true;
        }
        position = (position + 1);
    }
    return false;
}
function list_is_text(value) {

    if ((!value_is_list(value))) {
        return false;
    }
    let position = 0;
    while ((position < (value).length)) {
        if (($mini_value_kind($mini_list_get(value, position)) !== "text")) {
            return false;
        }
        position = (position + 1);
    }
    return true;
}
function list_push_back(items, value) {

    if (value_is_list(items)) {
        $mini_list_set(items, (items).length, value);
    }
    return 0;
}
function list_push_front(items, value) {

    if ((!value_is_list(items))) {
        return 0;
    }
    let position = (items).length;
    while ((position > 0)) {
        $mini_list_set(items, position, $mini_list_get(items, (position - 1)));
        position = (position - 1);
    }
    $mini_list_set(items, 0, value);
    return 0;
}
function list_pop_back(items) {

    if (((!value_is_list(items)) || ((items).length === 0))) {
        return 0;
    }
    let length = (items).length;
    let value = $mini_list_get(items, (length - 1));
    $mini_list_truncate(items, (length - 1));
    return value;
}
function list_pop_front(items) {

    if (((!value_is_list(items)) || ((items).length === 0))) {
        return 0;
    }
    let length = (items).length;
    let value = $mini_list_get(items, 0);
    let position = 0;
    while ((position < (length - 1))) {
        $mini_list_set(items, position, $mini_list_get(items, (position + 1)));
        position = (position + 1);
    }
    $mini_list_truncate(items, (length - 1));
    return value;
}
function list_of() {
    const $mini_fn_args = Array.prototype.slice.call(arguments);

    return $mini_fn_args;
}
function list_rest(items, count) {

    let result = [];
    let position = count;
    while ((position < (items).length)) {
        $mini_list_set(result, (result).length, $mini_list_get(items, position));
        position = (position + 1);
    }
    return result;
}
function path_join(left, right) {

    if ((left === "")) {
        return right;
    }
    if ((right === "")) {
        return left;
    }
    if ((text_ends_with(left, "/") || text_ends_with(left, "\\"))) {
        return (left + right);
    }
    return ((left + "/") + right);
}
function path_temp_file() {

    let path = path_join($mini_path_temp_directory(), "file");
    (writeFileSync(path, "", "utf8"), 0);
    return path;
}
function file_remove(path) {

    if ((((path !== "") && $mini_path_is_exists(path)) && (!$mini_path_is_directory(path)))) {
        return $mini_path_remove(path);
    }
    return 0;
}
function directory_remove(path) {

    if ((((path !== "") && $mini_path_is_directory(path)) && (($mini_directory_list(path)).length === 0))) {
        return $mini_path_remove(path);
    }
    return 0;
}
function path_parent(path) {

    let position = ((path).length - 1);
    while ((position >= 0)) {
        let character = $mini_text_get(path, position);
        if (((character === "/") || (character === "\\"))) {
            return $mini_text_slice(path, 0, position);
        }
        position = (position - 1);
    }
    return "";
}
function path_basename(path) {

    let position = ((path).length - 1);
    while ((position >= 0)) {
        let character = $mini_text_get(path, position);
        if (((character === "/") || (character === "\\"))) {
            return $mini_text_slice(path, (position + 1), (path).length);
        }
        position = (position - 1);
    }
    return path;
}
function path_is_absolute(path) {

    if (text_starts_with(path, "/")) {
        return true;
    }
    return ((((path).length > 2) && ($mini_text_get(path, 1) === ":")) && (($mini_text_get(path, 2) === "/") || ($mini_text_get(path, 2) === "\\")));
}
function path_normalize(path) {

    let absolute = text_starts_with(path, "/");
    let parts = $mini_text_split(path, "/");
    let stack = [];
    let position = 0;
    while ((position < (parts).length)) {
        let part = $mini_list_get(parts, position);
        if (((part === "") || (part === "."))) {
        } else {
            if ((part === "..")) {
                if ((((stack).length > 0) && ($mini_list_get(stack, ((stack).length - 1)) !== ".."))) {
                    $mini_list_set(stack, ((stack).length - 1), "");
                    $mini_list_set(stack, (stack).length, "");
                    let kept = [];
                    let index = 0;
                    while ((index < (stack).length)) {
                        if (($mini_list_get(stack, index) !== "")) {
                            $mini_list_set(kept, (kept).length, $mini_list_get(stack, index));
                        }
                        index = (index + 1);
                    }
                    stack = kept;
                } else {
                    if ((!absolute)) {
                        $mini_list_set(stack, (stack).length, part);
                    }
                }
            } else {
                $mini_list_set(stack, (stack).length, part);
            }
        }
        position = (position + 1);
    }
    let output = $mini_list_join(stack, "/");
    if (absolute) {
        return ("/" + output);
    }
    return output;
}
function path_resolve(base, path) {

    if (path_is_absolute(path)) {
        return path_normalize(path);
    }
    return path_normalize(path_join(base, path));
}
function token_new(kind, text, source, start, end, line, column, context) {

    let token = ({ __proto__: $mini_map_proto });
    $mini_map_set(token, "kind", kind);
    $mini_map_set(token, "text", text);
    $mini_map_set(token, "source", source);
    $mini_map_set(token, "start", start);
    $mini_map_set(token, "end", end);
    $mini_map_set(token, "line", line);
    $mini_map_set(token, "column", column);
    $mini_map_set(token, "context", context);
    return token;
}
function lex_advance(state) {

    let source = $mini_map_get(state, "text");
    let position = $mini_map_get(state, "position");
    let value = $mini_text_get(source, position);
    $mini_map_set(state, "position", (position + 1));
    if ((value === "\n")) {
        $mini_map_set(state, "line", ($mini_map_get(state, "line") + 1));
        $mini_map_set(state, "column", 1);
    } else {
        $mini_map_set(state, "column", ($mini_map_get(state, "column") + 1));
    }
    return value;
}
function lex_start(state) {

    let lines = $mini_map_get(state, "lines");
    let token = token_new("symbol", "", $mini_map_get(state, "source"), $mini_map_get(state, "position"), $mini_map_get(state, "position"), $mini_map_get(state, "line"), $mini_map_get(state, "column"), $mini_list_get(lines, ($mini_map_get(state, "line") - 1)));
    return token;
}
function diagnostic_indent(token) {

    let context = $mini_map_get(token, "context");
    let column = $mini_map_get(token, "column");
    let indent = "";
    let position = 0;
    while (((position < (column - 1)) && (position < (context).length))) {
        if (($mini_text_get(context, position) === "\t")) {
            indent = (indent + "\t");
        } else {
            indent = (indent + " ");
        }
        position = (position + 1);
    }
    return indent;
}
function diagnostic_text(token, label) {

    let lines = list_of((((((($mini_map_get(token, "source") + ":") + $mini_number_to_text($mini_map_get(token, "line"))) + ":") + $mini_number_to_text($mini_map_get(token, "column"))) + ": ") + label), $mini_map_get(token, "context"), (diagnostic_indent(token) + "^"), "");
    return $mini_list_join(lines, "\n");
}
function diagnostic_fail(token, message) {

    (writeSync(2, diagnostic_text(token, message)), 0);
    (process.exit(1), 0);
    return 0;
}
function diagnostic_warn(token, message) {

    (writeSync(2, diagnostic_text(token, ("warning: " + message))), 0);
    return 0;
}
function lex_fail(token, message) {

    return diagnostic_fail(token, message);
}
function lex_comment(state, source, include_comments) {

    let comment_token = lex_start(state);
    while (((($mini_map_get(state, "position") < (source).length) && ($mini_text_get(source, $mini_map_get(state, "position")) !== "\r")) && ($mini_text_get(source, $mini_map_get(state, "position")) !== "\n"))) {
        lex_advance(state);
    }
    if (include_comments) {
        $mini_map_set(comment_token, "kind", "comment");
        $mini_map_set(comment_token, "text", $mini_text_slice(source, $mini_map_get(comment_token, "start"), $mini_map_get(state, "position")));
        $mini_map_set(comment_token, "end", $mini_map_get(state, "position"));
        let comment_tokens = $mini_map_get(state, "tokens");
        $mini_list_set(comment_tokens, (comment_tokens).length, comment_token);
    }
    return 0;
}
function lex_word(state, source, token) {

    $mini_map_set(token, "kind", "identifier");
    while ((($mini_map_get(state, "position") < (source).length) && is_identifier_part($mini_text_get(source, $mini_map_get(state, "position"))))) {
        lex_advance(state);
    }
    let spelling = $mini_text_slice(source, $mini_map_get(token, "start"), $mini_map_get(state, "position"));
    if ((((((((spelling === "fn") || (spelling === "return")) || (spelling === "if")) || (spelling === "else")) || (spelling === "while")) || (spelling === "true")) || (spelling === "false"))) {
        $mini_map_set(token, "kind", "keyword");
    }
    return 0;
}
function lex_digits(state, source, token) {

    $mini_map_set(token, "kind", "number");
    while ((($mini_map_get(state, "position") < (source).length) && is_digit($mini_text_get(source, $mini_map_get(state, "position"))))) {
        lex_advance(state);
    }
    return 0;
}
function lex_text(state, source, token) {

    $mini_map_set(token, "kind", "text");
    lex_advance(state);
    while ((($mini_map_get(state, "position") < (source).length) && ($mini_text_get(source, $mini_map_get(state, "position")) !== "\""))) {
        let inner = $mini_text_get(source, $mini_map_get(state, "position"));
        if (((inner === "\n") || (inner === "\r"))) {
            lex_fail(token, "unterminated text");
        }
        if ((inner === "\\")) {
            let escape = lex_start(state);
            lex_advance(state);
            if ((($mini_map_get(state, "position") === (source).length) || ($mini_text_find("\"\\nrt", $mini_text_get(source, $mini_map_get(state, "position"))) < 0))) {
                lex_fail(escape, "unknown text escape");
            }
        }
        lex_advance(state);
    }
    if (($mini_map_get(state, "position") === (source).length)) {
        lex_fail(token, "unterminated text");
    }
    lex_advance(state);
    return 0;
}
function lex_tokenize(source, source_name, include_comments) {

    let state = ({ __proto__: $mini_map_proto });
    $mini_map_set(state, "text", source);
    $mini_map_set(state, "source", source_name);
    $mini_map_set(state, "tokens", []);
    $mini_map_set(state, "lines", split_lines(source));
    $mini_map_set(state, "position", 0);
    $mini_map_set(state, "line", 1);
    $mini_map_set(state, "column", 1);
    if (((((source).length >= 2) && ($mini_text_get(source, 0) === "#")) && ($mini_text_get(source, 1) === "!"))) {
        let shebang_token = lex_start(state);
        $mini_map_set(shebang_token, "kind", "shebang");
        while (((($mini_map_get(state, "position") < (source).length) && ($mini_text_get(source, $mini_map_get(state, "position")) !== "\r")) && ($mini_text_get(source, $mini_map_get(state, "position")) !== "\n"))) {
            lex_advance(state);
        }
        $mini_map_set(shebang_token, "text", $mini_text_slice(source, $mini_map_get(shebang_token, "start"), $mini_map_get(state, "position")));
        $mini_map_set(shebang_token, "end", $mini_map_get(state, "position"));
        let initial_tokens = $mini_map_get(state, "tokens");
        $mini_list_set(initial_tokens, (initial_tokens).length, shebang_token);
    }
    while (($mini_map_get(state, "position") < (source).length)) {
        let character = $mini_text_get(source, $mini_map_get(state, "position"));
        if (($mini_text_find(" \t\r\n", character) >= 0)) {
            lex_advance(state);
        } else if (((character === "/") && ($mini_text_get(source, ($mini_map_get(state, "position") + 1)) === "/"))) {
            lex_comment(state, source, include_comments);
        } else {
            let token = lex_start(state);
            if (is_letter(character)) {
                lex_word(state, source, token);
            } else if (is_digit(character)) {
                lex_digits(state, source, token);
            } else if ((character === "\"")) {
                lex_text(state, source, token);
            } else if (is_two_character_symbol($mini_text_slice(source, $mini_map_get(state, "position"), ($mini_map_get(state, "position") + 2)))) {
                lex_advance(state);
                lex_advance(state);
            } else if (($mini_text_find("=+-!<>(),;{}", character) >= 0)) {
                lex_advance(state);
            } else {
                lex_fail(token, ("unexpected character " + $mini_json_to_text(character)));
            }
            $mini_map_set(token, "text", $mini_text_slice(source, $mini_map_get(token, "start"), $mini_map_get(state, "position")));
            $mini_map_set(token, "end", $mini_map_get(state, "position"));
            let tokens = $mini_map_get(state, "tokens");
            $mini_list_set(tokens, (tokens).length, token);
        }
    }
    let end_token = lex_start(state);
    $mini_map_set(end_token, "kind", "eof");
    let end_tokens = $mini_map_get(state, "tokens");
    $mini_list_set(end_tokens, (end_tokens).length, end_token);
    return end_tokens;
}
function lex_resolve_include(base, path) {

    if (text_starts_with(path, "/")) {
        return path_normalize(path);
    }
    if ((text_starts_with(path, "./") || text_starts_with(path, "../"))) {
        let directory = path_parent(base);
        if ((directory === "")) {
            return path_normalize(path);
        }
        return path_normalize(((directory + "/") + path));
    }
    return path_normalize(("libs/" + path));
}
function lex_expand_includes(tokens, base, seen) {

    if ($mini_map_has(seen, base)) {
        return [];
    }
    $mini_map_set(seen, base, true);
    let dependencies = [];
    let own = [];
    let position = 0;
    let depth = 0;
    while ((position < (tokens).length)) {
        let token = $mini_list_get(tokens, position);
        let text = $mini_map_get(token, "text");
        if ((text === "{")) {
            depth = (depth + 1);
        }
        if ((text === "}")) {
            depth = (depth - 1);
        }
        let is_include = ((((text === "include") && ((position + 2) < (tokens).length)) && ($mini_map_get($mini_list_get(tokens, (position + 1)), "kind") === "text")) && ($mini_map_get($mini_list_get(tokens, (position + 2)), "text") === ";"));
        if ((!is_include)) {
            $mini_list_set(own, (own).length, token);
            position = (position + 1);
        } else {
            if ((depth !== 0)) {
                diagnostic_fail(token, "include must be top-level");
            }
            let quoted = $mini_map_get($mini_list_get(tokens, (position + 1)), "text");
            let path = $mini_text_slice(quoted, 1, ((quoted).length - 1));
            let resolved = lex_resolve_include(base, path);
            if ((!$mini_map_has(seen, resolved))) {
                if ((!$mini_path_is_exists(resolved))) {
                    diagnostic_fail(token, ("cannot include " + path));
                }
                let raw = lex_tokenize(readFileSync(resolved, "utf8"), path, false);
                let included = [];
                let raw_position = 0;
                while ((raw_position < (raw).length)) {
                    if (($mini_map_get($mini_list_get(raw, raw_position), "kind") !== "eof")) {
                        $mini_list_set(included, (included).length, $mini_list_get(raw, raw_position));
                    }
                    raw_position = (raw_position + 1);
                }
                if ((((included).length > 0) && ($mini_map_get($mini_list_get(included, 0), "kind") === "shebang"))) {
                    diagnostic_fail(token, "included file must not have a shebang");
                }
                let expanded = lex_expand_includes(included, resolved, seen);
                let index = 0;
                while ((index < (expanded).length)) {
                    $mini_list_set(dependencies, (dependencies).length, $mini_list_get(expanded, index));
                    index = (index + 1);
                }
            }
            position = (position + 3);
        }
    }
    let order = 0;
    if ($mini_map_has(seen, "$file_count")) {
        order = $mini_map_get(seen, "$file_count");
    }
    let index = 0;
    while ((index < (own).length)) {
        let token = $mini_list_get(own, index);
        $mini_map_set(token, "file", base);
        $mini_map_set(token, "file_order", order);
        index = (index + 1);
    }
    $mini_map_set(seen, "$file_count", (order + 1));
    let output = [];
    let own_start = 0;
    if ((((own).length > 0) && ($mini_map_get($mini_list_get(own, 0), "kind") === "shebang"))) {
        $mini_list_set(output, (output).length, $mini_list_get(own, 0));
        own_start = 1;
    }
    index = 0;
    while ((index < (dependencies).length)) {
        $mini_list_set(output, (output).length, $mini_list_get(dependencies, index));
        index = (index + 1);
    }
    index = own_start;
    while ((index < (own).length)) {
        $mini_list_set(output, (output).length, $mini_list_get(own, index));
        index = (index + 1);
    }
    return output;
}
function ast_node(kind, token) {

    let node = ({ __proto__: $mini_map_proto });
    $mini_map_set(node, "node_kind", kind);
    $mini_map_set(node, "source", $mini_map_get(token, "source"));
    $mini_map_set(node, "start", $mini_map_get(token, "start"));
    $mini_map_set(node, "end", $mini_map_get(token, "end"));
    $mini_map_set(node, "line", $mini_map_get(token, "line"));
    $mini_map_set(node, "column", $mini_map_get(token, "column"));
    if ($mini_map_has(token, "context")) {
        $mini_map_set(node, "context", $mini_map_get(token, "context"));
    }
    if ($mini_map_has(token, "file")) {
        $mini_map_set(node, "file", $mini_map_get(token, "file"));
    } else {
        $mini_map_set(node, "file", $mini_map_get(token, "source"));
    }
    if ($mini_map_has(token, "file_order")) {
        $mini_map_set(node, "file_order", $mini_map_get(token, "file_order"));
    }
    return node;
}
function ast_derive(kind, first, value_kind) {

    let node = ({ __proto__: $mini_map_proto });
    $mini_map_set(node, "node_kind", kind);
    $mini_map_set(node, "source", $mini_map_get(first, "source"));
    $mini_map_set(node, "start", $mini_map_get(first, "start"));
    $mini_map_set(node, "end", $mini_map_get(first, "end"));
    $mini_map_set(node, "line", $mini_map_get(first, "line"));
    $mini_map_set(node, "column", $mini_map_get(first, "column"));
    if ($mini_map_has(first, "context")) {
        $mini_map_set(node, "context", $mini_map_get(first, "context"));
    }
    if ($mini_map_has(first, "file")) {
        $mini_map_set(node, "file", $mini_map_get(first, "file"));
    } else {
        $mini_map_set(node, "file", $mini_map_get(first, "source"));
    }
    if ($mini_map_has(first, "file_order")) {
        $mini_map_set(node, "file_order", $mini_map_get(first, "file_order"));
    }
    $mini_map_set(node, "value_kind", value_kind);
    return node;
}
function ast_finish(node, token) {

    $mini_map_set(node, "end", $mini_map_get(token, "end"));
    return node;
}
function ast_finish_node(node, last) {

    $mini_map_set(node, "end", $mini_map_get(last, "end"));
    return node;
}
function ast_expression(kind, token, value_kind) {

    let node = ast_node(kind, token);
    $mini_map_set(node, "value_kind", value_kind);
    return node;
}
function builtin_add(name, parameters, result, layer, import_name, helper_key, helper, reference, emit_form) {

    $mini_list_set(builtin_names_list, (builtin_names_list).length, name);
    $mini_map_set(builtin_name_set, name, true);
    $mini_map_set(builtin_parameter_kinds, name, parameters);
    $mini_map_set(builtin_result_kinds, name, result);
    $mini_map_set(builtin_import_names, name, import_name);
    $mini_map_set(builtin_helper_keys, name, helper_key);
    $mini_map_set(builtin_classes, name, layer);
    $mini_map_set(builtin_emit_forms, name, emit_form);
    if ((helper_key !== "")) {
        $mini_map_set(builtin_helpers, helper_key, helper);
        if ((!list_contains(builtin_helper_order, helper_key))) {
            $mini_list_set(builtin_helper_order, (builtin_helper_order).length, helper_key);
        }
    }
    if ((reference !== "")) {
        $mini_map_set(builtin_reference_targets, name, reference);
    }
    return 0;
}
function builtin_names() {

    return $mini_list_copy(builtin_names_list);
}
function builtin_exists(name) {

    return $mini_map_has(builtin_name_set, name);
}
function builtin_parameters(name) {

    if ((!$mini_map_has(builtin_parameter_kinds, name))) {
        return [];
    }
    let kinds = $mini_map_get(builtin_parameter_kinds, name);
    if ((kinds === "")) {
        return [];
    }
    return $mini_text_split(kinds, ",");
}
function builtin_result(name) {

    if ($mini_map_has(builtin_result_kinds, name)) {
        return $mini_map_get(builtin_result_kinds, name);
    }
    return "unknown";
}
function builtin_imports(name) {

    if ((!$mini_map_has(builtin_import_names, name))) {
        return [];
    }
    let imports = $mini_map_get(builtin_import_names, name);
    if ((imports === "")) {
        return [];
    }
    return $mini_text_split(imports, ",");
}
function builtin_class(name) {

    if ($mini_map_has(builtin_classes, name)) {
        return $mini_map_get(builtin_classes, name);
    }
    return "library";
}
function builtin_reference_target(name) {

    if ($mini_map_has(builtin_reference_targets, name)) {
        return $mini_map_get(builtin_reference_targets, name);
    }
    return "";
}
function builtin_helper_key(name) {

    if ($mini_map_has(builtin_helper_keys, name)) {
        return $mini_map_get(builtin_helper_keys, name);
    }
    return "";
}
function builtin_helper_order_keys() {

    return $mini_list_copy(builtin_helper_order);
}
function builtin_used_helper_blocks(helpers) {

    let order = builtin_helper_order;
    let parts = [];
    let position = 0;
    while ((position < (order).length)) {
        let key = $mini_list_get(order, position);
        if ($mini_map_has(helpers, key)) {
            $mini_list_set(parts, (parts).length, builtin_helper_text(key));
        }
        position = (position + 1);
    }
    return $mini_list_join(parts, "");
}
function builtin_helper_text(key) {

    if ($mini_map_has(builtin_helpers, key)) {
        return $mini_map_get(builtin_helpers, key);
    }
    return "";
}
function builtin_replace(source, needle, replacement) {

    let parts = [];
    let position = 0;
    while ((position < (source).length)) {
        let rest = $mini_text_slice(source, position, (source).length);
        let found = $mini_text_find(rest, needle);
        if ((found < 0)) {
            $mini_list_set(parts, (parts).length, $mini_text_slice(source, position, (source).length));
            return $mini_list_join(parts, "");
        }
        $mini_list_set(parts, (parts).length, $mini_text_slice(source, position, (position + found)));
        $mini_list_set(parts, (parts).length, replacement);
        position = ((position + found) + (needle).length);
    }
    return $mini_list_join(parts, "");
}
function builtin_apply(form, args) {

    let output = form;
    if (($mini_text_find(output, "{...}") >= 0)) {
        output = builtin_replace(output, "{...}", $mini_list_join(args, ", "));
    }
    let position = 0;
    while ((position < (args).length)) {
        output = builtin_replace(output, (("{" + $mini_number_to_text(position)) + "}"), $mini_list_get(args, position));
        position = (position + 1);
    }
    return output;
}
function builtin_emit(name, args) {

    let reference_target = builtin_reference_target(name);
    if ((reference_mode && (reference_target !== ""))) {
        return (((reference_target + "(") + $mini_list_join(args, ", ")) + ")");
    }
    if ((!$mini_map_has(builtin_emit_forms, name))) {
        return "";
    }
    return builtin_apply($mini_map_get(builtin_emit_forms, name), args);
}
function parser_fail(token, message) {

    return diagnostic_fail(token, message);
}
function parser_binary_expression(kind, left, operator, right) {

    let node = ast_derive(AST_BINARY, left, kind);
    $mini_map_set(node, "operator", $mini_map_get(operator, "text"));
    $mini_map_set(node, "left", left);
    $mini_map_set(node, "right", right);
    ast_finish_node(node, right);
    return node;
}
function parser_token(parser) {

    return $mini_list_get($mini_map_get(parser, "tokens"), $mini_map_get(parser, "position"));
}
function parser_peek(parser, offset) {

    return $mini_list_get($mini_map_get(parser, "tokens"), ($mini_map_get(parser, "position") + offset));
}
function parser_take(parser) {

    let token = parser_token(parser);
    $mini_map_set(parser, "position", ($mini_map_get(parser, "position") + 1));
    return token;
}
function parser_expect(parser, text) {

    if (($mini_map_get(parser_token(parser), "text") !== text)) {
        parser_fail(parser_token(parser), ("expected " + text));
    }
    parser_take(parser);
    return 0;
}
function parser_identifier(parser, message) {

    if (($mini_map_get(parser_token(parser), "kind") !== "identifier")) {
        parser_fail(parser_token(parser), message);
    }
    return parser_take(parser);
}
function parser_expression(parser) {

    let left = parser_conjunction(parser);
    while (($mini_map_get(parser_token(parser), "text") === "||")) {
        let operator = parser_take(parser);
        let right = parser_conjunction(parser);
        if (((($mini_map_get(left, "value_kind") !== "boolean") && ($mini_map_get(left, "value_kind") !== "unknown")) || (($mini_map_get(right, "value_kind") !== "boolean") && ($mini_map_get(right, "value_kind") !== "unknown")))) {
            parser_fail(operator, "|| needs booleans");
        }
        left = parser_binary_expression("boolean", left, operator, right);
    }
    return left;
}
function parser_conjunction(parser) {

    let left = parser_equality(parser);
    while (($mini_map_get(parser_token(parser), "text") === "&&")) {
        let operator = parser_take(parser);
        let right = parser_equality(parser);
        if (((($mini_map_get(left, "value_kind") !== "boolean") && ($mini_map_get(left, "value_kind") !== "unknown")) || (($mini_map_get(right, "value_kind") !== "boolean") && ($mini_map_get(right, "value_kind") !== "unknown")))) {
            parser_fail(operator, "&& needs booleans");
        }
        left = parser_binary_expression("boolean", left, operator, right);
    }
    return left;
}
function parser_equality(parser) {

    let left = parser_comparison(parser);
    while ((($mini_map_get(parser_token(parser), "text") === "==") || ($mini_map_get(parser_token(parser), "text") === "!="))) {
        let operator = parser_take(parser);
        let right = parser_comparison(parser);
        let left_kind = $mini_map_get(left, "value_kind");
        let right_kind = $mini_map_get(right, "value_kind");
        if ((((((left_kind === "list") || (right_kind === "list")) || (left_kind === "map")) || (right_kind === "map")) || (((left_kind !== "unknown") && (right_kind !== "unknown")) && (left_kind !== right_kind)))) {
            parser_fail(operator, "equality needs matching scalar kinds");
        }
        left = parser_binary_expression("boolean", left, operator, right);
    }
    return left;
}
function parser_comparison(parser) {

    let left = parser_additive(parser);
    while ((((($mini_map_get(parser_token(parser), "text") === "<") || ($mini_map_get(parser_token(parser), "text") === "<=")) || ($mini_map_get(parser_token(parser), "text") === ">")) || ($mini_map_get(parser_token(parser), "text") === ">="))) {
        let operator = parser_take(parser);
        let right = parser_additive(parser);
        if (((($mini_map_get(left, "value_kind") !== "number") && ($mini_map_get(left, "value_kind") !== "unknown")) || (($mini_map_get(right, "value_kind") !== "number") && ($mini_map_get(right, "value_kind") !== "unknown")))) {
            parser_fail(operator, "comparison needs numbers");
        }
        left = parser_binary_expression("boolean", left, operator, right);
    }
    return left;
}
function parser_additive_kind(kind) {

    return (((kind === "number") || (kind === "text")) || (kind === "unknown"));
}
function parser_additive(parser) {

    let left = parser_unary(parser);
    while ((($mini_map_get(parser_token(parser), "text") === "+") || ($mini_map_get(parser_token(parser), "text") === "-"))) {
        let operator = parser_take(parser);
        let right = parser_unary(parser);
        let left_kind = $mini_map_get(left, "value_kind");
        let right_kind = $mini_map_get(right, "value_kind");
        if (($mini_map_get(operator, "text") === "-")) {
            if ((((left_kind !== "number") && (left_kind !== "unknown")) || ((right_kind !== "number") && (right_kind !== "unknown")))) {
                parser_fail(operator, "- needs two numbers");
            }
        } else {
            if ((((!parser_additive_kind(left_kind)) || (!parser_additive_kind(right_kind))) || (((left_kind !== "unknown") && (right_kind !== "unknown")) && (left_kind !== right_kind)))) {
                parser_fail(operator, "+ needs two numbers or two texts");
            }
        }
        let result_kind = left_kind;
        if ((left_kind === "unknown")) {
            result_kind = right_kind;
        }
        left = parser_binary_expression(result_kind, left, operator, right);
    }
    return left;
}
function parser_unary(parser) {

    if (($mini_map_get(parser_token(parser), "text") === "-")) {
        let operator = parser_take(parser);
        let number = parser_token(parser);
        if (($mini_map_get(number, "kind") !== "number")) {
            parser_fail(operator, "- must precede a number literal");
        }
        parser_take(parser);
        let value = ("-" + lex_normalize_number($mini_map_get(number, "text")));
        let node = ast_node(AST_LITERAL, operator);
        $mini_map_set(node, "literal_kind", "number");
        $mini_map_set(node, "value", value);
        $mini_map_set(node, "raw", ("-" + $mini_map_get(number, "text")));
        ast_finish(node, number);
        $mini_map_set(node, "value_kind", "number");
        return node;
    }
    if (($mini_map_get(parser_token(parser), "text") === "!")) {
        let operator = parser_take(parser);
        let value = parser_unary(parser);
        let kind = "boolean";
        if ((($mini_map_get(value, "value_kind") !== kind) && ($mini_map_get(value, "value_kind") !== "unknown"))) {
            parser_fail(operator, (($mini_map_get(operator, "text") + " needs a ") + kind));
        }
        let node = ast_node(AST_UNARY, operator);
        $mini_map_set(node, "value_kind", kind);
        $mini_map_set(node, "operator", $mini_map_get(operator, "text"));
        $mini_map_set(node, "operand", value);
        ast_finish_node(node, value);
        return node;
    }
    return parser_primary(parser);
}
function lex_normalize_number(text) {

    let position = 0;
    while (((position < (text).length) && ($mini_text_get(text, position) === "0"))) {
        position = (position + 1);
    }
    if ((position === (text).length)) {
        return "0";
    }
    return $mini_text_slice(text, position, (text).length);
}
function parser_primary(parser) {

    let token = parser_take(parser);
    if (($mini_map_get(token, "text") === "(")) {
        let value = parser_expression(parser);
        let close = parser_token(parser);
        parser_expect(parser, ")");
        let node = ast_node(AST_GROUP, token);
        $mini_map_set(node, "expression", value);
        ast_finish(node, close);
        $mini_map_set(node, "value_kind", $mini_map_get(value, "value_kind"));
        return node;
    }
    if (($mini_map_get(token, "kind") === "number")) {
        let node = ast_expression(AST_LITERAL, token, "number");
        $mini_map_set(node, "literal_kind", "number");
        $mini_map_set(node, "raw", $mini_map_get(token, "text"));
        $mini_map_set(node, "value", lex_normalize_number($mini_map_get(token, "text")));
        return node;
    }
    if (($mini_map_get(token, "kind") === "text")) {
        let node = ast_expression(AST_LITERAL, token, "text");
        $mini_map_set(node, "literal_kind", "text");
        $mini_map_set(node, "raw", $mini_map_get(token, "text"));
        $mini_map_set(node, "value", $mini_map_get(token, "text"));
        return node;
    }
    if ((($mini_map_get(token, "text") === "true") || ($mini_map_get(token, "text") === "false"))) {
        let node = ast_expression(AST_LITERAL, token, "boolean");
        $mini_map_set(node, "literal_kind", "boolean");
        $mini_map_set(node, "raw", $mini_map_get(token, "text"));
        $mini_map_set(node, "value", ($mini_map_get(token, "text") === "true"));
        return node;
    }
    if ((($mini_map_get(token, "kind") === "identifier") && ($mini_map_get(token, "text") === "fn_args"))) {
        return parser_fn_args(parser, token);
    }
    if ((($mini_map_get(token, "kind") === "identifier") && ($mini_map_get(parser_token(parser), "text") === "("))) {
        return parser_call(parser, token);
    }
    if ((($mini_map_get(token, "kind") === "identifier") && $mini_map_has($mini_map_get(parser, "variables"), $mini_map_get(token, "text")))) {
        let value_kind = $mini_map_get($mini_map_get(parser, "variables"), $mini_map_get(token, "text"));
        let node = ast_expression(AST_NAME, token, value_kind);
        $mini_map_set(node, "name", $mini_map_get(token, "text"));
        return node;
    }
    parser_fail(token, "expected expression");
    let node = ast_expression(AST_LITERAL, token, "unknown");
    $mini_map_set(node, "value", "");
    return node;
}
function parser_fn_args(parser, token) {

    parser_expect(parser, "(");
    let close = parser_token(parser);
    parser_expect(parser, ")");
    if ((!$mini_map_get(parser, "in_function"))) {
        let node = ast_expression(AST_FN_ARGS, token, "list");
        $mini_map_set(node, "captures", false);
        ast_finish(node, close);
        return node;
    }
    $mini_map_set($mini_map_get(parser, "current"), "captures", true);
    let node = ast_expression(AST_FN_ARGS, token, "list");
    $mini_map_set(node, "captures", true);
    ast_finish(node, close);
    return node;
}
function parser_call_node(name, args, result_kind, is_builtin, close) {

    let node = ast_node(AST_CALL, name);
    $mini_map_set(node, "callee", $mini_map_get(name, "text"));
    $mini_map_set(node, "is_builtin", is_builtin);
    $mini_map_set(node, "value_kind", result_kind);
    let argument_nodes = [];
    let position = 0;
    while ((position < (args).length)) {
        $mini_list_set(argument_nodes, (argument_nodes).length, $mini_list_get(args, position));
        position = (position + 1);
    }
    $mini_map_set(node, "arguments", argument_nodes);
    ast_finish(node, close);
    return node;
}
function parser_call(parser, name) {

    let name_text = $mini_map_get(name, "text");
    let is_builtin = builtin_exists(name_text);
    let functions = $mini_map_get(parser, "functions");
    let has_user = $mini_map_has(functions, name_text);
    if (((!is_builtin) && (!has_user))) {
        parser_fail(name, ("unknown function " + name_text));
    }
    parser_expect(parser, "(");
    let args = [];
    if (($mini_map_get(parser_token(parser), "text") !== ")")) {
        $mini_list_set(args, (args).length, parser_expression(parser));
        while (($mini_map_get(parser_token(parser), "text") === ",")) {
            parser_take(parser);
            $mini_list_set(args, (args).length, parser_expression(parser));
        }
    }
    let close = parser_token(parser);
    parser_expect(parser, ")");
    if (is_builtin) {
        let arity = (builtin_parameters(name_text)).length;
        let variadic = ((arity > 0) && ($mini_text_slice($mini_list_get(builtin_parameters(name_text), (arity - 1)), 0, 3) === "..."));
        let fixed_arity = arity;
        if (variadic) {
            fixed_arity = (arity - 1);
        }
        if ((((!variadic) && ((args).length !== arity)) || (variadic && ((args).length < fixed_arity)))) {
            let suffix = "s";
            if (((variadic && (fixed_arity === 1)) || ((!variadic) && (arity === 1)))) {
                suffix = "";
            }
            let message = ((("expected " + $mini_number_to_text(arity)) + " argument") + suffix);
            if (variadic) {
                message = ((("expected " + $mini_number_to_text(fixed_arity)) + " or more argument") + suffix);
            }
            parser_fail(name, message);
        }
    } else {
        let arity = $mini_map_get($mini_map_get(functions, name_text), "arity");
        while (((args).length < arity)) {
            let zero = ast_expression(AST_LITERAL, name, "number");
            $mini_map_set(zero, "literal_kind", "number");
            $mini_map_set(zero, "raw", "0");
            $mini_map_set(zero, "value", "0");
            $mini_map_set(zero, "synthetic", true);
            $mini_list_set(args, (args).length, zero);
        }
    }
    if ((!is_builtin)) {
        let result_kind = $mini_map_get($mini_map_get(functions, name_text), "result");
        return parser_call_node(name, args, result_kind, false, close);
    }
    let parameters = builtin_parameters(name_text);
    let position = 0;
    while ((position < (parameters).length)) {
        let kind = $mini_list_get(parameters, position);
        if (($mini_text_slice(kind, 0, 3) !== "...")) {
            let actual = $mini_map_get($mini_list_get(args, position), "value_kind");
            if (((((kind !== "unknown") && (kind !== "any_value")) && (actual !== "unknown")) && (actual !== kind))) {
                parser_fail(name, (("expected " + kind) + " argument"));
            }
        }
        position = (position + 1);
    }
    let result_kind = builtin_result(name_text);
    return parser_call_node(name, args, result_kind, true, close);
}
function parser_statement(parser) {

    if (($mini_map_get(parser_token(parser), "text") === "while")) {
        let token = parser_take(parser);
        let while_condition = parser_condition(parser);
        let body = parser_block(parser);
        let node = ast_node(AST_WHILE, token);
        $mini_map_set(node, "condition", while_condition);
        $mini_map_set(node, "body", body);
        ast_finish_node(node, body);
        return node;
    }
    if (($mini_map_get(parser_token(parser), "text") === "if")) {
        let token = parser_take(parser);
        let if_condition = parser_condition(parser);
        let consequent = parser_block(parser);
        let alternate = 0;
        if (($mini_map_get(parser_token(parser), "text") === "else")) {
            parser_take(parser);
            if (($mini_map_get(parser_token(parser), "text") === "if")) {
                alternate = parser_statement(parser);
                let node = ast_node(AST_IF, token);
                $mini_map_set(node, "condition", if_condition);
                $mini_map_set(node, "consequent", consequent);
                $mini_map_set(node, "alternate", alternate);
                ast_finish_node(node, alternate);
                return node;
            }
            alternate = parser_block(parser);
        }
        let node = ast_node(AST_IF, token);
        $mini_map_set(node, "condition", if_condition);
        $mini_map_set(node, "consequent", consequent);
        if ((alternate !== 0)) {
            $mini_map_set(node, "alternate", alternate);
            ast_finish_node(node, alternate);
        } else {
            ast_finish_node(node, consequent);
        }
        return node;
    }
    if (($mini_map_get(parser_token(parser), "text") === "fn")) {
        return parser_function_declaration(parser);
    }
    if (($mini_map_get(parser_token(parser), "text") === "return")) {
        let return_token = parser_take(parser);
        if ((!$mini_map_get(parser, "in_function"))) {
            parser_fail(return_token, "return outside function");
        }
        let return_value = parser_expression(parser);
        let semicolon = parser_token(parser);
        parser_expect(parser, ";");
        $mini_map_set($mini_map_get(parser, "current"), "result", $mini_map_get(return_value, "value_kind"));
        let node = ast_node(AST_RETURN, return_token);
        $mini_map_set(node, "value", return_value);
        ast_finish(node, semicolon);
        return node;
    }
    if ((($mini_map_get(parser_token(parser), "kind") === "identifier") && ($mini_map_get(parser_peek(parser, 1), "text") === "("))) {
        let call_value = parser_expression(parser);
        let semicolon = parser_token(parser);
        parser_expect(parser, ";");
        let node = ast_node(AST_CALL_STATEMENT, call_value);
        $mini_map_set(node, "expression", call_value);
        ast_finish(node, semicolon);
        return node;
    }
    let variables = $mini_map_get(parser, "variables");
    let statement_name = parser_identifier(parser, "expected binding name");
    if (($mini_map_get(parser_token(parser), "text") === ":=")) {
        parser_take(parser);
        if ($mini_map_has($mini_map_get(parser, "declared"), $mini_map_get(statement_name, "text"))) {
            parser_fail(statement_name, ("duplicate binding " + $mini_map_get(statement_name, "text")));
        }
        let declaration_value = parser_expression(parser);
        let semicolon = parser_token(parser);
        parser_expect(parser, ";");
        let value_kind = $mini_map_get(declaration_value, "value_kind");
        $mini_map_set(variables, $mini_map_get(statement_name, "text"), value_kind);
        $mini_map_set($mini_map_get(parser, "declared"), $mini_map_get(statement_name, "text"), true);
        let top_level = (($mini_map_get(parser, "depth") === 0) && (!$mini_map_get(parser, "in_function")));
        let node = ast_node(AST_BINDING, statement_name);
        $mini_map_set(node, "name", $mini_map_get(statement_name, "text"));
        $mini_map_set(node, "value_kind", value_kind);
        $mini_map_set(node, "initializer", declaration_value);
        $mini_map_set(node, "top_level", top_level);
        ast_finish(node, semicolon);
        return node;
    }
    if ((!$mini_map_has(variables, $mini_map_get(statement_name, "text")))) {
        parser_fail(statement_name, ("unknown binding " + $mini_map_get(statement_name, "text")));
    }
    parser_expect(parser, "=");
    let assignment_value = parser_expression(parser);
    let semicolon = parser_token(parser);
    parser_expect(parser, ";");
    let value_kind = $mini_map_get(assignment_value, "value_kind");
    $mini_map_set(variables, $mini_map_get(statement_name, "text"), value_kind);
    let node = ast_node(AST_ASSIGNMENT, statement_name);
    $mini_map_set(node, "name", $mini_map_get(statement_name, "text"));
    $mini_map_set(node, "value_kind", value_kind);
    $mini_map_set(node, "value", assignment_value);
    ast_finish(node, semicolon);
    return node;
}
function parser_condition_parenthesized(parser) {

    let tokens = $mini_map_get(parser, "tokens");
    let position = $mini_map_get(parser, "position");
    if (($mini_map_get($mini_list_get(tokens, position), "text") !== "(")) {
        return false;
    }
    let depth = 0;
    while ((position < (tokens).length)) {
        let text = $mini_map_get($mini_list_get(tokens, position), "text");
        if ((text === "(")) {
            depth = (depth + 1);
        }
        if ((text === ")")) {
            depth = (depth - 1);
            if ((depth === 0)) {
                return ($mini_map_get($mini_list_get(tokens, (position + 1)), "text") === "{");
            }
        }
        position = (position + 1);
    }
    return false;
}
function parser_condition(parser) {

    let start = parser_token(parser);
    if (($mini_map_get(parser, "warn") && parser_condition_parenthesized(parser))) {
        diagnostic_warn(start, "unnecessary condition parentheses");
    }
    let condition = parser_expression(parser);
    if ((($mini_map_get(condition, "value_kind") !== "boolean") && ($mini_map_get(condition, "value_kind") !== "unknown"))) {
        parser_fail(start, "condition must be boolean");
    }
    return condition;
}
function parser_block(parser) {

    let open = parser_token(parser);
    parser_expect(parser, "{");
    let outer = $mini_map_get(parser, "variables");
    let outer_declared = $mini_map_get(parser, "declared");
    $mini_map_set(parser, "variables", $mini_map_copy(outer));
    $mini_map_set(parser, "declared", ({ __proto__: $mini_map_proto }));
    $mini_map_set(parser, "depth", ($mini_map_get(parser, "depth") + 1));
    let last_statement = 0;
    let statements = [];
    while ((($mini_map_get(parser_token(parser), "text") !== "}") && ($mini_map_get(parser_token(parser), "kind") !== "eof"))) {
        let statement = parser_statement(parser);
        last_statement = statement;
        $mini_list_set(statements, (statements).length, statement);
    }
    let close = parser_token(parser);
    parser_expect(parser, "}");
    if (($mini_map_get(parser, "depth") === 1)) {
        $mini_map_set(parser, "block_ends_with_return", ((last_statement !== 0) && ($mini_map_get(last_statement, "node_kind") === AST_RETURN)));
    }
    $mini_map_set(parser, "depth", ($mini_map_get(parser, "depth") - 1));
    $mini_map_set(parser, "variables", outer);
    $mini_map_set(parser, "declared", outer_declared);
    let node = ast_node(AST_BLOCK, open);
    $mini_map_set(node, "statements", statements);
    $mini_map_set(node, "ends_with_return", ((last_statement !== 0) && ($mini_map_get(last_statement, "node_kind") === AST_RETURN)));
    ast_finish(node, close);
    return node;
}
function parser_function_declaration(parser) {

    let token = parser_take(parser);
    if (($mini_map_get(parser, "depth") !== 0)) {
        parser_fail(token, "functions must be top-level");
    }
    let name = parser_identifier(parser, "expected function name");
    parser_expect(parser, "(");
    let parameters = [];
    let parameter_nodes = [];
    if (($mini_map_get(parser_token(parser), "text") !== ")")) {
        let first_parameter = parser_identifier(parser, "expected parameter name");
        $mini_list_set(parameters, (parameters).length, $mini_map_get(first_parameter, "text"));
        let first_node = ast_node(AST_NAME, first_parameter);
        $mini_map_set(first_node, "name", $mini_map_get(first_parameter, "text"));
        $mini_map_set(first_node, "role", "parameter");
        $mini_list_set(parameter_nodes, (parameter_nodes).length, first_node);
        while (($mini_map_get(parser_token(parser), "text") === ",")) {
            parser_take(parser);
            let next_parameter = parser_identifier(parser, "expected parameter name");
            $mini_list_set(parameters, (parameters).length, $mini_map_get(next_parameter, "text"));
            let next_node = ast_node(AST_NAME, next_parameter);
            $mini_map_set(next_node, "name", $mini_map_get(next_parameter, "text"));
            $mini_map_set(next_node, "role", "parameter");
            $mini_list_set(parameter_nodes, (parameter_nodes).length, next_node);
        }
    }
    parser_expect(parser, ")");
    let info = $mini_map_get($mini_map_get(parser, "functions"), $mini_map_get(name, "text"));
    $mini_map_set(parser, "current", info);
    $mini_map_set(parser, "in_function", true);
    let outer = $mini_map_get(parser, "variables");
    $mini_map_set(parser, "variables", $mini_map_copy(outer));
    let position = 0;
    while ((position < (parameters).length)) {
        $mini_map_set($mini_map_get(parser, "variables"), $mini_list_get(parameters, position), "unknown");
        position = (position + 1);
    }
    $mini_map_set(parser, "block_ends_with_return", false);
    let body = parser_block(parser);
    $mini_map_set(parser, "variables", outer);
    $mini_map_set(parser, "in_function", false);
    let node = ast_node(AST_FUNCTION, token);
    $mini_map_set(node, "name", $mini_map_get(name, "text"));
    $mini_map_set(node, "parameters", parameter_nodes);
    $mini_map_set(node, "body", body);
    $mini_map_set(node, "captures_arguments", $mini_map_get(info, "captures"));
    $mini_map_set(node, "result_kind", $mini_map_get(info, "result"));
    $mini_map_set(node, "has_final_return", $mini_map_get(body, "ends_with_return"));
    ast_finish_node(node, body);
    return node;
}
function parser_file_key(token) {

    if ($mini_map_has(token, "file")) {
        return $mini_map_get(token, "file");
    }
    return $mini_map_get(token, "source");
}
function parser_file_register(order, priorities, token) {

    let file = parser_file_key(token);
    if ((!$mini_map_has(priorities, file))) {
        let priority = 0;
        if ($mini_map_has(token, "file_order")) {
            priority = $mini_map_get(token, "file_order");
        }
        let index = (order).length;
        while (((index > 0) && ($mini_map_get(priorities, $mini_list_get(order, (index - 1))) > priority))) {
            $mini_list_set(order, index, $mini_list_get(order, (index - 1)));
            index = (index - 1);
        }
        $mini_list_set(order, index, file);
        $mini_map_set(priorities, file, priority);
    }
    return file;
}
function parser_program(parser) {

    let has_shebang = false;
    if (($mini_map_get(parser_token(parser), "kind") === "shebang")) {
        parser_take(parser);
        has_shebang = true;
    }
    let order = [];
    let priorities = ({ __proto__: $mini_map_proto });
    let ast_body = [];
    let tokens = $mini_map_get(parser, "tokens");
    let main_source = $mini_map_get($mini_list_get(tokens, ((tokens).length - 1)), "source");
    while (($mini_map_get(parser_token(parser), "kind") !== "eof")) {
        let token = parser_token(parser);
        let statement = parser_statement(parser);
        $mini_list_set(ast_body, (ast_body).length, statement);
        parser_file_register(order, priorities, token);
    }
    let program = ast_node(AST_PROGRAM, $mini_list_get(tokens, 0));
    $mini_map_set(program, "ast_schema_version", AST_SCHEMA_VERSION);
    $mini_map_set(program, "body", ast_body);
    $mini_map_set(program, "files", order);
    $mini_map_set(program, "main_source", main_source);
    $mini_map_set(program, "has_shebang", has_shebang);
    $mini_map_set(program, "tokens", tokens);
    ast_finish(program, $mini_list_get(tokens, ((tokens).length - 1)));
    return program;
}
function parser_new(tokens) {

    let parser = ({ __proto__: $mini_map_proto });
    $mini_map_set(parser, "tokens", tokens);
    $mini_map_set(parser, "position", 0);
    $mini_map_set(parser, "variables", ({ __proto__: $mini_map_proto }));
    $mini_map_set(parser, "functions", ({ __proto__: $mini_map_proto }));
    $mini_map_set(parser, "declared", ({ __proto__: $mini_map_proto }));
    $mini_map_set(parser, "warn", true);
    $mini_map_set(parser, "depth", 0);
    $mini_map_set(parser, "in_function", false);
    $mini_map_set(parser, "current", ({ __proto__: $mini_map_proto }));
    let depth = 0;
    let index = 0;
    while ((index < (tokens).length)) {
        let token = $mini_list_get(tokens, index);
        if (($mini_map_get(token, "text") === "{")) {
            depth = (depth + 1);
        }
        if (($mini_map_get(token, "text") === "}")) {
            depth = (depth - 1);
        }
        if ((((depth === 0) && ($mini_map_get(token, "kind") === "identifier")) && ($mini_map_get($mini_list_get(tokens, (index + 1)), "text") === ":="))) {
            $mini_map_set($mini_map_get(parser, "variables"), $mini_map_get(token, "text"), "unknown");
        }
        if ((((depth === 0) && ($mini_map_get(token, "text") === "fn")) && ($mini_map_get($mini_list_get(tokens, (index + 1)), "kind") === "identifier"))) {
            let arity = 0;
            let cursor = (index + 3);
            while ((((cursor < (tokens).length) && ($mini_map_get($mini_list_get(tokens, cursor), "text") !== ")")) && ($mini_map_get($mini_list_get(tokens, cursor), "text") !== "{"))) {
                if (($mini_map_get($mini_list_get(tokens, cursor), "kind") === "identifier")) {
                    arity = (arity + 1);
                }
                cursor = (cursor + 1);
            }
            let info = ({ __proto__: $mini_map_proto });
            $mini_map_set(info, "arity", arity);
            $mini_map_set(info, "result", "unknown");
            $mini_map_set(info, "captures", false);
            $mini_map_set($mini_map_get(parser, "functions"), $mini_map_get($mini_list_get(tokens, (index + 1)), "text"), info);
        }
        index = (index + 1);
    }
    return parser;
}
function parser_ast(tokens) {

    return parser_program(parser_new(tokens));
}
function parser_ast_quiet(tokens) {

    let parser = parser_new(tokens);
    $mini_map_set(parser, "warn", false);
    return parser_program(parser);
}
function emit_js_operator(operator) {

    if ((operator === "==")) {
        return "===";
    }
    if ((operator === "!=")) {
        return "!==";
    }
    return operator;
}
function emit_js_expression(node) {

    let kind = $mini_map_get(node, "node_kind");
    if ((kind === AST_LITERAL)) {
        let literal_kind = $mini_map_get(node, "literal_kind");
        if ((literal_kind === "boolean")) {
            if ($mini_map_get(node, "value")) {
                return "true";
            }
            return "false";
        }
        let value = $mini_map_get(node, "value");
        if (((literal_kind === "number") && text_starts_with(value, "-"))) {
            return (("(" + value) + ")");
        }
        return value;
    }
    if ((kind === AST_NAME)) {
        return $mini_map_get(node, "name");
    }
    if ((kind === AST_GROUP)) {
        return emit_js_expression($mini_map_get(node, "expression"));
    }
    if ((kind === AST_FN_ARGS)) {
        if ($mini_map_get(node, "captures")) {
            return "$mini_fn_args";
        }
        return "process.argv.slice(2)";
    }
    if ((kind === AST_UNARY)) {
        return ((("(" + $mini_map_get(node, "operator")) + emit_js_expression($mini_map_get(node, "operand"))) + ")");
    }
    if ((kind === AST_BINARY)) {
        return (((((("(" + emit_js_expression($mini_map_get(node, "left"))) + " ") + emit_js_operator($mini_map_get(node, "operator"))) + " ") + emit_js_expression($mini_map_get(node, "right"))) + ")");
    }
    if ((kind === AST_CALL)) {
        let argument_codes = emit_js_arguments($mini_map_get(node, "arguments"));
        let callee = $mini_map_get(node, "callee");
        if ($mini_map_get(node, "is_builtin")) {
            return builtin_emit(callee, argument_codes);
        }
        return (((callee + "(") + $mini_list_join(argument_codes, ", ")) + ")");
    }
    return "";
}
function emit_js_arguments(nodes) {

    let output = [];
    let position = 0;
    while ((position < (nodes).length)) {
        $mini_list_set(output, (output).length, emit_js_expression($mini_list_get(nodes, position)));
        position = (position + 1);
    }
    return output;
}
function emit_js_block(node) {

    let body = emit_js_statements($mini_map_get(node, "statements"));
    let indented = indent_output(body);
    if ((indented === "")) {
        return $mini_list_join(list_of("{", "}"), "\n");
    }
    return $mini_list_join(list_of("{", indented, "}"), "\n");
}
function emit_js_function_body(node) {

    let body_node = $mini_map_get(node, "body");
    let body = emit_js_block(body_node);
    if ((!$mini_map_get(node, "has_final_return"))) {
        body = ($mini_text_slice(body, 0, ((body).length - 1)) + "    return 0;\n}");
    }
    let capture = "";
    if ($mini_map_get(node, "captures_arguments")) {
        capture = "    const $mini_fn_args = Array.prototype.slice.call(arguments);\n";
    }
    return (("{\n" + capture) + $mini_text_slice(body, 1, (body).length));
}
function emit_js_function(node) {

    let name = $mini_map_get(node, "name");
    if (((!reference_mode) && (name === "number_add"))) {
        return "function number_add(a, b) {\n    if (typeof a !== \"number\" || typeof b !== \"number\") return 0;\n    return a + b;\n}\n";
    }
    let parameters = [];
    let nodes = $mini_map_get(node, "parameters");
    let position = 0;
    while ((position < (nodes).length)) {
        $mini_list_set(parameters, (parameters).length, $mini_map_get($mini_list_get(nodes, position), "name"));
        position = (position + 1);
    }
    return (((((("function " + $mini_map_get(node, "name")) + "(") + $mini_list_join(parameters, ", ")) + ") ") + emit_js_function_body(node)) + "\n");
}
function emit_js_statement(node) {

    let kind = $mini_map_get(node, "node_kind");
    if ((kind === AST_FUNCTION)) {
        return emit_js_function(node);
    }
    if ((kind === AST_BLOCK)) {
        return emit_js_block(node);
    }
    if ((kind === AST_RETURN)) {
        return (("return " + emit_js_expression($mini_map_get(node, "value"))) + ";\n");
    }
    if ((kind === AST_CALL_STATEMENT)) {
        return (emit_js_expression($mini_map_get(node, "expression")) + ";\n");
    }
    if ((kind === AST_BINDING)) {
        if ($mini_map_get(node, "top_level")) {
            return ((($mini_map_get(node, "name") + " = ") + emit_js_expression($mini_map_get(node, "initializer"))) + ";\n");
        }
        return (((("let " + $mini_map_get(node, "name")) + " = ") + emit_js_expression($mini_map_get(node, "initializer"))) + ";\n");
    }
    if ((kind === AST_ASSIGNMENT)) {
        return ((($mini_map_get(node, "name") + " = ") + emit_js_expression($mini_map_get(node, "value"))) + ";\n");
    }
    if ((kind === AST_IF)) {
        let output = ((("if (" + emit_js_expression($mini_map_get(node, "condition"))) + ") ") + emit_js_block($mini_map_get(node, "consequent")));
        let alternate = $mini_map_get(node, "alternate");
        if ((alternate !== 0)) {
            if (($mini_map_get(alternate, "node_kind") === AST_IF)) {
                return ((output + " else ") + emit_js_statement(alternate));
            }
            output = ((output + " else ") + emit_js_block(alternate));
        }
        return (output + "\n");
    }
    if ((kind === AST_WHILE)) {
        return (((("while (" + emit_js_expression($mini_map_get(node, "condition"))) + ") ") + emit_js_block($mini_map_get(node, "body"))) + "\n");
    }
    return "";
}
function emit_js_statements(nodes) {

    let parts = [];
    let position = 0;
    while ((position < (nodes).length)) {
        $mini_list_set(parts, (parts).length, emit_js_statement($mini_list_get(nodes, position)));
        position = (position + 1);
    }
    return $mini_list_join(parts, "");
}
function emit_js_collect_helpers(node, imports, helpers) {

    let kind = $mini_map_get(node, "node_kind");
    if (((kind === AST_CALL) && $mini_map_get(node, "is_builtin"))) {
        let name = $mini_map_get(node, "callee");
        let required_imports = builtin_imports(name);
        let position = 0;
        while ((position < (required_imports).length)) {
            $mini_map_set(imports, $mini_list_get(required_imports, position), true);
            position = (position + 1);
        }
        let helper = builtin_helper_key(name);
        if ((helper !== "")) {
            $mini_map_set(helpers, helper, true);
        }
        if (((name === "io_write") || (name === "to_text"))) {
            $mini_map_set(helpers, builtin_helper_key("number_to_text"), true);
            $mini_map_set(helpers, builtin_helper_key("json_to_text"), true);
        }
        if ((name === "io_write")) {
            $mini_map_set(helpers, builtin_helper_key("to_text"), true);
        }
        if ((name === "json_to_text")) {
            $mini_map_set(helpers, builtin_helper_key("number_to_text"), true);
        }
    }
    if (((kind === AST_PROGRAM) || (kind === AST_BLOCK))) {
        let nodes = $mini_map_get(node, "body");
        if ((kind === AST_BLOCK)) {
            nodes = $mini_map_get(node, "statements");
        }
        let position = 0;
        while ((position < (nodes).length)) {
            emit_js_collect_helpers($mini_list_get(nodes, position), imports, helpers);
            position = (position + 1);
        }
    } else if ((kind === AST_FUNCTION)) {
        emit_js_collect_helpers($mini_map_get(node, "body"), imports, helpers);
    } else if ((kind === AST_IF)) {
        emit_js_collect_helpers($mini_map_get(node, "condition"), imports, helpers);
        emit_js_collect_helpers($mini_map_get(node, "consequent"), imports, helpers);
        let alternate = $mini_map_get(node, "alternate");
        if ((alternate !== 0)) {
            emit_js_collect_helpers(alternate, imports, helpers);
        }
    } else if ((kind === AST_WHILE)) {
        emit_js_collect_helpers($mini_map_get(node, "condition"), imports, helpers);
        emit_js_collect_helpers($mini_map_get(node, "body"), imports, helpers);
    } else if ((kind === AST_RETURN)) {
        emit_js_collect_helpers($mini_map_get(node, "value"), imports, helpers);
    } else if ((kind === AST_CALL_STATEMENT)) {
        emit_js_collect_helpers($mini_map_get(node, "expression"), imports, helpers);
    } else if ((kind === AST_BINDING)) {
        emit_js_collect_helpers($mini_map_get(node, "initializer"), imports, helpers);
    } else if ((kind === AST_ASSIGNMENT)) {
        emit_js_collect_helpers($mini_map_get(node, "value"), imports, helpers);
    } else if ((kind === AST_CALL)) {
        let argument_nodes = $mini_map_get(node, "arguments");
        let position = 0;
        while ((position < (argument_nodes).length)) {
            emit_js_collect_helpers($mini_list_get(argument_nodes, position), imports, helpers);
            position = (position + 1);
        }
    } else if ((kind === AST_BINARY)) {
        emit_js_collect_helpers($mini_map_get(node, "left"), imports, helpers);
        emit_js_collect_helpers($mini_map_get(node, "right"), imports, helpers);
    } else if ((kind === AST_UNARY)) {
        emit_js_collect_helpers($mini_map_get(node, "operand"), imports, helpers);
    } else if ((kind === AST_GROUP)) {
        emit_js_collect_helpers($mini_map_get(node, "expression"), imports, helpers);
    }
    return 0;
}
function emit_js_import_names(imports) {

    let output = "";
    if ($mini_map_has(imports, "readFileSync")) {
        output = (output + "readFileSync");
    }
    if ($mini_map_has(imports, "writeFileSync")) {
        if ((output !== "")) {
            output = (output + ", ");
        }
        output = (output + "writeFileSync");
    }
    if ($mini_map_has(imports, "writeSync")) {
        if ((output !== "")) {
            output = (output + ", ");
        }
        output = (output + "writeSync");
    }
    return output;
}
function emit_js_file_body(nodes, file) {

    let parts = [];
    let position = 0;
    while ((position < (nodes).length)) {
        let node = $mini_list_get(nodes, position);
        if ((($mini_map_get(node, "file") === file) && ($mini_map_get(node, "node_kind") !== AST_FUNCTION))) {
            $mini_list_set(parts, (parts).length, emit_js_statement(node));
        }
        position = (position + 1);
    }
    return $mini_list_join(parts, "");
}
function emit_js_file_initializers(program) {

    let wrappers = [];
    let calls = [];
    let files = $mini_map_get(program, "files");
    let body = $mini_map_get(program, "body");
    let index = 0;
    while ((index < (files).length)) {
        let name = ("$mini_file_" + $mini_number_to_text(index));
        let code = emit_js_file_body(body, $mini_list_get(files, index));
        let wrapper_lines = list_of((("function " + name) + "() {"), indent_output(code), "}", "");
        $mini_list_set(wrappers, (wrappers).length, $mini_list_join(wrapper_lines, "\n"));
        $mini_list_set(calls, (calls).length, (("    " + name) + "();"));
        index = (index + 1);
    }
    if (((files).length > 0)) {
        let main_lines = list_of("function $mini_main() {", $mini_list_join(calls, "\n"), "}", "$mini_main();", "");
        $mini_list_set(wrappers, (wrappers).length, $mini_list_join(main_lines, "\n"));
    }
    return $mini_list_join(wrappers, "");
}
function emit_js_program_only(program) {

    let output = [];
    let body = $mini_map_get(program, "body");
    let main_source = $mini_map_get(program, "main_source");
    let position = 0;
    while ((position < (body).length)) {
        let node = $mini_list_get(body, position);
        if (($mini_map_get(node, "source") === main_source)) {
            if ((($mini_map_get(node, "node_kind") === AST_BINDING) && $mini_map_get(node, "top_level"))) {
                $mini_list_set(output, (output).length, (((("let " + $mini_map_get(node, "name")) + " = ") + emit_js_expression($mini_map_get(node, "initializer"))) + ";\n"));
            } else {
                $mini_list_set(output, (output).length, emit_js_statement(node));
            }
        }
        position = (position + 1);
    }
    return $mini_list_join(output, "");
}
function emit_js_program(program) {

    let imports = ({ __proto__: $mini_map_proto });
    let helpers = ({ __proto__: $mini_map_proto });
    let body = $mini_map_get(program, "body");
    let position = 0;
    let globals = [];
    let declarations = [];
    while ((position < (body).length)) {
        let node = $mini_list_get(body, position);
        emit_js_collect_helpers(node, imports, helpers);
        if (($mini_map_get(node, "node_kind") === AST_FUNCTION)) {
            $mini_list_set(declarations, (declarations).length, emit_js_function(node));
        } else if ((($mini_map_get(node, "node_kind") === AST_BINDING) && $mini_map_get(node, "top_level"))) {
            $mini_list_set(globals, (globals).length, (("let " + $mini_map_get(node, "name")) + ";\n"));
        }
        position = (position + 1);
    }
    let import_text = "";
    if (((Object.keys(imports)).length > 0)) {
        import_text = (("import { " + emit_js_import_names(imports)) + " } from \"node:fs\";\n");
    }
    let helper_text = builtin_used_helper_blocks(helpers);
    let shebang = "";
    if ($mini_map_get(program, "has_shebang")) {
        shebang = "#!/usr/bin/env node\n";
    }
    return $mini_list_join(list_of(shebang, "\"use strict\";\n", import_text, helper_text, $mini_list_join(globals, ""), $mini_list_join(declarations, ""), emit_js_file_initializers(program)), "");
}
function emit_js_compile(tokens) {

    return emit_js_program(parser_ast(tokens));
}
function emit_js_compile_program_only(tokens) {

    return emit_js_program_only(parser_ast(tokens));
}
function emit_js_compile_quiet(tokens) {

    return emit_js_program(parser_ast_quiet(tokens));
}
function io_write_line() {
    const $mini_fn_args = Array.prototype.slice.call(arguments);

    let values = $mini_fn_args;
    let position = 0;
    while ((position < (values).length)) {
        $mini_io_write($mini_list_get(values, position));
        position = (position + 1);
    }
    return $mini_io_write("\n");
}
function process_capture(command, args, directory, input) {

    let options = ({ __proto__: $mini_map_proto });
    $mini_map_set(options, "command", command);
    $mini_map_set(options, "arguments", args);
    $mini_map_set(options, "directory", directory);
    $mini_map_set(options, "input", input);
    $mini_map_set(options, "timeout", 30000);
    return $mini_process_spawn(options);
}
function result_ok(value, message) {

    let result = ({ __proto__: $mini_map_proto });
    $mini_map_set(result, "ok", true);
    $mini_map_set(result, "value", value);
    $mini_map_set(result, "message", message);
    return result;
}
function result_fail(message) {

    let result = ({ __proto__: $mini_map_proto });
    $mini_map_set(result, "ok", false);
    $mini_map_set(result, "value", 0);
    $mini_map_set(result, "message", message);
    return result;
}
function result_is_ok(result) {

    if ((!value_is_map(result))) {
        return false;
    }
    return ($mini_map_get(result, "ok") === true);
}
function result_is_fail(result) {

    return (!result_is_ok(result));
}
function result_get_message(result) {

    if ((!value_is_map(result))) {
        return "";
    }
    return $mini_map_get(result, "message");
}
function result_set_message(result, message) {

    if (value_is_map(result)) {
        $mini_map_set(result, "message", message);
    }
    return result;
}
function result_get_value(result) {

    if ((!value_is_map(result))) {
        return 0;
    }
    return $mini_map_get(result, "value");
}
function result_set_value(result, value) {

    if (value_is_map(result)) {
        $mini_map_set(result, "value", value);
    }
    return result;
}
function json_parse_file(path) {

    if ((!$mini_path_is_exists(path))) {
        return result_fail(("cannot read " + path));
    }
    let parsed = $mini_json_parse(readFileSync(path, "utf8"));
    if (result_is_fail(parsed)) {
        return result_fail(("invalid JSON: " + path));
    }
    return result_ok(result_get_value(parsed), 0);
}
function project_root() {

    let script = process.argv[1];
    let base = path_parent(path_parent(script));
    if ((path_basename(base) === "dist")) {
        return path_parent(base);
    }
    return base;
}
function project_compiler_entry(root) {

    let parsed = json_parse_file(path_join(root, "config/compiler.json"));
    if (result_is_fail(parsed)) {
        return "";
    }
    return $mini_map_get(result_get_value(parsed), "entry");
}
function bootstrap_fail(message) {

    (writeSync(2, (message + "\n")), 0);
    (process.exit(1), 0);
    return 0;
}
function bootstrap_compile_text(source) {

    let tokens = lex_tokenize(readFileSync(source, "utf8"), path_basename(source), false);
    let expanded = lex_expand_includes(tokens, source, ({ __proto__: $mini_map_proto }));
    return emit_js_compile(expanded);
}
function bootstrap_compile_with(root, compiler, source, output) {

    let args = list_of(compiler, source, output);
    let result = process_capture(process.execPath, args, root, []);
    if (($mini_map_get(result, "status") !== 0)) {
        bootstrap_fail(("compile failed: " + $mini_text_from_bytes($mini_map_get(result, "stderr"))));
    }
    return 0;
}
function bootstrap_run(root, path) {

    let args = [];
    $mini_list_set(args, 0, path);
    let result = process_capture(process.execPath, args, root, []);
    if (($mini_map_get(result, "status") !== 0)) {
        bootstrap_fail(("run failed: " + $mini_text_from_bytes($mini_map_get(result, "stderr"))));
    }
    return 0;
}
function bootstrap_executable(root, path) {

    let args = list_of("755", path);
    process_capture("chmod", args, root, []);
    return 0;
}
function bootstrap_step(root, label, command, args, directory) {

    let options = ({ __proto__: $mini_map_proto });
    $mini_map_set(options, "command", command);
    $mini_map_set(options, "arguments", args);
    $mini_map_set(options, "directory", directory);
    $mini_map_set(options, "mode", "inherit");
    let result = $mini_process_spawn(options);
    if (($mini_map_get(result, "status") !== 0)) {
        bootstrap_fail((label + " failed"));
    }
    return 0;
}
function bootstrap_clean_generated(root) {

    bootstrap_step(root, "remove untracked and ignored project files", "git", list_of("clean", "-ffdx"), root);
    return 0;
}
function bootstrap_clean_all(root) {

    io_write_line("Removing all untracked and ignored project files...");
    bootstrap_clean_generated(root);
    bootstrap_step(root, "root npm ci", "npm", list_of("ci"), root);
    let editor = path_join(root, "editors/vscode");
    bootstrap_step(root, "VS Code npm ci", "npm", list_of("ci"), editor);
    bootstrap_all(root);
    let node = process.execPath;
    let mini = path_join(root, "bin/mini");
    bootstrap_step(root, "repository check", node, list_of(mini, "check"), root);
    bootstrap_step(root, "case suite", node, list_of(mini, "test"), root);
    bootstrap_step(root, "Mini unit suite", node, list_of(mini, "test", "--unit"), root);
    bootstrap_step(root, "LSP tests", node, list_of("--test", "test/lang-server.test.ts"), root);
    bootstrap_step(root, "release tests", node, list_of("--test", "test/release.test.ts"), root);
    bootstrap_step(root, "VS Code TypeScript check", "npm", list_of("run", "check"), editor);
    bootstrap_step(root, "VS Code build", "npm", list_of("run", "build"), editor);
    bootstrap_step(root, "VS Code grammar tests", node, list_of("--test", "test/grammar.test.ts"), editor);
    let versions_result = json_parse_file(path_join(root, "config/versions.json"));
    if (result_is_fail(versions_result)) {
        bootstrap_fail(result_get_message(versions_result));
    }
    let versions = result_get_value(versions_result);
    let package_name = (((("mini-" + $mini_map_get(versions, "group")) + "-v") + $mini_map_get(versions, "vscode")) + ".vsix");
    let output_directory = path_join(root, "dist/rebuild");
    $mini_directory_create(output_directory);
    let package_path = path_join(output_directory, package_name);
    let vsce = path_join(editor, "node_modules/@vscode/vsce/vsce");
    bootstrap_step(root, "VS Code VSIX package", node, list_of(vsce, "package", "--no-dependencies", "--allow-missing-repository", "--skip-license", "--out", package_path), editor);
    io_write_line(("Clean rebuild and full project checks passed. VSIX: dist/rebuild/" + package_name));
    return 0;
}
function bootstrap_all(root) {

    let work = $mini_path_temp_directory();
    let source = path_join(root, "tools/compiler.mini");
    let first = path_join(work, "compiler1.js");
    let second = path_join(work, "compiler2.js");
    (writeFileSync(first, bootstrap_compile_text(source), "utf8"), 0);
    bootstrap_executable(root, first);
    bootstrap_compile_with(root, first, source, second);
    if (($mini_hash_sha256($mini_file_read_bytes(first)) !== $mini_hash_sha256($mini_file_read_bytes(second)))) {
        bootstrap_fail("compiler fixed point mismatch");
    }
    let seed = path_join(root, "dist/compile.js");
    $mini_path_copy(first, seed);
    bootstrap_executable(root, seed);
    let build = path_join(root, "dist/build.js");
    bootstrap_compile_with(root, seed, path_join(root, "tools/build.mini"), build);
    bootstrap_executable(root, build);
    bootstrap_run(root, build);
    $mini_path_remove(work);
    io_write_line("bootstrap complete");
    return 0;
}
function main(args) {

    if (((args).length === 0)) {
        return bootstrap_all(project_root());
    }
    if ((((args).length === 1) && ($mini_list_get(args, 0) === "--clean"))) {
        return bootstrap_clean_all(project_root());
    }
    (writeSync(2, "usage: ./bin/bootstrap [--clean]\n"), 0);
    return 1;
}
