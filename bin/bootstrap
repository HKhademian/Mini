function directory_create(path) { process.getBuiltinModule("node:fs").mkdirSync(path, { recursive: true }); return 0; }
function directory_list(path) { const fs = process.getBuiltinModule("node:fs"); try { return fs.readdirSync(path).sort(); } catch { return []; } }
function path_copy(from, to) { process.getBuiltinModule("node:fs").cpSync(from, to, { recursive: true, force: true, dereference: true }); return 0; }
function path_is_directory(path) { const fs = process.getBuiltinModule("node:fs"); try { return fs.statSync(path).isDirectory(); } catch { return false; } }
