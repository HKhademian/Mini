function panic(message) {

    (writeSync(2, (message + "\n")), 0);
    (process.exit(1), 0);
    return 0;
}
function value_is_text(value) {

    return ($mini_value_kind(value) === "text");
}
function value_is_number(value) {

    return ($mini_value_kind(value) === "number");
}
function value_is_boolean(value) {

    return ($mini_value_kind(value) === "boolean");
}
function value_is_list(value) {

    return ($mini_value_kind(value) === "list");
}
function value_is_map(value) {

    return ($mini_value_kind(value) === "map");
}
function list_new() { return []; }
function list_get(items, index) {
    if (!Array.isArray(items) || !Number.isInteger(index)) return 0;
    if (index < 0) index = items.length + index;
    return index >= 0 && index < items.length && index in items ? items[index] : 0;
}
function list_length(items) { return Array.isArray(items) ? items.length : 0; }
function list_set(items, index, value) {
    if (!Array.isArray(items) || !Number.isInteger(index)) return 0;
    if (index < 0) index = items.length + index;
    if (index >= 0) items[index] = value;
    return 0;
}
function list_truncate(items, length) {
    if (Array.isArray(items) && Number.isInteger(length) && length >= 0 && length < items.length) items.length = length;
    return 0;
}
function list_copy(items) { return Array.isArray(items) ? items.slice() : []; }
function list_join(items, separator) {
    if (!Array.isArray(items) || typeof separator !== "string") return "";
    let output = "";
    for (let index = 0; index < items.length; index++) {
        if (index > 0) output += separator;
        const value = items[index];
        if (typeof value === "string") output += value;
    }
    return output;
}
function list_has_text(items, value) {

    let position = 0;
    while ((position < list_length(items))) {
        if ((list_get(items, position) === value)) {
            return true;
        }
        position = (position + 1);
    }
    return false;
}
function list_join_from(items, start, separator) {

    let parts = list_new();
    let position = start;
    while ((position < list_length(items))) {
        list_set(parts, list_length(parts), list_get(items, position));
        position = (position + 1);
    }
    return list_join(parts, separator);
}
function list_reverse(items) {

    let result = list_new();
    let position = (list_length(items) - 1);
    while ((position >= 0)) {
        list_set(result, list_length(result), list_get(items, position));
        position = (position - 1);
    }
    return result;
}
function list_sorted(items) {

    let result = list_copy(items);
    let position = 0;
    while ((position < list_length(result))) {
        let cursor = (position + 1);
        while ((cursor < list_length(result))) {
            if ((list_get(result, cursor) < list_get(result, position))) {
                let hold = list_get(result, position);
                list_set(result, position, list_get(result, cursor));
                list_set(result, cursor, hold);
            }
            cursor = (cursor + 1);
        }
        position = (position + 1);
    }
    return result;
}
function list_contains(items, value) {

    let position = 0;
    while ((position < list_length(items))) {
        if ((list_get(items, position) === value)) {
            return true;
        }
        position = (position + 1);
    }
    return false;
}
function list_is_text(value) {

    if ((!value_is_list(value))) {
        return false;
    }
    let position = 0;
    while ((position < list_length(value))) {
        if (($mini_value_kind(list_get(value, position)) !== "text")) {
            return false;
        }
        position = (position + 1);
    }
    return true;
}
function list_push_back(items, value) {

    if (value_is_list(items)) {
        list_set(items, list_length(items), value);
    }
    return 0;
}
function list_push_front(items, value) {

    if ((!value_is_list(items))) {
        return 0;
    }
    let position = list_length(items);
    while ((position > 0)) {
        list_set(items, position, list_get(items, (position - 1)));
        position = (position - 1);
    }
    list_set(items, 0, value);
    return 0;
}
function list_pop_back(items) {

    if (((!value_is_list(items)) || (list_length(items) === 0))) {
        return 0;
    }
    let length = list_length(items);
    let value = list_get(items, (length - 1));
    list_truncate(items, (length - 1));
    return value;
}
function list_pop_front(items) {

    if (((!value_is_list(items)) || (list_length(items) === 0))) {
        return 0;
    }
    let length = list_length(items);
    let value = list_get(items, 0);
    let position = 0;
    while ((position < (length - 1))) {
        list_set(items, position, list_get(items, (position + 1)));
        position = (position + 1);
    }
    list_truncate(items, (length - 1));
    return value;
}
function list_of() {
    const $mini_fn_args = Array.prototype.slice.call(arguments);

    return $mini_fn_args;
}
function list_rest(items, count) {

    let result = list_new();
    let position = count;
    while ((position < list_length(items))) {
        list_set(result, list_length(result), list_get(items, position));
        position = (position + 1);
    }
    return result;
}
function number_add(a, b) {
    if (typeof a !== "number" || typeof b !== "number") return 0;
    return a + b;
}
function number_sub(a, b) {

    if (((!value_is_number(a)) || (!value_is_number(b)))) {
        return 0;
    }
    return (a - b);
}
function number_min(a, b) {

    if (((!value_is_number(a)) || (!value_is_number(b)))) {
        return 0;
    }
    if ((a < b)) {
        return a;
    }
    return b;
}
function number_max(a, b) {

    if (((!value_is_number(a)) || (!value_is_number(b)))) {
        return 0;
    }
    if ((a > b)) {
        return a;
    }
    return b;
}
function split_lines(source) {

    let lines = $mini_text_split(source, "\n");
    let position = 0;
    while ((position < (list_length(lines) - 1))) {
        let line = list_get(lines, position);
        if ((((line).length > 0) && ($mini_text_get(line, ((line).length - 1)) === "\r"))) {
            list_set(lines, position, text_slice(line, 0, ((line).length - 1)));
        }
        position = (position + 1);
    }
    return lines;
}
function text_slice(source, start, end) {
    if (typeof source !== "string" || !Number.isInteger(start) || !Number.isInteger(end)) return "";
    if (start < 0) start = source.length + start;
    if (end < 0) end = source.length + end;
    if (start < 0) start = 0;
    if (end < 0) end = 0;
    if (start > source.length) start = source.length;
    if (end > source.length) end = source.length;
    if (end <= start) return "";
    return source.slice(start, end);
}
function indent_output(output) {

    let lines = split_lines(output);
    let result = list_new();
    let position = 0;
    while ((position < list_length(lines))) {
        let line = list_get(lines, position);
        if (((line).length > 0)) {
            list_set(result, list_length(result), ("    " + line));
        }
        position = (position + 1);
    }
    return list_join(result, "\n");
}
function text_ends_with(source, suffix) {

    let size = (suffix).length;
    let length = (source).length;
    if ((size > length)) {
        return false;
    }
    return (text_slice(source, (length - size), length) === suffix);
}
function is_letter(character) {

    return ($mini_text_find("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz_", character) >= 0);
}
function is_digit(character) {

    return ($mini_text_find("0123456789", character) >= 0);
}
function is_identifier_part(character) {

    return (is_letter(character) || is_digit(character));
}
function is_two_character_symbol(value) {

    return (((((((value === "==") || (value === "!=")) || (value === "<=")) || (value === ">=")) || (value === "&&")) || (value === "||")) || (value === ":="));
}
function text_starts_with(source, prefix) {

    let size = (prefix).length;
    if ((size > (source).length)) {
        return false;
    }
    return (text_slice(source, 0, size) === prefix);
}
function text_chomp(text) {

    let length = (text).length;
    while (((length > 0) && (($mini_text_get(text, (length - 1)) === "\n") || ($mini_text_get(text, (length - 1)) === "\r")))) {
        length = (length - 1);
    }
    return text_slice(text, 0, length);
}
function text_trim_end(text) {

    let length = (text).length;
    while ((length > 0)) {
        let character = $mini_text_get(text, (length - 1));
        if ((((character === " ") || (character === "\t")) || (character === "\r"))) {
            length = (length - 1);
        } else {
            return text_slice(text, 0, length);
        }
    }
    return "";
}
function text_trim(text) {

    let start = 0;
    let end = (text).length;
    while (((start < end) && ($mini_text_find(" \t\r\n", $mini_text_get(text, start)) >= 0))) {
        start = (start + 1);
    }
    while (((end > start) && ($mini_text_find(" \t\r\n", $mini_text_get(text, (end - 1))) >= 0))) {
        end = (end - 1);
    }
    return text_slice(text, start, end);
}
function map_new() { return Object.create(null); }
function map_get(items, key) {
    if (items === null || typeof items !== "object" || Array.isArray(items)) return 0;
    return Object.prototype.hasOwnProperty.call(items, key) ? items[key] : 0;
}
function map_set(items, key, value) {
    if (items !== null && typeof items === "object" && !Array.isArray(items) && typeof key === "string") items[key] = value;
    return 0;
}
function map_has(items, key) {
    return items !== null && typeof items === "object" && !Array.isArray(items) && typeof key === "string" && Object.prototype.hasOwnProperty.call(items, key);
}
function map_keys(items) {
    if (items === null || typeof items !== "object" || Array.isArray(items)) return [];
    return Object.keys(items);
}
function map_delete(items, key) {
    if (items !== null && typeof items === "object" && !Array.isArray(items) && typeof key === "string") delete items[key];
    return 0;
}
function map_copy(items) {
    if (items === null || typeof items !== "object" || Array.isArray(items)) return Object.create(null);
    return Object.assign(Object.create(null), items);
}
function map_of() {
    const $mini_fn_args = Array.prototype.slice.call(arguments);

    let entries = $mini_fn_args;
    let result = map_new();
    let position = 0;
    while ((position < list_length(entries))) {
        let key = list_get(entries, position);
        let value = 0;
        if (((position + 1) < list_length(entries))) {
            value = list_get(entries, (position + 1));
        }
        map_set(result, key, value);
        position = (position + 2);
    }
    return result;
}
function path_join(left, right) {

    if ((left === "")) {
        return right;
    }
    if ((right === "")) {
        return left;
    }
    if ((text_ends_with(left, "/") || text_ends_with(left, "\\"))) {
        return (left + right);
    }
    return ((left + "/") + right);
}
function path_temp_file() {

    let path = path_join($mini_path_temp_directory(), "file");
    (writeFileSync(path, "", "utf8"), 0);
    return path;
}
function file_remove(path) {

    if ((((path !== "") && $mini_path_is_exists(path)) && (!$mini_path_is_directory(path)))) {
        return $mini_path_remove(path);
    }
    return 0;
}
function directory_remove(path) {

    if ((((path !== "") && $mini_path_is_directory(path)) && (list_length($mini_directory_list(path)) === 0))) {
        return $mini_path_remove(path);
    }
    return 0;
}
function path_parent(path) {

    let position = ((path).length - 1);
    while ((position >= 0)) {
        let character = $mini_text_get(path, position);
        if (((character === "/") || (character === "\\"))) {
            return text_slice(path, 0, position);
        }
        position = (position - 1);
    }
    return "";
}
function path_basename(path) {

    let position = ((path).length - 1);
    while ((position >= 0)) {
        let character = $mini_text_get(path, position);
        if (((character === "/") || (character === "\\"))) {
            return text_slice(path, (position + 1), (path).length);
        }
        position = (position - 1);
    }
    return path;
}
function path_is_absolute(path) {

    if (text_starts_with(path, "/")) {
        return true;
    }
    return ((((path).length > 2) && ($mini_text_get(path, 1) === ":")) && (($mini_text_get(path, 2) === "/") || ($mini_text_get(path, 2) === "\\")));
}
function path_normalize(path) {

    let absolute = text_starts_with(path, "/");
    let parts = $mini_text_split(path, "/");
    let stack = list_new();
    let position = 0;
    while ((position < list_length(parts))) {
        let part = list_get(parts, position);
        if (((part === "") || (part === "."))) {
        } else {
            if ((part === "..")) {
                if (((list_length(stack) > 0) && (list_get(stack, (list_length(stack) - 1)) !== ".."))) {
                    list_set(stack, (list_length(stack) - 1), "");
                    list_set(stack, list_length(stack), "");
                    let kept = list_new();
                    let index = 0;
                    while ((index < list_length(stack))) {
                        if ((list_get(stack, index) !== "")) {
                            list_set(kept, list_length(kept), list_get(stack, index));
                        }
                        index = (index + 1);
                    }
                    stack = kept;
                } else {
                    if ((!absolute)) {
                        list_set(stack, list_length(stack), part);
                    }
                }
            } else {
                list_set(stack, list_length(stack), part);
            }
        }
        position = (position + 1);
    }
    let output = list_join(stack, "/");
    if (absolute) {
        return ("/" + output);
    }
    return output;
}
function path_resolve(base, path) {

    if (path_is_absolute(path)) {
        return path_normalize(path);
    }
    return path_normalize(path_join(base, path));
}
function token_new(kind, text, source, start, end, line, column, context) {

    let token = map_new();
    map_set(token, "kind", kind);
    map_set(token, "text", text);
    map_set(token, "source", source);
    map_set(token, "start", start);
    map_set(token, "end", end);
    map_set(token, "line", line);
    map_set(token, "column", column);
    map_set(token, "context", context);
    return token;
}
function lex_advance(state) {

    let source = map_get(state, "text");
    let position = map_get(state, "position");
    let value = $mini_text_get(source, position);
    map_set(state, "position", (position + 1));
    if ((value === "\n")) {
        map_set(state, "line", (map_get(state, "line") + 1));
        map_set(state, "column", 1);
    } else {
        map_set(state, "column", (map_get(state, "column") + 1));
    }
    return value;
}
function lex_start(state) {

    let lines = map_get(state, "lines");
    let token = token_new("symbol", "", map_get(state, "source"), map_get(state, "position"), map_get(state, "position"), map_get(state, "line"), map_get(state, "column"), list_get(lines, (map_get(state, "line") - 1)));
    return token;
}
function diagnostic_indent(token) {

    let context = map_get(token, "context");
    let column = map_get(token, "column");
    let indent = "";
    let position = 0;
    while (((position < (column - 1)) && (position < (context).length))) {
        if (($mini_text_get(context, position) === "\t")) {
            indent = (indent + "\t");
        } else {
            indent = (indent + " ");
        }
        position = (position + 1);
    }
    return indent;
}
function diagnostic_text(token, label) {

    let lines = list_of(((((((map_get(token, "source") + ":") + $mini_number_to_text(map_get(token, "line"))) + ":") + $mini_number_to_text(map_get(token, "column"))) + ": ") + label), map_get(token, "context"), (diagnostic_indent(token) + "^"), "");
    return list_join(lines, "\n");
}
function diagnostic_fail(token, message) {

    (writeSync(2, diagnostic_text(token, message)), 0);
    (process.exit(1), 0);
    return 0;
}
function diagnostic_warn(token, message) {

    (writeSync(2, diagnostic_text(token, ("warning: " + message))), 0);
    return 0;
}
function lex_fail(token, message) {

    return diagnostic_fail(token, message);
}
function lex_comment(state, source, include_comments) {

    let comment_token = lex_start(state);
    while ((((map_get(state, "position") < (source).length) && ($mini_text_get(source, map_get(state, "position")) !== "\r")) && ($mini_text_get(source, map_get(state, "position")) !== "\n"))) {
        lex_advance(state);
    }
    if (include_comments) {
        map_set(comment_token, "kind", "comment");
        map_set(comment_token, "text", text_slice(source, map_get(comment_token, "start"), map_get(state, "position")));
        map_set(comment_token, "end", map_get(state, "position"));
        let comment_tokens = map_get(state, "tokens");
        list_set(comment_tokens, list_length(comment_tokens), comment_token);
    }
    return 0;
}
function lex_word(state, source, token) {

    map_set(token, "kind", "identifier");
    while (((map_get(state, "position") < (source).length) && is_identifier_part($mini_text_get(source, map_get(state, "position"))))) {
        lex_advance(state);
    }
    let spelling = text_slice(source, map_get(token, "start"), map_get(state, "position"));
    if ((((((((spelling === "fn") || (spelling === "return")) || (spelling === "if")) || (spelling === "else")) || (spelling === "while")) || (spelling === "true")) || (spelling === "false"))) {
        map_set(token, "kind", "keyword");
    }
    return 0;
}
function lex_digits(state, source, token) {

    map_set(token, "kind", "number");
    while (((map_get(state, "position") < (source).length) && is_digit($mini_text_get(source, map_get(state, "position"))))) {
        lex_advance(state);
    }
    return 0;
}
function lex_text(state, source, token) {

    map_set(token, "kind", "text");
    lex_advance(state);
    while (((map_get(state, "position") < (source).length) && ($mini_text_get(source, map_get(state, "position")) !== "\""))) {
        let inner = $mini_text_get(source, map_get(state, "position"));
        if (((inner === "\n") || (inner === "\r"))) {
            lex_fail(token, "unterminated text");
        }
        if ((inner === "\\")) {
            let escape = lex_start(state);
            lex_advance(state);
            if (((map_get(state, "position") === (source).length) || ($mini_text_find("\"\\nrt", $mini_text_get(source, map_get(state, "position"))) < 0))) {
                lex_fail(escape, "unknown text escape");
            }
        }
        lex_advance(state);
    }
    if ((map_get(state, "position") === (source).length)) {
        lex_fail(token, "unterminated text");
    }
    lex_advance(state);
    return 0;
}
function lex_tokenize(source, source_name, include_comments) {

    let state = map_new();
    map_set(state, "text", source);
    map_set(state, "source", source_name);
    map_set(state, "tokens", list_new());
    map_set(state, "lines", split_lines(source));
    map_set(state, "position", 0);
    map_set(state, "line", 1);
    map_set(state, "column", 1);
    if (((((source).length >= 2) && ($mini_text_get(source, 0) === "#")) && ($mini_text_get(source, 1) === "!"))) {
        let shebang_token = lex_start(state);
        map_set(shebang_token, "kind", "shebang");
        while ((((map_get(state, "position") < (source).length) && ($mini_text_get(source, map_get(state, "position")) !== "\r")) && ($mini_text_get(source, map_get(state, "position")) !== "\n"))) {
            lex_advance(state);
        }
        map_set(shebang_token, "text", text_slice(source, map_get(shebang_token, "start"), map_get(state, "position")));
        map_set(shebang_token, "end", map_get(state, "position"));
        let initial_tokens = map_get(state, "tokens");
        list_set(initial_tokens, list_length(initial_tokens), shebang_token);
    }
    while ((map_get(state, "position") < (source).length)) {
        let character = $mini_text_get(source, map_get(state, "position"));
        if (($mini_text_find(" \t\r\n", character) >= 0)) {
            lex_advance(state);
        } else if (((character === "/") && ($mini_text_get(source, (map_get(state, "position") + 1)) === "/"))) {
            lex_comment(state, source, include_comments);
        } else {
            let token = lex_start(state);
            if (is_letter(character)) {
                lex_word(state, source, token);
            } else if (is_digit(character)) {
                lex_digits(state, source, token);
            } else if ((character === "\"")) {
                lex_text(state, source, token);
            } else if (is_two_character_symbol(text_slice(source, map_get(state, "position"), (map_get(state, "position") + 2)))) {
                lex_advance(state);
                lex_advance(state);
            } else if (($mini_text_find("=+-!<>(),;{}", character) >= 0)) {
                lex_advance(state);
            } else {
                lex_fail(token, ("unexpected character " + $mini_json_to_text(character)));
            }
            map_set(token, "text", text_slice(source, map_get(token, "start"), map_get(state, "position")));
            map_set(token, "end", map_get(state, "position"));
            let tokens = map_get(state, "tokens");
            list_set(tokens, list_length(tokens), token);
        }
    }
    let end_token = lex_start(state);
    map_set(end_token, "kind", "eof");
    let end_tokens = map_get(state, "tokens");
    list_set(end_tokens, list_length(end_tokens), end_token);
    return end_tokens;
}
function lex_resolve_import(base, path) {

    let resolved_path = path;
    if ((!text_ends_with(resolved_path, ".mini"))) {
        resolved_path = (resolved_path + ".mini");
    }
    if (text_starts_with(path, "/")) {
        return path_normalize(resolved_path);
    }
    if ((text_starts_with(path, "./") || text_starts_with(path, "../"))) {
        let directory = path_parent(base);
        if ((directory === "")) {
            return path_normalize(resolved_path);
        }
        return path_normalize(((directory + "/") + resolved_path));
    }
    return path_normalize(("libs/" + resolved_path));
}
function lex_expand_imports(tokens, base, seen) {

    if (map_has(seen, base)) {
        return list_new();
    }
    map_set(seen, base, true);
    let dependencies = list_new();
    let own = list_new();
    let position = 0;
    let depth = 0;
    while ((position < list_length(tokens))) {
        let token = list_get(tokens, position);
        let text = map_get(token, "text");
        if ((text === "{")) {
            depth = (depth + 1);
        }
        if ((text === "}")) {
            depth = (depth - 1);
        }
        let is_import = ((((text === "import") && ((position + 2) < list_length(tokens))) && (map_get(list_get(tokens, (position + 1)), "kind") === "text")) && (map_get(list_get(tokens, (position + 2)), "text") === ";"));
        if ((!is_import)) {
            list_set(own, list_length(own), token);
            position = (position + 1);
        } else {
            if ((depth !== 0)) {
                diagnostic_fail(token, "import must be top-level");
            }
            let quoted = map_get(list_get(tokens, (position + 1)), "text");
            let path = text_slice(quoted, 1, ((quoted).length - 1));
            let resolved = lex_resolve_import(base, path);
            let action = "import";
            if ((!map_has(seen, resolved))) {
                if ((!$mini_path_is_exists(resolved))) {
                    diagnostic_fail(token, ((("cannot " + action) + " ") + path));
                }
                let raw = lex_tokenize(readFileSync(resolved, "utf8"), path, false);
                let imported = list_new();
                let raw_position = 0;
                while ((raw_position < list_length(raw))) {
                    if ((map_get(list_get(raw, raw_position), "kind") !== "eof")) {
                        list_set(imported, list_length(imported), list_get(raw, raw_position));
                    }
                    raw_position = (raw_position + 1);
                }
                if (((list_length(imported) > 0) && (map_get(list_get(imported, 0), "kind") === "shebang"))) {
                    diagnostic_fail(token, "imported file must not have a shebang");
                }
                let expanded = lex_expand_imports(imported, resolved, seen);
                let index = 0;
                while ((index < list_length(expanded))) {
                    list_set(dependencies, list_length(dependencies), list_get(expanded, index));
                    index = (index + 1);
                }
            }
            position = (position + 3);
        }
    }
    let order = 0;
    if (map_has(seen, "$file_count")) {
        order = map_get(seen, "$file_count");
    }
    let index = 0;
    while ((index < list_length(own))) {
        let token = list_get(own, index);
        map_set(token, "file", base);
        map_set(token, "file_order", order);
        index = (index + 1);
    }
    map_set(seen, "$file_count", (order + 1));
    let output = list_new();
    let own_start = 0;
    if (((list_length(own) > 0) && (map_get(list_get(own, 0), "kind") === "shebang"))) {
        list_set(output, list_length(output), list_get(own, 0));
        own_start = 1;
    }
    index = 0;
    while ((index < list_length(dependencies))) {
        list_set(output, list_length(output), list_get(dependencies, index));
        index = (index + 1);
    }
    index = own_start;
    while ((index < list_length(own))) {
        list_set(output, list_length(output), list_get(own, index));
        index = (index + 1);
    }
    return output;
}
function ast_node(kind, token) {

    let node = map_new();
    map_set(node, "node_kind", kind);
    map_set(node, "source", map_get(token, "source"));
    map_set(node, "start", map_get(token, "start"));
    map_set(node, "end", map_get(token, "end"));
    map_set(node, "line", map_get(token, "line"));
    map_set(node, "column", map_get(token, "column"));
    if (map_has(token, "context")) {
        map_set(node, "context", map_get(token, "context"));
    }
    if (map_has(token, "file")) {
        map_set(node, "file", map_get(token, "file"));
    } else {
        map_set(node, "file", map_get(token, "source"));
    }
    if (map_has(token, "file_order")) {
        map_set(node, "file_order", map_get(token, "file_order"));
    }
    return node;
}
function ast_derive(kind, first, value_kind) {

    let node = map_new();
    map_set(node, "node_kind", kind);
    map_set(node, "source", map_get(first, "source"));
    map_set(node, "start", map_get(first, "start"));
    map_set(node, "end", map_get(first, "end"));
    map_set(node, "line", map_get(first, "line"));
    map_set(node, "column", map_get(first, "column"));
    if (map_has(first, "context")) {
        map_set(node, "context", map_get(first, "context"));
    }
    if (map_has(first, "file")) {
        map_set(node, "file", map_get(first, "file"));
    } else {
        map_set(node, "file", map_get(first, "source"));
    }
    if (map_has(first, "file_order")) {
        map_set(node, "file_order", map_get(first, "file_order"));
    }
    map_set(node, "value_kind", value_kind);
    return node;
}
function ast_finish(node, token) {

    map_set(node, "end", map_get(token, "end"));
    return node;
}
function ast_finish_node(node, last) {

    map_set(node, "end", map_get(last, "end"));
    return node;
}
function ast_expression(kind, token, value_kind) {

    let node = ast_node(kind, token);
    map_set(node, "value_kind", value_kind);
    return node;
}
function builtin_add(name, parameters, result, layer, import_name, helper_key, helper, reference, emit_form) {

    list_set(builtin_names_list, list_length(builtin_names_list), name);
    map_set(builtin_name_set, name, true);
    map_set(builtin_parameter_kinds, name, parameters);
    map_set(builtin_result_kinds, name, result);
    map_set(builtin_import_names, name, import_name);
    map_set(builtin_helper_keys, name, helper_key);
    map_set(builtin_classes, name, layer);
    map_set(builtin_emit_forms, name, emit_form);
    if ((helper_key !== "")) {
        map_set(builtin_helpers, helper_key, helper);
        if ((!list_contains(builtin_helper_order, helper_key))) {
            list_set(builtin_helper_order, list_length(builtin_helper_order), helper_key);
        }
    }
    if ((reference !== "")) {
        map_set(builtin_reference_targets, name, reference);
    }
    return 0;
}
function builtin_source_api(name) {

    map_set(builtin_source_functions, name, true);
    return 0;
}
function builtin_names() {

    return list_copy(builtin_names_list);
}
function builtin_exists(name) {

    return map_has(builtin_name_set, name);
}
function builtin_source_required(name) {

    return map_has(builtin_source_functions, name);
}
function builtin_parameters(name) {

    if ((!map_has(builtin_parameter_kinds, name))) {
        return list_new();
    }
    let kinds = map_get(builtin_parameter_kinds, name);
    if ((kinds === "")) {
        return list_new();
    }
    return $mini_text_split(kinds, ",");
}
function builtin_result(name) {

    if (map_has(builtin_result_kinds, name)) {
        return map_get(builtin_result_kinds, name);
    }
    return "unknown";
}
function builtin_imports(name) {

    if ((!map_has(builtin_import_names, name))) {
        return list_new();
    }
    let imports = map_get(builtin_import_names, name);
    if ((imports === "")) {
        return list_new();
    }
    return $mini_text_split(imports, ",");
}
function builtin_class(name) {

    if (map_has(builtin_classes, name)) {
        return map_get(builtin_classes, name);
    }
    return "library";
}
function builtin_reference_target(name) {

    if (map_has(builtin_reference_targets, name)) {
        return map_get(builtin_reference_targets, name);
    }
    return "";
}
function builtin_helper_key(name) {

    if (map_has(builtin_helper_keys, name)) {
        return map_get(builtin_helper_keys, name);
    }
    return "";
}
function builtin_helper_order_keys() {

    return list_copy(builtin_helper_order);
}
function builtin_used_helper_blocks(helpers) {

    let order = builtin_helper_order;
    let parts = list_new();
    let position = 0;
    while ((position < list_length(order))) {
        let key = list_get(order, position);
        if (map_has(helpers, key)) {
            list_set(parts, list_length(parts), builtin_helper_text(key));
        }
        position = (position + 1);
    }
    return list_join(parts, "");
}
function builtin_helper_text(key) {

    if (map_has(builtin_helpers, key)) {
        return map_get(builtin_helpers, key);
    }
    return "";
}
function builtin_replace(source, needle, replacement) {

    let parts = list_new();
    let position = 0;
    while ((position < (source).length)) {
        let rest = text_slice(source, position, (source).length);
        let found = $mini_text_find(rest, needle);
        if ((found < 0)) {
            list_set(parts, list_length(parts), text_slice(source, position, (source).length));
            return list_join(parts, "");
        }
        list_set(parts, list_length(parts), text_slice(source, position, (position + found)));
        list_set(parts, list_length(parts), replacement);
        position = ((position + found) + (needle).length);
    }
    return list_join(parts, "");
}
function builtin_apply(form, args) {

    let output = form;
    if (($mini_text_find(output, "{...}") >= 0)) {
        output = builtin_replace(output, "{...}", list_join(args, ", "));
    }
    let position = 0;
    while ((position < list_length(args))) {
        output = builtin_replace(output, (("{" + $mini_number_to_text(position)) + "}"), list_get(args, position));
        position = (position + 1);
    }
    return output;
}
function builtin_emit(name, args) {

    let reference_target = builtin_reference_target(name);
    if ((reference_mode && (reference_target !== ""))) {
        return (((reference_target + "(") + list_join(args, ", ")) + ")");
    }
    if ((!map_has(builtin_emit_forms, name))) {
        return "";
    }
    return builtin_apply(map_get(builtin_emit_forms, name), args);
}
function parser_fail(token, message) {

    return diagnostic_fail(token, message);
}
function parser_binary_expression(kind, left, operator, right) {

    let node = ast_derive(AST_BINARY, left, kind);
    map_set(node, "operator", map_get(operator, "text"));
    map_set(node, "left", left);
    map_set(node, "right", right);
    ast_finish_node(node, right);
    return node;
}
function parser_token(parser) {

    return list_get(map_get(parser, "tokens"), map_get(parser, "position"));
}
function parser_peek(parser, offset) {

    return list_get(map_get(parser, "tokens"), (map_get(parser, "position") + offset));
}
function parser_take(parser) {

    let token = parser_token(parser);
    map_set(parser, "position", (map_get(parser, "position") + 1));
    return token;
}
function parser_expect(parser, text) {

    if ((map_get(parser_token(parser), "text") !== text)) {
        parser_fail(parser_token(parser), ("expected " + text));
    }
    parser_take(parser);
    return 0;
}
function parser_identifier(parser, message) {

    if ((map_get(parser_token(parser), "kind") !== "identifier")) {
        parser_fail(parser_token(parser), message);
    }
    return parser_take(parser);
}
function parser_expression(parser) {

    let left = parser_conjunction(parser);
    while ((map_get(parser_token(parser), "text") === "||")) {
        let operator = parser_take(parser);
        let right = parser_conjunction(parser);
        if ((((map_get(left, "value_kind") !== "boolean") && (map_get(left, "value_kind") !== "unknown")) || ((map_get(right, "value_kind") !== "boolean") && (map_get(right, "value_kind") !== "unknown")))) {
            parser_fail(operator, "|| needs booleans");
        }
        left = parser_binary_expression("boolean", left, operator, right);
    }
    return left;
}
function parser_conjunction(parser) {

    let left = parser_equality(parser);
    while ((map_get(parser_token(parser), "text") === "&&")) {
        let operator = parser_take(parser);
        let right = parser_equality(parser);
        if ((((map_get(left, "value_kind") !== "boolean") && (map_get(left, "value_kind") !== "unknown")) || ((map_get(right, "value_kind") !== "boolean") && (map_get(right, "value_kind") !== "unknown")))) {
            parser_fail(operator, "&& needs booleans");
        }
        left = parser_binary_expression("boolean", left, operator, right);
    }
    return left;
}
function parser_equality(parser) {

    let left = parser_comparison(parser);
    while (((map_get(parser_token(parser), "text") === "==") || (map_get(parser_token(parser), "text") === "!="))) {
        let operator = parser_take(parser);
        let right = parser_comparison(parser);
        let left_kind = map_get(left, "value_kind");
        let right_kind = map_get(right, "value_kind");
        if ((((((left_kind === "list") || (right_kind === "list")) || (left_kind === "map")) || (right_kind === "map")) || (((left_kind !== "unknown") && (right_kind !== "unknown")) && (left_kind !== right_kind)))) {
            parser_fail(operator, "equality needs matching scalar kinds");
        }
        left = parser_binary_expression("boolean", left, operator, right);
    }
    return left;
}
function parser_comparison(parser) {

    let left = parser_additive(parser);
    while (((((map_get(parser_token(parser), "text") === "<") || (map_get(parser_token(parser), "text") === "<=")) || (map_get(parser_token(parser), "text") === ">")) || (map_get(parser_token(parser), "text") === ">="))) {
        let operator = parser_take(parser);
        let right = parser_additive(parser);
        if ((((map_get(left, "value_kind") !== "number") && (map_get(left, "value_kind") !== "unknown")) || ((map_get(right, "value_kind") !== "number") && (map_get(right, "value_kind") !== "unknown")))) {
            parser_fail(operator, "comparison needs numbers");
        }
        left = parser_binary_expression("boolean", left, operator, right);
    }
    return left;
}
function parser_additive_kind(kind) {

    return (((kind === "number") || (kind === "text")) || (kind === "unknown"));
}
function parser_additive(parser) {

    let left = parser_unary(parser);
    while (((map_get(parser_token(parser), "text") === "+") || (map_get(parser_token(parser), "text") === "-"))) {
        let operator = parser_take(parser);
        let right = parser_unary(parser);
        let left_kind = map_get(left, "value_kind");
        let right_kind = map_get(right, "value_kind");
        if ((map_get(operator, "text") === "-")) {
            if ((((left_kind !== "number") && (left_kind !== "unknown")) || ((right_kind !== "number") && (right_kind !== "unknown")))) {
                parser_fail(operator, "- needs two numbers");
            }
        } else {
            if ((((!parser_additive_kind(left_kind)) || (!parser_additive_kind(right_kind))) || (((left_kind !== "unknown") && (right_kind !== "unknown")) && (left_kind !== right_kind)))) {
                parser_fail(operator, "+ needs two numbers or two texts");
            }
        }
        let result_kind = left_kind;
        if ((left_kind === "unknown")) {
            result_kind = right_kind;
        }
        left = parser_binary_expression(result_kind, left, operator, right);
    }
    return left;
}
function parser_unary(parser) {

    if ((map_get(parser_token(parser), "text") === "-")) {
        let operator = parser_take(parser);
        let number = parser_token(parser);
        if ((map_get(number, "kind") !== "number")) {
            parser_fail(operator, "- must precede a number literal");
        }
        parser_take(parser);
        let value = ("-" + lex_normalize_number(map_get(number, "text")));
        let node = ast_node(AST_LITERAL, operator);
        map_set(node, "literal_kind", "number");
        map_set(node, "value", value);
        map_set(node, "raw", ("-" + map_get(number, "text")));
        ast_finish(node, number);
        map_set(node, "value_kind", "number");
        return node;
    }
    if ((map_get(parser_token(parser), "text") === "!")) {
        let operator = parser_take(parser);
        let value = parser_unary(parser);
        let kind = "boolean";
        if (((map_get(value, "value_kind") !== kind) && (map_get(value, "value_kind") !== "unknown"))) {
            parser_fail(operator, ((map_get(operator, "text") + " needs a ") + kind));
        }
        let node = ast_node(AST_UNARY, operator);
        map_set(node, "value_kind", kind);
        map_set(node, "operator", map_get(operator, "text"));
        map_set(node, "operand", value);
        ast_finish_node(node, value);
        return node;
    }
    return parser_primary(parser);
}
function lex_normalize_number(text) {

    let position = 0;
    while (((position < (text).length) && ($mini_text_get(text, position) === "0"))) {
        position = (position + 1);
    }
    if ((position === (text).length)) {
        return "0";
    }
    return text_slice(text, position, (text).length);
}
function parser_primary(parser) {

    let token = parser_take(parser);
    if ((map_get(token, "text") === "(")) {
        let value = parser_expression(parser);
        let close = parser_token(parser);
        parser_expect(parser, ")");
        let node = ast_node(AST_GROUP, token);
        map_set(node, "expression", value);
        ast_finish(node, close);
        map_set(node, "value_kind", map_get(value, "value_kind"));
        return node;
    }
    if ((map_get(token, "kind") === "number")) {
        let node = ast_expression(AST_LITERAL, token, "number");
        map_set(node, "literal_kind", "number");
        map_set(node, "raw", map_get(token, "text"));
        map_set(node, "value", lex_normalize_number(map_get(token, "text")));
        return node;
    }
    if ((map_get(token, "kind") === "text")) {
        let node = ast_expression(AST_LITERAL, token, "text");
        map_set(node, "literal_kind", "text");
        map_set(node, "raw", map_get(token, "text"));
        map_set(node, "value", map_get(token, "text"));
        return node;
    }
    if (((map_get(token, "text") === "true") || (map_get(token, "text") === "false"))) {
        let node = ast_expression(AST_LITERAL, token, "boolean");
        map_set(node, "literal_kind", "boolean");
        map_set(node, "raw", map_get(token, "text"));
        map_set(node, "value", (map_get(token, "text") === "true"));
        return node;
    }
    if (((map_get(token, "kind") === "identifier") && (map_get(token, "text") === "fn_args"))) {
        return parser_fn_args(parser, token);
    }
    if (((map_get(token, "kind") === "identifier") && (map_get(parser_token(parser), "text") === "("))) {
        return parser_call(parser, token);
    }
    if (((map_get(token, "kind") === "identifier") && map_has(map_get(parser, "variables"), map_get(token, "text")))) {
        let value_kind = map_get(map_get(parser, "variables"), map_get(token, "text"));
        let node = ast_expression(AST_NAME, token, value_kind);
        map_set(node, "name", map_get(token, "text"));
        return node;
    }
    parser_fail(token, "expected expression");
    let node = ast_expression(AST_LITERAL, token, "unknown");
    map_set(node, "value", "");
    return node;
}
function parser_fn_args(parser, token) {

    parser_expect(parser, "(");
    let close = parser_token(parser);
    parser_expect(parser, ")");
    if ((!map_get(parser, "in_function"))) {
        let node = ast_expression(AST_FN_ARGS, token, "list");
        map_set(node, "captures", false);
        ast_finish(node, close);
        return node;
    }
    map_set(map_get(parser, "current"), "captures", true);
    let node = ast_expression(AST_FN_ARGS, token, "list");
    map_set(node, "captures", true);
    ast_finish(node, close);
    return node;
}
function parser_call_node(name, args, result_kind, is_builtin, close) {

    let node = ast_node(AST_CALL, name);
    map_set(node, "callee", map_get(name, "text"));
    map_set(node, "is_builtin", is_builtin);
    map_set(node, "value_kind", result_kind);
    let argument_nodes = list_new();
    let position = 0;
    while ((position < list_length(args))) {
        list_set(argument_nodes, list_length(argument_nodes), list_get(args, position));
        position = (position + 1);
    }
    map_set(node, "arguments", argument_nodes);
    ast_finish(node, close);
    return node;
}
function parser_call(parser, name) {

    let name_text = map_get(name, "text");
    let has_builtin_contract = builtin_exists(name_text);
    let source_required = builtin_source_required(name_text);
    let is_builtin = (has_builtin_contract && (!source_required));
    let functions = map_get(parser, "functions");
    let has_user = map_has(functions, name_text);
    if ((((!is_builtin) && (!has_user)) || (source_required && (!has_user)))) {
        parser_fail(name, ("unknown function " + name_text));
    }
    parser_expect(parser, "(");
    let args = list_new();
    if ((map_get(parser_token(parser), "text") !== ")")) {
        list_set(args, list_length(args), parser_expression(parser));
        while ((map_get(parser_token(parser), "text") === ",")) {
            parser_take(parser);
            list_set(args, list_length(args), parser_expression(parser));
        }
    }
    let close = parser_token(parser);
    parser_expect(parser, ")");
    if (has_builtin_contract) {
        let arity = list_length(builtin_parameters(name_text));
        let variadic = ((arity > 0) && (text_slice(list_get(builtin_parameters(name_text), (arity - 1)), 0, 3) === "..."));
        let fixed_arity = arity;
        if (variadic) {
            fixed_arity = (arity - 1);
        }
        if ((((!variadic) && (list_length(args) !== arity)) || (variadic && (list_length(args) < fixed_arity)))) {
            let suffix = "s";
            if (((variadic && (fixed_arity === 1)) || ((!variadic) && (arity === 1)))) {
                suffix = "";
            }
            let message = ((("expected " + $mini_number_to_text(arity)) + " argument") + suffix);
            if (variadic) {
                message = ((("expected " + $mini_number_to_text(fixed_arity)) + " or more argument") + suffix);
            }
            parser_fail(name, message);
        }
    } else if ((!has_builtin_contract)) {
        let arity = map_get(map_get(functions, name_text), "arity");
        while ((list_length(args) < arity)) {
            let zero = ast_expression(AST_LITERAL, name, "number");
            map_set(zero, "literal_kind", "number");
            map_set(zero, "raw", "0");
            map_set(zero, "value", "0");
            map_set(zero, "synthetic", true);
            list_set(args, list_length(args), zero);
        }
    }
    let parameters = builtin_parameters(name_text);
    let position = 0;
    while (((position < list_length(parameters)) && has_builtin_contract)) {
        let kind = list_get(parameters, position);
        if ((text_slice(kind, 0, 3) !== "...")) {
            let actual = map_get(list_get(args, position), "value_kind");
            if (((((kind !== "unknown") && (kind !== "any_value")) && (actual !== "unknown")) && (actual !== kind))) {
                parser_fail(name, (("expected " + kind) + " argument"));
            }
        }
        position = (position + 1);
    }
    if (source_required) {
        return parser_call_node(name, args, builtin_result(name_text), false, close);
    }
    if ((!is_builtin)) {
        let result_kind = map_get(map_get(functions, name_text), "result");
        return parser_call_node(name, args, result_kind, false, close);
    }
    let result_kind = builtin_result(name_text);
    return parser_call_node(name, args, result_kind, is_builtin, close);
}
function parser_statement(parser) {

    if ((map_get(parser_token(parser), "text") === "while")) {
        let token = parser_take(parser);
        let while_condition = parser_condition(parser);
        let body = parser_block(parser);
        let node = ast_node(AST_WHILE, token);
        map_set(node, "condition", while_condition);
        map_set(node, "body", body);
        ast_finish_node(node, body);
        return node;
    }
    if ((map_get(parser_token(parser), "text") === "if")) {
        let token = parser_take(parser);
        let if_condition = parser_condition(parser);
        let consequent = parser_block(parser);
        let alternate = 0;
        if ((map_get(parser_token(parser), "text") === "else")) {
            parser_take(parser);
            if ((map_get(parser_token(parser), "text") === "if")) {
                alternate = parser_statement(parser);
                let node = ast_node(AST_IF, token);
                map_set(node, "condition", if_condition);
                map_set(node, "consequent", consequent);
                map_set(node, "alternate", alternate);
                ast_finish_node(node, alternate);
                return node;
            }
            alternate = parser_block(parser);
        }
        let node = ast_node(AST_IF, token);
        map_set(node, "condition", if_condition);
        map_set(node, "consequent", consequent);
        if ((alternate !== 0)) {
            map_set(node, "alternate", alternate);
            ast_finish_node(node, alternate);
        } else {
            ast_finish_node(node, consequent);
        }
        return node;
    }
    if ((map_get(parser_token(parser), "text") === "fn")) {
        return parser_function_declaration(parser);
    }
    if ((map_get(parser_token(parser), "text") === "return")) {
        let return_token = parser_take(parser);
        if ((!map_get(parser, "in_function"))) {
            parser_fail(return_token, "return outside function");
        }
        let return_value = parser_expression(parser);
        let semicolon = parser_token(parser);
        parser_expect(parser, ";");
        map_set(map_get(parser, "current"), "result", map_get(return_value, "value_kind"));
        let node = ast_node(AST_RETURN, return_token);
        map_set(node, "value", return_value);
        ast_finish(node, semicolon);
        return node;
    }
    if (((map_get(parser_token(parser), "kind") === "identifier") && (map_get(parser_peek(parser, 1), "text") === "("))) {
        let call_value = parser_expression(parser);
        let semicolon = parser_token(parser);
        parser_expect(parser, ";");
        let node = ast_node(AST_CALL_STATEMENT, call_value);
        map_set(node, "expression", call_value);
        ast_finish(node, semicolon);
        return node;
    }
    let variables = map_get(parser, "variables");
    let statement_name = parser_identifier(parser, "expected binding name");
    if ((map_get(parser_token(parser), "text") === ":=")) {
        parser_take(parser);
        if (map_has(map_get(parser, "declared"), map_get(statement_name, "text"))) {
            parser_fail(statement_name, ("duplicate binding " + map_get(statement_name, "text")));
        }
        let declaration_value = parser_expression(parser);
        let semicolon = parser_token(parser);
        parser_expect(parser, ";");
        let value_kind = map_get(declaration_value, "value_kind");
        map_set(variables, map_get(statement_name, "text"), value_kind);
        map_set(map_get(parser, "declared"), map_get(statement_name, "text"), true);
        let top_level = ((map_get(parser, "depth") === 0) && (!map_get(parser, "in_function")));
        let node = ast_node(AST_BINDING, statement_name);
        map_set(node, "name", map_get(statement_name, "text"));
        map_set(node, "value_kind", value_kind);
        map_set(node, "initializer", declaration_value);
        map_set(node, "top_level", top_level);
        ast_finish(node, semicolon);
        return node;
    }
    if ((!map_has(variables, map_get(statement_name, "text")))) {
        parser_fail(statement_name, ("unknown binding " + map_get(statement_name, "text")));
    }
    parser_expect(parser, "=");
    let assignment_value = parser_expression(parser);
    let semicolon = parser_token(parser);
    parser_expect(parser, ";");
    let value_kind = map_get(assignment_value, "value_kind");
    map_set(variables, map_get(statement_name, "text"), value_kind);
    let node = ast_node(AST_ASSIGNMENT, statement_name);
    map_set(node, "name", map_get(statement_name, "text"));
    map_set(node, "value_kind", value_kind);
    map_set(node, "value", assignment_value);
    ast_finish(node, semicolon);
    return node;
}
function parser_condition_parenthesized(parser) {

    let tokens = map_get(parser, "tokens");
    let position = map_get(parser, "position");
    if ((map_get(list_get(tokens, position), "text") !== "(")) {
        return false;
    }
    let depth = 0;
    while ((position < list_length(tokens))) {
        let text = map_get(list_get(tokens, position), "text");
        if ((text === "(")) {
            depth = (depth + 1);
        }
        if ((text === ")")) {
            depth = (depth - 1);
            if ((depth === 0)) {
                return (map_get(list_get(tokens, (position + 1)), "text") === "{");
            }
        }
        position = (position + 1);
    }
    return false;
}
function parser_condition(parser) {

    let start = parser_token(parser);
    if ((map_get(parser, "warn") && parser_condition_parenthesized(parser))) {
        diagnostic_warn(start, "unnecessary condition parentheses");
    }
    let condition = parser_expression(parser);
    if (((map_get(condition, "value_kind") !== "boolean") && (map_get(condition, "value_kind") !== "unknown"))) {
        parser_fail(start, "condition must be boolean");
    }
    return condition;
}
function parser_block(parser) {

    let open = parser_token(parser);
    parser_expect(parser, "{");
    let outer = map_get(parser, "variables");
    let outer_declared = map_get(parser, "declared");
    map_set(parser, "variables", map_copy(outer));
    map_set(parser, "declared", map_new());
    map_set(parser, "depth", (map_get(parser, "depth") + 1));
    let last_statement = 0;
    let statements = list_new();
    while (((map_get(parser_token(parser), "text") !== "}") && (map_get(parser_token(parser), "kind") !== "eof"))) {
        let statement = parser_statement(parser);
        last_statement = statement;
        list_set(statements, list_length(statements), statement);
    }
    let close = parser_token(parser);
    parser_expect(parser, "}");
    if ((map_get(parser, "depth") === 1)) {
        map_set(parser, "block_ends_with_return", ((last_statement !== 0) && (map_get(last_statement, "node_kind") === AST_RETURN)));
    }
    map_set(parser, "depth", (map_get(parser, "depth") - 1));
    map_set(parser, "variables", outer);
    map_set(parser, "declared", outer_declared);
    let node = ast_node(AST_BLOCK, open);
    map_set(node, "statements", statements);
    map_set(node, "ends_with_return", ((last_statement !== 0) && (map_get(last_statement, "node_kind") === AST_RETURN)));
    ast_finish(node, close);
    return node;
}
function parser_function_declaration(parser) {

    let token = parser_take(parser);
    if ((map_get(parser, "depth") !== 0)) {
        parser_fail(token, "functions must be top-level");
    }
    let name = parser_identifier(parser, "expected function name");
    parser_expect(parser, "(");
    let parameters = list_new();
    let parameter_nodes = list_new();
    if ((map_get(parser_token(parser), "text") !== ")")) {
        let first_parameter = parser_identifier(parser, "expected parameter name");
        list_set(parameters, list_length(parameters), map_get(first_parameter, "text"));
        let first_node = ast_node(AST_NAME, first_parameter);
        map_set(first_node, "name", map_get(first_parameter, "text"));
        map_set(first_node, "role", "parameter");
        list_set(parameter_nodes, list_length(parameter_nodes), first_node);
        while ((map_get(parser_token(parser), "text") === ",")) {
            parser_take(parser);
            let next_parameter = parser_identifier(parser, "expected parameter name");
            list_set(parameters, list_length(parameters), map_get(next_parameter, "text"));
            let next_node = ast_node(AST_NAME, next_parameter);
            map_set(next_node, "name", map_get(next_parameter, "text"));
            map_set(next_node, "role", "parameter");
            list_set(parameter_nodes, list_length(parameter_nodes), next_node);
        }
    }
    parser_expect(parser, ")");
    let info = map_get(map_get(parser, "functions"), map_get(name, "text"));
    map_set(parser, "current", info);
    map_set(parser, "in_function", true);
    let outer = map_get(parser, "variables");
    map_set(parser, "variables", map_copy(outer));
    let position = 0;
    while ((position < list_length(parameters))) {
        map_set(map_get(parser, "variables"), list_get(parameters, position), "unknown");
        position = (position + 1);
    }
    map_set(parser, "block_ends_with_return", false);
    let body = parser_block(parser);
    map_set(parser, "variables", outer);
    map_set(parser, "in_function", false);
    let node = ast_node(AST_FUNCTION, token);
    map_set(node, "name", map_get(name, "text"));
    map_set(node, "parameters", parameter_nodes);
    map_set(node, "body", body);
    map_set(node, "captures_arguments", map_get(info, "captures"));
    map_set(node, "result_kind", map_get(info, "result"));
    map_set(node, "has_final_return", map_get(body, "ends_with_return"));
    ast_finish_node(node, body);
    return node;
}
function parser_file_key(token) {

    if (map_has(token, "file")) {
        return map_get(token, "file");
    }
    return map_get(token, "source");
}
function parser_file_register(order, priorities, token) {

    let file = parser_file_key(token);
    if ((!map_has(priorities, file))) {
        let priority = 0;
        if (map_has(token, "file_order")) {
            priority = map_get(token, "file_order");
        }
        let index = list_length(order);
        while (((index > 0) && (map_get(priorities, list_get(order, (index - 1))) > priority))) {
            list_set(order, index, list_get(order, (index - 1)));
            index = (index - 1);
        }
        list_set(order, index, file);
        map_set(priorities, file, priority);
    }
    return file;
}
function parser_program(parser) {

    let has_shebang = false;
    if ((map_get(parser_token(parser), "kind") === "shebang")) {
        parser_take(parser);
        has_shebang = true;
    }
    let order = list_new();
    let priorities = map_new();
    let ast_body = list_new();
    let tokens = map_get(parser, "tokens");
    let main_source = map_get(list_get(tokens, (list_length(tokens) - 1)), "source");
    while ((map_get(parser_token(parser), "kind") !== "eof")) {
        let token = parser_token(parser);
        let statement = parser_statement(parser);
        list_set(ast_body, list_length(ast_body), statement);
        parser_file_register(order, priorities, token);
    }
    let program = ast_node(AST_PROGRAM, list_get(tokens, 0));
    map_set(program, "ast_schema_version", AST_SCHEMA_VERSION);
    map_set(program, "body", ast_body);
    map_set(program, "files", order);
    map_set(program, "main_source", main_source);
    map_set(program, "has_shebang", has_shebang);
    map_set(program, "tokens", tokens);
    ast_finish(program, list_get(tokens, (list_length(tokens) - 1)));
    return program;
}
function parser_new(tokens) {

    let parser = map_new();
    map_set(parser, "tokens", tokens);
    map_set(parser, "position", 0);
    map_set(parser, "variables", map_new());
    map_set(parser, "functions", map_new());
    map_set(parser, "declared", map_new());
    map_set(parser, "warn", true);
    map_set(parser, "depth", 0);
    map_set(parser, "in_function", false);
    map_set(parser, "current", map_new());
    let depth = 0;
    let index = 0;
    while ((index < list_length(tokens))) {
        let token = list_get(tokens, index);
        if ((map_get(token, "text") === "{")) {
            depth = (depth + 1);
        }
        if ((map_get(token, "text") === "}")) {
            depth = (depth - 1);
        }
        if ((((depth === 0) && (map_get(token, "kind") === "identifier")) && (map_get(list_get(tokens, (index + 1)), "text") === ":="))) {
            map_set(map_get(parser, "variables"), map_get(token, "text"), "unknown");
        }
        if ((((depth === 0) && (map_get(token, "text") === "fn")) && (map_get(list_get(tokens, (index + 1)), "kind") === "identifier"))) {
            let arity = 0;
            let cursor = (index + 3);
            while ((((cursor < list_length(tokens)) && (map_get(list_get(tokens, cursor), "text") !== ")")) && (map_get(list_get(tokens, cursor), "text") !== "{"))) {
                if ((map_get(list_get(tokens, cursor), "kind") === "identifier")) {
                    arity = (arity + 1);
                }
                cursor = (cursor + 1);
            }
            let info = map_new();
            map_set(info, "arity", arity);
            map_set(info, "result", "unknown");
            map_set(info, "captures", false);
            map_set(map_get(parser, "functions"), map_get(list_get(tokens, (index + 1)), "text"), info);
        }
        index = (index + 1);
    }
    return parser;
}
function parser_ast(tokens) {

    return parser_program(parser_new(tokens));
}
function parser_ast_quiet(tokens) {

    let parser = parser_new(tokens);
    map_set(parser, "warn", false);
    return parser_program(parser);
}
function emit_js_host_function_add(name, definition, keep_reference) {

    let entry = map_new();
    map_set(entry, "definition", definition);
    map_set(entry, "keep_reference", keep_reference);
    map_set(js_host_functions, name, entry);
    return 0;
}
function emit_js_host_function(name) {

    if ((!map_has(js_host_functions, name))) {
        return "";
    }
    let entry = map_get(js_host_functions, name);
    if ((reference_mode && (!map_get(entry, "keep_reference")))) {
        return "";
    }
    return map_get(entry, "definition");
}
function emit_js_operator(operator) {

    if ((operator === "==")) {
        return "===";
    }
    if ((operator === "!=")) {
        return "!==";
    }
    return operator;
}
function emit_js_expression(node) {

    let kind = map_get(node, "node_kind");
    if ((kind === AST_LITERAL)) {
        let literal_kind = map_get(node, "literal_kind");
        if ((literal_kind === "boolean")) {
            if (map_get(node, "value")) {
                return "true";
            }
            return "false";
        }
        let value = map_get(node, "value");
        if (((literal_kind === "number") && text_starts_with(value, "-"))) {
            return (("(" + value) + ")");
        }
        return value;
    }
    if ((kind === AST_NAME)) {
        return map_get(node, "name");
    }
    if ((kind === AST_GROUP)) {
        return emit_js_expression(map_get(node, "expression"));
    }
    if ((kind === AST_FN_ARGS)) {
        if (map_get(node, "captures")) {
            return "$mini_fn_args";
        }
        return "process.argv.slice(2)";
    }
    if ((kind === AST_UNARY)) {
        return ((("(" + map_get(node, "operator")) + emit_js_expression(map_get(node, "operand"))) + ")");
    }
    if ((kind === AST_BINARY)) {
        return (((((("(" + emit_js_expression(map_get(node, "left"))) + " ") + emit_js_operator(map_get(node, "operator"))) + " ") + emit_js_expression(map_get(node, "right"))) + ")");
    }
    if ((kind === AST_CALL)) {
        let argument_codes = emit_js_arguments(map_get(node, "arguments"));
        let callee = map_get(node, "callee");
        if (map_get(node, "is_builtin")) {
            return builtin_emit(callee, argument_codes);
        }
        return (((callee + "(") + list_join(argument_codes, ", ")) + ")");
    }
    return "";
}
function emit_js_arguments(nodes) {

    let output = list_new();
    let position = 0;
    while ((position < list_length(nodes))) {
        list_set(output, list_length(output), emit_js_expression(list_get(nodes, position)));
        position = (position + 1);
    }
    return output;
}
function emit_js_block(node) {

    let body = emit_js_statements(map_get(node, "statements"));
    let indented = indent_output(body);
    if ((indented === "")) {
        return list_join(list_of("{", "}"), "\n");
    }
    return list_join(list_of("{", indented, "}"), "\n");
}
function emit_js_function_body(node) {

    let body_node = map_get(node, "body");
    let body = emit_js_block(body_node);
    if ((!map_get(node, "has_final_return"))) {
        body = (text_slice(body, 0, ((body).length - 1)) + "    return 0;\n}");
    }
    let capture = "";
    if (map_get(node, "captures_arguments")) {
        capture = "    const $mini_fn_args = Array.prototype.slice.call(arguments);\n";
    }
    return (("{\n" + capture) + text_slice(body, 1, (body).length));
}
function emit_js_function(node) {

    let name = map_get(node, "name");
    let host_override = emit_js_host_function(name);
    if ((host_override !== "")) {
        return host_override;
    }
    let parameters = list_new();
    let nodes = map_get(node, "parameters");
    let position = 0;
    while ((position < list_length(nodes))) {
        list_set(parameters, list_length(parameters), map_get(list_get(nodes, position), "name"));
        position = (position + 1);
    }
    return (((((("function " + map_get(node, "name")) + "(") + list_join(parameters, ", ")) + ") ") + emit_js_function_body(node)) + "\n");
}
function emit_js_statement(node) {

    let kind = map_get(node, "node_kind");
    if ((kind === AST_FUNCTION)) {
        return emit_js_function(node);
    }
    if ((kind === AST_BLOCK)) {
        return emit_js_block(node);
    }
    if ((kind === AST_RETURN)) {
        return (("return " + emit_js_expression(map_get(node, "value"))) + ";\n");
    }
    if ((kind === AST_CALL_STATEMENT)) {
        return (emit_js_expression(map_get(node, "expression")) + ";\n");
    }
    if ((kind === AST_BINDING)) {
        if (map_get(node, "top_level")) {
            return (((map_get(node, "name") + " = ") + emit_js_expression(map_get(node, "initializer"))) + ";\n");
        }
        return (((("let " + map_get(node, "name")) + " = ") + emit_js_expression(map_get(node, "initializer"))) + ";\n");
    }
    if ((kind === AST_ASSIGNMENT)) {
        return (((map_get(node, "name") + " = ") + emit_js_expression(map_get(node, "value"))) + ";\n");
    }
    if ((kind === AST_IF)) {
        let output = ((("if (" + emit_js_expression(map_get(node, "condition"))) + ") ") + emit_js_block(map_get(node, "consequent")));
        let alternate = map_get(node, "alternate");
        if ((alternate !== 0)) {
            if ((map_get(alternate, "node_kind") === AST_IF)) {
                return ((output + " else ") + emit_js_statement(alternate));
            }
            output = ((output + " else ") + emit_js_block(alternate));
        }
        return (output + "\n");
    }
    if ((kind === AST_WHILE)) {
        return (((("while (" + emit_js_expression(map_get(node, "condition"))) + ") ") + emit_js_block(map_get(node, "body"))) + "\n");
    }
    return "";
}
function emit_js_statements(nodes) {

    let parts = list_new();
    let position = 0;
    while ((position < list_length(nodes))) {
        list_set(parts, list_length(parts), emit_js_statement(list_get(nodes, position)));
        position = (position + 1);
    }
    return list_join(parts, "");
}
function emit_js_collect_helpers(node, imports, helpers) {

    let kind = map_get(node, "node_kind");
    if (((kind === AST_CALL) && map_get(node, "is_builtin"))) {
        let name = map_get(node, "callee");
        let required_imports = builtin_imports(name);
        let position = 0;
        while ((position < list_length(required_imports))) {
            map_set(imports, list_get(required_imports, position), true);
            position = (position + 1);
        }
        let helper = builtin_helper_key(name);
        if ((helper !== "")) {
            map_set(helpers, helper, true);
        }
        if (((name === "io_write") || (name === "to_text"))) {
            map_set(helpers, builtin_helper_key("number_to_text"), true);
            map_set(helpers, builtin_helper_key("json_to_text"), true);
        }
        if ((name === "io_write")) {
            map_set(helpers, builtin_helper_key("to_text"), true);
        }
        if ((name === "json_to_text")) {
            map_set(helpers, builtin_helper_key("number_to_text"), true);
        }
    }
    if (((kind === AST_PROGRAM) || (kind === AST_BLOCK))) {
        let nodes = map_get(node, "body");
        if ((kind === AST_BLOCK)) {
            nodes = map_get(node, "statements");
        }
        let position = 0;
        while ((position < list_length(nodes))) {
            emit_js_collect_helpers(list_get(nodes, position), imports, helpers);
            position = (position + 1);
        }
    } else if ((kind === AST_FUNCTION)) {
        emit_js_collect_helpers(map_get(node, "body"), imports, helpers);
    } else if ((kind === AST_IF)) {
        emit_js_collect_helpers(map_get(node, "condition"), imports, helpers);
        emit_js_collect_helpers(map_get(node, "consequent"), imports, helpers);
        let alternate = map_get(node, "alternate");
        if ((alternate !== 0)) {
            emit_js_collect_helpers(alternate, imports, helpers);
        }
    } else if ((kind === AST_WHILE)) {
        emit_js_collect_helpers(map_get(node, "condition"), imports, helpers);
        emit_js_collect_helpers(map_get(node, "body"), imports, helpers);
    } else if ((kind === AST_RETURN)) {
        emit_js_collect_helpers(map_get(node, "value"), imports, helpers);
    } else if ((kind === AST_CALL_STATEMENT)) {
        emit_js_collect_helpers(map_get(node, "expression"), imports, helpers);
    } else if ((kind === AST_BINDING)) {
        emit_js_collect_helpers(map_get(node, "initializer"), imports, helpers);
    } else if ((kind === AST_ASSIGNMENT)) {
        emit_js_collect_helpers(map_get(node, "value"), imports, helpers);
    } else if ((kind === AST_CALL)) {
        let argument_nodes = map_get(node, "arguments");
        let position = 0;
        while ((position < list_length(argument_nodes))) {
            emit_js_collect_helpers(list_get(argument_nodes, position), imports, helpers);
            position = (position + 1);
        }
    } else if ((kind === AST_BINARY)) {
        emit_js_collect_helpers(map_get(node, "left"), imports, helpers);
        emit_js_collect_helpers(map_get(node, "right"), imports, helpers);
    } else if ((kind === AST_UNARY)) {
        emit_js_collect_helpers(map_get(node, "operand"), imports, helpers);
    } else if ((kind === AST_GROUP)) {
        emit_js_collect_helpers(map_get(node, "expression"), imports, helpers);
    }
    return 0;
}
function emit_js_import_names(imports) {

    let output = "";
    if (map_has(imports, "readFileSync")) {
        output = (output + "readFileSync");
    }
    if (map_has(imports, "writeFileSync")) {
        if ((output !== "")) {
            output = (output + ", ");
        }
        output = (output + "writeFileSync");
    }
    if (map_has(imports, "writeSync")) {
        if ((output !== "")) {
            output = (output + ", ");
        }
        output = (output + "writeSync");
    }
    return output;
}
function emit_js_file_body(nodes, file) {

    let parts = list_new();
    let position = 0;
    while ((position < list_length(nodes))) {
        let node = list_get(nodes, position);
        if (((map_get(node, "file") === file) && (map_get(node, "node_kind") !== AST_FUNCTION))) {
            list_set(parts, list_length(parts), emit_js_statement(node));
        }
        position = (position + 1);
    }
    return list_join(parts, "");
}
function emit_js_file_initializers(program) {

    let wrappers = list_new();
    let calls = list_new();
    let files = map_get(program, "files");
    let body = map_get(program, "body");
    let index = 0;
    while ((index < list_length(files))) {
        let name = ("$mini_file_" + $mini_number_to_text(index));
        let code = emit_js_file_body(body, list_get(files, index));
        let wrapper_lines = list_of((("function " + name) + "() {"), indent_output(code), "}", "");
        list_set(wrappers, list_length(wrappers), list_join(wrapper_lines, "\n"));
        list_set(calls, list_length(calls), (("    " + name) + "();"));
        index = (index + 1);
    }
    if ((list_length(files) > 0)) {
        let main_lines = list_of("function $mini_main() {", list_join(calls, "\n"), "}", "$mini_main();", "");
        list_set(wrappers, list_length(wrappers), list_join(main_lines, "\n"));
    }
    return list_join(wrappers, "");
}
function emit_js_program_only(program) {

    let output = list_new();
    let body = map_get(program, "body");
    let main_source = map_get(program, "main_source");
    let position = 0;
    while ((position < list_length(body))) {
        let node = list_get(body, position);
        if ((map_get(node, "source") === main_source)) {
            if (((map_get(node, "node_kind") === AST_BINDING) && map_get(node, "top_level"))) {
                list_set(output, list_length(output), (((("let " + map_get(node, "name")) + " = ") + emit_js_expression(map_get(node, "initializer"))) + ";\n"));
            } else {
                list_set(output, list_length(output), emit_js_statement(node));
            }
        }
        position = (position + 1);
    }
    return list_join(output, "");
}
function emit_js_program(program) {

    let imports = map_new();
    let helpers = map_new();
    let body = map_get(program, "body");
    let position = 0;
    let globals = list_new();
    let declarations = list_new();
    while ((position < list_length(body))) {
        let node = list_get(body, position);
        emit_js_collect_helpers(node, imports, helpers);
        if ((map_get(node, "node_kind") === AST_FUNCTION)) {
            list_set(declarations, list_length(declarations), emit_js_function(node));
        } else if (((map_get(node, "node_kind") === AST_BINDING) && map_get(node, "top_level"))) {
            list_set(globals, list_length(globals), (("let " + map_get(node, "name")) + ";\n"));
        }
        position = (position + 1);
    }
    let import_text = "";
    if ((list_length(map_keys(imports)) > 0)) {
        import_text = (("import { " + emit_js_import_names(imports)) + " } from \"node:fs\";\n");
    }
    let helper_text = builtin_used_helper_blocks(helpers);
    let shebang = "";
    if (map_get(program, "has_shebang")) {
        shebang = "#!/usr/bin/env node\n";
    }
    return list_join(list_of(shebang, "\"use strict\";\n", import_text, helper_text, list_join(globals, ""), list_join(declarations, ""), emit_js_file_initializers(program)), "");
}
function emit_js_compile(tokens) {

    return emit_js_program(parser_ast(tokens));
}
function emit_js_compile_program_only(tokens) {

    return emit_js_program_only(parser_ast(tokens));
}
function emit_js_compile_quiet(tokens) {

    return emit_js_program(parser_ast_quiet(tokens));
}
function io_write_line() {
    const $mini_fn_args = Array.prototype.slice.call(arguments);

    let values = $mini_fn_args;
    let position = 0;
    while ((position < list_length(values))) {
        $mini_io_write(list_get(values, position));
        position = (position + 1);
    }
    return $mini_io_write("\n");
}
function process_capture(command, args, directory, input) {

    let options = map_new();
    map_set(options, "command", command);
    map_set(options, "arguments", args);
    map_set(options, "directory", directory);
    map_set(options, "input", input);
    map_set(options, "timeout", 30000);
    return $mini_process_spawn(options);
}
function result_ok(value, message) {

    let result = map_new();
    map_set(result, "ok", true);
    map_set(result, "value", value);
    map_set(result, "message", message);
    return result;
}
function result_fail(message) {

    let result = map_new();
    map_set(result, "ok", false);
    map_set(result, "value", 0);
    map_set(result, "message", message);
    return result;
}
function result_is_ok(result) {

    if ((!value_is_map(result))) {
        return false;
    }
    return (map_get(result, "ok") === true);
}
function result_is_fail(result) {

    return (!result_is_ok(result));
}
function result_get_message(result) {

    if ((!value_is_map(result))) {
        return "";
    }
    return map_get(result, "message");
}
function result_set_message(result, message) {

    if (value_is_map(result)) {
        map_set(result, "message", message);
    }
    return result;
}
function result_get_value(result) {

    if ((!value_is_map(result))) {
        return 0;
    }
    return map_get(result, "value");
}
function result_set_value(result, value) {

    if (value_is_map(result)) {
        map_set(result, "value", value);
    }
    return result;
}
function json_parse_file(path) {

    if ((!$mini_path_is_exists(path))) {
        return result_fail(("cannot read " + path));
    }
    let parsed = $mini_json_parse(readFileSync(path, "utf8"));
    if (result_is_fail(parsed)) {
        return result_fail(("invalid JSON: " + path));
    }
    return result_ok(result_get_value(parsed), 0);
}
function project_root() {

    let script = process.argv[1];
    let base = path_parent(path_parent(script));
    if ((path_basename(base) === "dist")) {
        return path_parent(base);
    }
    return base;
}
function project_compiler_entry(root) {

    let parsed = json_parse_file(path_join(root, "config/compiler.json"));
    if (result_is_fail(parsed)) {
        return "";
    }
    return map_get(result_get_value(parsed), "entry");
}
function bootstrap_fail(message) {

    (writeSync(2, (message + "\n")), 0);
    (process.exit(1), 0);
    return 0;
}
function bootstrap_compile_text(source) {

    let tokens = lex_tokenize(readFileSync(source, "utf8"), path_basename(source), false);
    let expanded = lex_expand_imports(tokens, source, map_new());
    return emit_js_compile(expanded);
}
function bootstrap_compile_with(root, compiler, source, output) {

    let args = list_of(compiler, source, output);
    let result = process_capture(process.execPath, args, root, list_new());
    if ((map_get(result, "status") !== 0)) {
        bootstrap_fail(("compile failed: " + $mini_text_from_bytes(map_get(result, "stderr"))));
    }
    return 0;
}
function bootstrap_run(root, path) {

    let args = list_new();
    list_set(args, 0, path);
    let result = process_capture(process.execPath, args, root, list_new());
    if ((map_get(result, "status") !== 0)) {
        bootstrap_fail(("run failed: " + $mini_text_from_bytes(map_get(result, "stderr"))));
    }
    return 0;
}
function bootstrap_executable(root, path) {

    let args = list_of("755", path);
    process_capture("chmod", args, root, list_new());
    return 0;
}
function bootstrap_step(root, label, command, args, directory) {

    let options = map_new();
    map_set(options, "command", command);
    map_set(options, "arguments", args);
    map_set(options, "directory", directory);
    map_set(options, "mode", "inherit");
    let result = $mini_process_spawn(options);
    if ((map_get(result, "status") !== 0)) {
        bootstrap_fail((label + " failed"));
    }
    return 0;
}
function bootstrap_clean_generated(root) {

    bootstrap_step(root, "remove untracked and ignored project files", "git", list_of("clean", "-ffdx"), root);
    return 0;
}
function bootstrap_clean_all(root) {

    io_write_line("Removing all untracked and ignored project files...");
    bootstrap_clean_generated(root);
    bootstrap_step(root, "root npm ci", "npm", list_of("ci"), root);
    let editor = path_join(root, "editors/vscode");
    bootstrap_step(root, "VS Code npm ci", "npm", list_of("ci"), editor);
    bootstrap_all(root);
    let node = process.execPath;
    let mini = path_join(root, "bin/mini");
    bootstrap_step(root, "repository check", node, list_of(mini, "check"), root);
    bootstrap_step(root, "case suite", node, list_of(mini, "test"), root);
    bootstrap_step(root, "Mini unit suite", node, list_of(mini, "test", "--unit"), root);
    bootstrap_step(root, "LSP tests", node, list_of("--test", "test/lang-server.test.ts"), root);
    bootstrap_step(root, "release tests", node, list_of("--test", "test/release.test.ts"), root);
    bootstrap_step(root, "VS Code TypeScript check", "npm", list_of("run", "check"), editor);
    bootstrap_step(root, "VS Code build", "npm", list_of("run", "build"), editor);
    bootstrap_step(root, "VS Code grammar tests", node, list_of("--test", "test/grammar.test.ts"), editor);
    let versions_result = json_parse_file(path_join(root, "config/versions.json"));
    if (result_is_fail(versions_result)) {
        bootstrap_fail(result_get_message(versions_result));
    }
    let versions = result_get_value(versions_result);
    let package_name = (((("mini-" + map_get(versions, "group")) + "-v") + map_get(versions, "vscode")) + ".vsix");
    let output_directory = path_join(root, "dist/rebuild");
    $mini_directory_create(output_directory);
    let package_path = path_join(output_directory, package_name);
    let vsce = path_join(editor, "node_modules/@vscode/vsce/vsce");
    bootstrap_step(root, "VS Code VSIX package", node, list_of(vsce, "package", "--no-dependencies", "--allow-missing-repository", "--skip-license", "--out", package_path), editor);
    io_write_line(("Clean rebuild and full project checks passed. VSIX: dist/rebuild/" + package_name));
    return 0;
}
function bootstrap_all(root) {

    let work = $mini_path_temp_directory();
    let source = path_join(root, "tools/compiler.mini");
    let first = path_join(work, "compiler1.js");
    let second = path_join(work, "compiler2.js");
    (writeFileSync(first, bootstrap_compile_text(source), "utf8"), 0);
    bootstrap_executable(root, first);
    bootstrap_compile_with(root, first, source, second);
    if (($mini_hash_sha256($mini_file_read_bytes(first)) !== $mini_hash_sha256($mini_file_read_bytes(second)))) {
        bootstrap_fail("compiler fixed point mismatch");
    }
    let seed = path_join(root, "dist/compile.js");
    $mini_path_copy(first, seed);
    bootstrap_executable(root, seed);
    let build = path_join(root, "dist/build.js");
    bootstrap_compile_with(root, seed, path_join(root, "tools/build.mini"), build);
    bootstrap_executable(root, build);
    bootstrap_run(root, build);
    $mini_path_remove(work);
    io_write_line("bootstrap complete");
    return 0;
}
function main(args) {

    if ((list_length(args) === 0)) {
        return bootstrap_all(project_root());
    }
    if (((list_length(args) === 1) && (list_get(args, 0) === "--clean"))) {
        return bootstrap_clean_all(project_root());
    }
    (writeSync(2, "usage: ./bin/bootstrap [--clean]\n"), 0);
    return 1;
}
