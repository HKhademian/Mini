function builtin_replace(source, needle, replacement) {
    let output = "";
    let position = 0;
    while ((position < (source).length)) {
        let rest = $mini_text_slice(source, position, (source).length);
        let found = $mini_text_find(rest, needle);
        if ((found < 0)) {
            return (output + $mini_text_slice(source, position, (source).length));
        }
        output = ((output + $mini_text_slice(source, position, (position + found))) + replacement);
        position = ((position + found) + (needle).length);
    }
    return output;
    return 0;
}
function builtin_apply(form, args) {
    let output = form;
    let position = 0;
    while ((position < (args).length)) {
        output = builtin_replace(output, (("{" + $mini_number_to_text(position)) + "}"), $mini_list_get(args, position));
        position = (position + 1);
    }
    return output;
    return 0;
}
function builtin_emit(name, args) {
    let reference_target = builtin_reference_target(name);
    if ((reference_mode && (reference_target !== ""))) {
        return (((reference_target + "(") + $mini_list_to_text(args, ", ")) + ")");
    }
    if ((!$mini_map_has(builtin_emit_forms, name))) {
        return "";
    }
    return builtin_apply($mini_map_get(builtin_emit_forms, name), args);
    return 0;
}
function path_join(left, right) {
    if ((left === "")) {
        return right;
    }
    if ((right === "")) {
        return left;
    }
    if ((text_ends_with(left, "/") || text_ends_with(left, "\\"))) {
        return (left + right);
    }
    return ((left + "/") + right);
    return 0;
}
function path_parent(path) {
    let position = ((path).length - 1);
    while ((position >= 0)) {
        let character = $mini_text_get(path, position);
        if (((character === "/") || (character === "\\"))) {
            return $mini_text_slice(path, 0, position);
        }
        position = (position - 1);
    }
    return "";
    return 0;
}
function path_basename(path) {
    let position = ((path).length - 1);
    while ((position >= 0)) {
        let character = $mini_text_get(path, position);
        if (((character === "/") || (character === "\\"))) {
            return $mini_text_slice(path, (position + 1), (path).length);
        }
        position = (position - 1);
    }
    return path;
    return 0;
}
function path_is_absolute(path) {
    if (text_starts_with(path, "/")) {
        return true;
    }
    return ((((path).length > 2) && ($mini_text_get(path, 1) === ":")) && (($mini_text_get(path, 2) === "/") || ($mini_text_get(path, 2) === "\\")));
    return 0;
}
function path_normalize(path) {
    let absolute = text_starts_with(path, "/");
    let parts = $mini_text_split(path, "/");
    let stack = [];
    let position = 0;
    while ((position < (parts).length)) {
        let part = $mini_list_get(parts, position);
        if (((part === "") || (part === "."))) {
        } else {
            if ((part === "..")) {
                if ((((stack).length > 0) && ($mini_list_get(stack, ((stack).length - 1)) !== ".."))) {
                    $mini_list_set(stack, ((stack).length - 1), "");
                    $mini_list_set(stack, (stack).length, "");
                    let kept = [];
                    let index = 0;
                    while ((index < (stack).length)) {
                        if (($mini_list_get(stack, index) !== "")) {
                            $mini_list_set(kept, (kept).length, $mini_list_get(stack, index));
                        }
                        index = (index + 1);
                    }
                    stack = kept;
                } else {
                    if ((!absolute)) {
                        $mini_list_set(stack, (stack).length, part);
                    }
                }
            } else {
                $mini_list_set(stack, (stack).length, part);
            }
        }
        position = (position + 1);
    }
    let output = $mini_list_to_text(stack, "/");
    if (absolute) {
        return ("/" + output);
    }
    return output;
    return 0;
}
function path_resolve(base, path) {
    if (path_is_absolute(path)) {
        return path_normalize(path);
    }
    return path_normalize(path_join(base, path));
    return 0;
}
function process_capture(command, args, directory, input) {
    let options = ({ __proto__: $mini_map_proto });
    $mini_map_set(options, "command", command);
    $mini_map_set(options, "arguments", args);
    $mini_map_set(options, "directory", directory);
    $mini_map_set(options, "input", input);
    $mini_map_set(options, "timeout", 30000);
    return $mini_process_spawn(options);
    return 0;
}
function result_ok(value, message) {
    let result = ({ __proto__: $mini_map_proto });
    $mini_map_set(result, "ok", true);
    $mini_map_set(result, "value", value);
    $mini_map_set(result, "message", message);
    return result;
    return 0;
}
function result_fail(message) {
    let result = ({ __proto__: $mini_map_proto });
    $mini_map_set(result, "ok", false);
    $mini_map_set(result, "value", 0);
    $mini_map_set(result, "message", message);
    return result;
    return 0;
}
function result_is_ok(result) {
    if ((!value_is_map(result))) {
        return false;
    }
    return ($mini_map_get(result, "ok") === true);
    return 0;
}
function result_is_fail(result) {
    return (!result_is_ok(result));
    return 0;
}
function result_get_message(result) {
    if ((!value_is_map(result))) {
        return "";
    }
    return $mini_map_get(result, "message");
    return 0;
}
function result_set_message(result, message) {
    if (value_is_map(result)) {
        $mini_map_set(result, "message", message);
    }
    return result;
    return 0;
}
function result_get_value(result) {
    if ((!value_is_map(result))) {
        return 0;
    }
    return $mini_map_get(result, "value");
    return 0;
}
function result_set_value(result, value) {
    if (value_is_map(result)) {
        $mini_map_set(result, "value", value);
    }
    return result;
    return 0;
}
function json_parse_file(path) {
    if ((!$mini_path_is_exists(path))) {
        return result_fail(("cannot read " + path));
    }
    let parsed = $mini_json_parse(readFileSync(path, "utf8"));
    if (result_is_fail(parsed)) {
        return result_fail(("invalid JSON: " + path));
    }
    return result_ok($mini_map_get(parsed, "value"), "");
    return 0;
}
function project_root() {
    let script = process.argv[1];
    let base = path_parent(path_parent(script));
    if ((path_basename(base) === "dist")) {
        return path_parent(base);
    }
    return base;
    return 0;
}
function project_compiler_entry(root) {
    let parsed = json_parse_file(path_join(root, "config/compiler.json"));
    if (result_is_fail(parsed)) {
        result_fail($mini_map_get(parsed, "message"));
        return "";
    }
    return $mini_map_get($mini_map_get(parsed, "value"), "entry");
    return 0;
}
function bootstrap_fail(message) {
    (writeSync(2, (message + "\n")), 0);
    (process.exit(1), 0);
    return 0;
    return 0;
}
function bootstrap_compile_text(source) {
    let tokens = tokenize(readFileSync(source, "utf8"), basename(source), false);
    let expanded = expand_includes(tokens, source, [], ({ __proto__: $mini_map_proto }));
    return compile(expanded);
    return 0;
}
function bootstrap_compile_with(root, compiler, source, output) {
    let args = [];
    $mini_list_set(args, 0, compiler);
    $mini_list_set(args, 1, source);
    $mini_list_set(args, 2, output);
    let result = process_capture(process.execPath, args, root, []);
    if (($mini_map_get(result, "status") !== 0)) {
        bootstrap_fail(("compile failed: " + $mini_text_from_bytes($mini_map_get(result, "stderr"))));
    }
    return 0;
    return 0;
}
function bootstrap_run(root, path) {
    let args = [];
    $mini_list_set(args, 0, path);
    let result = process_capture(process.execPath, args, root, []);
    if (($mini_map_get(result, "status") !== 0)) {
        bootstrap_fail(("run failed: " + $mini_text_from_bytes($mini_map_get(result, "stderr"))));
    }
    return 0;
    return 0;
}
function bootstrap_executable(root, path) {
    let args = [];
    $mini_list_set(args, 0, "755");
    $mini_list_set(args, 1, path);
    process_capture("chmod", args, root, []);
    return 0;
    return 0;
}
function bootstrap_all(root) {
    let work = $mini_path_temp_directory();
    let source = path_join(root, "tools/compiler.mini");
    let first = path_join(work, "compiler1.js");
    let second = path_join(work, "compiler2.js");
    (writeFileSync(first, bootstrap_compile_text(source), "utf8"), 0);
    bootstrap_executable(root, first);
    bootstrap_compile_with(root, first, source, second);
    if (($mini_hash_sha256($mini_file_read_bytes(first)) !== $mini_hash_sha256($mini_file_read_bytes(second)))) {
        bootstrap_fail("compiler fixed point mismatch");
    }
    let seed = path_join(root, "dist/compile.js");
    $mini_path_copy(first, seed);
    bootstrap_executable(root, seed);
    let build = path_join(root, "dist/build.js");
    bootstrap_compile_with(root, seed, path_join(root, "tools/build.mini"), build);
    bootstrap_executable(root, build);
    bootstrap_run(root, build);
    $mini_path_remove(work);
    (writeSync(1, "bootstrap complete" + "\n"), 0);
    return 0;
    return 0;
}
function main() {
    return bootstrap_all(project_root());
    return 0;
}
main();
