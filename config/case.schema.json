{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mini verification case",
  "type": "object",
  "required": ["id", "kind", "features", "cases"],
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "tool" } } },
      "then": { "required": ["tool"], "properties": { "source": false } },
      "else": { "required": ["source"], "properties": { "tool": false } }
    }
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["tool", "feature", "reject", "compile", "sample", "example"] },
    "source": { "type": "string", "minLength": 1 },
    "tool": { "type": "string", "pattern": "^(mini|minic|mini-[a-z]+)$" },
    "features": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "stdin", "stdout", "stderr", "exitCode"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "args": { "type": "array", "items": { "type": "string" } },
          "stdin": { "$ref": "stream.schema.json" },
          "stdout": { "$ref": "stream.schema.json" },
          "stderr": { "$ref": "stream.schema.json" },
          "artifact": { "$ref": "stream.schema.json" },
          "workspace": { "enum": ["clean", "dirty"] },
          "tag": {
            "type": "object",
            "required": ["name", "annotated"],
            "properties": { "name": { "type": "string" }, "annotated": { "type": "boolean" } },
            "additionalProperties": false
          },
          "files": { "type": "array", "items": { "type": "string" } },
          "exitCode": { "type": "integer", "minimum": 0, "maximum": 255 }
        },
        "additionalProperties": false
      }
    },
    "benchmark": {
      "type": "object",
      "required": ["warmups", "samples"],
      "properties": {
        "warmups": { "type": "integer", "minimum": 0 },
        "samples": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
