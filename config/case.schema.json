{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mini verification case",
  "type": "object",
  "required": ["id", "kind", "source", "features", "cases"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["tool", "feature", "reject", "compile", "sample", "example"] },
    "source": { "type": "string", "minLength": 1 },
    "features": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "stdin", "stdout", "stderr", "exitCode"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "args": { "type": "array", "items": { "type": "string" } },
          "stdin": { "type": "string", "pattern": "\\.json$" },
          "stdout": { "type": "string", "pattern": "\\.json$" },
          "stderr": { "type": "string", "pattern": "\\.json$" },
          "artifact": { "type": "string", "pattern": "\\.json$" },
          "exitCode": { "type": "integer", "minimum": 0, "maximum": 255 }
        },
        "additionalProperties": false
      }
    },
    "benchmark": {
      "type": "object",
      "required": ["warmups", "samples"],
      "properties": {
        "warmups": { "type": "integer", "minimum": 0 },
        "samples": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
