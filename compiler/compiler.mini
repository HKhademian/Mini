// Host adapter text for generated programs; this file is the source of truth.
var map_runtime = "const $mini_map_proto = { __proto__: null };\nfunction $mini_map_get(items, key) {\n    if (items === null || typeof items !== \"object\" || Array.isArray(items)) return 0;\n    const value = items[key];\n    return value !== undefined || key in items ? value : 0;\n}\nfunction $mini_map_has(items, key) {\n    return key in items;\n}\nfunction $mini_map_set(items, key, value) {\n    if (items !== null && typeof items === \"object\" && !Array.isArray(items)) items[key] = value;\n}\n";
var directory_remove_helper = "function $mini_directory_remove(path) {\n    const fs = process.getBuiltinModule(\"node:fs\");\n    if (path !== \"\" && fs.existsSync(path) && fs.statSync(path).isDirectory()) fs.rmdirSync(path);\n}\n";
var file_remove_helper = "function $mini_file_remove(path) {\n    const fs = process.getBuiltinModule(\"node:fs\");\n    if (path !== \"\" && fs.existsSync(path) && !fs.statSync(path).isDirectory()) fs.rmSync(path, { force: true });\n}\n";
var map_copy_helper = "function $mini_map_copy(items) {\n    if (items === null || typeof items !== \"object\" || Array.isArray(items)) return Object.create(null);\n    return Object.assign(Object.create(null), items);\n}\n";
var list_copy_helper = "function $mini_list_copy(items) {\n    if (!Array.isArray(items)) return [];\n    return items.slice();\n}\n";
var list_to_text_helper = "function $mini_list_to_text(items, separator) {\n    if (!Array.isArray(items) || typeof separator !== \"string\") return \"\";\n    let output = \"\";\n    for (let index = 0; index < items.length; index++) {\n        if (index > 0) output += separator;\n        const value = items[index];\n        if (typeof value === \"string\") output += value;\n    }\n    return output;\n}\n";
var list_get_helper = "function $mini_list_get(items, index) {\n    if (!Array.isArray(items)) return 0;\n    if (index < 0) index = items.length + index;\n    if (index >= 0 && index < items.length && index in items) return items[index];\n    return 0;\n}\n";
var list_set_helper = "function $mini_list_set(items, index, value) {\n    if (!Array.isArray(items)) return;\n    if (index < 0) index = items.length + index;\n    if (index >= 0) items[index] = value;\n}\n";
var json_to_text_helper = "function $mini_json_to_text(value) {\n    const seen = new Set();\n    function encode(item) {\n        if (typeof item === \"string\") return JSON.stringify(item);\n        if (typeof item === \"number\") return Number.isSafeInteger(item) ? String(item) : \"null\";\n        if (typeof item === \"boolean\") return item ? \"true\" : \"false\";\n        if (item === null || item === undefined) return \"null\";\n        if (typeof item !== \"object\") return \"null\";\n        if (seen.has(item)) throw 0;\n        seen.add(item);\n        let output;\n        if (Array.isArray(item)) {\n            const parts = [];\n            for (let index = 0; index < item.length; index++) parts.push(index in item ? encode(item[index]) : \"null\");\n            output = \"[\" + parts.join(\",\") + \"]\";\n        } else {\n            const parts = [];\n            for (const key of Object.keys(item).sort()) parts.push(JSON.stringify(key) + \":\" + encode(item[key]));\n            output = \"{\" + parts.join(\",\") + \"}\";\n        }\n        seen.delete(item);\n        return output;\n    }\n    try { return encode(value); } catch { return \"\"; }\n}\n";
var number_to_text_helper = "function $mini_number_to_text(value) {\n    if (typeof value !== \"number\" || !Number.isSafeInteger(value)) return \"\";\n    return String(value);\n}\n";
var process_run_helper = "function $mini_process_run(command, args, mode) {\n    const output = { __proto__: null, status: 1, signal: \"\", stdout: \"\", stderr: \"\", error: \"\" };\n    const child = process.getBuiltinModule(\"node:child_process\");\n    const result = child.spawnSync(command, Array.isArray(args) ? args.map(String) : [], {\n        stdio: mode === \"inherit\" ? \"inherit\" : \"pipe\",\n        encoding: \"utf8\",\n        maxBuffer: 32 * 1024 * 1024,\n    });\n    if (result.error) output.error = String(result.error.message);\n    if (result.status !== null) output.status = result.status;\n    if (typeof result.signal === \"string\") output.signal = result.signal;\n    output.stdout = typeof result.stdout === \"string\" ? result.stdout : \"\";\n    output.stderr = typeof result.stderr === \"string\" ? result.stderr : \"\";\n    return output;\n}\n";
var directory_temp_helper = "function $mini_directory_temp() {\n    const fs = process.getBuiltinModule(\"node:fs\");\n    const os = process.getBuiltinModule(\"node:os\");\n    return fs.mkdtempSync(os.tmpdir() + \"/mini-\");\n}\n";
var text_find_helper = "function $mini_text_find(text, needle) {\n    if (typeof text !== \"string\" || typeof needle !== \"string\") return -1;\n    return text.indexOf(needle);\n}\n";
var text_get_helper = "function $mini_text_get(text, index) {\n    if (typeof text === \"string\" && index >= 0 && index < text.length) return text[index];\n    return \"\";\n}\n";
var text_split_helper = "function $mini_text_split(text, divider) {\n    if (typeof text !== \"string\" || typeof divider !== \"string\") return [];\n    if (divider === \"\") return [text];\n    return text.split(divider);\n}\n";
var text_slice_helper = "function $mini_text_slice(source, start, end) {\n    if (typeof source !== \"string\") return \"\";\n    if (start < 0) start = source.length + start;\n    if (end < 0) end = source.length + end;\n    if (start < 0) start = 0;\n    if (end < 0) end = 0;\n    if (start > source.length) start = source.length;\n    if (end > source.length) end = source.length;\n    if (end <= start) return \"\";\n    return source.slice(start, end);\n}\n";
var json_parse_helper = "function $mini_json_parse(text) {\n    const result = { __proto__: null, ok: false, value: 0 };\n    if (typeof text !== \"string\") return result;\n    let parsed;\n    try { parsed = JSON.parse(text); } catch { return result; }\n    const clean = (item) => {\n        if (item === null) return 0;\n        if (Array.isArray(item)) return item.map(clean);\n        if (typeof item === \"object\") {\n            const out = { __proto__: null };\n            for (const key of Object.keys(item)) out[key] = clean(item[key]);\n            return out;\n        }\n        return item;\n    };\n    result.ok = true;\n    result.value = clean(parsed);\n    return result;\n}\n";
var text_bytes_helper = "function $mini_text_bytes(text) {\n    if (typeof text !== \"string\") return [];\n    return Array.from(Buffer.from(text, \"utf8\"));\n}\n";
var bytes_text_helper = "function $mini_bytes_text(bytes) {\n    if (!Array.isArray(bytes)) return \"\";\n    return Buffer.from(bytes.map(value => typeof value === \"number\" && Number.isInteger(value) ? value & 255 : 0)).toString(\"utf8\");\n}\n";
var file_read_bytes_helper = "function $mini_file_read_bytes(path) {\n    return Array.from(process.getBuiltinModule(\"node:fs\").readFileSync(path));\n}\n";
var file_write_bytes_helper = "function $mini_file_write_bytes(path, bytes) {\n    const values = Array.isArray(bytes) ? bytes.map(value => typeof value === \"number\" && Number.isInteger(value) ? value & 255 : 0) : [];\n    process.getBuiltinModule(\"node:fs\").writeFileSync(path, Buffer.from(values));\n}\n";
/// Return lines split on LF or CRLF, retaining a final empty line.
fn split_lines(source) {
    var lines = text_split(source, "\n");
    var position = 0;
    while (position < list_length(lines) - 1) {
        var line = list_get(lines, position);
        if (text_length(line) > 0 && text_get(line, text_length(line) - 1) == "\r") {
            list_set(lines, position, text_slice(line, 0, text_length(line) - 1));
        }
        position = position + 1;
    }
    return lines;
}

/// Return output lines with nonempty lines prefixed by four spaces and joined by LF.
fn indent_output(output) {
    var lines = split_lines(output);
    var result = "";
    var first = true;
    var position = 0;
    while (position < list_length(lines)) {
        var line = list_get(lines, position);
        if (text_length(line) > 0) {
            if (!first) {
                result = result + "\n";
            }
            result = result + "    " + line;
            first = false;
        }
        position = position + 1;
    }
    return result;
}

/// Return the final path component.
fn basename(path) {
    var position = text_length(path) - 1;
    while (position >= 0) {
        if (text_get(path, position) == "/") {
            return text_slice(path, position + 1, text_length(path));
        }
        position = position - 1;
    }
    return path;
}

/// Return whether text ends with suffix.
fn text_ends_with(source, suffix) {
    var size = text_length(suffix);
    var length = text_length(source);
    if (size > length) {
        return false;
    }
    return text_slice(source, length - size, length) == suffix;
}

/// Return whether character is an ASCII identifier start.
fn is_letter(character) {
    return text_find("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz_", character) >= 0;
}

/// Return whether character is a decimal digit.
fn is_digit(character) {
    return text_find("0123456789", character) >= 0;
}

/// Return whether character continues an identifier.
fn is_identifier_part(character) {
    return is_letter(character) || is_digit(character);
}

/// Return whether value is one of the accepted two-character symbols.
fn is_two_character_symbol(value) {
    return value == "==" || value == "!=" || value == "<=" || value == ">=" || value == "&&" || value == "||";
}

/// Return a token map with the fields used by T0.
fn token_new(kind, text, source, start, end, line, column, context) {
    var token = map_new();
    map_set(token, "kind", kind);
    map_set(token, "text", text);
    map_set(token, "source", source);
    map_set(token, "start", start);
    map_set(token, "end", end);
    map_set(token, "line", line);
    map_set(token, "column", column);
    map_set(token, "context", context);
    return token;
}

/// Advance lexer state and return the consumed character.
fn lex_advance(state) {
    var source = map_get(state, "text");
    var position = map_get(state, "position");
    var value = text_get(source, position);
    map_set(state, "position", position + 1);
    if (value == "\n") {
        map_set(state, "line", map_get(state, "line") + 1);
        map_set(state, "column", 1);
    } else {
        map_set(state, "column", map_get(state, "column") + 1);
    }
    return value;
}

/// Return a token at the current lexer position.
fn lex_start(state) {
    var lines = map_get(state, "lines");
    var token = token_new("symbol", "", map_get(state, "source"), map_get(state, "position"),
        map_get(state, "position"), map_get(state, "line"), map_get(state, "column"),
        list_get(lines, map_get(state, "line") - 1));
    return token;
}

/// Report a positioned diagnostic and stop the compiler.
fn diagnostic_fail(token, message) {
    var context = map_get(token, "context");
    var column = map_get(token, "column");
    var indent = "";
    var position = 0;
    while (position < column - 1 && position < text_length(context)) {
        if (text_get(context, position) == "\t") {
            indent = indent + "\t";
        } else {
            indent = indent + " ";
        }
        position = position + 1;
    }
    write_error(map_get(token, "source") + ":" + number_to_text(map_get(token, "line")) + ":" + number_to_text(column) + ": " + message + "\n" + context + "\n" + indent + "^\n");
    process_exit(1);
    return 0;
}

/// Report a lexer/tokenizer diagnostic.
fn lex_fail(token, message) {
    return diagnostic_fail(token, message);
}

/// Scan text into a token list, matching T0 positions and diagnostics.
fn tokenize(source, source_name, include_comments) {
    var state = map_new();
    map_set(state, "text", source);
    map_set(state, "source", source_name);
    map_set(state, "tokens", list_new());
    map_set(state, "lines", split_lines(source));
    map_set(state, "position", 0);
    map_set(state, "line", 1);
    map_set(state, "column", 1);
    if (text_length(source) >= 2 && text_get(source, 0) == "#" && text_get(source, 1) == "!") {
        var shebang_token = lex_start(state);
        map_set(shebang_token, "kind", "shebang");
        while (map_get(state, "position") < text_length(source)
            && text_get(source, map_get(state, "position")) != "\r"
            && text_get(source, map_get(state, "position")) != "\n") {
            lex_advance(state);
        }
        map_set(shebang_token, "text", text_slice(source, map_get(shebang_token, "start"), map_get(state, "position")));
        map_set(shebang_token, "end", map_get(state, "position"));
        var initial_tokens = map_get(state, "tokens");
        list_set(initial_tokens, list_length(initial_tokens), shebang_token);
    }
    while (map_get(state, "position") < text_length(source)) {
        var character = text_get(source, map_get(state, "position"));
        if (text_find(" \t\r\n", character) >= 0) {
            lex_advance(state);
        } else {
            if (character == "/" && text_get(source, map_get(state, "position") + 1) == "/") {
                var comment_token = lex_start(state);
                while (map_get(state, "position") < text_length(source)
                    && text_get(source, map_get(state, "position")) != "\r"
                    && text_get(source, map_get(state, "position")) != "\n") {
                    lex_advance(state);
                }
                if (include_comments) {
                    map_set(comment_token, "kind", "comment");
                    map_set(comment_token, "text", text_slice(source, map_get(comment_token, "start"), map_get(state, "position")));
                    map_set(comment_token, "end", map_get(state, "position"));
                    var comment_tokens = map_get(state, "tokens");
                    list_set(comment_tokens, list_length(comment_tokens), comment_token);
                }
            } else {
                var token = lex_start(state);
                if (is_letter(character)) {
                    map_set(token, "kind", "identifier");
                    while (map_get(state, "position") < text_length(source)
                        && is_identifier_part(text_get(source, map_get(state, "position")))) {
                        lex_advance(state);
                    }
                    var spelling = text_slice(source, map_get(token, "start"), map_get(state, "position"));
                    if (spelling == "var" || spelling == "fn" || spelling == "return" || spelling == "if"
                        || spelling == "else" || spelling == "while" || spelling == "true" || spelling == "false") {
                        map_set(token, "kind", "keyword");
                    }
                } else {
                    if (is_digit(character)) {
                        map_set(token, "kind", "number");
                        while (map_get(state, "position") < text_length(source)
                            && is_digit(text_get(source, map_get(state, "position")))) {
                            lex_advance(state);
                        }
                    } else {
                        if (character == "\"") {
                            map_set(token, "kind", "text");
                            lex_advance(state);
                            while (map_get(state, "position") < text_length(source)
                                && text_get(source, map_get(state, "position")) != "\"") {
                                var inner = text_get(source, map_get(state, "position"));
                                if (inner == "\n" || inner == "\r") {
                                    lex_fail(token, "unterminated text");
                                }
                                if (inner == "\\") {
                                    var escape = lex_start(state);
                                    lex_advance(state);
                                    if (map_get(state, "position") == text_length(source)
                                        || text_find("\"\\nrt", text_get(source, map_get(state, "position"))) < 0) {
                                        lex_fail(escape, "unknown text escape");
                                    }
                                }
                                lex_advance(state);
                            }
                            if (map_get(state, "position") == text_length(source)) {
                                lex_fail(token, "unterminated text");
                            }
                            lex_advance(state);
                        } else {
                            if (is_two_character_symbol(text_slice(source, map_get(state, "position"), map_get(state, "position") + 2))) {
                                lex_advance(state);
                                lex_advance(state);
                            } else {
                                if (text_find("=+-!<>(),;{}", character) >= 0) {
                                    lex_advance(state);
                                } else {
                                    lex_fail(token, "unexpected character " + json_to_text(character));
                                }
                            }
                        }
                    }
                }
                map_set(token, "text", text_slice(source, map_get(token, "start"), map_get(state, "position")));
                map_set(token, "end", map_get(state, "position"));
                var tokens = map_get(state, "tokens");
                list_set(tokens, list_length(tokens), token);
            }
        }
    }
    var end_token = lex_start(state);
    map_set(end_token, "kind", "eof");
    var end_tokens = map_get(state, "tokens");
    list_set(end_tokens, list_length(end_tokens), end_token);
    return end_tokens;
}

/// Report a parser/checker diagnostic.
fn parser_fail(token, message) {
    return diagnostic_fail(token, message);
}

/// Return an expression map with emitted code and kind.
fn expression_new(code, kind) {
    var expression = map_new();
    map_set(expression, "code", code);
    map_set(expression, "kind", kind);
    return expression;
}

/// Return the current parser token.
fn parser_token(parser) {
    return list_get(map_get(parser, "tokens"), map_get(parser, "position"));
}

/// Return a token offset from the current parser position.
fn parser_peek(parser, offset) {
    return list_get(map_get(parser, "tokens"), map_get(parser, "position") + offset);
}

/// Return the current token and advance.
fn parser_take(parser) {
    var token = parser_token(parser);
    map_set(parser, "position", map_get(parser, "position") + 1);
    return token;
}

/// Consume required punctuation or report a diagnostic.
fn parser_expect(parser, text) {
    if (map_get(parser_token(parser), "text") != text) {
        parser_fail(parser_token(parser), "expected " + text);
    }
    parser_take(parser);
    return 0;
}

/// Consume an identifier or report the selected diagnostic.
fn parser_identifier(parser, message) {
    if (map_get(parser_token(parser), "kind") != "identifier") {
        parser_fail(parser_token(parser), message);
    }
    return parser_take(parser);
}

/// Parse logical disjunction.
fn parser_expression(parser) {
    var left = parser_conjunction(parser);
    while (map_get(parser_token(parser), "text") == "||") {
        var operator = parser_take(parser);
        var right = parser_conjunction(parser);
        if ((map_get(left, "kind") != "boolean" && map_get(left, "kind") != "unknown")
            || (map_get(right, "kind") != "boolean" && map_get(right, "kind") != "unknown")) {
            parser_fail(operator, "|| needs booleans");
        }
        left = expression_new("(" + map_get(left, "code") + " || " + map_get(right, "code") + ")", "boolean");
    }
    return left;
}

/// Parse logical conjunction.
fn parser_conjunction(parser) {
    var left = parser_equality(parser);
    while (map_get(parser_token(parser), "text") == "&&") {
        var operator = parser_take(parser);
        var right = parser_equality(parser);
        if ((map_get(left, "kind") != "boolean" && map_get(left, "kind") != "unknown")
            || (map_get(right, "kind") != "boolean" && map_get(right, "kind") != "unknown")) {
            parser_fail(operator, "&& needs booleans");
        }
        left = expression_new("(" + map_get(left, "code") + " && " + map_get(right, "code") + ")", "boolean");
    }
    return left;
}

/// Parse scalar equality and inequality.
fn parser_equality(parser) {
    var left = parser_comparison(parser);
    while (map_get(parser_token(parser), "text") == "==" || map_get(parser_token(parser), "text") == "!=") {
        var operator = parser_take(parser);
        var right = parser_comparison(parser);
        var left_kind = map_get(left, "kind");
        var right_kind = map_get(right, "kind");
        if (left_kind == "void" || right_kind == "void"
            || left_kind == "list" || right_kind == "list"
            || left_kind == "map" || right_kind == "map"
            || (left_kind != "unknown" && right_kind != "unknown" && left_kind != right_kind)) {
            parser_fail(operator, "equality needs matching scalar kinds");
        }
        var symbol = "===";
        if (map_get(operator, "text") == "!=") {
            symbol = "!==";
        }
        left = expression_new("(" + map_get(left, "code") + " " + symbol + " " + map_get(right, "code") + ")", "boolean");
    }
    return left;
}

/// Parse numeric comparisons.
fn parser_comparison(parser) {
    var left = parser_additive(parser);
    while (map_get(parser_token(parser), "text") == "<" || map_get(parser_token(parser), "text") == "<="
        || map_get(parser_token(parser), "text") == ">" || map_get(parser_token(parser), "text") == ">=") {
        var operator = parser_take(parser);
        var right = parser_additive(parser);
        if ((map_get(left, "kind") != "number" && map_get(left, "kind") != "unknown")
            || (map_get(right, "kind") != "number" && map_get(right, "kind") != "unknown")) {
            parser_fail(operator, "comparison needs numbers");
        }
        left = expression_new("(" + map_get(left, "code") + " " + map_get(operator, "text") + " " + map_get(right, "code") + ")", "boolean");
    }
    return left;
}

/// Return whether kind can participate in addition.
fn additive_kind(kind) {
    return kind == "number" || kind == "text" || kind == "unknown";
}

/// Parse numeric addition/subtraction and text concatenation.
fn parser_additive(parser) {
    var left = parser_unary(parser);
    while (map_get(parser_token(parser), "text") == "+" || map_get(parser_token(parser), "text") == "-") {
        var operator = parser_take(parser);
        var right = parser_unary(parser);
        var left_kind = map_get(left, "kind");
        var right_kind = map_get(right, "kind");
        if (map_get(operator, "text") == "-") {
            if ((left_kind != "number" && left_kind != "unknown")
                || (right_kind != "number" && right_kind != "unknown")) {
                parser_fail(operator, "- needs two numbers");
            }
        } else {
            if (!additive_kind(left_kind) || !additive_kind(right_kind)
                || (left_kind != "unknown" && right_kind != "unknown" && left_kind != right_kind)) {
                parser_fail(operator, "+ needs two numbers or two texts");
            }
        }
        var result_kind = left_kind;
        if (left_kind == "unknown") {
            result_kind = right_kind;
        }
        left = expression_new("(" + map_get(left, "code") + " " + map_get(operator, "text") + " " + map_get(right, "code") + ")", result_kind);
    }
    return left;
}

/// Parse unary negation.
fn parser_unary(parser) {
    if (map_get(parser_token(parser), "text") == "-" || map_get(parser_token(parser), "text") == "!") {
        var operator = parser_take(parser);
        var value = parser_unary(parser);
        var kind = "boolean";
        if (map_get(operator, "text") == "-") {
            kind = "number";
        }
        if (map_get(value, "kind") != kind && map_get(value, "kind") != "unknown") {
            parser_fail(operator, map_get(operator, "text") + " needs a " + kind);
        }
        return expression_new("(" + map_get(operator, "text") + map_get(value, "code") + ")", kind);
    }
    return parser_primary(parser);
}

/// Return normalized decimal text for a digit-only literal.
fn normalize_number(text) {
    var position = 0;
    while (position < text_length(text) && text_get(text, position) == "0") {
        position = position + 1;
    }
    if (position == text_length(text)) {
        return "0";
    }
    return text_slice(text, position, text_length(text));
}

/// Parse literals, bindings, calls, and parenthesized expressions.
fn parser_primary(parser) {
    var token = parser_take(parser);
    if (map_get(token, "text") == "(") {
        var value = parser_expression(parser);
        parser_expect(parser, ")");
        return value;
    }
    if (map_get(token, "kind") == "number") {
        return expression_new(normalize_number(map_get(token, "text")), "number");
    }
    if (map_get(token, "kind") == "text") {
        return expression_new(map_get(token, "text"), "text");
    }
    if (map_get(token, "text") == "true" || map_get(token, "text") == "false") {
        return expression_new(map_get(token, "text"), "boolean");
    }
    if (map_get(token, "kind") == "identifier" && map_get(parser_token(parser), "text") == "(") {
        return parser_call(parser, token);
    }
    if (map_get(token, "kind") == "identifier" && map_has(map_get(parser, "variables"), map_get(token, "text"))) {
        return expression_new(map_get(token, "text"), map_get(map_get(parser, "variables"), map_get(token, "text")));
    }
    parser_fail(token, "expected expression");
    return expression_new("", "unknown");
}

/// Return argument code texts.
fn argument_code_list(args) {
    var codes = list_new();
    var position = 0;
    while (position < list_length(args)) {
        list_set(codes, list_length(codes), map_get(list_get(args, position), "code"));
        position = position + 1;
    }
    return codes;
}

/// Return argument code text joined by comma-space.
fn argument_codes(args) {
    return list_to_text(argument_code_list(args), ", ");
}

/// Parse a call and apply builtin metadata or a user signature.
fn parser_call(parser, name) {
    var name_text = map_get(name, "text");
    var is_builtin = builtin_exists(name_text);
    var functions = map_get(parser, "functions");
    var has_user = map_has(functions, name_text);
    if (!is_builtin && !has_user) {
        parser_fail(name, "unknown function " + name_text);
    }
    parser_expect(parser, "(");
    var args = list_new();
    if (map_get(parser_token(parser), "text") != ")") {
        list_set(args, list_length(args), parser_expression(parser));
        while (map_get(parser_token(parser), "text") == ",") {
            parser_take(parser);
            list_set(args, list_length(args), parser_expression(parser));
        }
    }
    parser_expect(parser, ")");
    var arity = map_get(map_get(functions, name_text), "arity");
    if (is_builtin) {
        arity = list_length(builtin_parameters(name_text));
    }
    if (list_length(args) != arity) {
        var suffix = "s";
        if (arity == 1) {
            suffix = "";
        }
        parser_fail(name, "expected " + number_to_text(arity) + " argument" + suffix);
    }
    if (!is_builtin) {
        return expression_new(name_text + "(" + argument_codes(args) + ")", map_get(map_get(functions, name_text), "result"));
    }
    var parameters = builtin_parameters(name_text);
    var position = 0;
    while (position < list_length(parameters)) {
        var kind = list_get(parameters, position);
        var actual = map_get(list_get(args, position), "kind");
        if (kind == "unknown") {
            if (actual == "void") {
                parser_fail(name, "expected value argument");
            }
        } else {
            if (actual != "unknown" && actual != kind) {
                parser_fail(name, "expected " + kind + " argument");
            }
        }
        position = position + 1;
    }
    var imports = builtin_imports(name_text);
    position = 0;
    while (position < list_length(imports)) {
        map_set(map_get(parser, "imports"), list_get(imports, position), true);
        position = position + 1;
    }
    var helper = builtin_helper_key(name_text);
    if (helper != "") {
        map_set(map_get(parser, "helpers"), helper, true);
    }
    return expression_new(builtin_emit(name_text, argument_code_list(args)), builtin_result(name_text));
}

/// Parse a statement and return emitted TypeScript.
fn parser_statement(parser) {
    if (map_get(parser_token(parser), "text") == "while") {
        parser_take(parser);
        var while_condition = parser_condition(parser);
        return "while (" + map_get(while_condition, "code") + ") " + parser_block(parser) + "\n";
    }
    if (map_get(parser_token(parser), "text") == "if") {
        parser_take(parser);
        var if_condition = parser_condition(parser);
        var output = "if (" + map_get(if_condition, "code") + ") " + parser_block(parser);
        if (map_get(parser_token(parser), "text") == "else") {
            parser_take(parser);
            output = output + " else " + parser_block(parser);
        }
        return output + "\n";
    }
    if (map_get(parser_token(parser), "text") == "fn") {
        return parser_function_declaration(parser);
    }
    if (map_get(parser_token(parser), "text") == "return") {
        var return_token = parser_take(parser);
        if (!map_get(parser, "in_function")) {
            parser_fail(return_token, "return outside function");
        }
        var return_value = parser_expression(parser);
        if (map_get(return_value, "kind") == "void") {
            parser_fail(return_token, "expected a value");
        }
        parser_expect(parser, ";");
        map_set(map_get(parser, "current"), "result", map_get(return_value, "kind"));
        map_set(map_get(parser, "current"), "returned", true);
        return "return " + map_get(return_value, "code") + ";\n";
    }
    if (map_get(parser_token(parser), "kind") == "identifier" && map_get(parser_peek(parser, 1), "text") == "(") {
        var call_value = parser_expression(parser);
        parser_expect(parser, ";");
        return map_get(call_value, "code") + ";\n";
    }
    if (map_get(parser_token(parser), "text") != "var") {
        var assignment_name = parser_identifier(parser, "expected binding name");
        var variables = map_get(parser, "variables");
        if (!map_has(variables, map_get(assignment_name, "text"))) {
            parser_fail(assignment_name, "unknown binding " + map_get(assignment_name, "text"));
        }
        parser_expect(parser, "=");
        var assignment_value = parser_expression(parser);
        if (map_get(assignment_value, "kind") == "void") {
            parser_fail(assignment_name, "expected a value");
        }
        parser_expect(parser, ";");
        map_set(variables, map_get(assignment_name, "text"), map_get(assignment_value, "kind"));
        return map_get(assignment_name, "text") + " = " + map_get(assignment_value, "code") + ";\n";
    }
    parser_expect(parser, "var");
    var declaration_name = parser_identifier(parser, "expected binding name");
    if (map_get(parser_token(parser), "text") != "=") {
        parser_fail(parser_token(parser), "expected initializer");
    }
    parser_take(parser);
    var declaration_value = parser_expression(parser);
    if (map_get(declaration_value, "kind") == "void") {
        parser_fail(declaration_name, "expected a value");
    }
    parser_expect(parser, ";");
    map_set(map_get(parser, "variables"), map_get(declaration_name, "text"), map_get(declaration_value, "kind"));
    return "let " + map_get(declaration_name, "text") + " = " + map_get(declaration_value, "code") + ";\n";
}

/// Parse a parenthesized boolean condition.
fn parser_condition(parser) {
    parser_expect(parser, "(");
    var start = parser_token(parser);
    var condition = parser_expression(parser);
    if (map_get(condition, "kind") != "boolean" && map_get(condition, "kind") != "unknown") {
        parser_fail(start, "condition must be boolean");
    }
    parser_expect(parser, ")");
    return condition;
}

/// Parse a braced block with a copied binding scope.
fn parser_block(parser) {
    parser_expect(parser, "{");
    var outer = map_get(parser, "variables");
    map_set(parser, "variables", map_copy(outer));
    map_set(parser, "depth", map_get(parser, "depth") + 1);
    var output = "";
    while (map_get(parser_token(parser), "text") != "}" && map_get(parser_token(parser), "kind") != "eof") {
        output = output + parser_statement(parser);
    }
    parser_expect(parser, "}");
    map_set(parser, "depth", map_get(parser, "depth") - 1);
    map_set(parser, "variables", outer);
    var indented = indent_output(output);
    if (indented == "") {
        return "{\n}";
    }
    return "{\n" + indented + "\n}";
}

/// Parse a top-level function declaration.
fn parser_function_declaration(parser) {
    var token = parser_take(parser);
    if (map_get(parser, "depth") != 0) {
        parser_fail(token, "functions must be top-level");
    }
    var name = parser_identifier(parser, "expected function name");
    parser_expect(parser, "(");
    var parameters = list_new();
    if (map_get(parser_token(parser), "text") != ")") {
        list_set(parameters, list_length(parameters), map_get(parser_identifier(parser, "expected parameter name"), "text"));
        while (map_get(parser_token(parser), "text") == ",") {
            parser_take(parser);
            list_set(parameters, list_length(parameters), map_get(parser_identifier(parser, "expected parameter name"), "text"));
        }
    }
    parser_expect(parser, ")");
    var info = map_get(map_get(parser, "functions"), map_get(name, "text"));
    map_set(parser, "current", info);
    map_set(parser, "in_function", true);
    var outer = map_get(parser, "variables");
    map_set(parser, "variables", map_copy(outer));
    var position = 0;
    while (position < list_length(parameters)) {
        map_set(map_get(parser, "variables"), list_get(parameters, position), "unknown");
        position = position + 1;
    }
    var body = parser_block(parser);
    map_set(parser, "variables", outer);
    map_set(parser, "in_function", false);
    if (!map_get(info, "returned")) {
        parser_fail(name, "T0 functions require a value return");
    }
    return "function " + map_get(name, "text") + "(" + list_to_text(parameters, ", ") + ") " + body + "\n";
}

/// Return the fixed sorted import list used by T0's finite dependencies.
fn import_names(imports) {
    var output = "";
    if (map_has(imports, "readFileSync")) {
        output = output + "readFileSync";
    }
    if (map_has(imports, "writeFileSync")) {
        if (output != "") {
            output = output + ", ";
        }
        output = output + "writeFileSync";
    }
    if (map_has(imports, "writeSync")) {
        if (output != "") {
            output = output + ", ";
        }
        output = output + "writeSync";
    }
    return output;
}

/// Return helper blocks in T0's sorted order.
fn helper_blocks(helpers) {
    // Keep this order equal to T0's lexicographic helper sort.
    var order = list_new();
    list_set(order, list_length(order), "map_runtime");
    list_set(order, list_length(order), "bytes_text");
    list_set(order, list_length(order), "directory_remove");
    list_set(order, list_length(order), "file_read_bytes");
    list_set(order, list_length(order), "file_remove");
    list_set(order, list_length(order), "file_write_bytes");
    list_set(order, list_length(order), "json_parse");
    list_set(order, list_length(order), "json_to_text");
    list_set(order, list_length(order), "list_copy");
    list_set(order, list_length(order), "list_get");
    list_set(order, list_length(order), "list_set");
    list_set(order, list_length(order), "list_to_text");
    list_set(order, list_length(order), "map_copy");
    list_set(order, list_length(order), "number_to_text");
    list_set(order, list_length(order), "process_run");
    list_set(order, list_length(order), "directory_temp");
    list_set(order, list_length(order), "text_bytes");
    list_set(order, list_length(order), "text_find");
    list_set(order, list_length(order), "text_get");
    list_set(order, list_length(order), "text_slice");
    list_set(order, list_length(order), "text_split");
    var output = "";
    var position = 0;
    while (position < list_length(order)) {
        var key = list_get(order, position);
        if (map_has(helpers, key)) {
            output = output + helper_text(key);
        }
        position = position + 1;
    }
    return output;
}

/// Parse the token list and return the complete TypeScript program.
fn parser_program(parser) {
    var shebang = "";
    if (map_get(parser_token(parser), "kind") == "shebang") {
        parser_take(parser);
        shebang = "#!/usr/bin/env node\n";
    }
    var output = "";
    while (map_get(parser_token(parser), "kind") != "eof") {
        output = output + parser_statement(parser);
    }
    var imports = map_get(parser, "imports");
    var import_text = "";
    if (list_length(map_keys(imports)) > 0) {
        import_text = "import { " + import_names(imports) + " } from \"node:fs\";\n";
    }
    return shebang + "\"use strict\";\n" + import_text + helper_blocks(map_get(parser, "helpers")) + output;
}

/// Return a parser state with pre-registered top-level function signatures.
fn parser_new(tokens) {
    var parser = map_new();
    map_set(parser, "tokens", tokens);
    map_set(parser, "position", 0);
    map_set(parser, "variables", map_new());
    map_set(parser, "functions", map_new());
    map_set(parser, "imports", map_new());
    map_set(parser, "helpers", map_new());
    map_set(parser, "depth", 0);
    map_set(parser, "in_function", false);
    map_set(parser, "current", map_new());
    var depth = 0;
    var index = 0;
    while (index < list_length(tokens)) {
        var token = list_get(tokens, index);
        if (map_get(token, "text") == "{") {
            depth = depth + 1;
        }
        if (map_get(token, "text") == "}") {
            depth = depth - 1;
        }
        if (depth == 0 && map_get(token, "text") == "fn" && map_get(list_get(tokens, index + 1), "kind") == "identifier") {
            var arity = 0;
            var cursor = index + 3;
            while (cursor < list_length(tokens) && map_get(list_get(tokens, cursor), "text") != ")"
                && map_get(list_get(tokens, cursor), "text") != "{") {
                if (map_get(list_get(tokens, cursor), "kind") == "identifier") {
                    arity = arity + 1;
                }
                cursor = cursor + 1;
            }
            var info = map_new();
            map_set(info, "arity", arity);
            map_set(info, "result", "unknown");
            map_set(info, "returned", false);
            map_set(map_get(parser, "functions"), map_get(list_get(tokens, index + 1), "text"), info);
        }
        index = index + 1;
    }
    return parser;
}

/// Compile a token list into TypeScript text.
fn compile(tokens) {
    return parser_program(parser_new(tokens));
}

