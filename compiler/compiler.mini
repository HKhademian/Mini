map_set(builtin_import_names, "bytes_text", "");
map_set(builtin_import_names, "file_read_bytes", "");
map_set(builtin_import_names, "file_write_bytes", "");

/// Builtin adapter keys keyed by name; empty for inline lowering.
var builtin_helper_keys = map_new();
map_set(builtin_helper_keys, "map_get", "map_runtime");
map_set(builtin_helper_keys, "map_keys", "");
map_set(builtin_helper_keys, "map_set", "map_runtime");
map_set(builtin_helper_keys, "map_has", "map_runtime");
map_set(builtin_helper_keys, "map_new", "map_runtime");
map_set(builtin_helper_keys, "map_copy", "map_copy");
