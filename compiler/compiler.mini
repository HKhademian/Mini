/// Return every builtin name once, in declaration order.
fn builtin_names() {
    return list_copy(builtin_names_list);
}

/// Return whether name selects a builtin.
fn builtin_exists(name) {
    return map_has(builtin_name_set, name);
}

/// Return builtin parameter kinds in declaration order.
fn builtin_parameters(name) {
    if (!map_has(builtin_parameter_kinds, name)) {
        return list_new();
    }
    var kinds = map_get(builtin_parameter_kinds, name);
    if (kinds == "") {
        return list_new();
    }
    return text_split(kinds, ",");
}

/// Return the builtin result kind.
fn builtin_result(name) {
    if (map_has(builtin_result_kinds, name)) {
        return map_get(builtin_result_kinds, name);
    }
    return "text";
}

/// Return builtin Node imports.
fn builtin_imports(name) {
    if (!map_has(builtin_import_names, name)) {
        return list_new();
    }
    var names = map_get(builtin_import_names, name);
    if (names == "") {
        return list_new();
    }
    return text_split(names, ",");
}

/// Return the builtin adapter key, or empty text.
fn builtin_helper_key(name) {
    if (map_has(builtin_helper_keys, name)) {
        return map_get(builtin_helper_keys, name);
    }
    return "";
}

/// Return the adapter text for a helper key.
fn helper_text(key) {
    if (key == "map_runtime") {
        return map_runtime;
    }
    if (key == "directory_remove") {
        return directory_remove_helper;
    }
    if (key == "directory_temp") {
        return directory_temp_helper;
    }
    if (key == "file_remove") {
        return file_remove_helper;
    }
    if (key == "json_to_text") {
        return json_to_text_helper;
    }
    if (key == "list_copy") {
        return list_copy_helper;
    }
    if (key == "list_get") {
        return list_get_helper;
    }
    if (key == "list_set") {
        return list_set_helper;
    }
    if (key == "list_to_text") {
        return list_to_text_helper;
    }
    if (key == "map_copy") {
        return map_copy_helper;
    }
    if (key == "number_to_text") {
        return number_to_text_helper;
    }
    if (key == "process_run") {
        return process_run_helper;
    }
    if (key == "text_find") {
        return text_find_helper;
    }
    if (key == "text_get") {
        return text_get_helper;
    }
    if (key == "text_slice") {
        return text_slice_helper;
    }
    if (key == "text_split") {
        return text_split_helper;
    }
    if (key == "json_parse") {
        return json_parse_helper;
    }
    if (key == "text_bytes") {
        return text_bytes_helper;
    }
    if (key == "bytes_text") {
        return bytes_text_helper;
    }
    if (key == "file_read_bytes") {
        return file_read_bytes_helper;
    }
    if (key == "file_write_bytes") {
        return file_write_bytes_helper;
    }
    return "";
}

/// Return the lowered TypeScript call text for a builtin.
fn builtin_emit(name, args) {
    var first = list_get(args, 0);
    var second = list_get(args, 1);
    if (name == "map_get" || name == "map_set" || name == "map_has" || name == "list_set" || name == "list_get" || name == "text_get" || name == "text_slice" || name == "text_find" || name == "text_split" || name == "map_copy" || name == "list_copy" || name == "list_to_text" || name == "number_to_text" || name == "json_to_text" || name == "process_run" || name == "directory_temp" || name == "file_remove" || name == "directory_remove" || name == "json_parse" || name == "text_bytes" || name == "bytes_text" || name == "file_read_bytes" || name == "file_write_bytes") {
        return "$mini_" + name + "(" + list_to_text(args, ", ") + ")";
    }
    if (name == "process_exec_path") {
        return "process.execPath";
    }
    if (name == "map_keys") {
        return "Object.keys(" + first + ")";
    }
    if (name == "map_new") {
        return "({ __proto__: $mini_map_proto })";
    }
    if (name == "list_new") {
        return "[]";
    }
    if (name == "write_error") {
        return "writeSync(2, " + first + ")";
    }
    if (name == "process_exit") {
        return "process.exit(" + first + ")";
    }
    if (name == "list_length") {
        return "(" + first + ").length";
    }
    if (name == "process_args") {
        return "process.argv.slice(2)";
    }
    if (name == "file_write") {
        return "writeFileSync(" + first + ", " + second + ", \"utf8\")";
    }
    if (name == "file_read") {
        return "readFileSync(" + first + ", \"utf8\")";
    }
    if (name == "text_length") {
        return "(" + first + ").length";
    }
    if (name == "readAll") {
        return "readFileSync(0, \"utf8\")";
    }
    if (name == "write") {
        return "writeSync(1, " + first + ")";
    }
    return "";
}

/// Return token JSON with two-space indentation and a final newline.
fn token_json(tokens) {
    var output = "[";
    var position = 0;
    while (position < list_length(tokens)) {
        if (position > 0) {
            output = output + ",";
        }
        var token = list_get(tokens, position);
        output = output + "\n  {";
        output = output + "\n    \"kind\": " + json_to_text(map_get(token, "kind")) + ",";
        output = output + "\n    \"text\": " + json_to_text(map_get(token, "text")) + ",";
        output = output + "\n    \"source\": " + json_to_text(map_get(token, "source")) + ",";
        output = output + "\n    \"start\": " + number_to_text(map_get(token, "start")) + ",";
        output = output + "\n    \"end\": " + number_to_text(map_get(token, "end")) + ",";
        output = output + "\n    \"line\": " + number_to_text(map_get(token, "line")) + ",";
        output = output + "\n    \"column\": " + number_to_text(map_get(token, "column")) + ",";
        output = output + "\n    \"context\": " + json_to_text(map_get(token, "context"));
        output = output + "\n  }";
        position = position + 1;
    }
    if (list_length(tokens) > 0) {
        output = output + "\n";
    }
    return output + "]\n";
}

/// Run the Mini compiler command interface.
fn main() {
    var args = process_args();
    var command = list_get(args, 0);
    var include_comments = false;
    var offset = 0;
    if (command == "tokens" && list_get(args, 1) == "--comments") {
        include_comments = true;
        offset = 1;
    }
    if (command == "metadata" && list_length(args) == 1) {
        var entries = list_new();
        var names = builtin_names();
        var index = 0;
        while (index < list_length(names)) {
            var name = list_get(names, index);
            var entry = map_new();
            map_set(entry, "name", name);
            map_set(entry, "parameters", builtin_parameters(name));
            map_set(entry, "result", builtin_result(name));
            list_set(entries, list_length(entries), entry);
            index = index + 1;
        }
        var metadata = map_new();
        map_set(metadata, "builtins", entries);
        write(json_to_text(metadata) + "\n");
        return 0;
    }
    var count = list_length(args) - offset;
    var source = list_get(args, 1 + offset);
    var output = list_get(args, 2 + offset);
    if (count < 2 || count > 3 || !text_ends_with(source, ".mini")
        || (command != "compile" && command != "tokens")) {
        write_error("usage: mini compile SOURCE.mini [OUTPUT.ts] | tokens [--comments] SOURCE.mini | metadata\n");
        process_exit(1);
    }
    var tokens = tokenize(file_read(source), basename(source), include_comments);
    if (command == "tokens") {
        write(token_json(tokens));
    } else {
        var target = source + ".ts";
        if (count == 3) {
            target = output;
        }
        file_write(target, compile(tokens));
    }
    return 0;
}

main();
