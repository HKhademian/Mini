map_set(builtin_result_kinds, "file_read_bytes", "list");
map_set(builtin_result_kinds, "file_write_bytes", "void");

/// Builtin Node import names keyed by name; comma-separated, empty for none.
var builtin_import_names = map_new();
map_set(builtin_import_names, "map_get", "");
map_set(builtin_import_names, "map_keys", "");
map_set(builtin_import_names, "map_set", "");
