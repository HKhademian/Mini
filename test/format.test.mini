#!/usr/bin/env node

import "common/io";
import "common/json";
import "common/map";
import "common/text";
import "common/list";
import "common/path";
import "common/file";
import "common/process";

/// Report a formatter test failure.
fn format_fail(name, message) {
    io_write_error(name + ": " + message + "\n");
    process_exit(1);
    return 0;
}

/// Format one temporary source and return stdout.
fn format_source(root, work, name, source) {
    path := path_join(work, name);
    has_io := text_find(source, "io_write(") >= 0 && text_find(source, "import \"common/io\";") < 0;
    if has_io {
        source = "import \"common/io\";\n" + source;
    }
    file_write(path, source);
    args := list_of(path_join(root, "bin/mini-format"), path);
    result := process_capture(process_exec_path(), args, root, list_new());
    if map_get(result, "status") != 0 {
        format_fail(name, text_from_bytes(map_get(result, "stderr")));
    }
    output := text_from_bytes(map_get(result, "stdout"));
    if has_io {
        return text_slice(output, text_find(output, "\n") + 1, text_length(output));
    }
    return output;
}

/// Compare a formatted result with an expected value.
fn format_expect(name, actual, expected) {
    if actual != expected {
        format_fail(name, "expected [" + expected + "] got [" + actual + "]");
    }
    return 0;
}

/// Return a stable token signature for one source.
fn format_signature(root, file) {
    args := list_of(path_join(root, "dist/compile.js"), "tokens", "--comments", file);
    result := process_capture(process_exec_path(), args, root, list_new());
    if map_get(result, "status") != 0 {
        format_fail(file, text_from_bytes(map_get(result, "stderr")));
    }
    parsed := json_parse(text_from_bytes(map_get(result, "stdout")));
    if !map_get(parsed, "ok") {
        format_fail(file, "invalid token JSON");
    }
    tokens := map_get(parsed, "value");
    signature := "";
    position := 0;
    while position < list_length(tokens) {
        token := list_get(tokens, position);
        signature = signature + map_get(token, "kind") + ":" + map_get(token, "text") + "\n";
        position = position + 1;
    }
    return signature;
}

/// Compile one source and return generated text.
fn format_compiled(root, file, output) {
    args := list_of(path_join(root, "dist/compile.js"), file, output);
    result := process_capture(process_exec_path(), args, root, list_new());
    if map_get(result, "status") != 0 {
        format_fail(file, text_from_bytes(map_get(result, "stderr")));
    }
    return file_read(output);
}

/// Run the formatter checks.
fn main(args) {
    root := list_get(args, 0);
    work := path_temp_directory();
    example := "value:=1;// keep\nif(value==1){io_write(\"ok\");}else{io_write(\"no\");}\n";
    canonical := "value := 1; // keep\nif (value == 1) {\n    io_write(\"ok\");\n} else {\n    io_write(\"no\");\n}\n";
    format_expect("example", format_source(root, work, "example.mini", example), canonical);
    format_expect("idempotent", format_source(root, work, "idempotent.mini", canonical), canonical);
    shebang := "#!/usr/bin/env -S mini run\nvalue:=1;\n";
    shebang_expected := "#!/usr/bin/env -S mini run\nvalue := 1;\n";
    format_expect("shebang", format_source(root, work, "shebang.mini", shebang), shebang_expected);
    format_expect("empty", format_source(root, work, "empty.mini", ""), "");
    format_expect("whitespace", format_source(root, work, "space.mini", " \n\t\r\n"), "");
    format_expect("comments", format_source(root, work, "comments.mini", "/// only"), "/// only\n");
    format_expect(
        "comment-lines",
        format_source(root, work, "comment-lines.mini", "// a\n\n// b\n"),
        "// a\n\n// b\n"
    );
    format_expect(
        "crlf",
        format_source(
            root,
            work,
            "crlf.mini",
            "value:=1;// keep\r\nif(value==1){io_write(\"ok\");}else{io_write(\"no\");}\r\n"
        ),
        canonical
    );
    format_expect(
        "operators",
        format_source(root, work, "operators.mini", "a:=-1;b:=1+-2;c:=!true;d:=0-(1+2);\n"),
        "a := -1;\nb := 1 + -2;\nc := !true;\nd := 0 - (1 + 2);\n"
    );
    format_expect(
        "parentheses",
        format_source(root, work, "paren.mini", "value:=(1+2)+3;\nif((value==6)&&(!false)){io_write(\"ok\");}\n"),
        "value := (1 + 2) + 3;\nif ((value == 6) && (!false)) {\n    io_write(\"ok\");\n}\n"
    );
    first := "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";
    second := "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb";
    third := "cccccccccccccccccccccccccccccccccc";
    fourth := "dddddddddddddddddddddddddddddddddd";
    fifth := "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee";
    wide_source := "io_write(\"" + first + "\",\"" + second + "\",\"" + third + "\",\"" + fourth + "\",\"" + fifth + "\");\n";
    wide_expected := "io_write(\n    \"" + first + "\",\n    \"" + second + "\",\n"
        + "    \"" + third + "\",\n    \"" + fourth + "\",\n    \"" + fifth + "\"\n);\n";
    format_expect("line-width", format_source(root, work, "wide.mini", wide_source), wide_expected);
    explicit_source := "io_write(\n\"first\",\n  \"second\"\n);\n";
    explicit_expected := "io_write(\n    \"first\",\n    \"second\"\n);\n";
    format_expect(
        "intentional-multiline-call",
        format_source(root, work, "multiline.mini", explicit_source),
        explicit_expected
    );
    chain_source := "value := 1 +\n2 +\n3;\n";
    chain_expected := "value := 1 +\n    2 +\n    3;\n";
    format_expect(
        "intentional-multiline-operator-chain",
        format_source(root, work, "chain.mini", chain_source),
        chain_expected
    );
    format_expect(
        "else-comment",
        format_source(root, work, "else.mini", "if (true) {\n} // why\nelse {\n}\n"),
        "if (true) {\n} else { // why\n}\n"
    );
    format_expect(
        "trailing",
        format_source(root, work, "trailing.mini", "value := 1;  // tail  \n"),
        "value := 1; // tail\n"
    );
    format_expect(
        "blank-lines",
        format_source(root, work, "blank.mini", "a:=1;\n\n\n\nb:=2;\n"),
        "a := 1;\n\nb := 2;\n"
    );
    check_args := list_of("--check", "cases/tooling/format-unformatted.mini");
    check := process_capture(path_join(root, "bin/mini-format"), check_args, root, list_new());
    if map_get(check, "status") != 1 || text_from_bytes(map_get(check, "stdout")) != "" || text_from_bytes(
        map_get(
            check,
            "stderr"
        )
    ) != "cases/tooling/format-unformatted.mini: not formatted\n" {
        format_fail("check", "unexpected --check result");
    }
    invalid_args := list_new();
    list_set(invalid_args, 0, "cases/tooling/format-invalid.mini");
    invalid := process_capture(path_join(root, "bin/mini-format"), invalid_args, root, list_new());
    if map_get(invalid, "status") != 1
        || text_from_bytes(map_get(invalid, "stderr")) != "cases/tooling/format-invalid.mini:1:10: expected expression\nvalue := ;\n         ^\n" {
        format_fail("invalid", "unexpected diagnostic");
    }
    names := directory_list(path_join(root, "samples"));
    checked := 0;
    position := 0;
    while position < list_length(names) {
        name := list_get(names, position);
        if text_ends_with(name, ".mini") {
            original := path_join(work, name);
            formatted := path_join(work, "formatted-" + name);
            file_write(original, file_read(path_join(path_join(root, "samples"), name)));
            output := format_source(root, work, name, file_read(original));
            file_write(formatted, output);
            if format_signature(root, formatted) != format_signature(root, original) {
                format_fail(name, "tokens changed");
            }
            if format_compiled(root, formatted, path_join(work, "formatted.js")) != format_compiled(
                root,
                original,
                path_join(work, "original.js")
            ) {
                format_fail(name, "generated code changed");
            }
            if format_source(root, work, name, file_read(formatted)) != output {
                format_fail(name, "not idempotent");
            }
            checked = checked + 1;
        }
        position = position + 1;
    }
    if checked <= 15 {
        format_fail("samples", "expected more samples");
    }
    path_remove(work);
    io_write("formatter ok\n");
    return 0;
}

main(fn_args());
