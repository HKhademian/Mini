#!/usr/bin/env node
include "../libs/common/text.mini";
include "../libs/tools/cases.mini";

/// Compile and run one source in host and reference modes, then compare results.
fn reference_compare(root, name, source_text) {
    work := path_temp_directory();
    file_write(path_join(work, "package.json"), "{\"type\":\"module\"}\n");
    source := path_join(work, name + ".mini");
    file_write(source, source_text);
    compiler := path_join(root, "dist/compile.js");
    host := path_join(work, name + "-host.js");
    pure := path_join(work, name + "-pure.js");
    host_args := list_new();
    list_set(host_args, 0, compiler);
    list_set(host_args, 1, source);
    list_set(host_args, 2, host);
    host_compile := process_capture(process_exec_path(), host_args, root, list_new());
    if map_get(host_compile, "status") != 0 {
        path_remove(work);
        io_write_error(name + " host compile failed: " + text_from_bytes(map_get(host_compile, "stderr")));
        process_exit(1);
    }
    pure_args := list_new();
    list_set(pure_args, 0, compiler);
    list_set(pure_args, 1, "--reference");
    list_set(pure_args, 2, source);
    list_set(pure_args, 3, pure);
    pure_compile := process_capture(process_exec_path(), pure_args, root, list_new());
    if map_get(pure_compile, "status") != 0 {
        path_remove(work);
        io_write_error(name + " reference compile failed: " + text_from_bytes(map_get(pure_compile, "stderr")));
        process_exit(1);
    }
    host_run_args := list_new();
    list_set(host_run_args, 0, host);
    host_run := process_capture(process_exec_path(), host_run_args, work, list_new());
    pure_run_args := list_new();
    list_set(pure_run_args, 0, pure);
    pure_run := process_capture(process_exec_path(), pure_run_args, work, list_new());
    if map_get(host_run, "status") != map_get(pure_run, "status")
        || text_from_bytes(map_get(host_run, "stdout")) != text_from_bytes(map_get(pure_run, "stdout"))
        || text_from_bytes(map_get(host_run, "stderr")) != text_from_bytes(map_get(pure_run, "stderr")) {
        path_remove(work);
        io_write_error(name + " differs between host and reference modes\n");
        process_exit(1);
    }
    path_remove(work);
    return 0;
}

/// Run the reference equivalence programs.
fn main() {
    args := process_args();
    root := list_get(args, 0);
    reference_compare(root, "text", "io_write(text_slice(\"abcdef\", 1, 4) + \"\\n\");\nio_write(number_to_text(text_find(\"abcabc\", \"bc\")) + \"\\n\");\nparts := text_split(\"a,b,c\", \",\");\nio_write(number_to_text(list_length(parts)) + \"\\n\");\n");
    reference_compare(root, "copy", "items := list_new();\nlist_set(items, 0, \"a\");\nlist_set(items, 1, \"b\");\ncopy := list_copy(items);\nlist_set(copy, 0, \"changed\");\nio_write(list_get(items, 0) + list_get(copy, 0) + \"\\n\");\nsource := map_new();\nmap_set(source, \"a\", 1);\ntarget := map_copy(source);\nmap_set(target, \"b\", 2);\nio_write(number_to_text(list_length(map_keys(target))) + \"\\n\");\n");
    reference_compare(root, "stack", "stack := list_new();\nlist_push_back(stack, \"b\");\nlist_push_front(stack, \"a\");\nlist_push_back(stack, \"c\");\nio_write(list_pop_front(stack) + list_pop_back(stack) + \"\\n\");\nlist_truncate(stack, 0);\nio_write(number_to_text(list_length(stack)) + \"\\n\");\n");
    reference_compare(root, "number", "io_write(number_to_text(number_mul(6, 7)) + \"\\n\");\nio_write(number_to_text(number_div(7, 2)) + \"\\n\");\nio_write(number_to_text(number_mod(7, 3)) + \"\\n\");\nio_write(number_to_text(number_floor(3)) + \"\\n\");\nio_write(number_to_text(number_pow(2, 10)) + \"\\n\");\nio_write(number_to_text(number_from_text(\"-42\")) + \"\\n\");\n");
    reference_compare(root, "bytes", "bytes := text_to_bytes(\"Aé😀\");\nio_write(text_from_bytes(bytes) + \"\\n\");\nio_write(number_to_text(text_code(\"é\")) + \"\\n\");\nio_write(text_from_code(128512) + \"\\n\");\n");
    reference_compare(root, "json", "parsed := json_parse(\"{\\\"a\\\":[1,true,null,\\\"x\\\"],\\\"b\\\":false}\");\nio_write(json_to_text(map_get(parsed, \"value\")) + \"\\n\");\nagain := json_parse(json_to_text(map_get(parsed, \"value\")));\nio_write(json_to_text(map_get(again, \"value\")) + \"\\n\");\n");
    reference_compare(root, "to-text", "io_write(number_to_text(0) + \"\\n\");\nio_write(number_to_text(-12345) + \"\\n\");\nio_write(number_to_text(9007199254740991) + \"\\n\");\nitems := list_new();\nlist_set(items, 0, \"a\");\nlist_set(items, 1, 2);\nlist_set(items, 2, \"b\");\nio_write(list_to_text(items, \"-\") + \"\\n\");\n");
    io_write("reference modes agree\n");
    return 0;
}

main();
