#!/usr/bin/env node
import "core/io";
import "core/text";
import "core/list";
import "util/path";
import "core/file";
import "tools/cases";
import "core/process";
import "util/process";

/// Compile and run one source in host and reference modes, then compare results.
fn reference_compare(root, name, source_text) {
    work := path_temp_directory();
    file_write(path_join(work, "package.json"), "{\"type\":\"module\"}\n");
    source := path_join(work, name + ".mini");
    file_write(source, source_text);
    compiler := path_join(root, "dist/compile.js");
    host := path_join(work, name + "-host.js");
    reference := path_join(work, name + "-reference.js");
    host_args := list_of(compiler, source, host);
    host_compile := process_capture(process_exec_path(), host_args, root, list_new());
    if map_get(host_compile, "status") != 0 {
        path_remove(work);
        io_write_error(name + " host compile failed: " + text_from_bytes(map_get(host_compile, "stderr")));
        process_exit(1);
    }
    reference_args := list_of(compiler, "--reference", source, reference);
    reference_compile := process_capture(process_exec_path(), reference_args, root, list_new());
    if map_get(reference_compile, "status") != 0 {
        path_remove(work);
        io_write_error(name + " reference compile failed: " + text_from_bytes(map_get(reference_compile, "stderr")));
        process_exit(1);
    }
    if name == "number-add" && text_find(file_read(host), "return a + b;") < 0 {
        path_remove(work);
        io_write_error(name + " JavaScript host override was not emitted\n");
        process_exit(1);
    }
    if name == "number-add" && text_find(file_read(reference), "return (a - (0 - b));") < 0 {
        path_remove(work);
        io_write_error(name + " Mini implementation was not emitted in reference mode\n");
        process_exit(1);
    }
    if name == "text" && text_find(file_read(host), "return characters.slice(start, end).join(\"\");") < 0 {
        path_remove(work);
        io_write_error(name + " JavaScript host override was not emitted\n");
        process_exit(1);
    }
    if name == "text" && text_find(file_read(reference), "return source.slice(start, end);") >= 0 {
        path_remove(work);
        io_write_error(name + " Mini implementation was not emitted in reference mode\n");
        process_exit(1);
    }
    host_run_args := list_new();
    list_set(host_run_args, 0, host);
    host_run := process_capture(process_exec_path(), host_run_args, work, list_new());
    reference_run_args := list_new();
    list_set(reference_run_args, 0, reference);
    reference_run := process_capture(process_exec_path(), reference_run_args, work, list_new());
    if map_get(host_run, "status") != map_get(reference_run, "status") || text_from_bytes(map_get(host_run, "stdout"))
        != text_from_bytes(map_get(reference_run, "stdout")) || text_from_bytes(map_get(host_run, "stderr")) != text_from_bytes(map_get(reference_run,
        "stderr")) {
        path_remove(work);
        io_write_error(name + " differs between host and reference modes\n");
        process_exit(1);
    }
    path_remove(work);
    return 0;
}

/// Run the reference equivalence programs.
fn main(args) {
    root := list_get(args, 0);
    reference_compare(
        root,
        "text",
        "import \"core/io\";\nimport \"core/number\";\nimport \"core/text\";\nimport \"core/list\";\nio_write(text_slice(\"abcdef\", 1, 4) + \"\\n\");\nio_write(number_to_text(text_find(\"abcabc\", \"bc\")) + \"\\n\");\nparts := text_split(\"a,b,c\", \",\");\nio_write(number_to_text(list_length(parts)) + \"\\n\");\n"
    );
    reference_compare(
        root,
        "copy",
        "import \"core/io\";\nimport \"core/number\";\nimport \"core/map\";\nimport \"core/list\";\nimport \"core/json\";\nitems := list_new();\nlist_set(items, 0, \"a\");\nlist_set(items, 1, \"b\");\ncopy := list_copy(items);\nlist_set(copy, 0, \"changed\");\nio_write(list_get(items, 0) + list_get(copy, 0) + \"\\n\");\nsource := map_new();\nmap_set(source, \"a\", 1);\ntarget := map_copy(source);\nmap_set(target, \"b\", 2);\nio_write(number_to_text(list_length(map_keys(target))) + \"\\n\");\n"
    );
    reference_compare(
        root,
        "number",
        "import \"core/io\";\nimport \"core/number\";\nio_write(number_to_text(number_mul(6, 7)) + \"\\n\");\nio_write(number_to_text(number_div(7, 2)) + \"\\n\");\nio_write(number_to_text(number_mod(7, 3)) + \"\\n\");\nio_write(number_to_text(number_floor(3)) + \"\\n\");\nio_write(number_to_text(number_pow(2, 10)) + \"\\n\");\nio_write(number_to_text(number_from_text(\"-42\")) + \"\\n\");\n"
    );
    reference_compare(
        root,
        "number-add",
        "import \"core/io\";\nimport \"core/number\";\nimport \"core/display\";\nio_write(number_add(2, 3), \"|\", number_add(10, -4), \"|\", number_add(\"x\", 7), \"|\", number_add(1, \"y\"), \"\\n\");\n"
    );
    reference_compare(
        root,
        "bytes",
        "import \"core/io\";\nimport \"core/number\";\nimport \"core/text\";\nbytes := text_to_bytes(\"Aé😀\");\nio_write(text_from_bytes(bytes) + \"\\n\");\nio_write(number_to_text(text_to_code(\"é\", 0)) + \"\\n\");\nio_write(text_from_code(128512) + \"\\n\");\nio_write(text_to_bytes(text_from_bytes(list_of(237, 160, 128))), \"\\n\");\n"
    );
    reference_compare(
        root,
        "json",
        "import \"core/io\";\nimport \"core/map\";\nimport \"core/json\";\nimport \"core/text\";\nparsed := json_value(\"{\\\"a\\\":[1,true,null,\\\"x\\\"],\\\"b\\\":false}\");\nio_write(json_text(map_get(parsed, \"value\")) + \"\\n\");\nagain := json_value(json_text(map_get(parsed, \"value\")));\nio_write(json_text(map_get(again, \"value\")) + \"\\n\");\nordered := map_new();\nmap_set(ordered, \"2\", 2);\nmap_set(ordered, \"10\", 10);\nmap_set(ordered, text_from_code(65536), 7);\nmap_set(ordered, text_from_code(57344), 6);\nio_write(json_text(ordered) + \"\\n\");\nio_write(ordered, \"\\n\");\nstable := map_of(\"z\", 1, \"a\", 2);\nio_write(json_text(stable) + \"\\n\");\nio_write(stable, \"\\n\");\nif list_get(map_keys(stable), 0) != \"z\" { io_write(\"serialization changed map order\\n\"); }\n"
    );
    reference_compare(
        root,
        "io-write-values",
        "import \"core/io\";\nimport \"core/number\";\nimport \"core/display\";\nimport \"core/list\";\nimport \"core/json\";\nitems := list_new();\nlist_set(items, 0, \"a\");\nlist_set(items, 1, 2);\nio_write(items, \"|\", value_to_text(items), \"|\", json_text(items), \"|\");\nio_write(42, \"|\", value_to_text(42), \"|\", number_to_text(42), \"|\");\nio_write(\"x\", 7);\nio_write(\"y\\n\");\n"
    );
    reference_compare(
        root,
        "to-text",
        "import \"core/io\";\nimport \"core/number\";\nimport \"core/display\";\nimport \"core/list\";\nimport \"core/json\";\nio_write(number_to_text(0) + \"\\n\");\nio_write(number_to_text(-12345) + \"\\n\");\nio_write(number_to_text(9007199254740991) + \"\\n\");\nitems := list_new();\nlist_set(items, 0, \"a\");\nlist_set(items, 1, 2);\nlist_set(items, 2, \"b\");\nio_write(list_join(\"-\", items) + \"\\n\");\n"
    );
    io_write("reference modes agree\n");
    return 0;
}

main(fn_args());

import "core/map";
