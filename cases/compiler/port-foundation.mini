/// Exercise the existing subset needed by M1 and write a checked TS program to the supplied path.

include "common/io.mini";

/// Return ten times value using only addition; used by decimal formatting.

fn times_ten(value) {
    twice := value + value;
    four := twice + twice;
    eight := four + four;
    return eight + twice;
}

/// Return signed decimal text for an ordinary integer value using addition and subtraction.
fn decimal(value) {
    remaining := value;
    sign := "";
    if remaining < 0 {
        sign = "-";
        remaining = -remaining;
    }
    if remaining == 0 {
        return "0";
    }
    powers := list_new();
    power := 1;
    while power <= remaining {
        list_set(powers, list_length(powers), power);
        power = times_ten(power);
    }
    output := sign;
    position := list_length(powers) - 1;
    while position >= 0 {
        power = list_get(powers, position);
        digit := 0;
        while remaining >= power {
            remaining = remaining - power;
            digit = digit + 1;
        }
        output = output + text_get("0123456789", digit);
        position = position - 1;
    }
    return output;
}

/// Return source characters from start through the exclusive limit; callers supply nonnegative bounds.
fn slice(source, start, limit) {
    position := start;
    output := "";
    while position < limit && position < text_length(source) {
        output = output + text_get(source, position);
        position = position + 1;
    }
    return output;
}

/// Return whether the single-character value occurs in choices.
fn contains(choices, value) {
    position := 0;
    while position < text_length(choices) {
        if text_get(choices, position) == value {
            return true;
        }
        position = position + 1;
    }
    return false;
}

/// Escape a single character using the five supported text escapes, or return it unchanged.
fn quote_char(character) {
    if character == "\"" || character == "\\" {
        return "\\" + character;
    }
    if character == "\n" {
        return "\\n";
    }
    if character == "\r" {
        return "\\r";
    }
    if character == "\t" {
        return "\\t";
    }
    return character;
}

/// Return source as a double-quoted TS literal using the supported escapes.
fn quoted(source) {
    output := "\"";
    position := 0;
    while position < text_length(source) {
        output = output + quote_char(text_get(source, position));
        position = position + 1;
    }
    return output + "\"";
}

/// Return a shallow copy of scope; replacing a binding in the result leaves scope unchanged.
fn copy_scope(scope) {
    result := map_new();
    keys := map_keys(scope);
    position := 0;
    while position < list_length(keys) {
        key := list_get(keys, position);
        map_set(result, key, map_get(scope, key));
        position = position + 1;
    }
    return result;
}

/// Return whether nonnegative value is even, testing forward mutual recursion with odd.
fn even(value) {
    if value == 0 {
        return true;
    }
    return odd(value - 1);
}

/// Return whether nonnegative value is odd, testing mutual recursion with even.
fn odd(value) {
    if value == 0 {
        return false;
    }
    return even(value - 1);
}

/// Append depths in ascending order to state.visits and increment state.count; return zero.
fn descend(state, depth) {
    saved := depth;
    if depth > 0 {
        descend(state, depth - 1);
    }
    visits := map_get(state, "visits");
    list_set(visits, list_length(visits), saved);
    map_set(state, "count", map_get(state, "count") + 1);
    return 0;
}

args := fn_args();
if list_length(args) != 1 {
    io_write_error("expected an output path\n");
    process_exit(1);
}
state := map_new();
map_set(state, "visits", list_new());
map_set(state, "count", 0);
descend(state, 3);
position := 0;
while position < 4 {
    if list_get(map_get(state, "visits"), position) != position {
        process_exit(1);
    }
    position = position + 1;
}
if map_get(state, "count") != 4 || !even(6) || !odd(5) {
    process_exit(1);
}
io_write_line("recursion and state");

scope := map_new();
map_set(scope, "name", "text");
inner := copy_scope(scope);
map_set(inner, "name", "number");
map_set(inner, "local", "text");
if map_get(scope, "name") != "text" || map_has(scope, "local") {
    process_exit(1);
}
io_write_line("scope copy");
io_write_line(decimal(0) + "," + decimal(-1234) + "," + decimal(100000));
io_write(quoted("a\"\\\n\r\t") + "\n");
if slice("compiler.mini", 0, 8) != "compiler" || !contains("abc", "b") || contains("abc", "#") {
    process_exit(1);
}
io_write_line("text helpers");

program := "\"use strict\";\nimport { writeSync } from \"node:fs\";\nwriteSync(1, " + quoted("port probe") + ");\n";
file_write(list_get(args, 0), program);
io_write_line("emitted");
