/// Render a text template after a key=value header and a blank line.

/// Return source with each {{key}} replaced from the header; unknown keys become <missing>.
fn app_run(source) {
    var values = map_new();
    var position = 0;
    var header = true;
    while header && position < text_length(source) {
        var key = "";
        var value = "";
        var in_value = false;
        while position < text_length(source) && text_get(source, position) != "\n" {
            var character = text_get(source, position);
            if character == "=" && !in_value {
                in_value = true;
            } else {
                if in_value {
                    value = value + character;
                } else {
                    key = key + character;
                }
            }
            position = position + 1;
        }
        position = position + 1;
        if key == "" && !in_value {
            header = false;
        } else {
            if in_value {
                map_set(values, key, value);
            }
        }
    }
    var output = "";
    while position < text_length(source) {
        if text_get(source, position) == "{" && text_get(source, position + 1) == "{" {
            position = position + 2;
            var key = "";
            while position < text_length(source) && text_get(source, position) != "}" {
                key = key + text_get(source, position);
                position = position + 1;
            }
            if map_has(values, key) {
                output = output + map_get(values, key);
            } else {
                output = output + "<missing>";
            }
            position = position + 2;
        } else {
            output = output + text_get(source, position);
            position = position + 1;
        }
    }
    return output;
}
