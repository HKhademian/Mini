/// Filter three-column CSV rows whose third field is yes, returning name and city as tab-separated text.

import "common/list";

/// Return a selected row as text; headers and other rows contribute empty text.
fn csv_row(fields) {
    if list_length(fields) == 3 && list_get(fields, 2) == "yes" {
        return list_get(fields, 0) + "\t" + list_get(fields, 1) + "\n";
    }
    return "";
}

/// Parse commas, quoted fields, doubled quotes, CRLF, and a final row without newline.
fn app_run(source) {
    output := "";
    fields := list_new();
    field := "";
    quoted := false;
    index := 0;
    while index <= text_length(source) {
        character := text_get(source, index);
        if character == "\"" {
            if quoted && text_get(source, index + 1) == "\"" {
                field = field + "\"";
                index = index + 1;
            } else {
                quoted = !quoted;
            }
        } else {
            if !quoted && (character == "," || character == "\n" || character == "") {
                list_set(fields, list_length(fields), field);
                field = "";
                if character != "," {
                    output = output + csv_row(fields);
                    fields = list_new();
                }
            } else {
                if quoted || character != "\r" {
                    field = field + character;
                }
            }
        }
        index = index + 1;
    }
    return output;
}
