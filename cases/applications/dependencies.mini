/// Build a dependency graph from whitespace-delimited edge pairs and traverse from root.

import "core/text";
import "core/list";
import "core/map";

/// Return whitespace-delimited words, preserving their source order.
fn graph_words(source) {
    words := list_new();
    word := "";
    position := 0;
    while position <= text_length(source) {
        character := text_get(source, position);
        if character == " " || character == "\t" || character == "\r" || character == "\n" || character == "" {
            if word != "" {
                list_set(words, list_length(words), word);
                word = "";
            }
        } else {
            word = word + character;
        }
        position = position + 1;
    }
    return words;
}

/// Return each node reachable from root in breadth-first order; cycles and duplicate edges are safe.
fn app_run(source) {
    words := graph_words(source);
    edges := map_new();
    position := 0;
    while position + 1 < list_length(words) {
        from := list_get(words, position);
        if !map_has(edges, from) {
            map_set(edges, from, list_new());
        }
        destinations := map_get(edges, from);
        list_set(destinations, list_length(destinations), list_get(words, position + 1));
        position = position + 2;
    }
    queue := list_new();
    list_set(queue, 0, "root");
    seen := map_new();
    map_set(seen, "root", true);
    position = 0;
    while position < list_length(queue) {
        node := list_get(queue, position);
        if map_has(edges, node) {
            destinations := map_get(edges, node);
            index := 0;
            while index < list_length(destinations) {
                next := list_get(destinations, index);
                if !map_has(seen, next) {
                    map_set(seen, next, true);
                    list_set(queue, list_length(queue), next);
                }
                index = index + 1;
            }
        }
        position = position + 1;
    }
    return queue;
}
