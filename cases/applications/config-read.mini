/// Parse sectioned key=value configuration with comments, whitespace trimming, and replacement.

/// Return a bounded character copy of source.
fn config_slice(source, start, end) {
    var output = "";
    var position = start;
    while (position < end) {
        output = output + text_get(source, position);
        position = position + 1;
    }
    return output;
}

/// Return source without leading or trailing spaces, tabs, or carriage returns.
fn config_trim(source) {
    var start = 0;
    var end = text_length(source);
    while (start < end && (text_get(source, start) == " " || text_get(source, start) == "\t" || text_get(source, start) == "\r")) {
        start = start + 1;
    }
    while (end > start && (text_get(source, end - 1) == " " || text_get(source, end - 1) == "\t" || text_get(source, end - 1) == "\r")) {
        end = end - 1;
    }
    return config_slice(source, start, end);
}

/// Return the final settings map, qualifying section keys with a dot.
fn app_run(source) {
    var settings = map_new();
    var section = "";
    var line = "";
    var position = 0;
    while (position <= text_length(source)) {
        var character = text_get(source, position);
        if (character == "\n" || character == "") {
            line = config_trim(line);
            if (text_get(line, 0) == "[" && text_get(line, text_length(line) - 1) == "]") {
                section = config_trim(config_slice(line, 1, text_length(line) - 1));
            } else {
                if (line != "" && text_get(line, 0) != "#" && text_get(line, 0) != ";") {
                    var split = 0;
                    while (split < text_length(line) && text_get(line, split) != "=") {
                        split = split + 1;
                    }
                    if (split < text_length(line)) {
                        var key = config_trim(config_slice(line, 0, split));
                        if (section != "") {
                            key = section + "." + key;
                        }
                        map_set(settings, key, config_trim(config_slice(line, split + 1, text_length(line))));
                    }
                }
            }
            line = "";
        } else {
            line = line + character;
        }
        position = position + 1;
    }
    return settings;
}
