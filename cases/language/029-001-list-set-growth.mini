import "core/io";
import "core/text";
import "core/list";
import "core/process";

items := list_new();
r := text_length(io_read_all()) - 1;
list_set(items, r - 1, 0);
if r > 0 {
    if list_length(items) != r || list_get(items, r - 1) != 0 {
        process_exit(1);
    }
} else {
    if list_length(items) != 0 {
        process_exit(1);
    }
}
io_write("ok");
