import "core/number";
import "core/io";
import "util/io";
fn classify(value) {
    if value < 0 {
        return -1;
    } else if value == 0 {
        return 0;
    } else {
        return 1;
    }
}
io_write_line(number_to_text(classify(-2)) + number_to_text(classify(0)) + number_to_text(classify(5)));
