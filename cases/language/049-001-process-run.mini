/// Exercise one-shot process execution with captured, inherited, and failed commands.

import "common/text";
import "common/list";
import "common/map";
import "common/io";
import "common/process";

args := list_new();
list_set(args, 0, "-e");
list_set(args, 1, "process.stdout.write(\"out\"); process.stderr.write(\"err\"); process.exit(3)");
result := process_run("node", args, "capture");
if map_get(result, "status") == 3 && map_get(result, "stdout") == "out" && map_get(result, "stderr") == "err"
    && map_get(result, "signal") == "" && map_get(result, "error") == "" {
    io_write_line("capture ok");
} else {
    io_write_line("capture bad");
}

inherited := list_new();
list_set(inherited, 0, "-e");
list_set(inherited, 1, "process.stdout.write(\"inherited\" + String.fromCharCode(10))");
shown := process_run("node", inherited, "inherit");
if map_get(shown, "status") == 0 && map_get(shown, "stdout") == "" && map_get(shown, "stderr") == "" {
    io_write_line("inherit ok");
} else {
    io_write_line("inherit bad");
}

missing := process_run("mini-no-such-command", list_new(), "capture");
if map_get(missing, "status") == 1 && map_get(missing, "stdout") == "" && text_length(map_get(missing, "error")) > 0 {
    io_write_line("failure ok");
} else {
    io_write_line("failure bad");
}

env_args := list_new();
list_set(env_args, 0, "-e");
list_set(env_args, 1, "process.stdout.write(process.env.PATH ? \"env\" : \"missing\")");
inherited_env := process_run("node", env_args, "capture");
if map_get(inherited_env, "stdout") == "env" {
    io_write_line("env ok");
} else {
    io_write_line("env bad");
}
