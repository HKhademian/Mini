var inner = list_new();
var untouched = list_new();
list_set(inner, 0, "nested");
var items = list_new();
list_set(items, 0, 7);
list_set(items, 1, true);
list_set(items, 2, inner);
if list_length(untouched) != 0 || list_length(items) != 3 {
    process_exit(1);
}
if list_get(items, 0) != 7 || list_get(items, 1) != true {
    process_exit(1);
}
io_write(list_get(list_get(items, 2), 0));
