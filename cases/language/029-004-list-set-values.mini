var inner = list_new();
var untouched = list_new();
list_set(inner, 0, "nested");
var items = list_new();
list_set(items, 0, 7);
list_set(items, 1, true);
list_set(items, 2, inner);
if (list_length(untouched) != 0 || list_length(items) != 3) {
    process_exit(1);
}
if (list_at(items, 0) != 7 || list_at(items, 1) != true) {
    process_exit(1);
}
write(list_at(list_at(items, 2), 0));
