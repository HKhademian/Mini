var items = list_new();
list_set(items, 0, "a");
list_set(items, 1, "b");
list_set(items, 2, "c");
if (list_to_text(items, ",") == "a,b,c") {
    write("ok\n");
} else {
    write("bad\n");
}
var mixed = list_new();
list_set(mixed, 0, "a");
list_set(mixed, 1, 1);
list_set(mixed, 2, "c");
if (list_to_text(mixed, "-") == "a--c") {
    write("ok\n");
} else {
    write("bad\n");
}
fn join(value, separator) {
    return list_to_text(value, separator);
}
var empty = list_new();
if (list_to_text(empty, ",") == "" && list_to_text(items, "") == "abc" && join(12, ",") == "" && join(items, 12) == "") {
    write("ok\n");
} else {
    write("bad\n");
}
