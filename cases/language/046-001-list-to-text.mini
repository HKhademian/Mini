include "../../libs/common/io.mini";
items := list_new();
list_set(items, 0, "a");
list_set(items, 1, "b");
list_set(items, 2, "c");
if list_to_text(items, ",") == "a,b,c" {
    io_write_line("ok");
} else {
    io_write_line("bad");
}
mixed := list_new();
list_set(mixed, 0, "a");
list_set(mixed, 1, 1);
list_set(mixed, 2, "c");
if list_to_text(mixed, "-") == "a--c" {
    io_write_line("ok");
} else {
    io_write_line("bad");
}
fn join(value, separator) {
    return list_to_text(value, separator);
}
empty := list_new();
if list_to_text(empty, ",") == "" && list_to_text(items, "") == "abc" && join(12, ",") == "" && join(items, 12) == "" {
    io_write_line("ok");
} else {
    io_write_line("bad");
}
