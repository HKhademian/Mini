/// Parse JSON objects, arrays, scalars, and invalid input.

import "common/json";
import "common/list";
import "common/map";
import "common/io";

object := json_parse("{\"name\":\"Mini\",\"count\":2,\"missing\":null,\"items\":[1,true]}");
if map_get(object, "ok") {
    value := map_get(object, "value");
    items := map_get(value, "items");
    if map_get(value, "name") == "Mini" && map_get(value, "count") == 2 && map_get(value, "missing") == 0
        && list_length(items) == 2 && list_get(items, 1) == true {
        io_write_line("object ok");
    } else {
        io_write_line("object bad");
    }
} else {
    io_write_line("object bad");
}
list_value := json_parse("[1,\"two\",false,null]");
values := map_get(list_value, "value");
if map_get(list_value, "ok") && list_length(values) == 4 && list_get(values, 3) == 0 {
    io_write_line("list ok");
} else {
    io_write_line("list bad");
}
broken := json_parse("{bad");
if !map_get(broken, "ok") {
    io_write_line("invalid ok");
} else {
    io_write_line("invalid bad");
}
