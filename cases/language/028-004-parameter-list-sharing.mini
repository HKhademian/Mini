import "core/io";
import "core/list";
import "core/process";

fn change(items) {
    list_set(items, 0, "shared");
    items = list_new();
    return list_length(items);
}

original := fn_args();
alias := original;
result := change(original);
if result != 0 || list_length(original) != 1 {
    process_exit(1);
}
io_write(list_get(original, 0));
io_write(":");
io_write(list_get(alias, 0));
