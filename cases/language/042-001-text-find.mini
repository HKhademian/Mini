include "../../libs/common/io.mini";
source := "alpha beta alpha";
first := text_find(source, "alpha");
second := text_find(source, "beta");
missing := text_find(source, "missing");
empty := text_find(source, "");
if first == 0 && second == 6 && missing == -1 && empty == 0 && text_find("abc", "bc") == 1 && text_find("abc", "abcd") == -1 {
    io_write_line("ok");
} else {
    io_write_line("bad");
}
