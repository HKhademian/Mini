include "../../libs/common/io.mini";
/// Read the millisecond clock without moving backwards.
first := time_millis();
if first > 0 {
    io_write_line("time ok");
} else {
    io_write_line("time bad");
}
second := time_millis();
if second >= first {
    io_write_line("order ok");
} else {
    io_write_line("order bad");
}
