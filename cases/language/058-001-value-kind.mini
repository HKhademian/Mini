/// Report the runtime kind of each mini value kind.

import "core/value";
import "core/list";
import "core/map";
import "core/io";
import "util/io";

if value_kind("x") == "text" && value_kind(1) == "number" && value_kind(true) == "boolean"
    && value_kind(list_new()) == "list" && value_kind(map_new()) == "map" {
    io_write_line("kind ok");
} else {
    io_write_line("kind bad");
}
