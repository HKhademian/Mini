import "common/json";
import "common/list";
import "common/map";
import "common/io";
inner := map_new();
map_set(inner, "z", list_new());
outer := map_new();
map_set(outer, "nested", inner);
map_set(outer, "text", "value");
if json_text(outer) == "{\"nested\":{\"z\":[]},\"text\":\"value\"}" {
    io_write_line("ok");
} else {
    io_write_line("bad");
}
sparse := list_new();
list_set(sparse, 2, "last");
if json_text(sparse) == "[null,null,\"last\"]" {
    io_write_line("ok");
} else {
    io_write_line("bad");
}
