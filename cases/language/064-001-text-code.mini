/// Exercise code-point access and construction.

import "common/number";
import "common/io";

accent := text_code("é");
io_write_line(number_to_text(accent));
io_write_line(text_from_code(accent));
emoji := text_code("😀");
io_write_line(number_to_text(emoji));
io_write_line(text_from_code(emoji));
