fn mark(value) {
    if value {
        return "T";
    } else {
        return "F";
    }
}
var token = io_read_all();
var left = token == "left";
var right = token == "right";
io_write(mark(!left) + mark(left && right) + mark(left || right));
io_write(mark(true || false && false));
io_write(mark((true || false) && false));
