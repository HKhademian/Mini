import "common/io";

fn mark(value) {
    if value {
        return "T";
    } else {
        return "F";
    }
}
token := io_read_all();
left := token == "left";
right := token == "right";
io_write(mark(!left) + mark(left && right) + mark(left || right));
io_write(mark(true || false && false));
io_write(mark((true || false) && false));
