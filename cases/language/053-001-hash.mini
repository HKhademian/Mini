/// Hash text and byte lists with SHA-256.

include "common/io.mini";

if hash_sha256("abc") == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad" {
    io_write_line("text ok");
} else {
    io_write_line("text bad");
}
bytes := list_new();
list_set(bytes, 0, 97);
list_set(bytes, 1, 98);
list_set(bytes, 2, 99);
if hash_sha256(bytes) == hash_sha256("abc") {
    io_write_line("bytes ok");
} else {
    io_write_line("bytes bad");
}
