import "common/io";
import "common/list";
import "common/map";
import "common/process";

expected := io_read_all();
items := map_new();
if list_length(map_keys(items)) != 0 {
    process_exit(1);
}
map_set(items, expected, 0);
map_set(items, expected + "!", false);
map_set(items, expected, 7);
keys := map_keys(items);
position := 0;
found_first := false;
found_second := false;
while position < list_length(keys) {
    key := list_get(keys, position);
    if !map_has(items, key) {
        process_exit(1);
    }
    if key == expected {
        found_first = true;
    }
    if key == expected + "!" {
        found_second = true;
    }
    position = position + 1;
}
if list_length(keys) != 2 || !found_first || !found_second || list_length(map_keys(items)) != 2 {
    process_exit(1);
}
io_write("keys");
