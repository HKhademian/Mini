items := map_new();
fresh := map_new();
key := io_read_all();
map_set(items, key, 0);
map_set(items, key + "!", false);
if !map_has(items, key) || !map_has(items, key + "!") {
    process_exit(1);
}
map_set(items, key, "replacement");
if !map_has(items, key) || map_has(items, key + "?") || map_has(fresh, key) {
    process_exit(1);
}
io_write("present");
