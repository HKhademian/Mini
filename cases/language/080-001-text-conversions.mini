import "core/io";
import "core/display";
import "core/list";
import "core/number";

values := list_of("a", 2);
io_write_line(
    text_to_text("plain"),
    "|",
    list_to_text(values),
    "|",
    value_to_text(values),
    "|",
    to_text(42),
    "|",
    number_to_text(42),
    "|",
    to_text(false)
);
if text_to_text(1) == "" && list_to_text(1) == "" {
    io_write_line("ok");
} else {
    io_write_line("bad");
}
