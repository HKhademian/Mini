import "common/list";
import "common/io";
items := list_new();
list_set(items, 0, "a");
list_set(items, 1, "b");
list_set(items, 2, "c");
if list_join(",", items) == "a,b,c" {
    io_write_line("ok");
} else {
    io_write_line("bad");
}
mixed := list_new();
list_set(mixed, 0, "a");
list_set(mixed, 1, 1);
list_set(mixed, 2, "c");
if list_join("-", mixed) == "a--c" {
    io_write_line("ok");
} else {
    io_write_line("bad");
}
more := list_of("d", "e");
if list_join("-", items, mixed, more) == "a-b-c-a--c-d-e" {
    io_write_line("ok");
} else {
    io_write_line("bad");
}
fn join(value, separator) {
    return list_join(separator, value);
}
empty := list_new();
if list_join(",", empty) == "" && list_join("", items) == "abc" && join(12, ",") == "" && join(items, 12) == "" {
    io_write_line("ok");
} else {
    io_write_line("bad");
}
