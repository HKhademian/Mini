var items = list_new();
list_set(items, 5, "hi");
var position = 0;
while position < 5 {
    if list_get(items, position) != 0 {
        process_exit(1);
    }
    position = position + 1;
}
if list_length(items) != 6 || list_get(items, 5) != "hi" || list_get(items, 6) != 0 {
    process_exit(1);
}
list_set(items, 2, false);
if list_get(items, 2) != false {
    process_exit(1);
}
io_write(list_get(items, 5));
