/// Exercise list stack mutation.

include "common/io.mini";
include "common/list.mini";

items := list_new();
list_push_back(items, "b");
list_push_back(items, "c");
list_push_front(items, "a");
io_write_line(list_get(items, 0) + list_get(items, 1) + list_get(items, 2));
io_write_line(list_pop_back(items));
io_write_line(list_pop_front(items));
io_write_line(number_to_text(list_length(items)));
list_truncate(items, 0);
io_write_line(number_to_text(list_length(items)));
