fn mark(value) {
    if value {
        return "T";
    } else {
        return "F";
    }
}
value := 2;
io_write(mark(value < 2) + mark(value <= 2));
io_write(mark(value > 2) + mark(value >= 2));
io_write(mark(value == 2) + mark(value != 2));
io_write(mark(1 < value) + mark(3 > value));
io_write(mark(3 <= value) + mark(1 >= value));
