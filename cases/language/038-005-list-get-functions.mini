import "common/list";
fn items() {
    io_write("l");
    result := list_new();
    list_set(result, 0, "value");
    return result;
}
fn index() {
    io_write("i");
    return 0;
}
io_write(list_get(items(), index()));
io_write(":");
if list_get(0, index()) != 0 {
    process_exit(1);
}
io_write(":ok");
