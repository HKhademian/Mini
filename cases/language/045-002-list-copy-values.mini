fn copy(value) {
    return list_copy(value);
}
var empty = copy(12);
if (list_length(empty) == 0) {
    write("ok\n");
} else {
    write("bad\n");
}
var sparse = list_new();
list_set(sparse, 3, "last");
var copied = list_copy(sparse);
if (list_length(copied) == 4 && list_get(copied, 0) == 0 && list_get(copied, 3) == "last") {
    write("ok\n");
} else {
    write("bad\n");
}
