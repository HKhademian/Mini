fn copy(value) {
    return list_copy(value);
}
empty := copy(12);
if list_length(empty) == 0 {
    io_write_line("ok");
} else {
    io_write_line("bad");
}
sparse := list_new();
list_set(sparse, 3, "last");
copied := list_copy(sparse);
if list_length(copied) == 4 && list_get(copied, 0) == 0 && list_get(copied, 3) == "last" {
    io_write_line("ok");
} else {
    io_write_line("bad");
}
