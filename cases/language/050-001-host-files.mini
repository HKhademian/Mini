/// Exercise the executable path, temporary directory, and removal primitives.

import "common/text";
import "common/list";
import "common/map";
import "common/path";
import "common/io";
import "common/process-run";
import "common/file";

version_args := list_new();
list_set(version_args, 0, "--version");
version := process_run(process_exec_path(), version_args, "capture");
if map_get(version, "status") == 0 && text_length(map_get(version, "stdout")) > 0 {
    io_write_line("exec ok");
} else {
    io_write_line("exec bad");
}
directory := path_temp_directory();
if text_length(directory) > 0 {
    io_write_line("temp ok");
} else {
    io_write_line("temp bad");
}
file_write(directory + "/note.txt", "value\n");
if file_read(directory + "/note.txt") == "value\n" {
    io_write_line("file ok");
} else {
    io_write_line("file bad");
}
file_remove(directory + "/note.txt");
file_remove(directory + "/note.txt");
directory_remove(directory);
directory_remove(directory);
io_write_line("remove ok");
