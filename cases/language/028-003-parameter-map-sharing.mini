import "common/map";
fn change(items) {
    map_set(items, "name", "shared");
    items = map_new();
    map_set(items, "name", "local");
    return map_get(items, "name");
}

original := map_new();
map_set(original, "name", "old");
alias := original;
result := change(original);
io_write(map_get(original, "name"));
io_write(":");
io_write(map_get(alias, "name"));
io_write(":");
io_write(result);
