import "common/number";
import "common/list";
import "common/io";
if number_to_text(0) == "0" && number_to_text(123) == "123" && number_to_text(-45) == "-45" && number_to_text(1 + 2) == "3" && number_to_text(0 - 7) == "-7" {
    io_write_line("ok");
} else {
    io_write_line("bad");
}
fn format_number(value) {
    return number_to_text(value);
}
if format_number("12") == "" && format_number(list_new()) == "" {
    io_write_line("ok");
} else {
    io_write_line("bad");
}
