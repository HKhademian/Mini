include "common/io.mini";
/// Exercise UTF-8 byte conversion.
bytes := text_to_bytes("Aé😀");
output := "";
position := 0;
while position < list_length(bytes) {
    if position > 0 {
        output = output + ",";
    }
    output = output + number_to_text(list_get(bytes, position));
    position = position + 1;
}
io_write_line(output);
io_write_line(text_from_bytes(bytes));
