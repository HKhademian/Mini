import "common/list";
import "common/map";
import "common/io";
import "common/process";
import "util/process";
args := list_new();
list_set(args, 0, "-e");
list_set(args, 1, "process.stdout.write('extra ignored')");
result := process_run("node", args, "capture", "ignored");
io_write_line(map_get(result, "stdout"));
