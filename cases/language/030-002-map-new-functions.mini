import "core/io";
import "core/list";
import "core/map";
import "core/process";

fn make_map() {
    return map_new();
}
fn store(value) {
    items := list_new();
    list_set(items, 0, value);
    return items;
}
items := store(make_map());
list_set(list_get(items, 0), 5, "ignored");
if list_length(items) != 1 {
    process_exit(1);
}
io_write("stored");
