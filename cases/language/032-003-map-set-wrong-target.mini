fn target() {
    write("t");
    return "hello";
}
fn key() {
    write("k");
    return "name";
}
fn value() {
    write("v");
    return 1;
}
map_set(target(), key(), value());
map_set("hello", "name", 1);
var items = list_new();
list_set(items, 0, "original");
map_set(items, "name", 2);
map_set(false, "name", list_new());
map_set(1, "name", map_new());
if (list_length(items) != 1 || list_at(items, 0) != "original") {
    process_exit(1);
}
write(":ok");
