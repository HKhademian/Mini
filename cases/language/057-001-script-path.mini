/// Read the running script path and confirm it exists.

import "core/text";
import "core/io";
import "core/path";
import "core/process";
import "util/io";

script := process_script_path();
if text_length(script) > 0 && path_is_exists(script) {
    io_write_line("script ok");
} else {
    io_write_line("script bad");
}
