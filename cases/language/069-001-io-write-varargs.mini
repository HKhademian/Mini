/// Write mixed values through the variadic I/O helpers.

import "core/display";
import "core/json";
import "core/text";
import "core/number";
import "core/list";
import "core/io";
import "core/map";

text := "Mini";
io_write_line(text_to_code(text_get(text, 0), 0), "=", text_from_code(77));
io_write(true, ":", 12);
io_write_line();
items := list_of("a", 2);
io_write(items, "|", value_to_text(items), "|", json_text(items), "|");
record := map_of("z", true, "a", 1);
io_write(record, "|", value_to_text(record), "|", json_text(record), "|");
io_write(42, "|", value_to_text(42), "|", number_to_text(42), "|");
io_write("raw", "|", value_to_text("raw"), "|", true, "|", value_to_text(true), "|");
io_write("x", 7);
io_write("y");
io_write_line();
