/// Write mixed values through the variadic I/O helpers.

include "common/io.mini";
include "common/map.mini";

text := "Mini";
io_write_line(text_code(text_get(text, 0)), "=", text_from_code(77));
io_write(true, ":", 12);
io_write_line();
items := list_of("a", 2);
io_write(items, "|", to_text(items), "|", json_to_text(items), "|");
record := map_of("z", true, "a", 1);
io_write(record, "|", to_text(record), "|", json_to_text(record), "|");
io_write(42, "|", to_text(42), "|", number_to_text(42), "|");
io_write("raw", "|", to_text("raw"), "|", true, "|", to_text(true), "|");
io_write("x", 7);
io_write("y");
io_write_line();
