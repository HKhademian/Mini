/// Count key snapshots before/after replacement, including empty and method-like keys.
//

import "common/io";
import "common/list";
import "common/map";

items := map_new();
key := io_read_all();
if list_length(map_keys(items)) != 0 {
    process_exit(1);
}
map_set(items, key, 0);
if list_length(map_keys(items)) != 1 {
    process_exit(1);
}
map_set(items, key, false);
if list_length(map_keys(items)) != 1 {
    process_exit(1);
}
map_set(items, key + "!", "second");
count := list_length(map_keys(items));
if count != 2 || list_length(map_keys(items)) != count || list_length(map_keys(map_new())) != 0 {
    process_exit(1);
}
io_write("two");
