import "core/list";
import "core/map";
import "core/io";
original := list_new();
list_set(original, 0, "first");
list_set(original, 1, "second");
copy := list_copy(original);
list_set(copy, 1, "changed");
list_set(copy, 2, "added");
if list_length(original) == 2 && list_get(original, 1) == "second" && list_length(copy) == 3 && list_get(copy, 1) == "changed" && list_get(copy, 2) == "added" {
    io_write_line("ok");
} else {
    io_write_line("bad");
}
nested := map_new();
map_set(nested, "value", "shared");
list_set(original, 2, nested);
nested_copy := list_copy(original);
map_set(list_get(nested_copy, 2), "value", "changed");
if map_get(nested, "value") == "changed" {
    io_write_line("shared");
} else {
    io_write_line("bad");
}
