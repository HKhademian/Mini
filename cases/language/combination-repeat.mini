fn repeat(token, count) {
    var output = "";
    var position = 0;
    while (position < count) {
        if (token == ";" && position == 1) {
            output = output + "\n";
        } else {
            output = output + token;
        }
        position = position + 1;
    }
    return output;
}
var token = readAll();
var count = 3;
if (token == "zero") {
    count = 0;
} else {
    if (token == "one") {
        count = 1;
    }
}
write(repeat(token, count));
