import "common/io";

fn repeat(token, count) {
    output := "";
    position := 0;
    while position < count {
        if token == ";" && position == 1 {
            output = output + "\n";
        } else {
            output = output + token;
        }
        position = position + 1;
    }
    return output;
}
token := io_read_all();
count := 3;
if token == "zero" {
    count = 0;
} else {
    if token == "one" {
        count = 1;
    }
}
io_write(repeat(token, count));
